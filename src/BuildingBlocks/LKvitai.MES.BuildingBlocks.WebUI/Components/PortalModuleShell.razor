@namespace LKvitai.MES.BuildingBlocks.WebUI.Components
@inject NavigationManager Navigation
@inject IConfiguration Configuration
@using Microsoft.JSInterop
@inject IJSRuntime JS
@implements IAsyncDisposable
@inject Microsoft.Extensions.Localization.IStringLocalizer<LKvitai.MES.BuildingBlocks.WebUI.Localization.ShellResources> L

@*
   PortalModuleShell — shared dark Portal topbar + test-strip wrapper used by
   every WebUI in the solution (Portal home, Sales, Frontline, future modules).
   Owning this in BuildingBlocks.WebUI keeps brand, environment chrome, search
   entry point and the user/logout block in lock-step across modules; module
   pages should only ever render their own content via @ChildContent.

   Issue #92 — Portal 1: Shared Header And Auth-Aware Shell:
     * Brand block is a single <a> linking to the Portal home URL so users
       can return from any module. URL resolution priority:
         1. PortalHomeUrl parameter (lets a host pin a specific value)
         2. Configuration["PortalWebUi:BaseUrl"] (the canonical knob — same
            key consumers already use to build cross-module redirects)
         3. "/" — safe local fallback (works in dev, in tests, and inside the
            Portal WebUI itself where the home IS this app's root).
     * Universal search (Issue #375): the button opens a search panel under
       the topbar. The panel markup is rendered here once; everything after
       that (debounce, parallel calls to each module's {PathBase}/shell/search
       relay, grouping, keyboard) is done by wwwroot/js/shell-search.js in the
       browser, with the user's Portal cookie and without circuit round trips.
     * User name / initials come from ClaimsPrincipal with a layered fallback
       chain (display_name claim → GivenName+Surname → ClaimTypes.Name →
       Identity.Name → "Signed in" / "U"). No more hardcoded "Lukas" / "RM".
     * Environment / Version are explicit slots ready to be fed by runtime
       data from the Portal status endpoint (Issue #93). Default Version is
       "—" so an unset value never silently shows a wrong number.

   Authentic-migration seam: the user-block + logout form below is the only
   place that talks to the current cookie-auth flow. Replacing it with an
   Authentic-driven token + redirect is a localised change — see the
   "AUTHENTIC SEAM" markers below.
*@

<div class="app-shell">
    @if (ShowEnvironmentStrip)
    {
        <div class="test-strip @(LiveProductionDataWarning ? "test-strip--live-production" : "")" role="status">
            <div class="test-strip__main">
                <span class="icon-warning" aria-hidden="true"></span>
                <strong>@L["Shell.EnvironmentBanner", EnvironmentLabel]</strong>
                <span class="test-strip__note">@ResolvedBannerNote</span>
            </div>
            <span class="mono test-strip__host">@DisplayHost</span>
        </div>
    }

    <header class="topbar">
        @if (OnMobileNavigationToggle.HasDelegate)
        {
            <button class="topbar__menu-toggle"
                    type="button"
                    aria-label="@(MobileNavigationLabel ?? L["Shell.MobileNavigation"])"
                    aria-controls="@MobileNavigationTargetId"
                    aria-expanded="@MobileNavigationOpen.ToString().ToLowerInvariant()"
                    @onkeydown="HandleMobileNavigationKeyDown"
                    @onclick="OnMobileNavigationToggle">
                <svg viewBox="0 0 24 24"
                     fill="none"
                     stroke="currentColor"
                     stroke-width="1.8"
                     stroke-linecap="round"
                     aria-hidden="true"
                     focusable="false">
                    <path d="M4 7h16M4 12h16M4 17h16" />
                </svg>
            </button>
        }

        @* Brand block: single clickable link back to Portal home. Logo,
           name and tagline all live INSIDE the same <a> per the design
           rule (one anchor, one click target). *@
        <a class="brand brand--link"
           href="@ResolvedHomeUrl"
           aria-label="@BrandAriaLabel">
            <div class="brand__mark" aria-hidden="true">
                <svg class="brand__mark-icon" viewBox="0 0 40 40" fill="none" stroke="currentColor" stroke-width="3.2" stroke-linecap="round" focusable="false">
                    <path d="M12 15 C22 12.5 30 15.5 32 21" />
                    <path d="M11 21 C21 19 28.5 22 31 27" />
                    <circle cx="9" cy="18.5" r="2.8" fill="currentColor" stroke="none" />
                </svg>
            </div>
            <div>
                <div class="brand__name"><span class="brand__wordmark">Cikada</span><span class="brand__suffix">.MES</span></div>
                <div class="brand__tagline mono">Manufacturing &middot; Execution &middot; Standards</div>
            </div>
        </a>

        <div class="topbar__separator" aria-hidden="true"></div>

        @* Universal-search entry point. Still a button (not an input) in the
           topbar so the header stays compact; it opens the search panel below.
           aria-expanded is owned by shell-search.js after the first render. *@
        <button class="portal-search portal-search--placeholder"
                type="button"
                @ref="_searchButton"
                aria-label="@(SearchLabel ?? L["Shell.Search.Label"])"
                aria-haspopup="dialog"
                aria-controls="shell-search-panel"
                aria-expanded="false">
            <span class="portal-search__icon" aria-hidden="true"></span>
            <span class="portal-search__placeholder">@(SearchPlaceholder ?? L["Shell.Search.Placeholder"])</span>
            <span class="portal-search__hint mono" aria-hidden="true" data-shell-search-hint>⌘K</span>
        </button>

        <div class="topbar__spacer"></div>

        <div class="env-badge" aria-label="@L["Shell.EnvironmentAndVersion"]">
            <div><span class="mono">ENV</span><strong class="mono">@EnvironmentBadge</strong></div>
            <div><span class="mono">VER</span><strong class="mono">@Version</strong></div>
        </div>

        <LanguageSwitcher />

        @* Help: the user manuals (served at /manuals/ behind the portal sign-in), opened on the current module's
           section in a new tab so the user keeps their place. *@
        <a class="topbar__help" href="@HelpUrl" target="_blank" rel="noopener"
           title="@L["Shell.Help"]" aria-label="@L["Shell.Help"]" data-testid="shell-help">?</a>

        @* AUTHENTIC SEAM: user-block + logout form.
           Replace the form below with an Authentic logout endpoint when the
           module migrates off cookie auth. The DisplayName/Initials helpers
           keep working as long as the new auth scheme still surfaces a
           ClaimsPrincipal — only the markup wrapping the logout submit needs
           to change. *@
        <div class="user-block">
            <div class="user-block__avatar">@Initials</div>
            <div>
                <div class="user-block__name">@DisplayName</div>
                <form action="@LogoutAction" method="post" class="logout-form">
                    <button class="link-button" type="submit">@L["Shell.Logout"]</button>
                </form>
            </div>
        </div>
    </header>

    @* Universal-search panel (Issue #375). Rendered once, hidden; opened,
       filled and closed by shell-search.js. Blazor never re-renders the
       results container, so the script owns its children. *@
    <div class="shell-search-anchor">
        <div class="shell-search"
             id="shell-search-panel"
             role="dialog"
             aria-label="@L["Shell.Search.PopoverTitle"]"
             @ref="_searchPanel"
             hidden>
            <div class="shell-search__bar">
                <span class="portal-search__icon" aria-hidden="true"></span>
                <input class="shell-search__input"
                       type="search"
                       data-shell-search-input
                       role="combobox"
                       aria-expanded="true"
                       aria-controls="shell-search-results"
                       aria-autocomplete="list"
                       aria-label="@L["Shell.Search.PopoverTitle"]"
                       placeholder="@(SearchPlaceholder ?? L["Shell.Search.Placeholder"])"
                       maxlength="100"
                       autocomplete="off"
                       autocapitalize="off"
                       spellcheck="false" />
                <button type="button"
                        class="link-button shell-search__close"
                        data-shell-search-close
                        aria-label="@L["Shell.Dismiss"]">×</button>
            </div>
            <div class="shell-search__scopes" role="toolbar" aria-label="@L["Shell.Search.Scope.Label"]"
                 data-shell-search-scopes hidden></div>
            <div class="shell-search__results" id="shell-search-results" role="listbox"
                 aria-label="@L["Shell.Search.PopoverTitle"]" data-shell-search-results></div>
            <div class="shell-search__status" role="status" aria-live="polite" data-shell-search-status>@L["Shell.Search.Hint"]</div>
        </div>
    </div>

    @ChildContent
</div>

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>
    /// Authenticated principal whose claims drive <see cref="DisplayName"/>
    /// and <see cref="Initials"/>. Pass <c>null</c> from anonymous shells —
    /// the safe "Signed in" / "U" fallback fires.
    /// </summary>
    [Parameter] public ClaimsPrincipal? User { get; set; }

    [Parameter] public string EnvironmentName { get; set; } = "Development";
    [Parameter] public string? HostLabel { get; set; }

    /// <summary>
    /// Build/release version shown in the env-badge. Issue #93 wires this
    /// to the Portal status endpoint (APP_VERSION / RELEASE_TAG); until then
    /// the default em-dash makes "value not set" obviously not-a-version.
    /// </summary>
    [Parameter] public string Version { get; set; } = "—";

    /// <summary>
    /// Optional override for the Portal home URL the brand block links to.
    /// When unset, the shell falls back to <c>Configuration["PortalWebUi:BaseUrl"]</c>
    /// then to <c>"/"</c>.
    /// </summary>
    [Parameter] public string? PortalHomeUrl { get; set; }

    /// <summary>
    /// Optional callback for modules that own a sidebar. When supplied, the
    /// topbar renders a hamburger at the mobile breakpoint; modules without a
    /// sidebar leave it unset so the shared header never shows a dead control.
    /// </summary>
    [Parameter] public EventCallback OnMobileNavigationToggle { get; set; }

    /// <summary>Current off-canvas navigation state for <c>aria-expanded</c>.</summary>
    [Parameter] public bool MobileNavigationOpen { get; set; }

    /// <summary>Accessible action label for the mobile navigation toggle.</summary>
    [Parameter] public string? MobileNavigationLabel { get; set; }

    /// <summary>ID of the module drawer controlled by the mobile toggle.</summary>
    [Parameter] public string? MobileNavigationTargetId { get; set; }

    /// <summary>
    /// Placeholder copy for the universal-search button and input. Outlook
    /// 365-style "search everything" entry point — never module-scoped:
    /// module-scoped search lives inside the module page (e.g. Sales has its
    /// own "Search orders" input). Modules SHOULD NOT override this — keeping the copy
    /// identical across Portal/Sales/Frontline is what teaches users the
    /// search button is a global entry point and not "Search this module".
    /// Was "Search…" / "Find fabric, module, customer…" pre-#92 — both
    /// drifted because each module set its own value.
    /// </summary>
    [Parameter] public string? SearchPlaceholder { get; set; }

    [Parameter] public string? SearchLabel { get; set; }

    /// <summary>
    /// Same-origin paths of the module search relays the panel asks in
    /// parallel (Issue #375). Null falls back to <c>Shell:Search:Endpoints</c>
    /// in configuration, then to <see cref="DefaultSearchEndpoints"/> — the
    /// path-based layout of deploy/traefik/dynamic. A module the user cannot
    /// use answers 401/403 and simply contributes no group.
    /// </summary>
    [Parameter] public IReadOnlyList<string>? SearchEndpoints { get; set; }

    /// <summary>Module relays known to the first version of the universal search.</summary>
    public static IReadOnlyList<string> DefaultSearchEndpoints { get; } =
        ["/sales/shell/search", "/warehouse/shell/search", "/portal/shell/search", "/shopfloor/shell/search",
         "/finance/shell/search", "/frontline/shell/search"];

    public const int SearchMinLength = 2;
    public const int SearchDebounceMs = 250;
    public const int SearchModuleTimeoutMs = 5000;
    public const int SearchLimitPerKind = 8;

    /// <summary>
    /// POST target for logout. Defaults to the relative <c>auth/logout</c>
    /// endpoint that <c>Portal.WebUI/Program.cs</c> + every module's auth
    /// pipeline already maps. AUTHENTIC SEAM: switch to the Authentic-issued
    /// endpoint here (or wrap the form in a host-provided fragment).
    /// </summary>
    [Parameter] public string LogoutAction { get; set; } = "auth/logout";

    /// <summary>
    /// Modules whose manual section has its own start page (docs/manuals/docs/{section}/index.md). The portal (the
    /// hub) and the warehouse (no section start page) open the manuals start page, which lists every module.
    /// </summary>
    private static readonly HashSet<string> ManualSections =
        new(StringComparer.OrdinalIgnoreCase) { "sales", "finance", "shopfloor", "frontline", "scanning" };

    /// <summary>Overrides the help link; by default it follows the module the page belongs to.</summary>
    [Parameter] public string? HelpLink { get; set; }

    private string HelpUrl => HelpLink ?? BuildHelpUrl(Navigation.BaseUri);

    /// <summary>
    /// /manuals/{module}/ for a module with its own manual section (the first path segment of the module's base
    /// URI, e.g. https://host/sales/ -> /manuals/sales/), otherwise the manuals start page.
    /// </summary>
    public static string BuildHelpUrl(string? baseUri)
    {
        if (!Uri.TryCreate(baseUri, UriKind.Absolute, out var uri)) return "/manuals/";
        var module = uri.AbsolutePath.Trim('/').Split('/')[0];
        return ManualSections.Contains(module) ? $"/manuals/{module.ToLowerInvariant()}/" : "/manuals/";
    }

    /// <summary>Test-strip note. Null falls back to the localized shared-environment copy.</summary>
    [Parameter] public string? BannerNote { get; set; }
    [Parameter] public bool LiveProductionDataWarning { get; set; }

    private bool ShowEnvironmentStrip => LKvitai.MES.BuildingBlocks.WebUI.Services.EnvironmentChrome.ShowEnvironmentStrip(EnvironmentName);

    private string ResolvedBannerNote => BannerNote ?? L["Shell.BannerNote.Shared"].Value;

    private const string DefaultManualsIndexUrl = "/manuals/search/search_index.json";

    private const string SearchModulePath = "./_content/LKvitai.MES.BuildingBlocks.WebUI/js/shell-search.js";

    private ElementReference _searchButton;
    private ElementReference _searchPanel;
    private IJSObjectReference? _searchModule;

    private IReadOnlyList<string> ResolvedSearchEndpoints
    {
        get
        {
            if (SearchEndpoints is not null) return SearchEndpoints;

            var configured = Configuration.GetSection("Shell:Search:Endpoints").GetChildren()
                .Select(x => x.Value)
                .Where(x => !string.IsNullOrWhiteSpace(x))
                .Select(x => x!)
                .ToArray();
            return configured.Length > 0 ? configured : DefaultSearchEndpoints;
        }
    }

    /// <summary>
    /// Wires the search panel once the circuit is interactive. Any failure
    /// here (script not served, circuit gone) must never take the module
    /// down with it — the panel then just stays closed.
    /// </summary>
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        try
        {
            // The assembly MVID alone does not change when only the static JS changes, and the scripts are
            // cached for hours (browser + Cloudflare): add the build version (it carries the commit).
            var version = typeof(PortalModuleShell).Assembly.ManifestModule.ModuleVersionId.ToString("N");
            var build = Uri.EscapeDataString(Version ?? string.Empty);
            _searchModule = await JS.InvokeAsync<IJSObjectReference>("import", $"{SearchModulePath}?v={version}&b={build}");
            await _searchModule.InvokeVoidAsync("init", _searchButton, _searchPanel, new
            {
                endpoints = ResolvedSearchEndpoints,
                // Manuals (MkDocs index, same origin); empty value switches the manuals group off.
                manualsIndexUrl = Configuration["Shell:Search:ManualsIndexUrl"] ?? DefaultManualsIndexUrl,
                minLength = SearchMinLength,
                debounceMs = SearchDebounceMs,
                timeoutMs = SearchModuleTimeoutMs,
                limit = SearchLimitPerKind,
                // History in the browser is kept per signed-in user.
                user = User?.FindFirstValue(ClaimTypes.NameIdentifier) ?? User?.Identity?.Name,
                text = new
                {
                    hint = L["Shell.Search.Hint"].Value,
                    loading = L["Shell.Search.Loading"].Value,
                    empty = L["Shell.Search.Empty"].Value,
                    partial = L["Shell.Search.Partial"].Value,
                    keys = L["Shell.Search.Keys"].Value,
                    otherKind = L["Shell.Search.Kind.Other"].Value,
                    scopeAll = L["Shell.Search.Scope.All"].Value,
                    recentOpened = L["Shell.Search.Recent.Opened"].Value,
                    recentQueries = L["Shell.Search.Recent.Queries"].Value,
                    recentClear = L["Shell.Search.Recent.Clear"].Value,
                    kinds = new Dictionary<string, string>
                    {
                        ["order"] = L["Shell.Search.Kind.Order"].Value,
                        ["customer"] = L["Shell.Search.Kind.Customer"].Value,
                        ["item"] = L["Shell.Search.Kind.Item"].Value,
                        ["supplier"] = L["Shell.Search.Kind.Supplier"].Value,
                        ["location"] = L["Shell.Search.Kind.Location"].Value,
                        ["document"] = L["Shell.Search.Kind.Document"].Value,
                        ["screen"] = L["Shell.Search.Kind.Screen"].Value,
                        ["manual"] = L["Shell.Search.Kind.Manual"].Value,
                    },
                },
            });
        }
        catch (Exception ex) when (ex is JSException or JSDisconnectedException
            or InvalidOperationException or OperationCanceledException)
        {
            _searchModule = null;
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (_searchModule is null) return;

        try
        {
            await _searchModule.InvokeVoidAsync("dispose", _searchButton);
            await _searchModule.DisposeAsync();
        }
        catch (Exception ex) when (ex is JSException or JSDisconnectedException
            or InvalidOperationException or OperationCanceledException)
        {
            // The circuit is already gone; the browser drops the listeners with the page.
        }
    }

    private string EnvironmentLabel => (EnvironmentName ?? "Development").ToUpperInvariant();

    private string DisplayHost => !string.IsNullOrWhiteSpace(HostLabel)
        ? HostLabel
        : ResolveNavigationHost();

    private string EnvironmentBadge
    {
        get
        {
            var name = EnvironmentName ?? "Development";
            return name.Length <= 4 ? name.ToUpperInvariant() : name[..4].ToUpperInvariant();
        }
    }

    /// <summary>
    /// Layered fallback chain for the user's display name. First match wins:
    ///   1. <c>display_name</c> claim (preferred — lets identity providers
    ///      surface a properly-cased "Lukas Mažeika" instead of a username).
    ///   2. <c>GivenName + Surname</c> assembled from standard claims.
    ///   3. <see cref="ClaimTypes.Name"/>.
    ///   4. <c>IIdentity.Name</c> (covers older test fixtures).
    ///   5. The literal "Signed in" — only when no auth context exists at all.
    /// </summary>
    private string DisplayName
    {
        get
        {
            if (User is null) return SignedInLabel;

            var displayClaim = User.FindFirstValue("display_name");
            if (!string.IsNullOrWhiteSpace(displayClaim)) return displayClaim;

            var given   = User.FindFirstValue(ClaimTypes.GivenName);
            var surname = User.FindFirstValue(ClaimTypes.Surname);
            if (!string.IsNullOrWhiteSpace(given) || !string.IsNullOrWhiteSpace(surname))
            {
                return $"{given} {surname}".Trim();
            }

            return User.FindFirstValue(ClaimTypes.Name)
                ?? User.Identity?.Name
                ?? SignedInLabel;
        }
    }

    /// <summary>
    /// Two-letter avatar text. Same fallback priority as
    /// <see cref="DisplayName"/>: an explicit <c>initials</c> claim wins
    /// outright; otherwise we slice the resolved display name.
    /// </summary>
    private string Initials
    {
        get
        {
            var explicitInitials = User?.FindFirstValue("initials");
            if (!string.IsNullOrWhiteSpace(explicitInitials))
            {
                return explicitInitials.ToUpperInvariant();
            }

            var name = DisplayName;
            if (string.Equals(name, SignedInLabel, StringComparison.Ordinal))
            {
                return "U";
            }

            var parts = name.Split(' ', StringSplitOptions.RemoveEmptyEntries);
            var raw = parts.Length >= 2
                ? $"{parts[0][0]}{parts[1][0]}"
                : parts.Length == 1 ? parts[0][0].ToString() : "U";
            return raw.ToUpperInvariant();
        }
    }

    private string ResolvedHomeUrl
    {
        get
        {
            if (!string.IsNullOrWhiteSpace(PortalHomeUrl)) return PortalHomeUrl;

            var configured = Configuration["PortalWebUi:BaseUrl"];
            if (!string.IsNullOrWhiteSpace(configured)) return configured;

            // Safe local fallback. Inside the Portal WebUI itself this is
            // always correct; inside module shells it just no-ops to the
            // module's own root, which is better than dead-linking.
            return "/";
        }
    }

    private string BrandAriaLabel => string.Equals(ResolvedHomeUrl, "/", StringComparison.Ordinal)
        ? L["Shell.HomeLink"].Value
        : L["Shell.HomeLink.Open"].Value;

    private string SignedInLabel => L["Shell.SignedIn"].Value;

    private string ResolveNavigationHost()
    {
        if (Uri.TryCreate(Navigation.Uri, UriKind.Absolute, out var uri) && !string.IsNullOrWhiteSpace(uri.Host))
        {
            return uri.Host;
        }

        return "localhost";
    }

    private async Task HandleMobileNavigationKeyDown(KeyboardEventArgs args)
    {
        if (!MobileNavigationOpen
            || !OnMobileNavigationToggle.HasDelegate
            || !string.Equals(args.Key, "Escape", StringComparison.Ordinal))
        {
            return;
        }

        await OnMobileNavigationToggle.InvokeAsync();
    }
}
