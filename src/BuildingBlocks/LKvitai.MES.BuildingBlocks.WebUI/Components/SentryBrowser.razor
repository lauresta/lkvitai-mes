@namespace LKvitai.MES.BuildingBlocks.WebUI.Components
@using LKvitai.MES.BuildingBlocks.Observability
@using Microsoft.Extensions.DependencyInjection
@inject IServiceProvider Services
@inject IHttpContextAccessor HttpContextAccessor

@*
    Sentry in the browser: JavaScript errors, Session Replay and, when Sentry:TracesSampleRate > 0, page tracing.
    Every WebUI's _Layout.cshtml renders it in <head> with
        <component type="typeof(SentryBrowser)" render-mode="Static" />
    Static, not ServerPrerendered: a script only has to be written into the page once, and a static render never
    becomes part of the Blazor circuit, which would insert the script elements again and start Sentry twice.

    Session Replay records the screen unmasked by default (internal staff application; Sentry:Replay:MaskAllText,
    MaskAllInputs and BlockAllMedia switch masking on). Password fields are always masked by the SDK.

    Renders nothing unless the module called builder.AddCikadaSentry(...) with Sentry:Dsn set. The CDN bundle is
    pinned to one @sentry/browser version with its SRI hash (bump both together; the hash is the sha384 of the
    file, base64). It loads with defer, so a slow or unreachable CDN never holds up the page; the init in
    SentryBrowserScript waits for its load event.
*@
@if (_initScript is not null)
{
    <script src="https://browser.sentry-cdn.com/11.19.0/bundle.tracing.replay.min.js"
            integrity="sha384-ZlqqlS4dZZCg5RC7/39fRjAV/Zu2Sk5X6fRnc7J1kwcXhEZrjWguFBFSS1K2DX6l"
            crossorigin="anonymous" defer id="@SentryBrowserScript.BundleElementId"></script>
    <script>@((MarkupString)_initScript)</script>
}

@code {
    private string? _initScript;

    protected override void OnInitialized()
    {
        var settings = Services.GetService<CikadaSentrySettings>();
        if (settings is not { Enabled: true })
        {
            return;
        }

        // HttpContext is the page request itself: the component is rendered statically, never in the circuit.
        var user = HttpContextAccessor.HttpContext?.User;
        var username = user?.Identity?.IsAuthenticated == true ? user.Identity.Name : null;
        _initScript = SentryBrowserScript.Build(settings, username);
    }
}
