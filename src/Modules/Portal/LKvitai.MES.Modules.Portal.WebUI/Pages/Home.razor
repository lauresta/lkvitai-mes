@page "/"
@inject IWebHostEnvironment Env
@inject PortalApiClient PortalApi
@inject IJSRuntime Js

<PageTitle>Cikada.MES &middot; @L["Common.Portal"]</PageTitle>

@*
    Portal home dashboard.

    After issue #93:
      * Modules + News come from the Portal API (PortalApiClient.GetModulesAsync /
        GetNewsAsync). The dashboard renders an empty section if the API is
        unreachable so a Portal-API outage can't take the home page down.
      * Version is rendered from the same API's /status endpoint, sourced from
        APP_VERSION / GIT_SHA / BUILD_DATE env vars injected by build-and-push.yml.
        Local fallback ("0.1.0-dev") keeps `dotnet run` happy.
      * "Open ..." hero buttons are last-three opened modules from
        localStorage (lkPortalRecents.get(3)), filtered against the live
        module list so a renamed/removed module never lingers as a stale chip.

    Out of #93 (still in PortalDashboardData):
      * Operations preview stages, daily-bars, branches-on-track. Replaced by
        the Operations Summary API in #94 / Branches metric in #95.
*@

<main class="main">
    <section class="hero">
        <div class="hero__copy">
            <div class="eyebrow mono">@L["Common.Portal"] &middot; @L["Home.Welcome"]</div>
            <h1>@(string.IsNullOrWhiteSpace(_greetingName) ? L["Home.Greeting"] : L["Home.GreetingNamed", _greetingName])</h1>
            <p>@L["Home.Intro"]</p>
            <div class="hero__actions">
                @* Recent shortcuts come from localStorage and are validated
                   against the navigable module list, so we never render a chip for
                   a module that has been removed/renamed. Falls back to the
                   "Open Warehouse" anchor while no recents exist. The
                   data-portal-recent-key attribute is what portal-recents.js
                   listens for in capture-phase to bump the recents list — JS
                   handles the bump BEFORE the browser navigates away, which
                   is impossible from a Razor @onclick on a real <a href>. *@
                @if (_recentShortcuts.Count > 0)
                {
                    foreach (var recent in _recentShortcuts)
                    {
                        <a class="button @(recent.IsPrimary ? "button--primary" : "button--secondary")"
                           href="@recent.Url"
                           data-portal-recent-key="@recent.Key">@L["Common.OpenModule", recent.Title] <span aria-hidden="true">&rarr;</span></a>
                    }
                }
                else
                {
                    <a class="button button--primary"
                       href="/warehouse/"
                       data-portal-recent-key="warehouse">@L["Common.OpenModule", L["Module.warehouse.Title"]] <span aria-hidden="true">&rarr;</span></a>
                }
                <a class="button button--secondary"
                   href="/shopfloor/"
                   data-portal-recent-key="shopfloor">@L["Common.OpenModule", L["Module.shopfloor.Title"]] <span aria-hidden="true">&rarr;</span></a>
                <a class="button button--secondary hero__roadmap" href="#roadmap">@L["Home.RoadmapNews"] <span aria-hidden="true">&rarr;</span></a>
            </div>
        </div>

        <section class="operations" aria-labelledby="operations-title">
            <div class="operations__head">
                <div>
                    <h2 id="operations-title" class="eyebrow mono">@L["Home.Operations.Title"]</h2>
                    @if (_summaryLoading)
                    {
                        <span class="operations__sample mono">@L["Common.Loading"]</span>
                    }
                    else if (_summary is null)
                    {
                        <span class="operations__sample mono">@L["Home.Operations.SampleData"]</span>
                    }
                </div>
                <fieldset class="segmented" aria-label="@L["Home.Operations.Period"]">
                    <legend class="sr-only">@L["Home.Operations.Period"]</legend>
                    <button class="segmented__button @(_period == "this" ? "is-active" : null)"
                            type="button"
                            @onclick='@(() => SetPeriod("this"))'>@L["Home.Operations.ThisMonth"]</button>
                    <button class="segmented__button @(_period == "last" ? "is-active" : null)"
                            type="button"
                            @onclick='@(() => SetPeriod("last"))'>@L["Home.Operations.LastMonth"]</button>
                </fieldset>
            </div>

            <div class="stage-grid">
                @{
                    var stages = _summary is not null
                        ? _summary.Stages.Select(s => (Label: s.Label, Count: s.Count)).ToList()
                        : PortalDashboardData.Stages.Select(s => (Label: StageLabel(s), Count: _period == "this" ? s.ThisMonth : s.LastMonth)).ToList();
                }
                @for (var index = 0; index < stages.Count; index++)
                {
                    var stage = stages[index];
                    var isFinal = index == stages.Count - 1;
                    <div class="stage @(isFinal ? "is-final" : null)">
                        <span>@stage.Label</span>
                        <strong class="mono">@stage.Count</strong>
                    </div>
                }
            </div>

            <div class="daily-card">
                <div class="daily-card__label mono">@L["Home.Operations.CompletedPerDay"] <span>@(_period == "last" ? L["Home.Operations.LastMonthShort"] : L["Home.Operations.ThisMonthShort"])</span></div>
                <div class="daily-card__bars" aria-hidden="true">
                    @{
                        IReadOnlyList<(int Count, bool IsWeekend)> bars;
                        if (_summary is not null && _summary.CompletedByDay.Count > 0)
                        {
                            bars = _summary.CompletedByDay
                                .Select(d => (
                                    d.Count,
                                    IsWeekend: DateTime.TryParse(d.Date, out var dt) &&
                                               (dt.DayOfWeek is DayOfWeek.Saturday or DayOfWeek.Sunday)))
                                .ToList();
                        }
                        else
                        {
                            bars = PortalDashboardData.Daily[_period]
                                .Select((count, i) => (Count: count, IsWeekend: i % 7 is 5 or 6))
                                .ToList();
                        }
                        var maxVal = bars.Count > 0 ? bars.Max(b => b.Count) : 1;
                        if (maxVal == 0) maxVal = 1;
                    }
                    @for (var index = 0; index < bars.Count; index++)
                    {
                        var (raw, weekend) = bars[index];
                        var height = Math.Max(4, (int)Math.Round(raw / (double)maxVal * 26d));
                        <i class="@(weekend ? "is-weekend" : null)" style="--bar-height: @(height)px"></i>
                    }
                </div>
                <div class="daily-card__total">
                    @{
                        var dailyTotal = _summary is not null
                            ? _summary.CompletedByDay.Sum(d => d.Count)
                            : PortalDashboardData.DailyTotal[_period];
                    }
                    <strong class="mono">@dailyTotal</strong>
                </div>
            </div>

            <div>
                <div class="operations__label mono">@L["Home.Operations.BranchesOnTrack"]</div>
                <div class="branch-grid">
                    @{
                        var branches = _summary?.BranchesOnTrack is { Count: > 0 } realBranches
                            ? realBranches
                            : (IReadOnlyList<BranchOnTrack>)PortalDashboardData.Branches;
                    }
                    @foreach (var branch in branches)
                    {
                        var pct = branch.OnTrackPercent;
                        <div class="branch @(pct.HasValue && pct < 90 ? "is-warning" : null)">
                            <span>@branch.Name</span>
                            @if (pct.HasValue)
                            {
                                <div class="branch__metric">
                                    <strong class="mono">@pct%</strong>
                                    <small class="mono">@branch.Issued&nbsp;/&nbsp;@branch.Ready</small>
                                </div>
                            }
                            else
                            {
                                <strong class="mono">–</strong>
                            }
                        </div>
                    }
                </div>
            </div>
        </section>
    </section>

    <div class="content-grid">
        <section id="roadmap" class="modules-section" aria-labelledby="modules-title">
            <div class="section-head">
                <div>
                    <h2 id="modules-title">@L["Common.Modules"]</h2>
                    <span><strong>@_liveCount</strong> @L["Common.Count.Live"] &middot; <strong>@_pilotCount</strong> @L["Common.Count.Pilot"] &middot; <strong>@_developingCount</strong> @L["Common.Count.Developing"] &middot; <strong>@_plannedCount</strong> @L["Common.Count.Planned"]</span>
                </div>
                @* Module-grid local filter. The topbar's universal-search is now
                   a "coming soon" placeholder owned by PortalModuleShell, so the
                   per-section module filter lives inside the Modules section
                   header — keeping the global search entry honest about scope. *@
                <label class="module-search" for="module-search">
                    <span class="module-search__icon" aria-hidden="true"></span>
                    <span class="sr-only">@L["Home.Modules.FilterLabel"]</span>
                    <input id="module-search"
                           type="search"
                           placeholder="@L["Home.Modules.FilterPlaceholder"]"
                           autocomplete="off"
                           @bind="_query"
                           @bind:event="oninput" />
                </label>
            </div>

            @{
                var filteredModules = FilterModules(_modules, _query);
            }
            @if (filteredModules.Count == 0)
            {
                <div class="empty-state">
                    <div class="mono">@L["Home.Modules.NoMatches"]</div>
                    <p>@L["Home.Modules.NoMatchesText"] <strong>"@_query"</strong>.</p>
                </div>
            }
            else
            {
                <div class="module-grid">
                    @foreach (var mod in filteredModules)
                    {
                        // Only Planned tiles are non-navigable. Live / Pilot /
                        // Developing all open the module; Developing tiles
                        // without a URL fall back to the toast so we never
                        // render a dead <a href="">.
                        var isNavigable = mod.Status is not ModuleStatus.Planned
                            && !string.IsNullOrWhiteSpace(mod.Url);
                        var statusClass = mod.Status switch
                        {
                            ModuleStatus.Live       => "is-live",
                            ModuleStatus.Pilot      => "is-pilot",
                            ModuleStatus.Developing => "is-developing",
                            _                       => null,
                        };

                        if (isNavigable)
                        {
                            <a class="module-card @statusClass"
                               href="@mod.Url"
                               data-portal-recent-key="@mod.Key">
                                <ModuleCardBody Card="@mod" />
                            </a>
                        }
                        else
                        {
                            <button type="button"
                                    class="module-card @statusClass"
                                    @onclick='@(() => ToastPlanned(L.ModuleTitle(mod), mod.Quarter ?? L["Home.Toast.Later"].Value))'>
                                <ModuleCardBody Card="@mod" />
                            </button>
                        }
                    }
                </div>
            }

            <section class="news" aria-labelledby="news-title">
                <div class="news__head">
                    <div>
                        <h2 id="news-title">@L["Home.News.Title"]</h2>
                        <span>@L["Home.News.Subtitle"]</span>
                    </div>
                    <a href="#">@L["Home.News.AllUpdates"] &rarr;</a>
                </div>
                <div class="news-grid">
                    @foreach (var item in _news)
                    {
                        <article class="news-item">
                            <div class="news-item__meta">
                                <span class="news-tag mono" style="color:@item.TagColor;background:@item.TagBackground">@item.Tag</span>
                                <span class="news-date mono">@item.Date</span>
                            </div>
                            <h3>@item.Title</h3>
                            <p>@item.Excerpt</p>
                        </article>
                    }
                </div>
            </section>
        </section>

        <aside class="side-panel" aria-label="@L["Home.Side.AriaLabel"]">
            <div class="side-panel__label mono">@L["Common.Portal"]</div>

            <section class="panel panel--status">
                <header>
                    <h2>@L["Home.Status.Title"]</h2>
                    <span><i aria-hidden="true"></i> @L["Home.Status.Online"]</span>
                </header>
                <div class="status-row"><span>@L["Home.Status.Environment"]</span><strong class="mono @_envStatusRowClass">@_envName</strong></div>
                <div class="status-row"><span>@L["Common.Version"]</span><strong class="mono">@_displayVersion</strong></div>
                <div class="status-row"><span>@L["Common.Modules"]</span><strong class="mono">@FormatModuleStatusSummary()</strong></div>
                <div class="status-row"><span>@L["Home.Status.CurrentModule"]</span><strong>@L["Common.Portal"]</strong></div>
                <div class="status-row"><span>@L["Common.Channel"]</span><strong class="mono">@_envChannel</strong></div>
            </section>

            <section class="panel">
                <header class="panel__plain-head"><h2>@L["Home.Support.Title"]</h2></header>
                <div class="panel__body">
                    <p>@L["Home.Support.Helpdesk"] &middot; <span class="mono">+37062454321</span></p>
                    <p>@L["Home.Support.Team"] &middot; <a href="mailto:developa@lauresta.lt">developa@lauresta.lt</a></p>
                    <p>@L["Common.PortalCms"] &middot; <a href="cms/tiles">@L["Common.Tiles"]</a></p>
                </div>
            </section>

            <section class="panel">
                <header class="panel__plain-head"><h2>@L["Home.Build.Title"]</h2></header>
                <div class="status-row"><span>@L["Common.Version"]</span><strong class="mono">@_displayVersion</strong></div>
                @if (!string.IsNullOrWhiteSpace(_displayGitSha))
                {
                    <div class="status-row"><span>@L["Home.Build.Commit"]</span><strong class="mono">@_displayGitSha</strong></div>
                }
                @if (_displayBuildDate is { } date)
                {
                    <div class="status-row"><span>@L["Home.Build.Built"]</span><strong class="mono">@date.ToString("yyyy-MM-dd")</strong></div>
                }
                <div class="status-row"><span>@L["Common.Channel"]</span><strong class="mono">@_envChannel</strong></div>
            </section>
        </aside>
    </div>
</main>

@if (_toastVisible)
{
    <output class="toast" aria-live="polite">@_toastMessage</output>
}

@code {
    private const int RecentSlots = 3;
    private const string LocalDevVersion = "0.1.0-dev";

    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }

    private string _period = "this";
    private string _query = string.Empty;

    private string _envName = "TEST";
    private string _envChannel = "test";
    private string? _envStatusRowClass = "status-row__test";
    private string _displayVersion = LocalDevVersion;
    private string? _displayGitSha;
    private DateTimeOffset? _displayBuildDate;

    private string? _greetingName;
    private bool _toastVisible;
    private string? _toastMessage;
    private CancellationTokenSource? _toastCts;

    private IReadOnlyList<ModuleCard> _modules = Array.Empty<ModuleCard>();
    private IReadOnlyList<NewsItem> _news = Array.Empty<NewsItem>();
    private List<RecentShortcut> _recentShortcuts = new();

    private OperationsSummary? _summary;
    private bool _summaryLoading = true;

    private int _liveCount;
    private int _pilotCount;
    private int _developingCount;
    private int _plannedCount;

    protected override async Task OnInitializedAsync()
    {
        ResolveEnvironmentLabels();

        // Fan-out: pull modules + news + status in parallel. None of them
        // block hero rendering — failures fall back to empty / local defaults
        // so a Portal API outage degrades the home page rather than killing it.
        var modulesTask = PortalApi.GetModulesAsync();
        var newsTask    = PortalApi.GetNewsAsync();
        var statusTask  = PortalApi.GetStatusAsync();
        var summaryTask = PortalApi.GetOperationsSummaryAsync(_period);

        _modules = await modulesTask;
        _news    = await newsTask;
        var status = await statusTask;
        if (status is not null)
        {
            if (!string.IsNullOrWhiteSpace(status.DisplayVersion)) _displayVersion = status.DisplayVersion;
            if (!string.IsNullOrWhiteSpace(status.GitSha))  _displayGitSha  = ShortSha(status.GitSha);
            _displayBuildDate = status.BuildDate;
        }

        _summary        = await summaryTask;
        _summaryLoading = false;

        _liveCount       = _modules.Count(m => m.Status == ModuleStatus.Live);
        _pilotCount      = _modules.Count(m => m.Status == ModuleStatus.Pilot);
        _developingCount = _modules.Count(m => m.Status == ModuleStatus.Developing);
        _plannedCount    = _modules.Count(m => m.Status == ModuleStatus.Planned);

        if (AuthState is not null)
        {
            var state = await AuthState;
            _greetingName = ResolveGreetingName(state.User);
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        // Recents come from localStorage (window.lkPortalRecents.get(3)). We
        // resolve them after first render because JSInterop requires an
        // attached circuit. A second StateHasChanged() promotes the now-validated
        // recents into the hero.
        var recentKeys = await SafeGetRecentsAsync(RecentSlots);
        var byKey = _modules
            .Where(m => m.Status is not ModuleStatus.Planned && !string.IsNullOrWhiteSpace(m.Url))
            .ToDictionary(m => m.Key, StringComparer.OrdinalIgnoreCase);

        var resolved = new List<RecentShortcut>(RecentSlots);
        foreach (var key in recentKeys)
        {
            if (byKey.TryGetValue(key, out var card) && !string.IsNullOrWhiteSpace(card.Url))
            {
                resolved.Add(new RecentShortcut(card.Key, L.ModuleTitle(card), card.Url, IsPrimary: resolved.Count == 0));
            }
            if (resolved.Count >= RecentSlots) break;
        }

        if (resolved.Count > 0)
        {
            _recentShortcuts = resolved;
            StateHasChanged();
        }
    }

    private async Task<IReadOnlyList<string>> SafeGetRecentsAsync(int take)
    {
        try
        {
            return await Js.InvokeAsync<string[]>("lkPortalRecents.get", take);
        }
        catch (JSException) { return Array.Empty<string>(); }
        catch (InvalidOperationException) { return Array.Empty<string>(); }
        catch (TaskCanceledException) { return Array.Empty<string>(); }
    }

    private void ResolveEnvironmentLabels()
    {
        var envName = (Env.EnvironmentName ?? "Development").Trim();
        if (Env.IsProduction())
        {
            _envName = "PROD";
            _envChannel = "prod";
            _envStatusRowClass = null;
        }
        else if (Env.IsDevelopment())
        {
            _envName = "DEV";
            _envChannel = "dev";
            _envStatusRowClass = "status-row__dev";
        }
        else
        {
            _envName = envName.ToUpperInvariant();
            _envChannel = envName.ToLowerInvariant();
            _envStatusRowClass = "status-row__test";
        }
    }

    private IReadOnlyList<ModuleCard> FilterModules(IReadOnlyList<ModuleCard> modules, string query)
    {
        if (string.IsNullOrWhiteSpace(query))
        {
            return modules;
        }

        var trimmed = query.Trim();
        return modules
            .Where(m => $"{m.Title} {m.Category} {m.Description} {L.ModuleTitle(m)} {L.ModuleCategory(m)} {L.ModuleDescription(m)}".Contains(trimmed, StringComparison.OrdinalIgnoreCase))
            .ToList();
    }

    private async Task ToastPlanned(string title, string quarter)
    {
        _toastMessage = L["Home.Toast.Planned", title, quarter].Value;
        _toastVisible = true;

        if (_toastCts is not null)
        {
            await _toastCts.CancelAsync();
            _toastCts.Dispose();
        }
        _toastCts = new CancellationTokenSource();
        var token = _toastCts.Token;

        try
        {
            await Task.Delay(2600, token);
        }
        catch (TaskCanceledException)
        {
            return;
        }

        _toastVisible = false;
        StateHasChanged();
    }

    private static string? ResolveGreetingName(ClaimsPrincipal user)
    {
        // Greet with the first available human-friendly name. Same fallback
        // chain as PortalModuleShell.DisplayName but stops short of "Signed
        // in" — the hero copy reads naturally without a name suffix.
        var displayClaim = user.FindFirstValue("display_name");
        if (!string.IsNullOrWhiteSpace(displayClaim)) return SafeFirstName(displayClaim);

        var given = user.FindFirstValue(ClaimTypes.GivenName);
        if (!string.IsNullOrWhiteSpace(given)) return given;

        var name = user.FindFirstValue(ClaimTypes.Name) ?? user.Identity?.Name;
        return string.IsNullOrWhiteSpace(name) ? null : SafeFirstName(name);
    }

    private static string SafeFirstName(string raw)
    {
        var parts = raw.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        return parts.Length == 0 ? raw : parts[0];
    }

    private static string ShortSha(string fullSha) =>
        fullSha.Length <= 7 ? fullSha : fullSha[..7];

    private string FormatModuleStatusSummary()
    {
        var parts = new List<string>(5);
        if (_liveCount > 0) parts.Add($"{_liveCount} {L["Common.Count.Live"].Value}");
        if (_pilotCount > 0) parts.Add($"{_pilotCount} {L["Common.Count.Pilot"].Value}");
        if (_developingCount > 0) parts.Add($"{_developingCount} {L["Common.Count.Developing"].Value}");
        if (_plannedCount > 0) parts.Add($"{_plannedCount} {L["Common.Count.Planned"].Value}");
        parts.Add($"{_modules.Count} {L["Common.Count.Total"].Value}");
        return string.Join(" / ", parts);
    }

    // Sample-data stage labels are hardcoded English in PortalDashboardData;
    // live stage labels come from the Sales DB and are rendered as-is.
    private string StageLabel(OperationsStage stage)
    {
        var localized = L[$"Home.Operations.Stage.{stage.Key}"];
        return localized.ResourceNotFound ? stage.Label : localized.Value;
    }

    private sealed record RecentShortcut(string Key, string Title, string Url, bool IsPrimary);

    private async Task SetPeriod(string period)
    {
        if (_period == period) return;
        _period         = period;
        _summaryLoading = true;
        _summary        = null;
        StateHasChanged();

        _summary        = await PortalApi.GetOperationsSummaryAsync(period);
        _summaryLoading = false;
        StateHasChanged();
    }
}
