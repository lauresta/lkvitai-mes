@implements IAsyncDisposable
@inject IJSRuntime JS

<div class="material-picker reference-autocomplete @(Invalid ? "is-invalid" : "")" data-selected-id="@_selectedId">
    <div class="material-picker__field">
        <span class="material-picker__thumb" aria-hidden="true">
            @if (Selected is { } selected && Image(selected.Code) is { } selectedImage)
            { <img src="@selectedImage" alt="" loading="lazy" /> }
            else { <span class="material-picker__placeholder">▧</span> }
        </span>
        <input @ref="_input" id="@InputId" class="mono material-picker__input" value="@_text"
               data-select-on-focus placeholder="@L["Material.Search"]" disabled="@Disabled" autocomplete="off" spellcheck="false"
               role="combobox" aria-label="@L["Material.Material"]" aria-autocomplete="list" aria-expanded="@(_open ? "true" : "false")"
               aria-controls="@ListId" aria-activedescendant="@ActiveOptionId" aria-invalid="@(Invalid ? "true" : null)"
               aria-describedby="@DescribedBy" @oninput="ChangeTextAsync" @onfocus="Open" @onblur="Close"
               @onkeydown="KeyDownAsync" />
        @if (Selected is { } material)
        {
            <span class="material-picker__selected-name">@material.Name</span>
            <span class="material-picker__free @(material.FreeQuantity <= 0 ? "is-short" : "")">@L["Material.FreeQuantity", Quantity(material.FreeQuantity), material.Unit ?? ""]</span>
        }
        <button type="button" class="material-picker__toggle" tabindex="-1" disabled="@Disabled" aria-label="@L["Material.ShowMaterials"]"
                @onmousedown:preventDefault @onclick="ToggleAsync">▾</button>
    </div>
    @if (_open && !Disabled)
    {
        <div id="@ListId" class="material-picker__menu" role="listbox" aria-label="@L["Material.Materials"]">
            <div class="material-picker__head" aria-hidden="true"><span>@L["Material.Material"]</span><span>@L["Material.Free"]</span><span>@L["Material.Warehouse"]</span><span>@L["Material.Production"]</span><span>@L["Material.Total"]</span><span>@L["Material.Reserved"]</span></div>
            @for (var index = 0; index < _matches.Count; index++)
            {
                var item = _matches[index];
                <div @key="item.Id" id="@OptionId(index)" class="material-picker__option @(_activeIndex == index ? "is-active" : "")"
                     role="option" aria-selected="@(item.Id == _selectedId ? "true" : "false")" @onmousedown:preventDefault @onclick="@(() => SelectAsync(item))">
                    <span class="material-picker__identity"><span class="material-picker__thumb" aria-hidden="true">
                        @if (Image(item.Code) is { } image) { <img src="@image" alt="" loading="lazy" /> }
                        else { <span class="material-picker__placeholder">▧</span> }
                    </span><span><strong class="mono">@item.Code</strong><small>@item.Name</small></span></span>
                    <span class="material-picker__quantity @(item.FreeQuantity <= 0 ? "is-short" : "")">@Quantity(item.FreeQuantity) <small>@item.Unit</small></span>
                    <span class="material-picker__quantity">@Quantity(item.WarehouseQuantity)</span>
                    <span class="material-picker__quantity">@Quantity(item.ProductionQuantity)</span>
                    <span class="material-picker__quantity">@Quantity(item.TotalQuantity)</span>
                    <span class="material-picker__quantity">@Quantity(item.ReservedQuantity)</span>
                </div>
            }
            @if (_matches.Count == 0) { <div class="material-picker__message">@L["Material.NoMatches"]</div> }
            else if (_hasMore) { <div class="material-picker__message">@L["Material.FirstResults", MaximumSuggestions]</div> }
            <div class="material-picker__message">@L["Material.StockSnapshot"]</div>
        </div>
    }
    @if (!string.IsNullOrWhiteSpace(ErrorText)) { <div id="@DescribedBy" class="material-picker__error" role="alert">@ErrorText</div> }
</div>

@code {
    private const int MaximumSuggestions = 30;
    [Parameter] public string Id { get; set; } = "";
    [Parameter] public IEnumerable<DemoColour> Items { get; set; } = [];
    [Parameter] public int? Value { get; set; }
    [Parameter] public EventCallback<int?> ValueChanged { get; set; }
    [Parameter] public string? ExistingCode { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public bool Invalid { get; set; }
    [Parameter] public string? DescribedBy { get; set; }
    [Parameter] public string? ErrorText { get; set; }
    private readonly string _instanceId = "material-" + Guid.NewGuid().ToString("N");
    private ElementReference _input;
    private IJSObjectReference? _module;
    private IReadOnlyList<DemoColour> _items = [], _matches = [];
    private readonly Dictionary<string,string> _images = new(StringComparer.OrdinalIgnoreCase);
    private int? _lastValue, _selectedId;
    private string _text = "", _imageRequestKey = "";
    private bool _initialized, _editing, _open, _hasMore, _disposed;
    private int _activeIndex = -1;
    private string InputId => string.IsNullOrWhiteSpace(Id) ? _instanceId : Id;
    private string ListId => _instanceId + "-list";
    private string OptionId(int index) => _instanceId + "-option-" + index;
    private string? ActiveOptionId => _open && _activeIndex >= 0 && _activeIndex < _matches.Count ? OptionId(_activeIndex) : null;
    private DemoColour? Selected => _items.FirstOrDefault(item => item.Id == _selectedId);
    private string? Image(string code) => _images.GetValueOrDefault(code);
    private static string Quantity(decimal? value) => value?.ToString("0.###", CultureInfo.CurrentCulture) ?? "—";

    protected override void OnParametersSet()
    {
        _items = Items.GroupBy(x => x.Id).Select(x => x.First()).OrderBy(x => x.Code.Length).ThenBy(x => x.Code, StringComparer.CurrentCultureIgnoreCase).ToArray();
        if (!_initialized || Value != _lastValue)
        {
            _initialized = true; _editing = false; _selectedId = Value; _lastValue = Value;
            _text = Selected?.Code ?? ExistingCode ?? "";
            _activeIndex = -1;
        }
        else if (!_editing) _text = Selected?.Code ?? ExistingCode ?? "";
        if (Disabled) Close();
        Filter();
    }

    private void Filter()
    {
        var query = _editing ? _text.Trim() : "";
        var matches = _items.Where(item => query.Length == 0 || item.Code.Contains(query, StringComparison.CurrentCultureIgnoreCase) || item.Name.Contains(query, StringComparison.CurrentCultureIgnoreCase)).Take(MaximumSuggestions + 1).ToArray();
        _hasMore = matches.Length > MaximumSuggestions; _matches = matches.Take(MaximumSuggestions).ToArray();
        if (_activeIndex >= _matches.Count) _activeIndex = _matches.Count - 1;
    }
    private void Open() { if (Disabled) return; _open = true; Filter(); _activeIndex = -1; }
    private void Close() { _open = false; _activeIndex = -1; }
    private async Task ToggleAsync() { if (_open) Close(); else { await _input.FocusAsync(); Open(); } }
    private async Task ChangeTextAsync(ChangeEventArgs args)
    {
        if (Disabled) return;
        _text = args.Value?.ToString() ?? ""; _editing = true; _open = true;
        var hadSelection = _selectedId.HasValue; _selectedId = _lastValue = null;
        Filter(); _activeIndex = _matches.Count > 0 ? 0 : -1;
        if (hadSelection) await ValueChanged.InvokeAsync(null);
    }
    private async Task SelectAsync(DemoColour option)
    {
        if (Disabled || !_items.Any(x => x.Id == option.Id)) return;
        _selectedId = _lastValue = option.Id; _text = option.Code; _editing = false; Close();
        await ValueChanged.InvokeAsync(option.Id);
    }
    private async Task KeyDownAsync(KeyboardEventArgs args)
    {
        if (Disabled) return;
        switch(args.Key)
        {
            case "ArrowDown": if (!_open) Open(); _activeIndex = _matches.Count == 0 ? -1 : (_activeIndex + 1) % _matches.Count; break;
            case "ArrowUp": if (!_open) Open(); _activeIndex = _matches.Count == 0 ? -1 : (_activeIndex <= 0 ? _matches.Count - 1 : _activeIndex - 1); break;
            case "Enter" when _open && _activeIndex >= 0 && _activeIndex < _matches.Count: await SelectAsync(_matches[_activeIndex]); break;
            case "Tab" when _editing && _activeIndex >= 0 && _activeIndex < _matches.Count: await SelectAsync(_matches[_activeIndex]); break;
            case "Escape": Close(); break;
        }
    }
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_disposed) return;
        if (firstRender)
        {
            _module = await JS.InvokeAsync<IJSObjectReference>("import", "./js/material-autocomplete.js");
            if (_disposed) { await _module.DisposeAsync(); return; }
            await _module.InvokeVoidAsync("attach", _input);
        }
        if (_module is null) return;
        if (ActiveOptionId is { } active) await _module.InvokeVoidAsync("scrollActive", _input, active);
        var codes = (_open ? _matches.Select(x => x.Code) : []).Prepend(Selected?.Code).Where(x => !string.IsNullOrEmpty(x)).Select(x => x!).Distinct(StringComparer.OrdinalIgnoreCase).ToArray();
        var key = string.Join("|", codes);
        if (key.Length == 0 || key == _imageRequestKey) return;
        _imageRequestKey = key;
        try
        {
            var images = await _module.InvokeAsync<Dictionary<string,string>>("loadImages", codes, _instanceId, Selected?.Code);
            if (_disposed) return;
            var changed = false;
            foreach (var image in images) if (_images.GetValueOrDefault(image.Key) != image.Value) { _images[image.Key] = image.Value; changed = true; }
            if (changed) StateHasChanged();
        }
        catch (JSException) { /* Optional thumbnails never prevent selecting a material. */ }
    }
    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        if (_module is null) return;
        try { await _module.InvokeVoidAsync("detach", _input, _instanceId); await _module.DisposeAsync(); }
        catch (JSDisconnectedException) { } catch (TaskCanceledException) { }
    }
}
