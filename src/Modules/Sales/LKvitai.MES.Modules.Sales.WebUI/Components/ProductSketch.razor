<svg class="product-sketch" viewBox="0 0 120 100" role="img" aria-label="Schematic illustration of @Category">
    <rect x="16" y="8" width="88" height="82" rx="3" fill="var(--n-0)" stroke="var(--n-300)" stroke-width="3" />
    <rect x="20" y="12" width="80" height="74" fill="var(--n-50)" />
    @if (Kind == "roller")
    {
        <rect x="20" y="12" width="80" height="@(IsCassette ? 14 : 8)" rx="3" fill="var(--n-600)" />
        <rect x="22" y="@(IsCassette ? 27 : 21)" width="76" height="@(IsCassette ? 49 : 55)" fill="var(--accent-100)" stroke="var(--accent-400)" />
        @if (IsZebra)
        {
            <path d="M22 35H98M22 49H98M22 63H98" stroke="var(--n-0)" stroke-width="7" />
        }
        <circle cx="101" cy="24" r="3" fill="var(--accent-700)" />
        <path d="M101 28v42" stroke="var(--accent-600)" stroke-width="2" />
    }
    else if (Kind == "horizontal")
    {
        @for (var y = 19; y < 82; y += HorizontalStep)
        {
            <path d="M22 @y H98" stroke="var(--accent-500)" stroke-width="5" />
        }
    }
    else if (Kind == "vertical")
    {
        @for (var x = 26; x < 100; x += 11)
        {
            <path d="M@x 16 V83" stroke="var(--accent-500)" stroke-width="7" />
        }
    }
    else if (Kind == "pleated")
    {
        @for (var y = 20; y < 80; y += 8)
        {
            <path d="M22 @y H98" stroke="var(--accent-400)" stroke-width="2" />
        }
        <path d="M22 14v72M98 14v72" stroke="var(--n-500)" stroke-width="2" />
    }
    else if (Kind == "screen")
    {
        <rect x="23" y="16" width="74" height="66" fill="var(--accent-50)" stroke="var(--n-500)" stroke-width="3" />
        <path d="M24 17l72 64M96 17L24 81" stroke="var(--accent-400)" stroke-width="1" />
    }
    else if (Kind == "grille")
    {
        @for (var x = 29; x < 100; x += 15)
        {
            <path d="M@x 14 V85" stroke="var(--n-600)" stroke-width="4" />
        }
        <path d="M21 35H99M21 61H99" stroke="var(--n-600)" stroke-width="3" />
    }
    else if (Kind == "awning")
    {
        <path d="M20 22H100L89 55H31Z" fill="var(--accent-100)" stroke="var(--accent-600)" stroke-width="3" />
        <path d="M30 55v26M90 55v26" stroke="var(--n-600)" stroke-width="3" />
    }
    else if (Kind == "gate")
    {
        @for (var y = 27; y < 83; y += 14)
        {
            <path d="M22 @y H98" stroke="var(--n-500)" stroke-width="4" />
        }
    }
    else if (Kind == "panel")
    {
        <rect x="23" y="15" width="24" height="66" fill="var(--accent-100)" stroke="var(--accent-500)" />
        <rect x="47" y="15" width="24" height="66" fill="var(--accent-50)" stroke="var(--accent-500)" />
        <rect x="71" y="15" width="24" height="66" fill="var(--accent-100)" stroke="var(--accent-500)" />
    }
    else if (Kind == "romane")
    {
        <path d="M22 16H98V70Q84 80 60 74Q38 80 22 70Z" fill="var(--accent-100)" stroke="var(--accent-500)" stroke-width="2" />
        <path d="M22 31Q60 37 98 31M22 49Q60 55 98 49M22 68Q60 74 98 68" fill="none" stroke="var(--accent-400)" stroke-width="2" />
    }
    else if (Kind == "pvc")
    {
        <rect x="23" y="15" width="74" height="67" fill="var(--accent-50)" stroke="var(--n-600)" stroke-width="5" />
        <path d="M60 16V82M24 49H96" stroke="var(--n-600)" stroke-width="4" />
        <path d="M64 25L89 42" stroke="var(--accent-400)" stroke-width="2" />
    }
    else if (Kind == "nature")
    {
        @for (var y = 20; y < 80; y += 11)
        {
            <path d="M22 @y H98" stroke="var(--accent-500)" stroke-width="7" />
        }
        <path d="M42 16V82M77 16V82" stroke="var(--n-500)" stroke-width="2" />
    }
    else if (Kind == "accessory")
    {
        <circle cx="60" cy="49" r="21" fill="var(--accent-50)" stroke="var(--accent-600)" stroke-width="4" />
        <circle cx="60" cy="49" r="7" fill="var(--accent-500)" />
    }
    else if (Kind == "service")
    {
        <path d="M37 69l30-32 10 10-30 32z" fill="var(--accent-100)" stroke="var(--accent-600)" stroke-width="3" />
        <circle cx="73" cy="36" r="9" fill="var(--n-50)" stroke="var(--accent-600)" stroke-width="3" />
    }
    else
    {
        <rect x="22" y="16" width="76" height="66" fill="var(--accent-100)" stroke="var(--accent-500)" stroke-width="2" />
        <path d="M22 48H98" stroke="var(--accent-400)" stroke-width="2" />
    }
</svg>

@code {
    [Parameter] public string Category { get; set; } = "";
    [Parameter] public string TypeName { get; set; } = "";

    private bool IsCassette => Category.Contains("kasetin", StringComparison.OrdinalIgnoreCase)
        || TypeName.Contains("kaset", StringComparison.OrdinalIgnoreCase)
        || TypeName.Contains("UNI", StringComparison.OrdinalIgnoreCase);
    private bool IsZebra => Category.Contains("ZEBRA", StringComparison.OrdinalIgnoreCase)
        || TypeName.Contains("ZEBRA", StringComparison.OrdinalIgnoreCase)
        || TypeName.Contains("DN", StringComparison.OrdinalIgnoreCase);
    private int HorizontalStep => TypeName.Contains("50", StringComparison.OrdinalIgnoreCase) ? 14 : 9;

    private string Kind
    {
        get
        {
            var name = Category.ToLowerInvariant();
            if (name.Contains("rolet")) return "roller";
            if (name.Contains("horizontal")) return "horizontal";
            if (name.Contains("vertikal")) return "vertical";
            if (name.Contains("plisuot")) return "pleated";
            if (name.Contains("tinkle")) return "screen";
            if (name.Contains("grot") || name.Contains("apsaug")) return "grille";
            if (name.Contains("markiz")) return "awning";
            if (name.Contains("vartai")) return "gate";
            if (name.Contains("panel")) return "panel";
            if (name.Contains("romanet")) return "romane";
            if (name.Contains("pvc")) return "pvc";
            if (name.Contains("nature")) return "nature";
            if (name.Contains("pried") || name.Contains("be gaminių")) return "accessory";
            if (name.Contains("paslaug")) return "service";
            return "other";
        }
    }
}
