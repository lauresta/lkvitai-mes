<div class="demo-live-preview" role="img" aria-label="@TypeName, @WidthMm by @HeightMm millimetres, @Quantity pieces">
    <div class="demo-live-preview__assembly">
        <div class="demo-live-preview__width mono" style="width: @PixelWidth.ToString(System.Globalization.CultureInfo.InvariantCulture)px">@(WidthMm > 0 ? $"{WidthMm} mm" : "Width · mm")</div>
        <div class="demo-live-preview__stage">
            <div class="demo-live-preview__product" style="width: @PixelWidth.ToString(System.Globalization.CultureInfo.InvariantCulture)px; height: @PixelHeight.ToString(System.Globalization.CultureInfo.InvariantCulture)px; transform: @(ControlType.Contains("left", StringComparison.OrdinalIgnoreCase) ? "scaleX(-1)" : "none")">
                <ProductSketch Category="@Category" TypeName="@TypeName" Stretch="true" />
            </div>
            <div class="demo-live-preview__height mono" style="height: @PixelHeight.ToString(System.Globalization.CultureInfo.InvariantCulture)px">@(HeightMm > 0 ? $"{HeightMm} mm" : "Height · mm")</div>
        </div>
    </div>
    <div class="demo-live-preview__quantity mono">× @Quantity pcs</div>
</div>

@code {
    [Parameter] public string Category { get; set; } = "";
    [Parameter] public string TypeName { get; set; } = "";
    [Parameter] public int WidthMm { get; set; }
    [Parameter] public int HeightMm { get; set; }
    [Parameter] public decimal Quantity { get; set; }
    [Parameter] public string ControlType { get; set; } = "";

    // Keep a fixed millimetre-to-pixel scale until the drawing reaches the available preview area.
    private double Scale => Math.Min(0.11, Math.Min(190d / Math.Max(WidthMm, 200), 200d / Math.Max(HeightMm, 200)));
    private double PixelWidth => Math.Max(WidthMm, 200) * Scale;
    private double PixelHeight => Math.Max(HeightMm, 200) * Scale;
}
