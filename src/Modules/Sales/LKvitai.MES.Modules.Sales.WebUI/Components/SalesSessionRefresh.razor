@implements IAsyncDisposable
@inject SalesSessionCredentials Credentials
@inject IJSRuntime JS
@inject NavigationManager Navigation
@using Microsoft.JSInterop
@using LKvitai.MES.Modules.Sales.WebUI.Services

@if (_expired)
{
    <div class="demo-editor__banner" role="status">Your session needs to be renewed.
        <a href="/portal/login.html?returnUrl=%2Fsales%2F" target="_blank" rel="noopener">Sign in in another tab</a> to keep this editor open.
    </div>
}

@code {
    private IJSObjectReference? _module;
    private DotNetObjectReference<SalesSessionRefresh>? _reference;
    private bool _expired;
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        _reference = DotNetObjectReference.Create(this);
        _module = await JS.InvokeAsync<IJSObjectReference>("import", "./js/sales-session.js");
        await _module.InvokeVoidAsync("start", _reference, new Uri(new Uri(Navigation.BaseUri), "auth/session-proof").AbsolutePath);
    }
    [JSInvokable]
    public async Task AcceptSessionProof(string? proof)
    {
        _expired = !await Credentials.AcceptProofAsync(proof);
        await InvokeAsync(StateHasChanged);
    }
    public async ValueTask DisposeAsync()
    {
        if (_module is not null)
        {
            try { await _module.InvokeVoidAsync("stop"); await _module.DisposeAsync(); }
            catch (JSDisconnectedException) { }
        }
        _reference?.Dispose();
    }
}
