@using LKvitai.MES.Modules.Sales.Contracts.OrderEntry
@using Microsoft.JSInterop
@implements IAsyncDisposable
@inject IJSRuntime JS

@* Loaded-reference selector for order-entry fields. Free text never establishes
   an identity: editing clears Value, and only choosing a listed record restores
   it. ExistingLabel preserves display of saved IDs absent from active choices.
   Filtering is local and displays at most thirty records; no lookup per key. *@
<div class="reference-autocomplete @Class" data-selected-id="@_selectedId">
    <div class="reference-autocomplete__field">
        <input @ref="_input" id="@InputId" data-select-on-focus class="demo-input reference-autocomplete__input"
               value="@_text" placeholder="@(Placeholder ?? L["Reference.Search"].Value)" disabled="@Disabled" readonly="@ReadOnly"
               autocomplete="off" spellcheck="false" role="combobox" aria-label="@(string.IsNullOrWhiteSpace(Label) ? null : Label)"
               aria-autocomplete="list" aria-expanded="@(_open ? "true" : "false")"
               aria-controls="@ListId" aria-activedescendant="@ActiveOptionId"
               @oninput="ChangeTextAsync" @onfocus="Open" @onblur="Close" @onkeydown="KeyDownAsync" />
        @if (!Disabled && !ReadOnly && (_selectedId.HasValue || _text.Length > 0))
        {
            <button class="reference-autocomplete__clear" type="button" tabindex="-1" aria-label="@L["Reference.ClearField", AccessibleLabel]"
                    title="@L["Reference.ClearSelection"]" @onclick="ClearAsync">×</button>
        }
    </div>
    @if (_open && !Disabled && !ReadOnly)
    {
        <div id="@ListId" class="reference-autocomplete__menu" role="listbox" aria-label="@AccessibleLabel">
            @for (var index = 0; index < _matches.Count; index++)
            {
                var option = _matches[index];
                <div @key="option.Id" id="@OptionId(index)" class="reference-autocomplete__option @(index == _activeIndex ? "is-active" : "")"
                     role="option" aria-selected="@(option.Id == _selectedId ? "true" : "false")"
                     @onmousedown:preventDefault @onclick="@(() => SelectAsync(option))">@option.Name</div>
            }
            @if (_matches.Count == 0)
            {
                <div class="reference-autocomplete__message" role="status">@L["Reference.NoMatches"]</div>
            }
            else if (_hasMore)
            {
                <div class="reference-autocomplete__message" role="status">@L["Reference.FirstMatches", MaximumSuggestions]</div>
            }
        </div>
    }
</div>

@code {
    private const int MaximumSuggestions = 30;
    [Parameter] public string Id { get; set; } = "";
    [Parameter] public string Label { get; set; } = "";
    [Parameter] public string? Class { get; set; }
    [Parameter] public string? Placeholder { get; set; }
    [Parameter] public IEnumerable<LiveNamedReferenceDto> Items { get; set; } = [];
    [Parameter] public int? Value { get; set; }
    [Parameter] public EventCallback<int?> ValueChanged { get; set; }
    [Parameter] public string? ExistingLabel { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public bool ReadOnly { get; set; }

    private readonly string _instanceId = "reference-" + Guid.NewGuid().ToString("N");
    private ElementReference _input;
    private IJSObjectReference? _module;
    private IReadOnlyList<LiveNamedReferenceDto> _items = [];
    private IReadOnlyList<LiveNamedReferenceDto> _matches = [];
    private int? _lastValue, _selectedId;
    private string _text = "";
    private bool _initialized, _editing, _open, _hasMore, _disposed;
    private int _activeIndex = -1;
    private string InputId => string.IsNullOrWhiteSpace(Id) ? _instanceId : Id;
    private string ListId => _instanceId + "-list";
    private string AccessibleLabel => string.IsNullOrWhiteSpace(Label) ? L["Reference.Selection"].Value : Label;
    private string OptionId(int index) => _instanceId + "-option-" + index;
    private string? ActiveOptionId => _open && _activeIndex >= 0 && _activeIndex < _matches.Count ? OptionId(_activeIndex) : null;

    protected override void OnParametersSet()
    {
        _items = Items?.GroupBy(item => item.Id).Select(group => group.First()).ToArray() ?? [];
        if (!_initialized || Value != _lastValue)
        {
            _initialized = true;
            _editing = false;
            _selectedId = Value;
            _lastValue = Value;
            _text = SelectedText();
            _activeIndex = -1;
        }
        else if (!_editing)
        {
            _text = SelectedText();
        }
        if (Disabled || ReadOnly) _open = false;
        Filter();
    }

    private string SelectedText()
    {
        if (!_selectedId.HasValue) return "";
        var live = _items.FirstOrDefault(item => item.Id == _selectedId);
        return live?.Name ?? L["Reference.SavedValue", string.IsNullOrWhiteSpace(ExistingLabel) ? $"#{_selectedId}" : ExistingLabel].Value;
    }

    private void Filter()
    {
        var query = _editing ? _text.Trim() : "";
        var matches = _items.Where(item => query.Length == 0 || item.Name.Contains(query, StringComparison.CurrentCultureIgnoreCase))
            .Take(MaximumSuggestions + 1).ToArray();
        _hasMore = matches.Length > MaximumSuggestions;
        _matches = matches.Take(MaximumSuggestions).ToArray();
        if (_activeIndex >= _matches.Count) _activeIndex = _matches.Count - 1;
    }

    private void Open()
    {
        if (Disabled || ReadOnly) return;
        _open = true;
        Filter();
        _activeIndex = -1;
    }

    private void Close() { _open = false; _activeIndex = -1; }

    private async Task ChangeTextAsync(ChangeEventArgs args)
    {
        if (Disabled || ReadOnly) return;
        _text = args.Value?.ToString() ?? "";
        _editing = true;
        _open = true;
        var hadSelection = _selectedId.HasValue;
        _selectedId = null;
        _lastValue = null;
        Filter();
        _activeIndex = _matches.Count > 0 ? 0 : -1;
        if (hadSelection) await ValueChanged.InvokeAsync(null);
    }

    private async Task SelectAsync(LiveNamedReferenceDto option)
    {
        if (Disabled || ReadOnly || !_items.Any(item => item.Id == option.Id)) return;
        _selectedId = option.Id;
        _lastValue = option.Id;
        _text = option.Name;
        _editing = false;
        Close();
        await ValueChanged.InvokeAsync(option.Id);
    }

    private async Task ClearAsync()
    {
        if (Disabled || ReadOnly) return;
        _selectedId = null;
        _lastValue = null;
        _text = "";
        _editing = false;
        Close();
        await ValueChanged.InvokeAsync(null);
    }

    private async Task KeyDownAsync(KeyboardEventArgs args)
    {
        if (Disabled || ReadOnly) return;
        switch (args.Key)
        {
            case "ArrowDown":
                if (!_open) { Open(); }
                _activeIndex = _matches.Count == 0 ? -1 : (_activeIndex + 1) % _matches.Count;
                break;
            case "ArrowUp":
                if (!_open) { Open(); }
                _activeIndex = _matches.Count == 0 ? -1 : (_activeIndex <= 0 ? _matches.Count - 1 : _activeIndex - 1);
                break;
            case "Enter" when _open && _activeIndex >= 0 && _activeIndex < _matches.Count:
                await SelectAsync(_matches[_activeIndex]);
                break;
            case "Escape": Close(); break;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_disposed) return;
        if (firstRender)
        {
            var module = await JS.InvokeAsync<IJSObjectReference>("import", "./js/reference-autocomplete.js");
            if (_disposed) { await module.DisposeAsync(); return; }
            _module = module;
            await module.InvokeVoidAsync("attach", _input);
        }
        if (_module is not null && ActiveOptionId is { } optionId)
            await _module.InvokeVoidAsync("scrollActive", _input, optionId);
    }

    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        if (_module is null) return;
        try { await _module.InvokeVoidAsync("detach", _input); await _module.DisposeAsync(); }
        catch (JSDisconnectedException) { }
        catch (TaskCanceledException) { }
    }
}
