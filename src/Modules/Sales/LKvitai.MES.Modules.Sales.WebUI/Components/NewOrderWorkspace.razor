                                            if (label is null) continue;
                                            var formula = ConfiguredType?.ParameterFormulas.ElementAtOrDefault(index);
                                            var automatic = formula is not null && !_configuringLine.ParameterManual[index] && DemoParameterFormula.TryEvaluate(formula, _configuringLine, out _);
