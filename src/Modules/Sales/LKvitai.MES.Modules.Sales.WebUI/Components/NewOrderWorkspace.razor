    private void SelectAccessory(int id)
    {
        _selectedAccessoryId = id;
        _accessoryPriceEntered=false;
        _price = SelectedAccessory?.Price ?? 0;
        if (_attachedTo is not null && SelectedAccessory is not null)
        {
            var width = _attachedTo.WidthMm / 1000m;
            var height = _attachedTo.HeightMm / 1000m;
            _quantity = SelectedAccessory.Unit switch
            {
                "1m pločio" => width * _attachedTo.Quantity,
                "1m aukščio" => height * _attachedTo.Quantity,
                "vnt" => _attachedTo.Quantity,
                "kvm" => width * height * _attachedTo.Quantity,
                _ => 1m
            };
            if (_quantity <= 0) _quantity = 1;
        }
        _pickerError = "";
    }
    private async Task AddLine()
    {
        if (IsLive) { await SaveLiveAccessoryAsync(); return; }
        if (_order is null) return;
        if (_quantity <= 0 || _price < 0)
        {
            _pickerError = L["Product.PositiveQuantityPrice"].Value;
            return;
        }
        if (SelectedAccessory is not null)
        {
            var line = new DemoOrderLine
            {
                Kind = "Priedai", TypeId = SelectedAccessory.Id,
                Category = "Priedai", Name = SelectedAccessory.Name,
                Unit = SelectedAccessory.Unit, Quantity = _quantity, Price = _price,
                Discountable = _attachedTo is not null
            };
            if (_attachedTo is null) _order.Lines.Add(line);
            else _attachedTo.Accessories.Add(line);
        }
        else
        {
            _pickerError = L["Product.ChoosePriedai"].Value;
            return;
        }
        ClosePicker();
    }

    private async Task RemoveLine(DemoOrderLine line) { if (IsLive) await DeleteLiveProductAsync(line); else _order?.Lines.Remove(line); }
    private async Task RemoveAccessory(DemoOrderLine parent, DemoOrderLine accessory) { if (IsLive) await DeleteLiveAccessoryAsync(parent,accessory); else parent.Accessories.Remove(accessory); }
    private void ClosePicker()
    {
        _pickerMode = null;
        _attachedTo = null;
    }
    private async Task CloseAsync()
    {
        if (IsLive && (Entry.HasPendingCommand)) { _liveError=L["Recovery.ResolveBeforeClose"].Value; return; }
        if (IsLive && !await LeaveProductAsync()) return;
        if (IsLive && (HeaderDirty || AddressDirty || PaymentDirty || ConfirmationDirty) && !await JS.InvokeAsync<bool>("confirm", L["Workspace.LeaveUnsavedConfirm"].Value)) return;
        _leaving=true;
        await OnClose.InvokeAsync();
    }
    public async Task HandleEscapeAsync()
    {
        if (_pickerMode is not null) ClosePicker();
        else if (_confirmationSheetOpen) CloseConfirmation();
        else if (_paymentSheetOpen) await ClosePaymentSheet();
        else if (_configuringLine is not null) await CloseConfigurator();
        else if (_selectingProduct) CloseProductPicker();
        else await CloseAsync();
        await InvokeAsync(StateHasChanged);
    }
    private string ApiMessage(string? message) => string.IsNullOrWhiteSpace(message) ? message ?? "" : LKvitai.MES.Modules.Sales.WebUI.Resources.SalesApiErrors.Translate(L, "", message);
    private string DisplayDuty(string value) => IsLive ? value : value switch
    {
        "Konsultantas" => L["Workspace.DutyConsultant"].Value, "Vadybininkas" => L["Workspace.DutyManager"].Value,
        "Matuotojas" => L["Workspace.DutyMeasurer"].Value, "Montuotojas" => L["Workspace.DutyInstaller"].Value,
        "Transportas" => L["Workspace.DutyTransport"].Value, _ => value
    };
    private string DisplayPaymentMethod(string value) => IsLive ? value : value switch
    {
        "Via PPK" => L["Payment.ViaPpk"].Value, "Bank transfer" => L["Payment.BankTransfer"].Value,
        "Cash desk" => L["Payment.CashDesk"].Value, "EKA register" => L["Payment.Register"].Value, _ => value
    };
    private string DisplayControl(string value) => IsLive ? value : value switch
    {
        "Chain left" => L["Product.ChainLeft"].Value, "Chain right" => L["Product.ChainRight"].Value,
        "Motor" => L["Product.Motor"].Value, "Other" => L["Product.Other"].Value, _ => value
    };
    private string DisplayUnit(string value) => value == "pcs" ? L["Product.Pieces"].Value : value;
    private string DefaultPaymentReceiver(string? name, bool hidden) => string.IsNullOrWhiteSpace(name)
        ? L["Payment.DefaultReceiverUnavailable"].Value
        : hidden ? L["Payment.DefaultReceiverHidden", name].Value : L["Payment.DefaultReceiver", name].Value;
    private static string Display(string value) => string.IsNullOrWhiteSpace(value) ? "—" : value;
    private bool IsPrivacyRestricted => IsLive && LKvitai.MES.Modules.Sales.Contracts.Orders.LegacyOrderPrivacy.IsRestricted(_order?.Note);
