                                            <div class="demo-product-editor__parameter @ProductFieldClass("ppp-"+index) @(automatic ? "" : "is-manual")"><label class="demo-label" for="config-ppp-@index">@label <span class="mono">PPP@((index + 1).ToString("D2"))</span><span class="fx">ƒx</span></label><input id="config-ppp-@index" data-select-on-focus aria-invalid="@(ProductError("ppp-"+index) is not null ? "true" : "false")" aria-describedby="config-ppp-@index-error" type="text" inputmode="@(index == 11 ? "decimal" : "text")" maxlength="@(index == 11 ? 20 : 15)" class="demo-input mono @(automatic ? "demo-parameter-auto" : "")" title="@(automatic ? "Calculated value. Type to override." : "Manual parameter")" value="@_configuringLine.ParameterValues[index]" @onchange="e => SetParameter(parameterIndex, e.Value?.ToString() ?? string.Empty)" />@ProductFieldError("ppp-"+index)</div>
