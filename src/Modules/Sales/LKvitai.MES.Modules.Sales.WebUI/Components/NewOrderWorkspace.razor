@using System.Globalization
@using System.Text.Json
@implements IAsyncDisposable
@inject IJSRuntime JS
@inject LKvitai.MES.BuildingBlocks.WebUI.Services.IBuildVersionAccessor BuildVersion
@using LKvitai.MES.Modules.Sales.Contracts.OrderEntry
<NavigationLock ConfirmExternalNavigation="@(IsLive && (HeaderDirty || ProductDirty || AddressDirty || PaymentDirty || ConfirmationDirty || Entry.HasPendingCommand))" OnBeforeInternalNavigation="GuardNavigationAsync" />

<div class="demo-layer" role="dialog" aria-modal="true" aria-label="Order entry" @ref="_layerElement">
    @if (_loading)
    {
        <div class="panel demo-editor__banner" role="status">Loading order references…</div>
    }
    else if (_loadError is not null)
    {
        <div class="panel demo-editor__banner" role="alert">@_loadError <button class="btn btn--ghost" @onclick="ReloadLiveAsync">Retry</button><button class="btn btn--ghost" @onclick="CloseAsync">Back to orders</button></div>
    }
    else
    {
    <div class="demo-workspace-notifications">
    @if (_busy || IsLive && !_pendingRestored)
    {
        <div class="demo-editor__banner" role="status">@(_busy ? "Saving / loading…" : "Loading saved input…")</div>
    }
    @if (!_busy && Entry.HasPendingCommand)
    {
        <div class="demo-editor__banner" role="alert">Saving was interrupted. Your input is retained. Check the earlier save before editing this order. <button class="btn btn--primary" @onclick="RecoverCommandAsync">Check / retry save</button> <button class="btn btn--ghost" @onclick="OpenOtherOrders">Other orders</button></div>
    }
    @if(Entry.LegacyPendingId is not null)
    {
        <div class="demo-editor__banner" role="status">An earlier save needs checking. It does not block this order. <button class="btn btn--ghost" disabled="@_busy" @onclick="CheckLegacySaveAsync">Check earlier save</button></div>
    }
    @if(_legacySaveOutcome is { } earlier)
    {
        <div class="demo-editor__banner" role="status">The earlier saved order is available. <a href="@($"entry/{earlier.OrderId}")">Open its order</a></div>
    }
    @foreach(var pending in Entry.OtherPendingSaves)
    {
        <div class="demo-editor__banner" role="status">Another saved input awaits recovery. @if(pending.OrderId is { } orderId){<a href="@($"entry/{orderId}")">Open that order</a>}else{<button class="btn btn--ghost" @onclick="OpenOtherOrders">Open orders to recover the unfinished new order</button>}</div>
    }
    @if(Entry.PendingRestoreWarning is { } storageWarning){<div class="demo-editor__banner" role="status">@storageWarning</div>}
    @if (!string.IsNullOrEmpty(_noticeText))
    {
        <div @key="_noticeVersion" class="sales-toast sales-toast--@_noticeKind" role="@(_noticeKind == "success" ? "status" : "alert")" aria-atomic="true">
            <span class="sales-toast__icon" aria-hidden="true">@(_noticeKind == "success" ? "✓" : "!")</span>
            <div><strong>@_noticeTitle</strong><p>@_noticeText</p>
                @if(_lastInvalidField is not null && _noticeKind == "error") { <button class="sales-toast__action" type="button" @onclick="FocusProductErrorAsync">Go to field</button> }
            </div>
            <button class="sales-toast__close" type="button" aria-label="Dismiss message" @onclick="DismissNotice">×</button>
        </div>
    }
    </div>
    <fieldset disabled="@(_busy || Entry.HasPendingCommand || IsLive && !_pendingRestored)" style="display:contents">
    @if (_order is null)
    {
        <button class="demo-backdrop" type="button" aria-label="Close new order" @onclick="CloseAsync"></button>
        <aside class="demo-drawer" aria-labelledby="demo-new-title">
            <div class="demo-drawer__head">
                <div><div class="eyebrow mono">Sales · Orders</div><h2 id="demo-new-title">New order</h2></div>
                <button class="demo-icon-button" type="button" aria-label="Close" @onclick="CloseAsync">×</button>
            </div>
            <div class="demo-drawer__body">
                <p class="demo-notice">@(IsLive ? "Live order entry. Creating an order saves its header. Test writes are limited to Testavimas series." : $"UI preview · Reference snapshot {Catalog.SnapshotDate}. Nothing is written to the database.")</p>
                <label class="demo-label" for="demo-number">Order number <span class="demo-required">*</span></label>
                <input id="demo-number" class="demo-input mono" value="@_rawNumber" @oninput="OnNumberInput"
                       placeholder="VV-123 or VV-123-A" autocomplete="off" aria-describedby="demo-number-help" />
                <div id="demo-number-help" class="demo-help">Type the series and sequence. The current year group is added automatically.</div>
                @if (SeriesSuggestions.Count > 0)
                {
                    <div class="demo-suggestions" aria-label="Matching series">
                        @foreach (var suggestion in SeriesSuggestions)
                        {
                            <button type="button" @onclick="() => ChooseSeries(suggestion)">@suggestion<span class="mono">series</span></button>
                        }
                    </div>
                }
                @if (HasNumberPreview)
                {
                    <div class="demo-number-preview"><span>Will be shown as</span><strong class="mono">@PreviewNumber</strong></div>
                }
                else if (!string.IsNullOrWhiteSpace(_rawNumber) && _numberTouched)
                {
                    <div class="demo-field-error" role="alert">@NumberError</div>
                }
                @if (!string.IsNullOrWhiteSpace(_lastAutofilledSeries))
                {
                    <div class="demo-help">Series @_lastAutofilledSeries filled the available people and store defaults. You can edit them here.</div>
                }

                <div class="demo-form-grid">
                    <div>
                        <label class="demo-label" for="demo-customer">Customer <span class="demo-required">*</span></label>
                        @if (IsLive) { @ReferenceSelect("demo-customer", Catalog.Customers, _customerId, value => { _customerId=value; _customer=ReferenceName(Catalog.Customers,value); }, existingLabel: _customer) } else { <input id="demo-customer" class="demo-input" @bind="_customer" placeholder="Customer name" /> }
                    </div>
                    <div>
                        <label class="demo-label" for="demo-store">Store <span class="demo-required">*</span></label>
                        @if (IsLive) { @ReferenceSelect("demo-store", Catalog.Stores, _storeId, value => { _storeId=value; _store=ReferenceName(Catalog.Stores,value); }, existingLabel: _store) } else { <input id="demo-store" class="demo-input" @bind="_store" placeholder="Store / branch" /> }
                    </div>
                    <div>
                        <label class="demo-label" for="demo-manager">Manager</label>
                        @if (IsLive) { @ReferenceSelect("demo-manager", Catalog.Employees, _managerId, value => { _managerId=value; _manager=ReferenceName(Catalog.Employees,value); }, existingLabel: _manager) } else { <input id="demo-manager" class="demo-input" @bind="_manager" placeholder="Manager" /> }
                    </div>
                    <div>
                        <label class="demo-label" for="demo-consultant">Consultant</label>
                        @if (IsLive) { @ReferenceSelect("demo-consultant", Catalog.Employees, _consultantId, value => { _consultantId=value; _consultant=ReferenceName(Catalog.Employees,value); }, existingLabel: _consultant) } else { <input id="demo-consultant" class="demo-input" @bind="_consultant" placeholder="Consultant" /> }
                    </div>
                    <div>
                        <label class="demo-label" for="demo-date">Order date</label>
                        <input id="demo-date" type="date" class="demo-input mono" value="@_date" @onchange="e => _date = e.Value?.ToString() ?? _date" />
                    </div>
                    <div>
                        <label class="demo-label" for="demo-due">Due date</label>
                        <input id="demo-due" type="date" class="demo-input mono" value="@_due" @onchange="e => _due = e.Value?.ToString() ?? _due" />
                    </div>
                </div>
                @if (!string.IsNullOrWhiteSpace(_formError))
                {
                    <div class="demo-field-error demo-field-error--block" role="alert">@_formError</div>
                }
            </div>
            <div class="demo-drawer__foot">
                <button class="btn btn--ghost" type="button" @onclick="CloseAsync">Cancel</button>
                <button class="btn btn--primary" type="button" @onclick="CreateDraft">@(IsLive ? "Create order and open" : "Create draft and open")</button>
            </div>
        </aside>
    }
    else
    {
        <div class="demo-editor">
            @if (!_selectingProduct && _configuringLine is null)
            {
                <CustomerPrivacyNotice IsRestricted="IsPrivacyRestricted" OnBack="CloseAsync" />
            }
            <header class="demo-editor__top">
                <div>
                    <div class="eyebrow mono">Sales · Order draft</div>
                    <h1 class="mono">@_order.Number</h1>
                    <div class="demo-editor__meta">@_order.Customer · @_order.Store</div>
                </div>
                <div class="demo-editor__actions">
                    <span class="chip chip--entered">@(IsLive ? (_busy ? "Saving…" : HeaderDirty || ProductDirty || AddressDirty ? "Unsaved changes" : "Saved order") : "Local preview")</span>
                    @if(IsLive && _order.Cancelled) { <span class="chip chip--danger">Anuliuotas</span> }
                    <button class="btn btn--ghost" type="button" @onclick="CloseAsync">@(IsLive ? "Back to orders" : "Discard and return to orders")</button>
                    @if(IsLive) { <button class="btn btn--ghost" type="button" disabled="@(!_order.WritesAllowed || _order.Cancelled || _order.StateId is not (4 or 7) || _order.CancellationUnavailableReason is not null)" title="@_order.CancellationUnavailableReason" @onclick="CancelLiveOrderAsync">Cancel order</button> }
                </div>
            </header>
            <div class="demo-editor__banner" role="status">@(IsLive ? (_order.WritesAllowed ? "Done saves product changes; Save order saves header changes. Unsaved inputs stay on this screen until saved." : "Read-only order: writes are currently enabled only for Testavimas.") : "This is a local design draft. Closing this screen discards it.")</div>
            <div class="demo-stage-strip" aria-label="Order stage"><span class="is-current">@(IsLive ? _order.StateName : "Įvestas")</span><span>Patvirtintas</span><span>Gaminamas</span><span>Pagamintas</span><span>Filialui</span><span>Atiduotas</span></div>
            <div class="demo-editor__grid">
                <div class="demo-editor__main">
                    <section class="panel demo-panel demo-reference-panel">
                        <div class="panel__head"><h2>People and dates</h2><span>Editable draft fields</span></div>
                        <div class="demo-panel__body demo-summary-grid">
                            <div><label class="demo-label" for="edit-customer">Customer</label>@if (IsLive) { @ReferenceSelect("edit-customer", Catalog.Customers, _order.CustomerId, value => { _order.CustomerId=value; _order.Customer=ReferenceName(Catalog.Customers,value); }, !_order.CanEdit || !_order.WritesAllowed, _order.Customer) } else { <input id="edit-customer" class="demo-input" @bind="_order.Customer" /> }</div>
                            <div><label class="demo-label" for="edit-manager">Manager</label>@if (IsLive) { @ReferenceSelect("edit-manager", Catalog.Employees, _order.ManagerId, value => { _order.ManagerId=value; _order.Manager=ReferenceName(Catalog.Employees,value); }, !_order.CanEdit || !_order.WritesAllowed, _order.Manager) } else { <input id="edit-manager" class="demo-input" @bind="_order.Manager" /> }</div>
                            <div><label class="demo-label" for="edit-store">Store</label>@if (IsLive) { @ReferenceSelect("edit-store", Catalog.Stores, _order.StoreId, value => { _order.StoreId=value; _order.Store=ReferenceName(Catalog.Stores,value); }, !_order.WritesAllowed, _order.Store) } else { <input id="edit-store" class="demo-input" @bind="_order.Store" /> }</div>
                            <div><label class="demo-label" for="edit-consultant">Consultant</label>@if (IsLive) { @ReferenceSelect("edit-consultant", Catalog.Employees, _order.ConsultantId, value => { _order.ConsultantId=value; _order.Consultant=ReferenceName(Catalog.Employees,value); }, !_order.CanEdit || !_order.WritesAllowed, _order.Consultant) } else { <input id="edit-consultant" class="demo-input" @bind="_order.Consultant" /> }</div>
                            <div><label class="demo-label" for="edit-date">Order date</label><input id="edit-date" type="date" readonly="@(IsLive && (!_order.CanEdit || !_order.WritesAllowed))" class="demo-input mono" value="@_editorDate" @onchange="UpdateOrderDate" /></div>
                            <div><label class="demo-label" for="edit-due">Due date</label><input id="edit-due" type="date" readonly="@(IsLive && !_order.WritesAllowed)" class="demo-input mono" value="@_editorDue" @onchange="UpdateDueDate" /></div>
                            <div><label class="demo-label" for="edit-mounting-date">Mounting date</label><input id="edit-mounting-date" type="date" readonly="@(IsLive && !_order.WritesAllowed)" class="demo-input mono" value="@_editorMountingDate" @onchange="UpdateMountingDate" /></div>
                            <div><label class="demo-label" for="edit-priority">Priority</label>@if (IsLive) { @ReferenceSelect("edit-priority", _priorities, _order.PriorityId, value => _order.PriorityId=value ?? 2, !_order.CanEdit || !_order.WritesAllowed) } else { <select id="edit-priority" class="demo-input" @bind="_order.Priority"><option>Normal</option><option>High</option><option>Urgent</option></select> }</div>
                        </div>
                    </section>

                    <section class="panel demo-panel">
                        <div class="panel__head"><h2>Address</h2><span>@(IsLive ? "Contact and delivery details" : "Draft contact and delivery details")</span></div>
                        <div class="demo-panel__body">
                            <div class="demo-form-grid demo-form-grid--address">
                                @if (IsLive)
                                {
                                    <div><label class="demo-label" for="address-search">Find street / address</label><input id="address-search" class="demo-input" @bind="_addressSearch" placeholder="City or street" /><button class="btn btn--ghost" type="button" @onclick="FindAddressesAsync">Search</button></div>
                                    <div><label class="demo-label" for="address-street-live">Street reference</label><select id="address-street-live" class="demo-input" value="@_order.StreetId" @onchange="SelectAddress"><option value="">Choose…</option>@foreach(var address in _addressOptions) { <option value="@address.Id">@(address.Path ?? address.Name)</option> }</select></div>
                                }
                                else
                                {
                                <div><label class="demo-label" for="address-region">Region · Apskritis</label><input id="address-region" class="demo-input" @bind="_order.Region" /></div>
                                <div><label class="demo-label" for="address-city">City · Miestas</label><input id="address-city" class="demo-input" @bind="_order.City" /></div>
                                <div><label class="demo-label" for="address-street">Street · Gatvė</label><input id="address-street" class="demo-input" @bind="_order.Street" /></div>
                                }
                                <div><label class="demo-label" for="address-building">Building No.</label><input id="address-building" class="demo-input mono" @bind="_order.Building" /></div>
                                <div><label class="demo-label" for="address-flat">Flat No.</label><input id="address-flat" class="demo-input mono" @bind="_order.Flat" /></div>
                                <div><label class="demo-label" for="address-phone">Phone</label><input id="address-phone" type="tel" class="demo-input mono" @bind="_order.Phone" /></div>
                            </div>
                            <label class="demo-label demo-label--spaced" for="address-note">Address notes</label><textarea id="address-note" class="demo-textarea" @bind="_order.AddressNote"></textarea>
                            @if(IsLive) { <button type="button" class="btn btn--ghost" disabled="@(!_order.WritesAllowed)" @onclick="SaveLiveAddressAsync">Save address</button><span class="demo-help">@_addressError</span> }
                        </div>
                    </section>

                    <section class="panel demo-panel">
                        <div class="panel__head">
                            <div><h2>Products, services and priedai</h2><span>@_order.Lines.Count lines in this draft</span></div>
                            <div class="demo-panel__actions">
                                <button class="btn btn--ghost" type="button" disabled="@(IsLive && (!_order.WritesAllowed || _order.Cancelled))" @onclick="() => OpenAccessoryPicker(null)">+ Priedai</button>
                                <button class="btn btn--primary" type="button" disabled="@(IsLive && (!_order.WritesAllowed || _order.Cancelled))" @onclick="OpenProductPicker">+ Add product / service</button>
                            </div>
                        </div>
                        @if (_order.Lines.Count == 0)
                        {
                            <div class="demo-empty">No lines yet. Add a product, a service, or priedai to explore the order flow.</div>
                        }
                        else
                        {
                            <div class="table-wrap">
                                <table class="lk-table demo-lines">
                                    <thead><tr><th>Item</th><th>Details</th><th class="is-num">Qty</th><th class="is-num">Price</th><th class="is-num">Amount</th><th></th></tr></thead>
                                    <tbody>
                                        @foreach (var line in _order.Lines)
                                        {
                                            <tr>
                                                <td><div class="demo-line-name"><div class="demo-line-sketch"><CategoryIcon Category="@line.Category" /></div><div>
                                                    <button class="demo-line-open" type="button" @onclick="() => OpenConfigurator(line)">@line.Name ↗</button>
                                                    <small>@line.Category</small></div></div></td>
                                                <td class="mono">@(line.WidthMm > 0 ? $"{line.WidthMm} × {line.HeightMm} mm" : line.Unit)</td>
                                                <td class="is-num"><input class="demo-table-input mono" readonly="@IsLive" type="number" min="0.001" step="0.001" aria-label="Quantity for @line.Name" @bind="line.Quantity" /></td>
                                                <td class="is-num"><input class="demo-table-input mono" readonly="@IsLive" type="number" min="0" step="0.01" aria-label="Price for @line.Name" @bind="line.Price" /></td>
                                                <td class="is-num">@OrderFormat.Money(IsLive ? line.ServerAmount ?? line.Quantity * line.Price : line.Quantity * line.Price)</td>
                                                <td class="demo-line-actions">
                                                    <label class="demo-discount-flag" title="Include in preview discount"><input type="checkbox" disabled="@IsLive" @bind="line.Discountable" /> Disc.</label>
                                                    @if (line.Kind == "Product")
                                                    {
                                                        <button type="button" title="Add accessory to this product" disabled="@(IsLive && (!line.CanEdit || !_order.WritesAllowed))" @onclick="() => OpenAccessoryPicker(line)">+ ACC</button>
                                                    }
                                                    <button type="button" title="Remove line" disabled="@(IsLive && (!line.CanDelete || !_order.WritesAllowed))" @onclick="() => RemoveLine(line)">×</button>
                                                </td>
                                            </tr>
                                            @foreach (var accessory in line.Accessories)
                                            {
                                                <tr class="demo-attached-row">
                                                    <td>@if (IsLive) { <button type="button" class="demo-line-open" @onclick="() => EditAccessoryAsync(line, accessory)">↳ @accessory.Name</button> } else { <span>↳ @accessory.Name</span> }</td><td>@accessory.Unit</td>
                                                    <td class="is-num"><input class="demo-table-input mono" readonly="@IsLive" type="number" min="0.001" step="0.001" aria-label="Quantity for @accessory.Name" @bind="accessory.Quantity" /></td>
                                                    <td class="is-num"><input class="demo-table-input mono" readonly="@IsLive" type="number" min="0" step="0.01" aria-label="Price for @accessory.Name" @bind="accessory.Price" /></td>
                                                    <td class="is-num">@OrderFormat.Money(accessory.Quantity * accessory.Price)</td>
                                                    <td class="demo-line-actions"><button type="button" title="Remove accessory" disabled="@(IsLive && (!line.CanEdit || !_order.WritesAllowed))" @onclick="() => RemoveAccessory(line, accessory)">×</button></td>
                                                </tr>
                                            }
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                    </section>

                    <section class="panel demo-panel">
                        <div class="panel__head"><h2>Responsible employees</h2><span>@(IsLive ? "Saved assignments" : "Local draft assignments")</span></div>
                        <div class="demo-panel__body">
                            @foreach (var employee in _order.Employees)
                            {
                                <div class="demo-employee-row"><span><strong>@employee.Duty</strong> — @employee.Name <small class="mono">@OrderFormat.Date(employee.Date)</small></span><button class="demo-small-remove" type="button" disabled="@(IsLive && !_order.WritesAllowed)" title="Remove employee assignment" @onclick="() => RemoveEmployeeAsync(employee)">×</button></div>
                            }
                            <div class="demo-employee-add">
                                <div><label class="demo-label" for="employee-duty">Duty</label>@if (IsLive) { @ReferenceSelect("employee-duty",_duties,_employeeDutyId,value=>_employeeDutyId=value) } else { <select id="employee-duty" class="demo-input" @bind="_employeeDuty"><option>Konsultantas</option><option>Vadybininkas</option><option>Matuotojas</option><option>Montuotojas</option><option>Transportas</option></select> }</div>
                                <div><label class="demo-label" for="employee-name">Employee</label>@if (IsLive) { @ReferenceSelect("employee-name",Catalog.Employees,_employeeId,value=>_employeeId=value) } else { <input id="employee-name" class="demo-input" @bind="_employeeName" /> }</div>
                                <div><label class="demo-label" for="employee-date">Date</label><input id="employee-date" type="date" class="demo-input mono" value="@_employeeDate" @onchange="e => _employeeDate = e.Value?.ToString() ?? _employeeDate" /></div>
                                <button class="btn btn--ghost" type="button" disabled="@(IsLive && !_order.WritesAllowed)" @onclick="AddEmployee">+ Add</button>
                            </div>
                            @if (!string.IsNullOrWhiteSpace(_employeeError)) { <div class="demo-field-error">@_employeeError</div> }
                        </div>
                    </section>

                    @if (!IsPrivacyRestricted)
                    {
                    <section class="panel demo-panel">
                        <div class="panel__head"><h2>Note</h2><span>@(IsLive ? "Saved with order" : "Draft only")</span></div>
                        <div class="demo-panel__body"><textarea class="demo-textarea" maxlength="128" readonly="@(IsLive && (!_order.CanEdit || !_order.WritesAllowed))" @bind="_order.Note" placeholder="Order note"></textarea><div class="demo-help">Maximum 128 characters.</div></div>
                    </section>
                    }
                    <OrderNoteHistory Entries="_order.NoteHistory" />
                </div>
                <aside class="panel demo-receipt">
                    <div class="panel__head"><h2>Receipt</h2><span>@(IsLive ? "Legacy amount" : "Preview amount")</span></div>
                    <div class="demo-receipt__row"><span>Before discount</span><strong class="mono">@OrderFormat.Money(_order.BeforeDiscount)</strong></div>
                    <div class="demo-receipt__row"><span>Discountable</span><strong class="mono">@OrderFormat.Money(_order.DiscountableAmount)</strong></div>
                    <div class="demo-receipt__discount">
                        <label class="demo-label" for="receipt-discount">Discount % · negative = markup</label><input id="receipt-discount" readonly="@(IsLive && (!_order.CanEdit || !_order.WritesAllowed))" type="number" min="-100" max="100" step="0.01" class="demo-input mono" @bind="_order.DiscountPercent" @bind:after="NormalizeDiscount" />
                        <label class="demo-label demo-label--spaced" for="receipt-fixed-price">Fixed final price · €</label><input id="receipt-fixed-price" readonly="@(IsLive && (!_order.CanEdit || !_order.WritesAllowed))" title="Set and save the final order price" type="number" min="0" step="0.01" class="demo-input mono" value="@(_finalPriceInput ?? _order.Total.ToString("0.00", CultureInfo.InvariantCulture))" @onchange="SetFixedPrice" />
                        @if (!string.IsNullOrWhiteSpace(_discountError)) { <div class="demo-field-error">@_discountError</div> }
                    </div>
                    <div class="demo-receipt__row"><span>@(_order.DiscountPercent < 0 ? "Markup" : "Discount")</span><strong class="mono">@OrderFormat.Money(Math.Abs(_order.DiscountAmount))</strong></div>
                    <div class="demo-receipt__row demo-receipt__row--total"><span>Total</span><strong class="mono">@OrderFormat.Money(_order.Total)</strong></div>
                    <div class="demo-receipt__row"><span>Paid</span><strong class="mono">@OrderFormat.Money(_order.Paid)</strong></div>
                    <div class="demo-receipt__row"><span>Debt</span><strong class="mono">@OrderFormat.Money(_order.Debt)</strong></div>
                    <p>@(IsLive ? "Totals update after saving." : "Local preview values only.")</p>
                    <button class="btn btn--primary" type="button" disabled="@(IsLive && !_order.WritesAllowed)" @onclick="SavePreview">@(IsLive ? "Save order" : "Save draft preview")</button>
                    @if (!string.IsNullOrWhiteSpace(_saveMessage)) { <div class="demo-save-message @(_saveIsError ? "demo-save-message--error" : "")" role="status">@_saveMessage</div> }
                    <button class="btn btn--ghost" type="button" disabled="@(!CanConfirmLiveProducts)" title="@(!CanConfirmLiveProducts ? "Production confirmation is unavailable for this order." : null)" @onclick="OpenConfirmationAsync">Confirm for production</button>
                    <div class="demo-receipt__payments">
                        <div><strong>Payments</strong><button class="btn btn--ghost" type="button" disabled="@(IsLive && !CanPostLivePayment)" title="@(IsLive && !CanPostLivePayment ? "Payments are unavailable for this order." : null)" @onclick="OpenPaymentSheet">+ New payment</button></div>
                        @if (_order.Payments.Count == 0)
                        {
                            <p>@(IsLive ? "No payments recorded for this order." : "No payments in this local draft.")</p>
                        }
                        @foreach (var payment in _order.Payments)
                        {
