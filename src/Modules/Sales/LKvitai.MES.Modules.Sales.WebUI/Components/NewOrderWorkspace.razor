                            </div>
                        </section>
                        @if (_configuringLine.Kind == "Product")
                        {
                            <section class="panel demo-product-editor__parameters">
                                <div class="panel__head"><h2>@L["Product.AdditionalParameters"]</h2><span>@L["Product.ParameterSummary", _configuringLine.Category, ConfiguredParameterCount]</span></div>
