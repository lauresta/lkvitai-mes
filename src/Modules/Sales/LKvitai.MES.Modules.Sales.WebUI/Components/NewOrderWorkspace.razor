                            @if(_paymentBankPage is { } bankPage)
                            {
                                <div class="demo-help"><button class="btn btn--ghost" type="button" disabled="@(_paymentBankLoading || bankPage.Page<=1)" @onclick="() => LoadPaymentBanksAsync(bankPage.Page-1)">Previous</button> @bankPage.TotalCount transfers · page @bankPage.Page <button class="btn btn--ghost" type="button" disabled="@(_paymentBankLoading || bankPage.Page*bankPage.PageSize>=bankPage.TotalCount)" @onclick="() => LoadPaymentBanksAsync(bankPage.Page+1)">Next</button></div>
                            }
                            @if(SelectedPaymentBank is { } bank)
                            {
                                <div class="demo-number-preview"><span><strong>@(bank.Payer ?? "Payer not specified")</strong><br /><small>@bank.Purpose</small><br /><small class="mono">@(bank.Date?.ToString("yyyy-MM-dd") ?? "—")</small></span><strong class="mono">@BankAmount(bank.AvailableAmount)<small> unassigned</small></strong></div>
                                @if(!bank.IsAvailable){<p class="demo-field-error">@bank.UnavailableReason</p>}
                            }
                            <p class="demo-help">Currency is not stored on this bank record; no conversion is applied. Payment currency: @_paymentReferences?.Currency?.Code.</p>
                        }
                        @if(SelectedPaymentMethod?.RequiresRegister==true)
                        {
                            <label class="demo-label demo-label--spaced" for="payment-register">EKA register</label>
                            <select id="payment-register" class="demo-input" value="@_paymentRegisterId" @onchange="ChangePaymentRegister"><option value="">Choose…</option>@foreach(var register in _paymentReferences?.Registers ?? []) { <option value="@register.Id">@register.Name</option> }</select>
                            @if(_paymentReferences?.SelectedRegister is { } selectedRegister)
                            {
                                <p class="demo-help">Default receiver: @(selectedRegister.DefaultEmployeeName ?? "not available — choose an employee")@(selectedRegister.DefaultEmployeeIsHidden ? " (hidden default)" : ""). The receiver can be changed.</p>
                            }
                        }
                        @if(_paymentLookupBusy){<p class="demo-help" role="status">Loading payment references…</p>}
                        else if(!string.IsNullOrWhiteSpace(PaymentPrerequisiteMessage)){<p class="demo-help" role="status">@PaymentPrerequisiteMessage</p>}
                        <fieldset disabled="@(!PaymentDownstreamEnabled)" style="display:contents">
                            <label class="demo-label demo-label--spaced" for="payment-employee">Receiver</label>
                            <select id="payment-employee" class="demo-input" value="@_paymentEmployeeId" @onchange="ChangePaymentEmployee" @ref="_paymentReceiverElement"><option value="">Choose…</option>@foreach(var employee in _paymentReferences?.Employees ?? []) { <option value="@employee.Id">@employee.Name@(employee.IsHidden ? " (hidden)" : "")</option> }</select>
                            <label class="demo-label demo-label--spaced" for="payment-amount">Amount · @_paymentReferences?.Currency?.Code</label><input id="payment-amount" type="number" min="0.01" max="@_paymentReferences?.MaximumAmount?.ToString(CultureInfo.InvariantCulture)" step="0.01" class="demo-input mono" value="@_paymentAmountText" @oninput="ChangePaymentAmount" />
                            <label class="demo-label demo-label--spaced" for="payment-note">Notes</label><textarea id="payment-note" class="demo-textarea" maxlength="500" @bind="_paymentNote" @bind:event="oninput"></textarea>
                        </fieldset>
                    }
                    else
                    {
                    <p class="demo-notice">UI preview · This payment stays only in the local draft.</p>
                    <label class="demo-label" for="payment-method">Payment method</label>
                    <select id="payment-method" class="demo-input" @bind="_paymentMethod"><option>Via PPK</option><option>Bank transfer</option><option>Cash desk</option><option>EKA register</option></select>
                    <div class="demo-form-grid">
                        <div><label class="demo-label" for="payment-date">Date</label><input id="payment-date" type="date" class="demo-input mono" value="@_paymentDate" @onchange="e => _paymentDate = e.Value?.ToString() ?? _paymentDate" /></div>
                        <div><label class="demo-label" for="payment-amount">Amount · €</label><input id="payment-amount" type="number" min="0.01" step="0.01" class="demo-input mono" @bind="_paymentAmount" /></div>
                    </div>
                    @if (_paymentMethod is "Via PPK" or "Bank transfer")
                    {
                        <label class="demo-label demo-label--spaced" for="payment-reference">@(_paymentMethod == "Via PPK" ? "PPK receipt series and number" : "Bank transfer reference")</label><input id="payment-reference" class="demo-input mono" @bind="_paymentReference" />
                    }
                    else
                    {
                        <label class="demo-label demo-label--spaced" for="payment-party">@(_paymentMethod == "Cash desk" ? "Cash receiver" : "EKA register")</label><input id="payment-party" class="demo-input" @bind="_paymentParty" />
                    }
                    }
                    @if(!IsLive){<label class="demo-label demo-label--spaced" for="payment-note">Notes</label><textarea id="payment-note" class="demo-textarea" maxlength="500" @bind="_paymentNote" @bind:event="oninput"></textarea>}
                    <div class="demo-number-preview"><span>Debt after payment</span><strong class="mono">@(IsLive ? PaymentDownstreamEnabled && _paymentAmount>0 ? PaymentMoney(_order.Debt - _paymentAmount) : "—" : OrderFormat.Money(_order.Debt - _paymentAmount))</strong></div>
                    @if (!string.IsNullOrWhiteSpace(_paymentError)) { <div class="demo-field-error demo-field-error--block" role="alert">@_paymentError</div> }
                </div>
                <div class="demo-drawer__foot"><button class="btn btn--ghost" type="button" @onclick="ClosePaymentSheet">Cancel</button><button class="btn btn--primary" type="button" disabled="@(IsLive && !PaymentCanSubmit)" @onclick="AddPayment">@(IsLive ? "Post payment" : "Add to draft")</button></div>
            </aside>
        }

        @if (_pickerMode is not null)
        {
            <button class="demo-picker-backdrop" type="button" aria-label="Close picker" @onclick="ClosePicker"></button>
            <aside class="demo-drawer demo-drawer--picker" aria-labelledby="demo-picker-title">
                <div class="demo-drawer__head">
                    <div><div class="eyebrow mono">@_order.Number · Draft line</div><h2 id="demo-picker-title">@(_attachedTo is null ? "Add priedai" : $"Accessory for {_attachedTo.Name}")</h2></div>
                    <button class="demo-icon-button" type="button" aria-label="Close picker" @onclick="ClosePicker">×</button>
                </div>
                <div class="demo-drawer__body">
                    <fieldset disabled="@(IsLive && (_attachedTo?.CanEdit != true || !_order.WritesAllowed))" style="display:contents">
                        <p class="demo-help">@(_attachedTo is null ? "Select a standalone priedai line for this order." : "These accessory options match the selected product category in the legacy reference snapshot.")</p>
                        <label class="demo-label" for="demo-accessory-search">Search priedai</label>
                        <input id="demo-accessory-search" class="demo-input" @bind="_accessorySearch" @bind:event="oninput" placeholder="Name or code" />
                        <div class="demo-type-list demo-type-list--accessories">
                            @foreach (var accessory in FilteredAccessories)
                            {
                                <button type="button" class="@(_selectedAccessoryId == accessory.Id ? "is-selected" : "")" @onclick="() => SelectAccessory(accessory.Id)">
                                    <span>@accessory.Name</span><small class="mono">@accessory.Unit · @OrderFormat.Money(accessory.Price)</small>
                                </button>
                            }
                        </div>
                        @if (SelectedAccessory is not null)
                        {
                            @if (_attachedTo is not null)
                            {
                                <p class="demo-help">The suggested quantity uses the legacy unit rule and this product's dimensions. You can change it for this draft.</p>
                            }
                            <div class="demo-form-grid demo-form-grid--picker">
                                <div><label class="demo-label" for="demo-acc-qty">Quantity · @SelectedAccessory.Unit</label><input id="demo-acc-qty" type="number" min="0.001" step="0.001" class="demo-input mono" @bind="_quantity" /></div>
                                <div><label class="demo-label" for="demo-acc-price">@(IsLive ? "Unit price · €" : "Preview unit price · €")</label><input id="demo-acc-price" type="number" min="0" step="0.0001" class="demo-input mono" @bind="_price" @bind:after="MarkAccessoryPrice" /></div>
                            </div>
                        }
                    @if (!string.IsNullOrWhiteSpace(_pickerError))
                    {
                        <div class="demo-field-error demo-field-error--block" role="alert">@_pickerError</div>
                    }
                    </fieldset>
                </div>
                <div class="demo-drawer__foot">
                    <button class="btn btn--ghost" type="button" @onclick="ClosePicker">Cancel</button>
                    <button class="btn btn--primary" type="button" disabled="@(IsLive && (_attachedTo?.CanEdit != true || !_order.WritesAllowed))" @onclick="AddLine">@(IsLive ? "Save accessory" : "Add to draft")</button>
                </div>
            </aside>
        }
    }
    </fieldset>
    }
</div>

@code {
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public long? LegacyOrderId { get; set; }

    private ElementReference _layerElement;
    private IJSObjectReference? _draftModule;
    private DotNetObjectReference<NewOrderWorkspace>? _draftReference;
    private bool _historyActive;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_loading || _loadError is not null) return;
        if (_draftReference is null)
        {
            _draftReference = DotNetObjectReference.Create(this);
            if (IsLive)
            {
                try { await Entry.RestorePendingAsync(); }
                catch(SalesOrderEntryFailure ex){_liveError=ex.Message;}
                _pendingRestored=true;
                await InvokeAsync(StateHasChanged);
            }
            var moduleVersion = BuildVersion.Get();
            _draftModule = await JS.InvokeAsync<IJSObjectReference>("import", "./js/sales-draft.js?v=" + Uri.EscapeDataString(moduleVersion.GitSha ?? moduleVersion.Version ?? "m2-history-2"));
            await _draftModule.InvokeVoidAsync("register", _draftReference, _layerElement);
        }
        if (_draftModule is null) return;
        await _draftModule.InvokeVoidAsync("updateNoticePosition");
        if (_focusInvalidField is { } invalidField)
        {
            _focusInvalidField=null;
            await _draftModule.InvokeVoidAsync("focusInvalidField", invalidField);
        }
        var productVisible = _selectingProduct || _configuringLine is not null;
        if (productVisible && !_historyActive)
        {
            await _draftModule.InvokeVoidAsync("openProduct");
            _historyActive = true;
        }
        else if (!productVisible && _historyActive)
        {
            _historyActive = false;
            await _draftModule.InvokeVoidAsync("closeProduct");
        }
        if(_paymentFocusReceiver && _paymentSheetOpen && PaymentDownstreamEnabled)
        {
            _paymentFocusReceiver=false;
            await _paymentReceiverElement.FocusAsync();
        }
    }

    [JSInvokable]
    public async Task HandleProductHistoryExit()
    {
        if (IsLive && !await LeaveProductAsync()) return;
        _selectingProduct = false;
        _configuringLine = null;
        _historyActive = false;
        await InvokeAsync(StateHasChanged);
    }

    [JSInvokable]
    public async Task SelectProductTypeByShortcut(int number)
    {
        if (!_selectingProduct || number is < 1 or > 9) return;
        var type = FilteredTypes.ElementAtOrDefault(number - 1);
        if (type is not null) await CreateProductFromType(type);
        await InvokeAsync(StateHasChanged);
    }

    public async ValueTask DisposeAsync()
    {
        if (_draftModule is not null)
        {
            try
            {
                await _draftModule.InvokeVoidAsync("unregister");
                await _draftModule.DisposeAsync();
            }
            catch (JSDisconnectedException) { }
        }
        _draftReference?.Dispose();
    }

    private DemoCatalog Catalog = new();
    private static readonly TimeZoneInfo Vilnius = TimeZoneInfo.FindSystemTimeZoneById("Europe/Vilnius");
    private static DateOnly Today => DateOnly.FromDateTime(TimeZoneInfo.ConvertTimeFromUtc(DateTime.UtcNow, Vilnius));
    private string _rawNumber = "";
    private string _customer = "";
    private string _manager = "";
    private string _store = "";
    private string _consultant = "";
    private string _date = Today.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture);
    private string _due = Today.AddDays(14).ToString("yyyy-MM-dd", CultureInfo.InvariantCulture);
    private string _editorDate = "";
    private string _editorDue = "";
    private string _editorMountingDate = "";
    private string _employeeDuty = "Konsultantas";
    private string _employeeName = "";
    private string _employeeDate = Today.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture);
    private string _employeeError = "";
    private string _discountError = "";
    private string _saveMessage = "";
    private bool _saveIsError;
    private string _formError = "";
    private bool _numberTouched;
    private bool _showSeriesSuggestions;
    private string _lastAutofilledSeries = "";
    private DemoOrderDraft? _order;
    private DateTimeOffset _draftCreatedAt;
    private DemoOrderLine? _configuringLine;
    private bool _selectingProduct;
    private bool _paymentSheetOpen;
    private string _paymentMethod = "Bank transfer";
    private string _paymentDate = Today.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture);
    private decimal _paymentAmount;
    private string _paymentReference = "";
    private string _paymentParty = "";
    private string _paymentNote = "";
    private string _paymentError = "";
    private string? _pickerMode;
    private DemoOrderLine? _attachedTo;
    private string _catalogSearch = "";
    private string _accessorySearch = "";
    private int _selectedCategoryId;
    private int _selectedAccessoryId;
    private decimal _quantity = 1;
    private decimal _price;
    private string _pickerError = "";

    private bool HasNumberPreview => DemoOrderNumber.TryNormalize(_rawNumber, Today.Year, Catalog, out _, out _, out _);
    private string PreviewNumber => DemoOrderNumber.TryNormalize(_rawNumber, Today.Year, Catalog, out var number, out _, out _) ? number : "";
    private string NumberError => DemoOrderNumber.TryNormalize(_rawNumber, Today.Year, Catalog, out _, out _, out var error) ? "" : error;
    private IReadOnlyList<string> SeriesSuggestions
    {
        get
        {
            if (!_showSeriesSuggestions || string.IsNullOrWhiteSpace(_rawNumber)) return [];
            var prefix = _rawNumber.Split('-')[0].Trim();
            if (prefix.Length is < 1 or > 8 || _rawNumber.Contains('-')) return [];
            return Catalog.Series.Where(x => x.Code.StartsWith(prefix, StringComparison.OrdinalIgnoreCase))
                .Take(6).Select(x => x.Code).ToList();
        }
    }

    private void OnNumberInput(ChangeEventArgs e)
    {
        _rawNumber = e.Value?.ToString() ?? "";
        _numberTouched = true;
        _showSeriesSuggestions = true;
        _formError = "";
        var match=Catalog.Series.OrderByDescending(x=>x.Code.Length).FirstOrDefault(x=>_rawNumber.StartsWith(x.Code+"-",StringComparison.OrdinalIgnoreCase));
        if(match is not null) ApplySeriesDefaults(match.Code);
    }

    private void ChooseSeries(string code)
    {
        _rawNumber = code + "-";
        _showSeriesSuggestions = false;
        _numberTouched = false;
        ApplySeriesDefaults(code);
    }

    private void ApplySeriesDefaults(string code)
    {
        if (string.Equals(code, _lastAutofilledSeries, StringComparison.OrdinalIgnoreCase)) return;
        var item = Catalog.Series.FirstOrDefault(x => string.Equals(x.Code, code, StringComparison.OrdinalIgnoreCase));
        if (item is null) return;
        _customer = item.Customer;
        _manager = item.Manager;
        _store = item.Store;
        _consultant = item.Consultant;
        _lastAutofilledSeries = item.Code;
        _customerId=item.CustomerId; _storeId=item.StoreId; _managerId=item.ManagerId; _consultantId=item.ConsultantId;
    }

    private async Task CreateDraft()
    {
        if (IsLive) { await CreateLiveOrderAsync(); return; }
        _numberTouched = true;
        if (!DemoOrderNumber.TryNormalize(_rawNumber, Today.Year, Catalog, out var number, out var series, out var error))
        {
            _formError = error;
            return;
        }
        if (string.IsNullOrWhiteSpace(_customer) || string.IsNullOrWhiteSpace(_store))
        {
            _formError = "Customer and store are required for this preview.";
            return;
        }
        if (!DateOnly.TryParseExact(_date, "yyyy-MM-dd", CultureInfo.InvariantCulture, DateTimeStyles.None, out var date)
            || !DateOnly.TryParseExact(_due, "yyyy-MM-dd", CultureInfo.InvariantCulture, DateTimeStyles.None, out var due)
            || due < date)
        {
            _formError = "Enter valid dates. The due date cannot be before the order date.";
            return;
        }
        _order = new DemoOrderDraft
        {
            Number = number, Series = series, Customer = _customer.Trim(), Store = _store.Trim(),
            Manager = _manager.Trim(), Consultant = _consultant.Trim(), Date = date, Due = due
        };
        _draftCreatedAt = DateTimeOffset.UtcNow;
        _editorDate = _date;
        _editorDue = _due;
        _formError = "";
    }

    private void UpdateOrderDate(ChangeEventArgs e)
    {
        if (_order is null) return;
        var value = e.Value?.ToString() ?? "";
        if (DateOnly.TryParseExact(value, "yyyy-MM-dd", CultureInfo.InvariantCulture, DateTimeStyles.None, out var date))
        {
            _order.Date = date;
            _editorDate = value;
        }
    }

    private void UpdateDueDate(ChangeEventArgs e)
    {
        if (_order is null) return;
        var value = e.Value?.ToString() ?? "";
        if (DateOnly.TryParseExact(value, "yyyy-MM-dd", CultureInfo.InvariantCulture, DateTimeStyles.None, out var date))
        {
            _order.Due = date;
            _editorDue = value;
        }
    }

    private void UpdateMountingDate(ChangeEventArgs e)
    {
        if (_order is null) return;
        var value = e.Value?.ToString() ?? "";
        if (string.IsNullOrWhiteSpace(value))
        {
            _order.MountingDate = null;
            _editorMountingDate = "";
        }
        else if (DateOnly.TryParseExact(value, "yyyy-MM-dd", CultureInfo.InvariantCulture, DateTimeStyles.None, out var date))
        {
            _order.MountingDate = date;
            _editorMountingDate = value;
        }
    }

    private async Task AddEmployee()
    {
        if (IsLive) { await SaveLiveDutyAsync(); return; }
        if (_order is null) return;
        if (string.IsNullOrWhiteSpace(_employeeName)
            || !DateOnly.TryParseExact(_employeeDate, "yyyy-MM-dd", CultureInfo.InvariantCulture, DateTimeStyles.None, out var date))
        {
            _employeeError = "Enter an employee and valid date.";
            return;
        }
        _order.Employees.Add(new DemoResponsibleEmployee { Duty = _employeeDuty, Name = _employeeName.Trim(), Date = date });
        _employeeName = "";
        _employeeError = "";
    }

    private void NormalizeDiscount()
    {
        if (_order is null) return;
        _order.DiscountPercent = Math.Clamp(_order.DiscountPercent, -100m, 100m);
        _discountError = "";
    }

    private async Task SetFixedPrice(ChangeEventArgs e)
    {
        if(IsLive){await SetLiveFinalPriceAsync(e);return;}
        if (_order is null) return;
        if (!decimal.TryParse(e.Value?.ToString(), NumberStyles.Number, CultureInfo.InvariantCulture, out var requested)
            || requested < 0 || _order.DiscountableAmount <= 0)
        {
            _discountError = "Enter a nonnegative final price and mark at least one line discountable.";
            return;
        }
        var percent = (_order.BeforeDiscount - requested) * 100m / _order.DiscountableAmount;
        if (percent is < -100m or > 100m)
        {
            _discountError = "This fixed price would require a discount or markup above 100%.";
            return;
        }
        _order.DiscountPercent = Math.Round(percent, 2, MidpointRounding.AwayFromZero);
        _discountError = "";
    }

    private async Task SavePreview()
    {
        if (IsLive) { await SaveLiveOrderAsync(); return; }
        if (_order is null) return;
        _saveIsError = true;
        if (string.IsNullOrWhiteSpace(_order.Customer) || string.IsNullOrWhiteSpace(_order.Store))
            _saveMessage = "Customer and store are required.";
        else if (_order.Due < _order.Date)
            _saveMessage = "Due date cannot be before the order date.";
        else if (_order.Lines.Count == 0)
            _saveMessage = "Add at least one product, service, or priedai line.";
        else if (_order.Lines.Any(x => x.Quantity <= 0 || x.Price < 0 || x.Kind == "Product" && (x.WidthMm < 200 || x.HeightMm < 200)
                    || x.Accessories.Any(a => a.Quantity <= 0 || a.Price < 0)))
            _saveMessage = "Check line quantities, prices, and product dimensions.";
        else if (_order.Lines.Any(x => !string.IsNullOrWhiteSpace(x.ColourCode) && x.ColourId is null))
            _saveMessage = "Choose a colour or fabric code from the static catalog.";
        else
        {
            _saveIsError = false;
            _saveMessage = "Preview checked. This draft is only in the open screen and disappears when you close or refresh it.";
        }
    }

    private int PickerCategoryCount => Catalog.Categories.Count(x => !IsLive || x.Active);
    private IReadOnlyList<DemoCategory> FilteredCategories => Catalog.Categories
        .Where(x => !IsLive || x.Active)
        .Where(x => (string.IsNullOrWhiteSpace(_catalogSearch)
             || x.Name.Contains(_catalogSearch, StringComparison.OrdinalIgnoreCase)
             || x.Types.Any(t => t.Name.Contains(_catalogSearch, StringComparison.OrdinalIgnoreCase))))
        .ToList();
    private DemoCategory? SelectedCategory => Catalog.Categories.FirstOrDefault(x => x.Id == _selectedCategoryId && (!IsLive || x.Active));
    private IReadOnlyList<DemoType> FilteredTypes => SelectedCategory?.Types
        .Where(x => string.IsNullOrWhiteSpace(_catalogSearch)
            || SelectedCategory.Name.Contains(_catalogSearch, StringComparison.OrdinalIgnoreCase)
            || x.Name.Contains(_catalogSearch, StringComparison.OrdinalIgnoreCase)).ToList() ?? [];
    private DemoCategory? ConfiguredCategory => Catalog.Categories.FirstOrDefault(x => x.Id == _configuringLine?.CategoryId);
    private DemoType? ConfiguredType => ConfiguredCategory?.Types.FirstOrDefault(x => x.Id == _configuringLine?.TypeId);
    private int ConfiguredParameterCount => ConfiguredCategory?.ParameterLabels.Count(x => x is not null) ?? 0;
    private IReadOnlyList<DemoColour> ConfiguredColours => _configuringLine is null ? [] : Catalog.Colours
        .Where(x => x.CategoryIds.Contains(_configuringLine.CategoryId)).ToList();
    private DemoColour? ConfiguredColour => ConfiguredColours.FirstOrDefault(x => x.Id == _configuringLine?.ColourId);
    private bool InvalidWidth => _configuringLine is { Kind: "Product" } && _configuringLine.WidthMm < (IsLive ? 1 : 200);
    private bool InvalidHeight => _configuringLine is { Kind: "Product" } && _configuringLine.HeightMm < (IsLive ? 1 : 200);
    private bool IsOtherControl => _configuringLine is not null && _configuringLine.ControlType is not ("Chain left" or "Chain right" or "Motor") && !string.IsNullOrWhiteSpace(_configuringLine.ControlType);
    private string DraftCreatedAtLabel => TimeZoneInfo.ConvertTime(_draftCreatedAt, Vilnius).ToString("yyyy-MM-dd HH:mm", CultureInfo.InvariantCulture);
    private string PreviewCaption => _configuringLine is null ? "" : string.Join(" · ", new[] { _configuringLine.Name, ConfiguredColour?.Name ?? _configuringLine.ColourCode, _configuringLine.ControlType }.Where(x => !string.IsNullOrWhiteSpace(x)));
    private static string LineDimensions(DemoOrderLine line) => line.Kind == "Product"
        ? $"{OrderFormat.Mm(line.WidthMm)} × {OrderFormat.Mm(line.HeightMm)} mm · ×{line.Quantity}"
        : $"×{line.Quantity} {line.Unit}";
    private IReadOnlyList<DemoAccessory> FilteredAccessories => Catalog.Accessories
        .Where(x => (_attachedTo is null || x.CategoryIds.Contains(_attachedTo.CategoryId))
            && (string.IsNullOrWhiteSpace(_accessorySearch)
                || x.Name.Contains(_accessorySearch, StringComparison.OrdinalIgnoreCase)
                || x.Id.ToString(CultureInfo.InvariantCulture).Contains(_accessorySearch, StringComparison.OrdinalIgnoreCase)))
        .Take(80).ToList();
    private DemoAccessory? SelectedAccessory => Catalog.Accessories.FirstOrDefault(x => x.Id == _selectedAccessoryId);

    private async Task OpenProductPicker()
    {
        if (IsLive && !await LeaveProductAsync()) return;
        if (IsLive && !await RefreshLiveCatalogAsync()) return;
        var previousCategoryId = _selectedCategoryId;
        ResetPicker();
        _selectedCategoryId = previousCategoryId != 0 && Catalog.Categories.Any(x => x.Id == previousCategoryId && (!IsLive || x.Active))
            ? previousCategoryId
            : Catalog.Categories.FirstOrDefault(x => (!IsLive || x.Active) && x.Name.Equals("Roletai", StringComparison.OrdinalIgnoreCase))?.Id
                ?? Catalog.Categories.FirstOrDefault(x => !IsLive || x.Active)?.Id ?? 0;
        _configuringLine = null;
        _selectingProduct = true;
    }
    private void CloseProductPicker() => _selectingProduct = false;
    private async Task CreateProductFromType(DemoType type)
    {
        if (IsLive) { await CreateLiveProductAsync(type); return; }
        if (_order is null || SelectedCategory is null) return;
        var kind = SelectedCategory.Name switch
        {
            "Priedai" or "Be gaminių" => "Priedai",
            "Paslaugos" => "Service",
            _ => "Product"
        };
        var line = new DemoOrderLine
        {
            Kind = kind, TypeId = type.Id, CategoryId = SelectedCategory.Id,
            Category = SelectedCategory.Name, Name = type.Name,
            Quantity = 1, Price = 0, Discountable = kind == "Product",
            WidthMm = kind == "Product" ? 800 : 0,
            HeightMm = kind == "Product" ? 1500 : 0,
            ControlType = kind == "Product" ? "Chain right" : ""
        };
        _order.Lines.Add(line);
        _selectingProduct = false;
        await OpenConfigurator(line);
    }
    private async Task OpenConfigurator(DemoOrderLine line)
    {
        if (IsLive && !await LeaveProductAsync()) return;
        _selectingProduct = false;
        if(IsLive && line.LegacyId is not null) line=_order?.Lines.FirstOrDefault(x=>x.LegacyId==line.LegacyId) ?? line;
        ClearProductErrors();
        _configuringLine = line;
        _productSaved=ProductState(line);
        if(!IsLive) await RecalculateConfiguredParameters();
        else { _requiredMaterial=null;_availableMaterial=null;_freeMaterial=null;_shortageDisposition=null;_isMaterialShort=null;await UpdateLivePreviewAsync(false); }
    }
    private async Task CloseConfigurator() { if (IsLive && !await SaveLiveProductAsync()) return; _configuringLine = null; }
    private void SetControlLeft() { if (_configuringLine is not null) _configuringLine.ControlType = "Chain left"; }
    private void SetControlRight() { if (_configuringLine is not null) _configuringLine.ControlType = "Chain right"; }
    private void SetControlMotor() { if (_configuringLine is not null) _configuringLine.ControlType = "Motor"; }
    private void SetControlOther() { if (_configuringLine is not null) _configuringLine.ControlType = "Other"; }
    private async Task StepWidth(int step)
    {
        if (_configuringLine is null) return;
        _configuringLine.WidthMm = Math.Max(IsLive ? 1 : 200, _configuringLine.WidthMm + step);
        await RecalculateConfiguredParameters();
    }
    private async Task StepHeight(int step)
    {
        if (_configuringLine is null) return;
        _configuringLine.HeightMm = Math.Max(IsLive ? 1 : 200, _configuringLine.HeightMm + step);
        await RecalculateConfiguredParameters();
    }
    private async Task StepQuantity(int step)
    {
        if (_configuringLine is null) return;
        _configuringLine.Quantity = Math.Max(IsLive ? 0.001m : _configuringLine.Kind == "Product" ? 1m : 0.001m, _configuringLine.Quantity + step);
        await RecalculateConfiguredParameters();
    }
    private async Task ChangeConfiguredType(ChangeEventArgs e)
    {
        if (_configuringLine is null || !int.TryParse(e.Value?.ToString(), out var id)) return;
        var type = ConfiguredCategory?.Types.FirstOrDefault(x => x.Id == id);
        if (type is null) return;
        _configuringLine.TypeId = type.Id;
        if(IsLive) { _configuringLine.UseListPrice=false; _configuringLine.RecalculateParameters=true; }
        _configuringLine.Name = type.Name;
        await RecalculateConfiguredParameters();
    }
    private async Task RecalculateConfiguredParameters()
    {
        if (IsLive && _configuringLine is not null) { Array.Fill(_configuringLine.ParameterManual,false); _configuringLine.RecalculateParameters=true; await UpdateLivePreviewAsync(); return; }
        if (_configuringLine is null || ConfiguredType is null) return;
        for (var index = 0; index < 12; index++)
        {
            if (_configuringLine.ParameterManual[index]) continue;
            var formula = ConfiguredType.ParameterFormulas.ElementAtOrDefault(index);
            if (DemoParameterFormula.TryEvaluate(formula, _configuringLine, out var result))
                _configuringLine.ParameterValues[index] = result;
        }
    }
    private async Task SetParameter(int index, string value)
    {
        if (_configuringLine is null) return;
        if(IsLive) _previewGeneration++;
        _configuringLine.ParameterValues[index] = value.Trim();
        _configuringLine.ParameterManual[index] = true;
        if(IsLive) await UpdateLivePreviewAsync(false);
    }
    private void ActivateParameter(int index)
    {
        if (_configuringLine is not null) _configuringLine.ParameterManual[index] = true;
    }
    private async Task SelectConfiguredMaterialAsync(int? id)
    {
        if(_configuringLine is null)return;
        var material=ConfiguredColours.FirstOrDefault(x=>x.Id==id);
        _configuringLine.ColourId=material?.Id;
        _configuringLine.ColourCode=material?.Code ?? "";
        _productErrors.Remove("colour");
        if(IsLive) await UpdateLivePreviewAsync(false);
    }
    private async Task OpenPaymentSheet()
    {
        if(IsLive) { await OpenLivePaymentAsync(); return; }
        if (_order is null) return;
        _paymentMethod = "Bank transfer";
        _paymentDate = Today.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture);
        _paymentAmount = Math.Max(0, _order.Debt);
        _paymentReference = "";
        _paymentParty = "";
        _paymentNote = "";
        _paymentError = "";
        _paymentSheetOpen = true;
    }
    private async Task ClosePaymentSheet()
    {
        if(IsLive && Entry.HasPendingCommand) { _paymentError="Recover the outstanding payment before closing this sheet.";return; }
        if(PaymentDirty && !await JS.InvokeAsync<bool>("confirm","Discard the payment inputs? No new payment will be posted."))return;
        _paymentSheetOpen=false;
    }
    private async Task AddPayment()
    {
        if(IsLive) { await PostLivePaymentAsync(); return; }
        if (_order is null) return;
        if (_paymentAmount <= 0 || !DateOnly.TryParseExact(_paymentDate, "yyyy-MM-dd", CultureInfo.InvariantCulture, DateTimeStyles.None, out var date))
        {
            _paymentError = "Enter a valid payment date and a positive amount.";
            return;
        }
        if ((_paymentMethod is "Via PPK" or "Bank transfer") && string.IsNullOrWhiteSpace(_paymentReference)
            || (_paymentMethod is "Cash desk" or "EKA register") && string.IsNullOrWhiteSpace(_paymentParty))
        {
            _paymentError = "Enter the document reference, receiver, or register required for this method.";
            return;
        }
        _order.Payments.Add(new DemoPayment
        {
            Date = date, Method = _paymentMethod, Amount = _paymentAmount,
            Reference = _paymentReference.Trim(), ReceiverOrRegister = _paymentParty.Trim(), Note = _paymentNote.Trim()
        });
        _paymentSheetOpen = false;
    }
    private async Task OpenAccessoryPicker(DemoOrderLine? parent)
    {
        if (IsLive) { if (parent is null) { await OpenStandalonePriedaiAsync(); return; } if (!await SaveLiveProductAsync()) return; parent=_order?.Lines.FirstOrDefault(x=>x.LegacyId==parent.LegacyId) ?? parent; }
        if (IsLive && !await RefreshLiveCatalogAsync()) return;
        ResetPicker();
        _attachedTo = parent;
        _pickerMode = "accessory";
    }
    private void ResetPicker()
    {
        _pickerError = "";
        _catalogSearch = "";
        _accessorySearch = "";
        _selectedCategoryId = 0;
        _selectedAccessoryId = 0;
        _quantity = 1;
        _price = 0;
    }
    private void SelectCategory(int id)
    {
        _selectedCategoryId = id;
        _pickerError = "";
    }
    private void SelectAccessory(int id)
    {
        _selectedAccessoryId = id;
        _accessoryPriceEntered=false;
        _price = SelectedAccessory?.Price ?? 0;
        if (_attachedTo is not null && SelectedAccessory is not null)
        {
            var width = _attachedTo.WidthMm / 1000m;
            var height = _attachedTo.HeightMm / 1000m;
            _quantity = SelectedAccessory.Unit switch
            {
                "1m pločio" => width * _attachedTo.Quantity,
                "1m aukščio" => height * _attachedTo.Quantity,
                "vnt" => _attachedTo.Quantity,
                "kvm" => width * height * _attachedTo.Quantity,
                _ => 1m
            };
            if (_quantity <= 0) _quantity = 1;
        }
        _pickerError = "";
    }
    private async Task AddLine()
    {
        if (IsLive) { await SaveLiveAccessoryAsync(); return; }
        if (_order is null) return;
        if (_quantity <= 0 || _price < 0)
        {
            _pickerError = "Quantity must be positive and price cannot be negative.";
            return;
        }
        if (SelectedAccessory is not null)
        {
            var line = new DemoOrderLine
            {
                Kind = "Priedai", TypeId = SelectedAccessory.Id,
                Category = "Priedai", Name = SelectedAccessory.Name,
                Unit = SelectedAccessory.Unit, Quantity = _quantity, Price = _price,
                Discountable = _attachedTo is not null
            };
            if (_attachedTo is null) _order.Lines.Add(line);
            else _attachedTo.Accessories.Add(line);
        }
        else
        {
            _pickerError = "Choose a priedai item.";
            return;
        }
        ClosePicker();
    }

    private async Task RemoveLine(DemoOrderLine line) { if (IsLive) await DeleteLiveProductAsync(line); else _order?.Lines.Remove(line); }
    private async Task RemoveAccessory(DemoOrderLine parent, DemoOrderLine accessory) { if (IsLive) await DeleteLiveAccessoryAsync(parent,accessory); else parent.Accessories.Remove(accessory); }
    private void ClosePicker()
    {
        _pickerMode = null;
        _attachedTo = null;
    }
    private async Task CloseAsync()
    {
        if (IsLive && (Entry.HasPendingCommand)) { _liveError="Resolve the outstanding save before closing this editor."; return; }
        if (IsLive && !await LeaveProductAsync()) return;
        if (IsLive && (HeaderDirty || AddressDirty || PaymentDirty || ConfirmationDirty) && !await JS.InvokeAsync<bool>("confirm", "Leave without saving the current inputs or confirming the selected products? The saved order remains in legacy.")) return;
        _leaving=true;
        await OnClose.InvokeAsync();
    }
    public async Task HandleEscapeAsync()
    {
        if (_pickerMode is not null) ClosePicker();
        else if (_confirmationSheetOpen) CloseConfirmation();
        else if (_paymentSheetOpen) await ClosePaymentSheet();
        else if (_configuringLine is not null) await CloseConfigurator();
        else if (_selectingProduct) CloseProductPicker();
        else await CloseAsync();
        await InvokeAsync(StateHasChanged);
    }
    private static string Display(string value) => string.IsNullOrWhiteSpace(value) ? "—" : value;
    private bool IsPrivacyRestricted => IsLive && LKvitai.MES.Modules.Sales.Contracts.Orders.LegacyOrderPrivacy.IsRestricted(_order?.Note);
}
