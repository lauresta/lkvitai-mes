                                </div>
                                @if ((_configuringLine.Kind == "Product" || IsLive) && !string.IsNullOrWhiteSpace(_configuringLine.ColourCode) && _configuringLine.ColourId is null)
                                {
                                    <div class="demo-field-error">Code not found for this category.</div>
                                }
