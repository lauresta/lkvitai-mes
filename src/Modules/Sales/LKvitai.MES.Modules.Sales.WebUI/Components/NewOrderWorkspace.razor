@using System.Globalization
@implements IAsyncDisposable
@inject IJSRuntime JS

<div class="demo-layer" role="dialog" aria-modal="true" aria-label="@L["Workspace.OrderEntry"]" @ref="_layerElement">
    @if (_order is null)
    {
        <button class="demo-backdrop" type="button" aria-label="@L["Workspace.CloseNew"]" @onclick="CloseAsync"></button>
        <aside class="demo-drawer" aria-labelledby="demo-new-title">
            <div class="demo-drawer__head">
                <div><div class="eyebrow mono">@L["Orders.PageTitle"]</div><h2 id="demo-new-title">@L["Orders.NewOrder"]</h2></div>
                <button class="demo-icon-button" type="button" aria-label="@L["Common.Close"]" @onclick="CloseAsync">×</button>
            </div>
            <div class="demo-drawer__body">
                <p class="demo-notice">@L["Preview.Snapshot", Catalog.SnapshotDate]</p>
                <label class="demo-label" for="demo-number">@L["Workspace.OrderNumber"] <span class="demo-required">*</span></label>
                <input id="demo-number" class="demo-input mono" value="@_rawNumber" @oninput="OnNumberInput"
                       placeholder="@L["Workspace.NumberExample"]" autocomplete="off" aria-describedby="demo-number-help" />
                <div id="demo-number-help" class="demo-help">@L["Workspace.NumberHelp"]</div>
                @if (SeriesSuggestions.Count > 0)
                {
                    <div class="demo-suggestions" aria-label="@L["Workspace.MatchingSeries"]">
                        @foreach (var suggestion in SeriesSuggestions)
                        {
                            <button type="button" @onclick="() => ChooseSeries(suggestion)">@suggestion<span class="mono">@L["Workspace.Series"]</span></button>
                        }
                    </div>
                }
                @if (HasNumberPreview)
                {
                    <div class="demo-number-preview"><span>@L["Workspace.NumberPreview"]</span><strong class="mono">@PreviewNumber</strong></div>
                }
                else if (!string.IsNullOrWhiteSpace(_rawNumber) && _numberTouched)
                {
                    <div class="demo-field-error" role="alert">@NumberError</div>
                }
                @if (!string.IsNullOrWhiteSpace(_lastAutofilledSeries))
                {
                    <div class="demo-help">@L["Workspace.SeriesDefaults", _lastAutofilledSeries]</div>
                }

                <div class="demo-form-grid">
                    <div>
                        <label class="demo-label" for="demo-customer">@L["Common.Customer"] <span class="demo-required">*</span></label>
                        <input id="demo-customer" class="demo-input" @bind="_customer" placeholder="@L["Workspace.CustomerName"]" />
                    </div>
                    <div>
                        <label class="demo-label" for="demo-store">@L["Common.Store"]<span class="demo-required">*</span></label>
                        <input id="demo-store" class="demo-input" @bind="_store" placeholder="@L["Workspace.StoreBranch"]" />
                    </div>
                    <div>
                        <label class="demo-label" for="demo-manager">@L["Common.Manager"]</label>
                        <input id="demo-manager" class="demo-input" @bind="_manager" placeholder="@L["Common.Manager"]" />
                    </div>
                    <div>
                        <label class="demo-label" for="demo-consultant">@L["Common.Consultant"]</label>
                        <input id="demo-consultant" class="demo-input" @bind="_consultant" placeholder="@L["Common.Consultant"]" />
                    </div>
                    <div>
                        <label class="demo-label" for="demo-date">@L["Common.OrderDate"]</label>
                        <input id="demo-date" type="date" class="demo-input mono" value="@_date" @onchange="e => _date = e.Value?.ToString() ?? _date" />
                    </div>
                    <div>
                        <label class="demo-label" for="demo-due">@L["Common.DueDate"]</label>
                        <input id="demo-due" type="date" class="demo-input mono" value="@_due" @onchange="e => _due = e.Value?.ToString() ?? _due" />
                    </div>
                </div>
                @if (!string.IsNullOrWhiteSpace(_formError))
                {
                    <div class="demo-field-error demo-field-error--block" role="alert">@_formError</div>
                }
            </div>
            <div class="demo-drawer__foot">
                <button class="btn btn--ghost" type="button" @onclick="CloseAsync">@L["Common.Cancel"]</button>
                <button class="btn btn--primary" type="button" @onclick="CreateDraft">@L["Workspace.CreateDraftOpen"]</button>
            </div>
        </aside>
    }
    else
    {
        <div class="demo-editor">
            <header class="demo-editor__top">
                <div>
                    <div class="eyebrow mono">@L["Workspace.SalesDraft"]</div>
                    <h1 class="mono">@_order.Number</h1>
                    <div class="demo-editor__meta">@_order.Customer · @_order.Store</div>
                </div>
                <div class="demo-editor__actions">
                    <span class="chip chip--entered">@L["Workspace.LocalPreview"]</span>
                    <button class="btn btn--ghost" type="button" @onclick="CloseAsync">@L["Workspace.DiscardReturn"]</button>
                </div>
            </header>
            <div class="demo-editor__banner" role="status">@L["Preview.DraftHelp"]</div>
            <div class="demo-stage-strip" aria-label="@L["Workspace.OrderStage"]"><span class="is-current">@L["Orders.Status.Entered"]</span><span>@L["Orders.Status.Approved"]</span><span>@L["Orders.Status.InProgress"]</span><span>@L["Orders.Status.Made"]</span><span>@L["Orders.Status.Shipped"]</span><span>@L["Orders.Status.Delivered"]</span></div>
            <div class="demo-editor__grid">
                <div class="demo-editor__main">
                    <section class="panel demo-panel">
                        <div class="panel__head"><h2>@L["Workspace.PeopleDates"]</h2><span>@L["Workspace.EditableFields"]</span></div>
                        <div class="demo-panel__body demo-summary-grid">
                            <div><label class="demo-label" for="edit-customer">@L["Common.Customer"]</label><input id="edit-customer" class="demo-input" @bind="_order.Customer" /></div>
                            <div><label class="demo-label" for="edit-manager">@L["Common.Manager"]</label><input id="edit-manager" class="demo-input" @bind="_order.Manager" /></div>
                            <div><label class="demo-label" for="edit-store">@L["Common.Store"]</label><input id="edit-store" class="demo-input" @bind="_order.Store" /></div>
                            <div><label class="demo-label" for="edit-consultant">@L["Common.Consultant"]</label><input id="edit-consultant" class="demo-input" @bind="_order.Consultant" /></div>
                            <div><label class="demo-label" for="edit-date">@L["Common.OrderDate"]</label><input id="edit-date" type="date" class="demo-input mono" value="@_editorDate" @onchange="UpdateOrderDate" /></div>
                            <div><label class="demo-label" for="edit-due">@L["Common.DueDate"]</label><input id="edit-due" type="date" class="demo-input mono" value="@_editorDue" @onchange="UpdateDueDate" /></div>
                            <div><label class="demo-label" for="edit-mounting-date">@L["Workspace.MountingDate"]</label><input id="edit-mounting-date" type="date" class="demo-input mono" value="@_editorMountingDate" @onchange="UpdateMountingDate" /></div>
                            <div><label class="demo-label" for="edit-priority">@L["Workspace.Priority"]</label><select id="edit-priority" class="demo-input" @bind="_order.Priority"><option value="Normal">@L["Workspace.PriorityNormal"]</option><option value="High">@L["Workspace.PriorityHigh"]</option><option value="Urgent">@L["Workspace.PriorityUrgent"]</option></select></div>
                        </div>
                    </section>

                    <section class="panel demo-panel">
                        <div class="panel__head"><h2>@L["Common.Address"]</h2><span>@L["Workspace.DraftContactDelivery"]</span></div>
                        <div class="demo-panel__body">
                            <div class="demo-form-grid demo-form-grid--address">
                                <div><label class="demo-label" for="address-region">@L["Workspace.Region"]</label><input id="address-region" class="demo-input" @bind="_order.Region" /></div>
                                <div><label class="demo-label" for="address-city">@L["Workspace.City"]</label><input id="address-city" class="demo-input" @bind="_order.City" /></div>
                                <div><label class="demo-label" for="address-street">@L["Workspace.Street"]</label><input id="address-street" class="demo-input" @bind="_order.Street" /></div>
                                <div><label class="demo-label" for="address-building">@L["Workspace.Building"]</label><input id="address-building" class="demo-input mono" @bind="_order.Building" /></div>
                                <div><label class="demo-label" for="address-flat">@L["Workspace.Flat"]</label><input id="address-flat" class="demo-input mono" @bind="_order.Flat" /></div>
                                <div><label class="demo-label" for="address-phone">@L["Common.Phone"]</label><input id="address-phone" type="tel" class="demo-input mono" @bind="_order.Phone" /></div>
                            </div>
                            <label class="demo-label demo-label--spaced" for="address-note">@L["Workspace.AddressNotes"]</label><textarea id="address-note" class="demo-textarea" @bind="_order.AddressNote"></textarea>
                        </div>
                    </section>

                    <section class="panel demo-panel">
                        <div class="panel__head">
                            <div><h2>@L["Workspace.ProductsServices"]</h2><span>@L["Workspace.LineCount", _order.Lines.Count]</span></div>
                            <div class="demo-panel__actions">
                                <button class="btn btn--ghost" type="button" @onclick="() => OpenAccessoryPicker(null)">@L["Workspace.AddPriedai"]</button>
                                <button class="btn btn--primary" type="button" @onclick="OpenProductPicker">@L["Workspace.AddProductService"]</button>
                            </div>
                        </div>
                        @if (_order.Lines.Count == 0)
                        {
                            <div class="demo-empty">@L["Workspace.NoLines"]</div>
                        }
                        else
                        {
                            <div class="table-wrap">
                                <table class="lk-table demo-lines">
                                    <thead><tr><th>@L["Details.Item"]</th><th>@L["Common.Details"]</th><th class="is-num">@L["Workspace.Qty"]</th><th class="is-num">@L["Common.Price"]</th><th class="is-num">@L["Common.Amount"]</th><th></th></tr></thead>
                                    <tbody>
                                        @foreach (var line in _order.Lines)
                                        {
                                            <tr>
                                                <td><div class="demo-line-name"><div class="demo-line-sketch"><CategoryIcon Category="@line.Category" /></div><div>
                                                    <button class="demo-line-open" type="button" @onclick="() => OpenConfigurator(line)">@line.Name ↗</button>
                                                    <small>@line.Category</small></div></div></td>
                                                <td class="mono">@(line.WidthMm > 0 ? $"{line.WidthMm} × {line.HeightMm} mm" : line.Unit)</td>
                                                <td class="is-num"><input class="demo-table-input mono" type="number" min="0.001" step="0.001" aria-label="@L["Product.QuantityFor", line.Name]" @bind="line.Quantity" /></td>
                                                <td class="is-num"><input class="demo-table-input mono" type="number" min="0" step="0.01" aria-label="@L["Product.PriceFor", line.Name]" @bind="line.Price" /></td>
                                                <td class="is-num">@OrderFormat.Money(line.Quantity * line.Price)</td>
                                                <td class="demo-line-actions">
                                                    <label class="demo-discount-flag" title="@L["Workspace.IncludeDiscount"]"><input type="checkbox" @bind="line.Discountable" />@L["Workspace.DiscountShort"]</label>
                                                    @if (line.Kind == "Product")
                                                    {
                                                        <button type="button" title="@L["Product.AddToProduct"]" @onclick="() => OpenAccessoryPicker(line)">@L["Product.AddAccessoryShort"]</button>
                                                    }
                                                    <button type="button" title="@L["Workspace.RemoveLine"]" @onclick="() => RemoveLine(line)">×</button>
                                                </td>
                                            </tr>
                                            @foreach (var accessory in line.Accessories)
                                            {
                                                <tr class="demo-attached-row">
                                                    <td>↳ @accessory.Name</td><td>@accessory.Unit</td>
                                                    <td class="is-num"><input class="demo-table-input mono" type="number" min="0.001" step="0.001" aria-label="@L["Product.QuantityFor", accessory.Name]" @bind="accessory.Quantity" /></td>
                                                    <td class="is-num"><input class="demo-table-input mono" type="number" min="0" step="0.01" aria-label="@L["Product.PriceFor", accessory.Name]" @bind="accessory.Price" /></td>
                                                    <td class="is-num">@OrderFormat.Money(accessory.Quantity * accessory.Price)</td>
                                                    <td class="demo-line-actions"><button type="button" title="@L["Product.RemoveAccessory"]" @onclick="() => RemoveAccessory(line, accessory)">×</button></td>
                                                </tr>
                                            }
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                    </section>

                    <section class="panel demo-panel">
                        <div class="panel__head"><h2>@L["Workspace.ResponsibleEmployees"]</h2><span>@L["Workspace.DraftAssignments"]</span></div>
                        <div class="demo-panel__body">
                            @foreach (var employee in _order.Employees)
                            {
                                <div class="demo-employee-row"><span><strong>@DisplayDuty(employee.Duty)</strong> — @employee.Name <small class="mono">@OrderFormat.Date(employee.Date)</small></span><button class="demo-small-remove" type="button" title="@L["Preview.RemoveEmployee"]" @onclick="() => _order.Employees.Remove(employee)">×</button></div>
                            }
                            <div class="demo-employee-add">
                                <div><label class="demo-label" for="employee-duty">@L["Details.Duty"]</label><select id="employee-duty" class="demo-input" @bind="_employeeDuty"><option value="Konsultantas">@L["Workspace.DutyConsultant"]</option><option value="Vadybininkas">@L["Workspace.DutyManager"]</option><option value="Matuotojas">@L["Workspace.DutyMeasurer"]</option><option value="Montuotojas">@L["Workspace.DutyInstaller"]</option><option value="Transportas">@L["Workspace.DutyTransport"]</option></select></div>
                                <div><label class="demo-label" for="employee-name">@L["Common.Employee"]</label><input id="employee-name" class="demo-input" @bind="_employeeName" /></div>
                                <div><label class="demo-label" for="employee-date">@L["Common.Date"]</label><input id="employee-date" type="date" class="demo-input mono" value="@_employeeDate" @onchange="e => _employeeDate = e.Value?.ToString() ?? _employeeDate" /></div>
                                <button class="btn btn--ghost" type="button" @onclick="AddEmployee">@L["Common.Add"]</button>
                            </div>
                            @if (!string.IsNullOrWhiteSpace(_employeeError)) { <div class="demo-field-error">@_employeeError</div> }
                        </div>
                    </section>

                    <section class="panel demo-panel">
                        <div class="panel__head"><h2>@L["Common.Note"]</h2><span>@L["Workspace.DraftOnly"]</span></div>
                        <div class="demo-panel__body"><textarea class="demo-textarea" maxlength="128" @bind="_order.Note" placeholder="@L["Workspace.OrderNote"]"></textarea><div class="demo-help">@L["Workspace.NoteLimit"]</div></div>
                    </section>
                </div>
                <aside class="panel demo-receipt">
                    <div class="panel__head"><h2>@L["Workspace.Receipt"]</h2><span>@L["Workspace.PreviewAmount"]</span></div>
                    <div class="demo-receipt__row"><span>@L["Workspace.BeforeDiscount"]</span><strong class="mono">@OrderFormat.Money(_order.BeforeDiscount)</strong></div>
                    <div class="demo-receipt__row"><span>@L["Workspace.Discountable"]</span><strong class="mono">@OrderFormat.Money(_order.DiscountableAmount)</strong></div>
                    <div class="demo-receipt__discount">
                        <label class="demo-label" for="receipt-discount">@L["Workspace.DiscountPercent"]</label><input id="receipt-discount" type="number" min="-100" max="100" step="0.01" class="demo-input mono" @bind="_order.DiscountPercent" @bind:after="NormalizeDiscount" />
                        <label class="demo-label demo-label--spaced" for="receipt-fixed-price">@L["Workspace.FixedFinalPrice"]</label><input id="receipt-fixed-price" type="number" min="0" step="0.01" class="demo-input mono" value="@_order.Total.ToString("0.00", CultureInfo.InvariantCulture)" @onchange="SetFixedPrice" />
                        @if (!string.IsNullOrWhiteSpace(_discountError)) { <div class="demo-field-error">@_discountError</div> }
                    </div>
                    <div class="demo-receipt__row"><span>@(_order.DiscountPercent < 0 ? L["Workspace.Markup"].Value : L["Workspace.Discount"].Value)</span><strong class="mono">@OrderFormat.Money(Math.Abs(_order.DiscountAmount))</strong></div>
                    <div class="demo-receipt__row demo-receipt__row--total"><span>@L["Common.Total"]</span><strong class="mono">@OrderFormat.Money(_order.Total)</strong></div>
                    <div class="demo-receipt__row"><span>@L["Common.Paid"]</span><strong class="mono">@OrderFormat.Money(_order.Paid)</strong></div>
                    <div class="demo-receipt__row"><span>@L["Common.Debt"]</span><strong class="mono">@OrderFormat.Money(_order.Debt)</strong></div>
                    <p>@L["Preview.PriceHelp"]</p>
                    <button class="btn btn--primary" type="button" @onclick="SavePreview">@L["Workspace.SaveDraft"]</button>
                    @if (!string.IsNullOrWhiteSpace(_saveMessage)) { <div class="demo-save-message @(_saveIsError ? "demo-save-message--error" : "")" role="status">@_saveMessage</div> }
                    <button class="btn btn--ghost" type="button" disabled title="@L["Preview.DatabaseLater"]">@L["Preview.ConfirmLater"]</button>
                    <div class="demo-receipt__payments">
                        <div><strong>@L["Common.Payments"]</strong><button class="btn btn--ghost" type="button" @onclick="OpenPaymentSheet">@L["Payment.AddNew"]</button></div>
                        @if (_order.Payments.Count == 0)
                        {
                            <p>@L["Payment.NoDraft"]</p>
                        }
                        @foreach (var payment in _order.Payments)
                        {
                            <div class="demo-payment-row"><span>@DisplayPaymentMethod(payment.Method)<br /><small class="mono">@OrderFormat.Date(payment.Date) · @payment.Reference @payment.ReceiverOrRegister</small></span><strong class="mono">@OrderFormat.Money(payment.Amount)</strong><button class="demo-small-remove" type="button" title="@L["Payment.Remove"]" @onclick="() => _order.Payments.Remove(payment)">×</button></div>
                        }
                    </div>
                </aside>
            </div>
        </div>

        @if (_selectingProduct)
        {
            <div class="demo-product-page" aria-label="@L["Product.ChooseNew"]">
                <header class="demo-product-page__header">
                    <div><nav class="demo-breadcrumb" aria-label="@L["Nav.Breadcrumb"]"><button type="button" @onclick="CloseAsync">@L["Common.Home"]</button><span>/</span><button type="button" @onclick="CloseProductPicker">@L["Common.Orders"]</button><span>/</span><button type="button" @onclick="CloseProductPicker">@_order.Number</button><span>/</span><strong>@L["Product.New"]</strong></nav><div class="eyebrow mono">@L["Product.ForOrder", _order.Number]</div><h1>@L["Product.NewService"]</h1></div>
                    <button class="btn btn--ghost" type="button" @onclick="CloseProductPicker">@L["Product.BackOrderArrow"]</button>
                </header>
                <div class="demo-product-page__grid">
                    <aside class="panel demo-product-rail">
                        <div class="panel__head"><h2>@L["Product.OrderProducts"]</h2><span class="mono">@OrderFormat.Money(_order.BeforeDiscount)</span></div>
                        @foreach (var product in _order.Lines)
                        {
                            <button type="button" class="demo-product-rail__item" @onclick="() => OpenConfigurator(product)"><span><CategoryIcon Category="@product.Category" /></span><strong>@product.Name<small class="mono">@LineDimensions(product)</small><span class="chip chip--entered">@L["Orders.Status.Entered"]</span></strong></button>
                        }
                        <button class="demo-product-rail__new" type="button" @onclick="OpenProductPicker">@L["Product.AddNew"]</button>
                    </aside>
                    <main class="demo-product-catalog">
                        <section class="panel demo-product-catalog__categories">
                            <div class="panel__head"><h2>@L["Product.CategoryStep"]</h2><input class="demo-input demo-product-catalog__search" aria-label="@L["Product.FindCategoryType"]" @bind="_catalogSearch" @bind:event="oninput" placeholder="@L["Product.SearchCategories", Catalog.Categories.Count]" /></div>
                            <div class="demo-product-catalog__tiles">
                                @foreach (var category in FilteredCategories)
                                {
                                    <button type="button" class="demo-product-tile @(_selectedCategoryId == category.Id ? "is-selected" : "")" @onclick="() => SelectCategory(category.Id)"><span><CategoryIcon Category="@category.Name" /></span><strong>@category.Name</strong><small>@L["Product.TypeCount", category.Types.Count]</small></button>
                                }
                            </div>
                        </section>
                        @if (SelectedCategory is not null)
                        {
                            <section class="panel demo-product-catalog__types">
                                <div class="panel__head"><h2>@L["Product.TypeStep"]</h2><span>@SelectedCategory.Name</span></div>
                                <div class="demo-product-catalog__type-list">
                                    @if (FilteredTypes.Count == 0)
                                    {
                                        <div class="demo-product-editor__empty">@L["Product.NoActiveTypes"]</div>
                                    }
                                    @foreach (var choice in FilteredTypes.Select((type, index) => (type, index)))
                                    {
                                        <button type="button" @onclick="() => CreateProductFromType(choice.type)"><strong>@choice.type.Name<small>@L["Product.ParameterFieldCount", choice.type.ParameterFormulas.Count(x => !string.IsNullOrWhiteSpace(x))]</small></strong><span>@(choice.index < 9 ? (choice.index + 1).ToString(CultureInfo.InvariantCulture) : "") →</span></button>
                                    }
                                </div>
                            </section>
                        }
                    </main>
                </div>
            </div>
        }

        @if (_configuringLine is not null)
        {
            <div class="demo-product-page demo-product-page--editor" aria-label="@L["Product.Editor"]">
                <header class="demo-product-page__header">
                    <div><nav class="demo-breadcrumb" aria-label="@L["Nav.Breadcrumb"]"><button type="button" @onclick="CloseAsync">@L["Common.Home"]</button><span>/</span><button type="button" @onclick="CloseConfigurator">@L["Common.Orders"]</button><span>/</span><button type="button" @onclick="CloseConfigurator">@_order.Number</button><span>/</span><strong>@_configuringLine.Name</strong></nav><div class="eyebrow mono">@L["Product.ForOrder", _order.Number]</div><div class="demo-product-page__title"><h1>@_configuringLine.Name</h1><span>@_configuringLine.Category</span><span class="chip chip--entered">@L["Orders.Status.Entered"]</span></div></div>
                    <div class="demo-product-page__actions"><button class="btn btn--ghost" type="button" disabled title="@L["Preview.Milestone2"]">@L["Product.CheckParameters"]</button><button class="btn btn--ghost" type="button" disabled title="@L["Preview.Milestone2"]">@L["Product.PriceFromList"]</button><button class="btn btn--ghost" type="button" disabled title="@L["Preview.Milestone2"]">@L["Product.Duplicate"]</button><button class="btn btn--ghost" type="button" disabled title="@L["Preview.Milestone2"]">@L["Common.Refresh"]</button><button class="btn btn--ghost" type="button" disabled title="@L["Preview.Milestone2"]">@L["Product.ReturnProduction"]</button><button class="btn btn--ghost" type="button" disabled title="@L["Preview.Milestone2"]">@L["Product.Warranty"]</button><button class="btn btn--ghost demo-danger-action" type="button" disabled title="@L["Preview.Milestone2"]">@L["Common.Delete"]</button><button class="btn btn--ghost" type="button" @onclick="CloseConfigurator">@L["Product.BackOrderArrow"]</button></div>
                </header>
                <div class="demo-product-page__grid demo-product-page__grid--editor">
                    <aside class="panel demo-product-rail">
                        <div class="panel__head"><h2>@L["Product.OrderProducts"]</h2><span class="mono">@OrderFormat.Money(_order.BeforeDiscount)</span></div>
                        @foreach (var product in _order.Lines)
                        {
                            <button type="button" class="demo-product-rail__item @(ReferenceEquals(product, _configuringLine) ? "is-selected" : "")" @onclick="() => OpenConfigurator(product)"><span><CategoryIcon Category="@product.Category" /></span><strong>@product.Name<small class="mono">@LineDimensions(product)</small><span class="chip chip--entered">@L["Orders.Status.Entered"]</span></strong></button>
                        }
                        <button class="demo-product-rail__add" type="button" @onclick="OpenProductPicker">@L["Product.AddNew"]</button>
                    </aside>
                    <main class="demo-product-editor">
                        <section class="panel demo-product-editor__main">
                            <div class="panel__head"><h2>@L["Product.MainParameters"]</h2><select class="demo-product-editor__type-select" aria-label="@L["Details.ProductType"]" value="@_configuringLine.TypeId" @onchange="ChangeConfiguredType">@foreach (var type in ConfiguredCategory?.Types ?? []) { <option value="@type.Id">@type.Name</option> }</select></div>
                            <div class="demo-product-editor__body">
                                @if (_configuringLine.Kind == "Product")
                                {
                                    <div class="demo-product-editor__control">
                                        <label class="demo-label" id="config-control-label">@L["Product.Control"]</label>
                                        <div class="demo-product-editor__control-entry">
                                            <div class="demo-product-editor__control-options" aria-labelledby="config-control-label">
                                                <button type="button" class="@(_configuringLine.ControlType == "Chain left" ? "is-selected" : "")" @onclick="SetControlLeft">@L["Product.ChainLeft"]</button>
