                        </section>
                    </main>
                    <aside class="demo-product-preview">
                        <section class="panel">
                            <div class="panel__head"><h2>@L["Product.LivePreview"]</h2><span class="mono">@(_configuringLine.WidthMm > 0 && _configuringLine.HeightMm > 0 ? L["Product.ToScale"].Value : L["Product.Schematic"].Value)</span></div>
                            <LiveProductPreview Category="@_configuringLine.Category" TypeName="@_configuringLine.Name" WidthMm="@_configuringLine.WidthMm" HeightMm="@_configuringLine.HeightMm" Quantity="@_configuringLine.Quantity" ControlType="@_configuringLine.ControlType" />
                            <div class="demo-product-preview__caption">@PreviewCaption</div>
                        </section>
                        <section class="panel demo-product-preview__totals">
                            <div class="panel__head"><h2>@L["Product.PriceStock"]</h2></div>
                            <div class="lk-stock"><div>@L["Product.FabricNeeded"]<span class="mono">—</span><span class="lk-stock__free mono">@L["Product.FreeUnknown"]</span></div><div class="bar"><i></i></div></div>
                            <div class="demo-receipt__row"><span>@L["Product.Kind"]</span><strong class="mono">@OrderFormat.Money(_configuringLine.Quantity * _configuringLine.Price)</strong></div>
                            <div class="demo-receipt__row"><span>@L["Product.Accessories"]</span><strong class="mono">@OrderFormat.Money(_configuringLine.Accessories.Sum(x => x.Total))</strong></div>
                            <div class="lk-total"><div class="label">@L["Product.Total"]</div><div class="value">@OrderFormat.Money(_configuringLine.Total)</div></div>
                            <p>@L["Product.MilestoneHelp"]</p>
                            <button class="btn btn--primary" type="button" @onclick="CloseConfigurator">@L["Preview.DoneOrder"]</button>
                        </section>
                    </aside>
                </div>
            </div>
        }

        @if (_paymentSheetOpen)
        {
            <button class="demo-picker-backdrop demo-payment-backdrop" type="button" aria-label="@L["Payment.Close"]" @onclick="ClosePaymentSheet"></button>
            <aside class="demo-drawer demo-drawer--payment" aria-labelledby="demo-payment-title">
                <div class="demo-drawer__head"><div><div class="eyebrow mono">@L["Payment.Header", _order.Number, OrderFormat.Money(_order.Debt)]</div><h2 id="demo-payment-title">@L["Payment.New"]</h2></div><button class="demo-icon-button" type="button" aria-label="@L["Payment.Close"]" @onclick="ClosePaymentSheet">×</button></div>
                <div class="demo-drawer__body">
                    <p class="demo-notice">@L["Payment.DraftHelp"]</p>
                    <label class="demo-label" for="payment-method">@L["Payment.Method"]</label>
                    <select id="payment-method" class="demo-input" @bind="_paymentMethod"><option value="Via PPK">@L["Payment.ViaPpk"]</option><option value="Bank transfer">@L["Payment.BankTransfer"]</option><option value="Cash desk">@L["Payment.CashDesk"]</option><option value="EKA register">@L["Payment.Register"]</option></select>
                    <div class="demo-form-grid">
                        <div><label class="demo-label" for="payment-date">@L["Common.Date"]</label><input id="payment-date" type="date" class="demo-input mono" value="@_paymentDate" @onchange="e => _paymentDate = e.Value?.ToString() ?? _paymentDate" /></div>
                        <div><label class="demo-label" for="payment-amount">@L["Payment.AmountEur"]</label><input id="payment-amount" type="number" min="0.01" step="0.01" class="demo-input mono" @bind="_paymentAmount" /></div>
                    </div>
                    @if (_paymentMethod is "Via PPK" or "Bank transfer")
                    {
                        <label class="demo-label demo-label--spaced" for="payment-reference">@(_paymentMethod == "Via PPK" ? L["Payment.PpkNumber"].Value : L["Payment.BankReference"].Value)</label><input id="payment-reference" class="demo-input mono" @bind="_paymentReference" />
                    }
                    else
                    {
                        <label class="demo-label demo-label--spaced" for="payment-party">@(_paymentMethod == "Cash desk" ? L["Payment.CashReceiver"].Value : L["Payment.Register"].Value)</label><input id="payment-party" class="demo-input" @bind="_paymentParty" />
                    }
                    <label class="demo-label demo-label--spaced" for="payment-note">@L["Common.Notes"]</label><textarea id="payment-note" class="demo-textarea" @bind="_paymentNote"></textarea>
                    <div class="demo-number-preview"><span>@L["Payment.DebtAfter"]</span><strong class="mono">@OrderFormat.Money(_order.Debt - _paymentAmount)</strong></div>
                    @if (!string.IsNullOrWhiteSpace(_paymentError)) { <div class="demo-field-error demo-field-error--block" role="alert">@_paymentError</div> }
                </div>
                <div class="demo-drawer__foot"><button class="btn btn--ghost" type="button" @onclick="ClosePaymentSheet">@L["Common.Cancel"]</button><button class="btn btn--primary" type="button" @onclick="AddPayment">@L["Payment.AddDraft"]</button></div>
            </aside>
        }

        @if (_pickerMode is not null)
        {
            <button class="demo-picker-backdrop" type="button" aria-label="@L["Product.ClosePicker"]" @onclick="ClosePicker"></button>
            <aside class="demo-drawer demo-drawer--picker" aria-labelledby="demo-picker-title">
                <div class="demo-drawer__head">
                    <div><div class="eyebrow mono">@L["Product.DraftLineHeader", _order.Number]</div><h2 id="demo-picker-title">@(_attachedTo is null ? L["Product.AddPriedai"].Value : L["Product.AccessoryFor", _attachedTo.Name].Value)</h2></div>
                    <button class="demo-icon-button" type="button" aria-label="@L["Product.ClosePicker"]" @onclick="ClosePicker">×</button>
                </div>
                <div class="demo-drawer__body">
                        <p class="demo-help">@(_attachedTo is null ? L["Product.StandaloneHelp"].Value : L["Product.AccessoryCategoryHelp"].Value)</p>
                        <label class="demo-label" for="demo-accessory-search">@L["Product.SearchPriedai"]</label>
                        <input id="demo-accessory-search" class="demo-input" @bind="_accessorySearch" @bind:event="oninput" placeholder="@L["Product.NameCode"]" />
                        <div class="demo-type-list demo-type-list--accessories">
                            @foreach (var accessory in FilteredAccessories)
                            {
                                <button type="button" class="@(_selectedAccessoryId == accessory.Id ? "is-selected" : "")" @onclick="() => SelectAccessory(accessory.Id)">
                                    <span>@accessory.Name</span><small class="mono">@accessory.Unit · @OrderFormat.Money(accessory.Price)</small>
                                </button>
                            }
                        </div>
                        @if (SelectedAccessory is not null)
                        {
                            @if (_attachedTo is not null)
                            {
                                <p class="demo-help">@L["Product.SuggestedQuantityHelp"]</p>
                            }
                            <div class="demo-form-grid demo-form-grid--picker">
                                <div><label class="demo-label" for="demo-acc-qty">@L["Product.QuantityUnit", DisplayUnit(SelectedAccessory.Unit)]</label><input id="demo-acc-qty" type="number" min="0.001" step="0.001" class="demo-input mono" @bind="_quantity" /></div>
                                <div><label class="demo-label" for="demo-acc-price">@L["Product.PreviewUnitPriceEur"]</label><input id="demo-acc-price" type="number" min="0" step="0.01" class="demo-input mono" @bind="_price" /></div>
                            </div>
                        }
                    @if (!string.IsNullOrWhiteSpace(_pickerError))
                    {
                        <div class="demo-field-error demo-field-error--block" role="alert">@_pickerError</div>
                    }
                </div>
                <div class="demo-drawer__foot">
                    <button class="btn btn--ghost" type="button" @onclick="ClosePicker">@L["Common.Cancel"]</button>
                    <button class="btn btn--primary" type="button" @onclick="AddLine">@L["Payment.AddDraft"]</button>
                </div>
            </aside>
        }
    }
</div>

@code {
    [Parameter] public EventCallback OnClose { get; set; }

    private ElementReference _layerElement;
    private IJSObjectReference? _draftModule;
    private DotNetObjectReference<NewOrderWorkspace>? _draftReference;
    private bool _historyActive;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _draftReference = DotNetObjectReference.Create(this);
            _draftModule = await JS.InvokeAsync<IJSObjectReference>("import", "./js/sales-draft.js");
            await _draftModule.InvokeVoidAsync("register", _draftReference, _layerElement);
        }
        if (_draftModule is null) return;
        var productVisible = _selectingProduct || _configuringLine is not null;
        if (productVisible && !_historyActive)
        {
            await _draftModule.InvokeVoidAsync("openProduct");
            _historyActive = true;
        }
        else if (!productVisible && _historyActive)
        {
            _historyActive = false;
            await _draftModule.InvokeVoidAsync("closeProduct");
        }
    }

    [JSInvokable]
    public Task HandleProductHistoryExit()
    {
        _selectingProduct = false;
        _configuringLine = null;
        _historyActive = false;
        return InvokeAsync(StateHasChanged);
    }

    [JSInvokable]
    public Task SelectProductTypeByShortcut(int number)
    {
        if (!_selectingProduct || number is < 1 or > 9) return Task.CompletedTask;
        var type = FilteredTypes.ElementAtOrDefault(number - 1);
        if (type is not null) CreateProductFromType(type);
        return InvokeAsync(StateHasChanged);
    }

    public async ValueTask DisposeAsync()
    {
        if (_draftModule is not null)
        {
            try
            {
                await _draftModule.InvokeVoidAsync("unregister");
                await _draftModule.DisposeAsync();
            }
            catch (JSDisconnectedException) { }
        }
        _draftReference?.Dispose();
    }

    private static readonly DemoCatalog Catalog = DemoCatalog.Load();
    private static readonly TimeZoneInfo Vilnius = TimeZoneInfo.FindSystemTimeZoneById("Europe/Vilnius");
    private static DateOnly Today => DateOnly.FromDateTime(TimeZoneInfo.ConvertTimeFromUtc(DateTime.UtcNow, Vilnius));
    private string _rawNumber = "";
    private string _customer = "";
    private string _manager = "";
    private string _store = "";
    private string _consultant = "";
    private string _date = Today.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture);
    private string _due = Today.AddDays(14).ToString("yyyy-MM-dd", CultureInfo.InvariantCulture);
    private string _editorDate = "";
    private string _editorDue = "";
    private string _editorMountingDate = "";
    private string _employeeDuty = "Konsultantas";
    private string _employeeName = "";
    private string _employeeDate = Today.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture);
    private string _employeeError = "";
    private string _discountError = "";
    private string _saveMessage = "";
    private bool _saveIsError;
    private string _formError = "";
    private bool _numberTouched;
    private bool _showSeriesSuggestions;
    private string _lastAutofilledSeries = "";
    private DemoOrderDraft? _order;
    private DateTimeOffset _draftCreatedAt;
    private DemoOrderLine? _configuringLine;
    private bool _selectingProduct;
    private bool _paymentSheetOpen;
    private string _paymentMethod = "Bank transfer";
    private string _paymentDate = Today.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture);
    private decimal _paymentAmount;
    private string _paymentReference = "";
    private string _paymentParty = "";
    private string _paymentNote = "";
    private string _paymentError = "";
    private string? _pickerMode;
    private DemoOrderLine? _attachedTo;
    private string _catalogSearch = "";
    private string _accessorySearch = "";
    private int _selectedCategoryId;
    private int _selectedAccessoryId;
    private decimal _quantity = 1;
    private decimal _price;
    private string _pickerError = "";

    private bool HasNumberPreview => DemoOrderNumber.TryNormalize(_rawNumber, Today.Year, Catalog, out _, out _, out _);
    private string PreviewNumber => DemoOrderNumber.TryNormalize(_rawNumber, Today.Year, Catalog, out var number, out _, out _) ? number : "";
    private string NumberError => DemoOrderNumber.TryNormalize(_rawNumber, Today.Year, Catalog, out _, out _, out var error) ? "" : error;
    private IReadOnlyList<string> SeriesSuggestions
    {
        get
        {
            if (!_showSeriesSuggestions || string.IsNullOrWhiteSpace(_rawNumber)) return [];
            var prefix = _rawNumber.Split('-')[0].Trim();
            if (prefix.Length is < 1 or > 8 || _rawNumber.Contains('-')) return [];
            return Catalog.Series.Where(x => x.Code.StartsWith(prefix, StringComparison.OrdinalIgnoreCase))
                .Take(6).Select(x => x.Code).ToList();
        }
    }

    private void OnNumberInput(ChangeEventArgs e)
    {
        _rawNumber = e.Value?.ToString() ?? "";
        _numberTouched = true;
        _showSeriesSuggestions = true;
        _formError = "";
        if (_rawNumber.Contains('-')) ApplySeriesDefaults(_rawNumber.Split('-')[0].Trim());
    }

    private void ChooseSeries(string code)
    {
        _rawNumber = code + "-";
        _showSeriesSuggestions = false;
        _numberTouched = false;
        ApplySeriesDefaults(code);
    }

    private void ApplySeriesDefaults(string code)
    {
        if (string.Equals(code, _lastAutofilledSeries, StringComparison.OrdinalIgnoreCase)) return;
        var item = Catalog.Series.FirstOrDefault(x => string.Equals(x.Code, code, StringComparison.OrdinalIgnoreCase));
        if (item is null) return;
        _customer = item.Customer;
        _manager = item.Manager;
        _store = item.Store;
        _consultant = item.Consultant;
        _lastAutofilledSeries = item.Code;
    }

    private void CreateDraft()
    {
        _numberTouched = true;
        if (!DemoOrderNumber.TryNormalize(_rawNumber, Today.Year, Catalog, out var number, out var series, out var error))
        {
            _formError = error;
            return;
        }
        if (string.IsNullOrWhiteSpace(_customer) || string.IsNullOrWhiteSpace(_store))
        {
            _formError = L["Workspace.PreviewCustomerStore"].Value;
            return;
        }
        if (!DateOnly.TryParseExact(_date, "yyyy-MM-dd", CultureInfo.InvariantCulture, DateTimeStyles.None, out var date)
            || !DateOnly.TryParseExact(_due, "yyyy-MM-dd", CultureInfo.InvariantCulture, DateTimeStyles.None, out var due)
            || due < date)
        {
            _formError = L["Workspace.ValidDatesOrder"].Value;
            return;
        }
        _order = new DemoOrderDraft
        {
            Number = number, Series = series, Customer = _customer.Trim(), Store = _store.Trim(),
            Manager = _manager.Trim(), Consultant = _consultant.Trim(), Date = date, Due = due
        };
        _draftCreatedAt = DateTimeOffset.UtcNow;
        _editorDate = _date;
        _editorDue = _due;
        _formError = "";
    }

    private void UpdateOrderDate(ChangeEventArgs e)
    {
        if (_order is null) return;
        var value = e.Value?.ToString() ?? "";
        if (DateOnly.TryParseExact(value, "yyyy-MM-dd", CultureInfo.InvariantCulture, DateTimeStyles.None, out var date))
        {
            _order.Date = date;
            _editorDate = value;
        }
    }

    private void UpdateDueDate(ChangeEventArgs e)
    {
        if (_order is null) return;
        var value = e.Value?.ToString() ?? "";
        if (DateOnly.TryParseExact(value, "yyyy-MM-dd", CultureInfo.InvariantCulture, DateTimeStyles.None, out var date))
        {
            _order.Due = date;
            _editorDue = value;
        }
    }

    private void UpdateMountingDate(ChangeEventArgs e)
    {
        if (_order is null) return;
        var value = e.Value?.ToString() ?? "";
        if (string.IsNullOrWhiteSpace(value))
        {
            _order.MountingDate = null;
            _editorMountingDate = "";
        }
        else if (DateOnly.TryParseExact(value, "yyyy-MM-dd", CultureInfo.InvariantCulture, DateTimeStyles.None, out var date))
        {
            _order.MountingDate = date;
            _editorMountingDate = value;
        }
    }

    private void AddEmployee()
    {
        if (_order is null) return;
        if (string.IsNullOrWhiteSpace(_employeeName)
            || !DateOnly.TryParseExact(_employeeDate, "yyyy-MM-dd", CultureInfo.InvariantCulture, DateTimeStyles.None, out var date))
        {
            _employeeError = L["Workspace.ValidEmployeeDate"].Value;
            return;
        }
        _order.Employees.Add(new DemoResponsibleEmployee { Duty = _employeeDuty, Name = _employeeName.Trim(), Date = date });
        _employeeName = "";
        _employeeError = "";
    }

    private void NormalizeDiscount()
    {
        if (_order is null) return;
        _order.DiscountPercent = Math.Clamp(_order.DiscountPercent, -100m, 100m);
        _discountError = "";
    }

    private void SetFixedPrice(ChangeEventArgs e)
    {
        if (_order is null) return;
        if (!decimal.TryParse(e.Value?.ToString(), NumberStyles.Number, CultureInfo.InvariantCulture, out var requested)
            || requested < 0 || _order.DiscountableAmount <= 0)
        {
            _discountError = L["Workspace.PriceDiscountable"].Value;
            return;
        }
        var percent = (_order.BeforeDiscount - requested) * 100m / _order.DiscountableAmount;
        if (percent is < -100m or > 100m)
        {
            _discountError = L["Workspace.PriceOverLimit"].Value;
            return;
        }
        _order.DiscountPercent = Math.Round(percent, 2, MidpointRounding.AwayFromZero);
        _discountError = "";
    }

    private void SavePreview()
    {
        if (_order is null) return;
        _saveIsError = true;
        if (string.IsNullOrWhiteSpace(_order.Customer) || string.IsNullOrWhiteSpace(_order.Store))
            _saveMessage = L["Workspace.CustomerStoreRequired"].Value;
        else if (_order.Due < _order.Date)
            _saveMessage = L["Workspace.DueBeforeDate"].Value;
        else if (_order.Lines.Count == 0)
            _saveMessage = L["Workspace.AddLineRequired"].Value;
        else if (_order.Lines.Any(x => x.Quantity <= 0 || x.Price < 0 || x.Kind == "Product" && (x.WidthMm < 200 || x.HeightMm < 200)
                    || x.Accessories.Any(a => a.Quantity <= 0 || a.Price < 0)))
            _saveMessage = L["Workspace.CheckLines"].Value;
        else if (_order.Lines.Any(x => !string.IsNullOrWhiteSpace(x.ColourCode) && x.ColourId is null))
            _saveMessage = L["Product.StaticCodeRequired"].Value;
        else
        {
            _saveIsError = false;
            _saveMessage = L["Workspace.PreviewChecked"].Value;
        }
    }

    private IReadOnlyList<DemoCategory> FilteredCategories => Catalog.Categories
        .Where(x => (string.IsNullOrWhiteSpace(_catalogSearch)
             || x.Name.Contains(_catalogSearch, StringComparison.OrdinalIgnoreCase)
             || x.Types.Any(t => t.Name.Contains(_catalogSearch, StringComparison.OrdinalIgnoreCase))))
        .ToList();
    private DemoCategory? SelectedCategory => Catalog.Categories.FirstOrDefault(x => x.Id == _selectedCategoryId);
    private IReadOnlyList<DemoType> FilteredTypes => SelectedCategory?.Types
        .Where(x => string.IsNullOrWhiteSpace(_catalogSearch)
            || SelectedCategory.Name.Contains(_catalogSearch, StringComparison.OrdinalIgnoreCase)
            || x.Name.Contains(_catalogSearch, StringComparison.OrdinalIgnoreCase)).ToList() ?? [];
    private DemoCategory? ConfiguredCategory => Catalog.Categories.FirstOrDefault(x => x.Id == _configuringLine?.CategoryId);
    private DemoType? ConfiguredType => ConfiguredCategory?.Types.FirstOrDefault(x => x.Id == _configuringLine?.TypeId);
    private int ConfiguredParameterCount => ConfiguredCategory?.ParameterLabels.Count(x => !string.IsNullOrWhiteSpace(x)) ?? 0;
    private IReadOnlyList<DemoColour> ConfiguredColours => _configuringLine is null ? [] : Catalog.Colours
        .Where(x => x.CategoryIds.Contains(_configuringLine.CategoryId)).ToList();
    private DemoColour? ConfiguredColour => ConfiguredColours.FirstOrDefault(x => x.Id == _configuringLine?.ColourId);
    private bool InvalidWidth => _configuringLine is { Kind: "Product", WidthMm: > 0 and < 200 };
    private bool InvalidHeight => _configuringLine is { Kind: "Product", HeightMm: > 0 and < 200 };
    private bool IsOtherControl => _configuringLine is not null && _configuringLine.ControlType is not ("Chain left" or "Chain right" or "Motor") && !string.IsNullOrWhiteSpace(_configuringLine.ControlType);
    private string DraftCreatedAtLabel => TimeZoneInfo.ConvertTime(_draftCreatedAt, Vilnius).ToString("yyyy-MM-dd HH:mm", CultureInfo.InvariantCulture);
    private string PreviewCaption => _configuringLine is null ? "" : string.Join(" · ", new[] { _configuringLine.Name, ConfiguredColour?.Name ?? _configuringLine.ColourCode, DisplayControl(_configuringLine.ControlType) }.Where(x => !string.IsNullOrWhiteSpace(x)));
    private static string LineDimensions(DemoOrderLine line) => line.Kind == "Product"
        ? $"{OrderFormat.Mm(line.WidthMm)} × {OrderFormat.Mm(line.HeightMm)} mm · ×{line.Quantity}"
        : $"×{line.Quantity} {line.Unit}";
    private IReadOnlyList<DemoAccessory> FilteredAccessories => Catalog.Accessories
        .Where(x => (_attachedTo is null || x.CategoryIds.Contains(_attachedTo.CategoryId))
            && (string.IsNullOrWhiteSpace(_accessorySearch)
                || x.Name.Contains(_accessorySearch, StringComparison.OrdinalIgnoreCase)
                || x.Id.ToString(CultureInfo.InvariantCulture).Contains(_accessorySearch, StringComparison.OrdinalIgnoreCase)))
        .Take(80).ToList();
    private DemoAccessory? SelectedAccessory => Catalog.Accessories.FirstOrDefault(x => x.Id == _selectedAccessoryId);

    private void OpenProductPicker()
    {
        var previousCategoryId = _selectedCategoryId;
        ResetPicker();
        _selectedCategoryId = previousCategoryId != 0
            ? previousCategoryId
            : Catalog.Categories.FirstOrDefault(x => x.Name.Equals("Roletai", StringComparison.OrdinalIgnoreCase))?.Id
                ?? Catalog.Categories.FirstOrDefault()?.Id ?? 0;
        _configuringLine = null;
        _selectingProduct = true;
    }
    private void CloseProductPicker() => _selectingProduct = false;
    private void CreateProductFromType(DemoType type)
    {
        if (_order is null || SelectedCategory is null) return;
        var kind = SelectedCategory.Name switch
        {
            "Priedai" or "Be gaminių" => "Priedai",
            "Paslaugos" => "Service",
            _ => "Product"
        };
        var line = new DemoOrderLine
        {
            Kind = kind, TypeId = type.Id, CategoryId = SelectedCategory.Id,
            Category = SelectedCategory.Name, Name = type.Name,
            Quantity = 1, Price = 0, Discountable = kind == "Product",
            WidthMm = kind == "Product" ? 800 : 0,
            HeightMm = kind == "Product" ? 1500 : 0,
            ControlType = kind == "Product" ? "Chain right" : ""
        };
        _order.Lines.Add(line);
        _selectingProduct = false;
        OpenConfigurator(line);
    }
    private void OpenConfigurator(DemoOrderLine line)
    {
        _selectingProduct = false;
        _configuringLine = line;
        RecalculateConfiguredParameters();
    }
    private void CloseConfigurator() => _configuringLine = null;
    private void SetControlLeft() { if (_configuringLine is not null) _configuringLine.ControlType = "Chain left"; }
    private void SetControlRight() { if (_configuringLine is not null) _configuringLine.ControlType = "Chain right"; }
    private void SetControlMotor() { if (_configuringLine is not null) _configuringLine.ControlType = "Motor"; }
    private void SetControlOther() { if (_configuringLine is not null) _configuringLine.ControlType = "Other"; }
    private void StepWidth(int step)
    {
        if (_configuringLine is null) return;
        _configuringLine.WidthMm = Math.Max(200, _configuringLine.WidthMm + step);
        RecalculateConfiguredParameters();
    }
    private void StepHeight(int step)
    {
        if (_configuringLine is null) return;
        _configuringLine.HeightMm = Math.Max(200, _configuringLine.HeightMm + step);
        RecalculateConfiguredParameters();
    }
    private void StepQuantity(int step)
    {
        if (_configuringLine is null) return;
        _configuringLine.Quantity = Math.Max(_configuringLine.Kind == "Product" ? 1m : 0.001m, _configuringLine.Quantity + step);
        RecalculateConfiguredParameters();
    }
    private void ChangeConfiguredType(ChangeEventArgs e)
    {
        if (_configuringLine is null || !int.TryParse(e.Value?.ToString(), out var id)) return;
        var type = ConfiguredCategory?.Types.FirstOrDefault(x => x.Id == id);
        if (type is null) return;
        _configuringLine.TypeId = type.Id;
        _configuringLine.Name = type.Name;
        RecalculateConfiguredParameters();
    }
    private void RecalculateConfiguredParameters()
    {
        if (_configuringLine is null || ConfiguredType is null) return;
        for (var index = 0; index < 12; index++)
        {
            if (_configuringLine.ParameterManual[index]) continue;
            var formula = ConfiguredType.ParameterFormulas.ElementAtOrDefault(index);
            if (DemoParameterFormula.TryEvaluate(formula, _configuringLine, out var result))
                _configuringLine.ParameterValues[index] = result;
        }
    }
    private void SetParameter(int index, string value)
    {
        if (_configuringLine is null) return;
        _configuringLine.ParameterValues[index] = value.Trim();
        _configuringLine.ParameterManual[index] = true;
    }
    private void ActivateParameter(int index)
    {
        if (_configuringLine is not null) _configuringLine.ParameterManual[index] = true;
    }
    private void UpdateColour(ChangeEventArgs e)
    {
        if (_configuringLine is null) return;
        var code = e.Value?.ToString()?.Trim() ?? "";
        var match = ConfiguredColours.FirstOrDefault(x => x.Code.Equals(code, StringComparison.OrdinalIgnoreCase));
        _configuringLine.ColourCode = match?.Code ?? code;
        _configuringLine.ColourId = match?.Id;
    }
    private void OpenPaymentSheet()
    {
        if (_order is null) return;
        _paymentMethod = "Bank transfer";
        _paymentDate = Today.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture);
        _paymentAmount = Math.Max(0, _order.Debt);
        _paymentReference = "";
        _paymentParty = "";
        _paymentNote = "";
        _paymentError = "";
        _paymentSheetOpen = true;
    }
    private void ClosePaymentSheet() => _paymentSheetOpen = false;
    private void AddPayment()
    {
        if (_order is null) return;
        if (_paymentAmount <= 0 || !DateOnly.TryParseExact(_paymentDate, "yyyy-MM-dd", CultureInfo.InvariantCulture, DateTimeStyles.None, out var date))
        {
            _paymentError = L["Payment.ValidDateAmount"].Value;
            return;
        }
        if ((_paymentMethod is "Via PPK" or "Bank transfer") && string.IsNullOrWhiteSpace(_paymentReference)
            || (_paymentMethod is "Cash desk" or "EKA register") && string.IsNullOrWhiteSpace(_paymentParty))
        {
            _paymentError = L["Payment.RequiredReference"].Value;
            return;
        }
        _order.Payments.Add(new DemoPayment
        {
            Date = date, Method = _paymentMethod, Amount = _paymentAmount,
            Reference = _paymentReference.Trim(), ReceiverOrRegister = _paymentParty.Trim(), Note = _paymentNote.Trim()
        });
        _paymentSheetOpen = false;
    }
    private void OpenAccessoryPicker(DemoOrderLine? parent)
    {
        ResetPicker();
        _attachedTo = parent;
        _pickerMode = "accessory";
    }
    private void ResetPicker()
    {
        _pickerError = "";
        _catalogSearch = "";
        _accessorySearch = "";
        _selectedCategoryId = 0;
        _selectedAccessoryId = 0;
        _quantity = 1;
        _price = 0;
    }
    private void SelectCategory(int id)
    {
        _selectedCategoryId = id;
        _pickerError = "";
    }
    private void SelectAccessory(int id)
    {
        _selectedAccessoryId = id;
        _price = SelectedAccessory?.Price ?? 0;
        if (_attachedTo is not null && SelectedAccessory is not null)
        {
            var width = _attachedTo.WidthMm / 1000m;
            var height = _attachedTo.HeightMm / 1000m;
            _quantity = SelectedAccessory.Unit switch
            {
                "1m pločio" => width * _attachedTo.Quantity,
                "1m aukščio" => height * _attachedTo.Quantity,
                "vnt" => _attachedTo.Quantity,
                "kvm" => width * height * _attachedTo.Quantity,
                _ => 1m
            };
            if (_quantity <= 0) _quantity = 1;
        }
        _pickerError = "";
    }
    private void AddLine()
    {
        if (_order is null) return;
        if (_quantity <= 0 || _price < 0)
        {
            _pickerError = L["Product.PositiveQuantityPrice"].Value;
            return;
        }
        if (SelectedAccessory is not null)
        {
            var line = new DemoOrderLine
            {
                Kind = "Priedai", TypeId = SelectedAccessory.Id,
                Category = "Priedai", Name = SelectedAccessory.Name,
                Unit = SelectedAccessory.Unit, Quantity = _quantity, Price = _price,
                Discountable = _attachedTo is not null
            };
            if (_attachedTo is null) _order.Lines.Add(line);
            else _attachedTo.Accessories.Add(line);
        }
        else
        {
            _pickerError = L["Product.ChoosePriedai"].Value;
            return;
        }
        ClosePicker();
    }

    private void RemoveLine(DemoOrderLine line) => _order?.Lines.Remove(line);
    private static void RemoveAccessory(DemoOrderLine parent, DemoOrderLine accessory) => parent.Accessories.Remove(accessory);
    private void ClosePicker()
    {
        _pickerMode = null;
        _attachedTo = null;
    }
    private Task CloseAsync() => OnClose.InvokeAsync();
    public async Task HandleEscapeAsync()
    {
        if (_pickerMode is not null) ClosePicker();
        else if (_paymentSheetOpen) ClosePaymentSheet();
        else if (_configuringLine is not null) CloseConfigurator();
        else if (_selectingProduct) CloseProductPicker();
        else await CloseAsync();
        await InvokeAsync(StateHasChanged);
    }
    private string DisplayDuty(string value) => value switch
    {
        "Konsultantas" => L["Workspace.DutyConsultant"].Value, "Vadybininkas" => L["Workspace.DutyManager"].Value,
        "Matuotojas" => L["Workspace.DutyMeasurer"].Value, "Montuotojas" => L["Workspace.DutyInstaller"].Value,
        "Transportas" => L["Workspace.DutyTransport"].Value, _ => value
    };
    private string DisplayPaymentMethod(string value) => value switch
    {
        "Via PPK" => L["Payment.ViaPpk"].Value, "Bank transfer" => L["Payment.BankTransfer"].Value,
        "Cash desk" => L["Payment.CashDesk"].Value, "EKA register" => L["Payment.Register"].Value, _ => value
    };
    private string DisplayControl(string value) => value switch
    {
        "Chain left" => L["Product.ChainLeft"].Value, "Chain right" => L["Product.ChainRight"].Value,
        "Motor" => L["Product.Motor"].Value, "Other" => L["Product.Other"].Value, _ => value
    };
    private string DisplayUnit(string value) => value == "pcs" ? L["Product.Pieces"].Value : value;
    private static string Display(string value) => string.IsNullOrWhiteSpace(value) ? "—" : value;
}
