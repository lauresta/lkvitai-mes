                            <div class="demo-receipt__row"><span>@(IsLive ? "Product (saved)" : "Product")</span><strong class="mono">@OrderFormat.Money(IsLive ? _configuringLine.ServerAmount ?? 0 : _configuringLine.Quantity * _configuringLine.Price)</strong></div>
