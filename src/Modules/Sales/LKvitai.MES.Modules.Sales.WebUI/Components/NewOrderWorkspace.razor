                        <button class="btn btn--ghost" type="button" disabled="@(!IsLive || !_configuringLine.CanEdit || !_order.WritesAllowed)" @onclick="DuplicateLiveProductAsync">Duplicate</button>
                        <button class="btn btn--ghost" type="button" disabled="@(!IsLive)" @onclick="RefreshLiveProductAsync">Refresh</button>
