                                    </div>
                                }
                                <div class="demo-product-editor__dimensions">
                                    @if (_configuringLine.Kind == "Product")
                                    {
                                        <div><label class="demo-label" for="config-width">@L["Common.Width"]</label><div class="lk-stepper @(InvalidWidth ? "is-invalid" : "")"><button type="button" aria-label="@L["Product.DecreaseWidth"]" @onclick="() => StepWidth(-10)">−</button><input id="config-width" type="number" min="200" step="10" @bind="_configuringLine.WidthMm" @bind:event="oninput" @bind:after="RecalculateConfiguredParameters" /><span class="unit">mm</span><button type="button" aria-label="@L["Product.IncreaseWidth"]" @onclick="() => StepWidth(10)">+</button></div>@if (InvalidWidth) { <div class="lk-field-error">@L["Preview.MinimumWidth"]</div> }</div>
                                        <div><label class="demo-label" for="config-height">@L["Common.Height"]</label><div class="lk-stepper @(InvalidHeight ? "is-invalid" : "")"><button type="button" aria-label="@L["Product.DecreaseHeight"]" @onclick="() => StepHeight(-10)">−</button><input id="config-height" type="number" min="200" step="10" @bind="_configuringLine.HeightMm" @bind:event="oninput" @bind:after="RecalculateConfiguredParameters" /><span class="unit">mm</span><button type="button" aria-label="@L["Product.IncreaseHeight"]" @onclick="() => StepHeight(10)">+</button></div>@if (InvalidHeight) { <div class="lk-field-error">@L["Preview.MinimumHeight"]</div> }</div>
                                    }
                                    <div><label class="demo-label" for="config-quantity">@L["Common.Quantity"]</label><div class="lk-stepper"><button type="button" aria-label="@L["Product.DecreaseQuantity"]" @onclick="() => StepQuantity(-1)">−</button><input id="config-quantity" type="number" min="@(_configuringLine.Kind == "Product" ? "1" : "0.001")" step="@(_configuringLine.Kind == "Product" ? "1" : "0.001")" @bind="_configuringLine.Quantity" @bind:event="oninput" @bind:after="RecalculateConfiguredParameters" /><span class="unit">@DisplayUnit(_configuringLine.Unit)</span><button type="button" aria-label="@L["Product.IncreaseQuantity"]" @onclick="() => StepQuantity(1)">+</button></div></div>
                                </div>
                                <div class="demo-product-editor__secondary @(_configuringLine.Kind == "Product" ? "" : "demo-product-editor__secondary--service")">
                                    @if (_configuringLine.Kind == "Product")
                                    {
                                        <div><label class="demo-label" for="config-colour">@L["Product.ColourFabric"]</label><div class="lk-fabric"><span class="swatch" aria-hidden="true"></span><input id="config-colour" list="demo-colour-codes" class="mono" value="@_configuringLine.ColourCode" @onchange="UpdateColour" placeholder="@L["Preview.SearchFabric"]" autocomplete="off" /><span class="name">@ConfiguredColour?.Name</span><span class="stock">@L["Preview.StockLater"]</span></div><datalist id="demo-colour-codes">@foreach (var colour in ConfiguredColours) { <option value="@colour.Code">@colour.Name</option> }</datalist></div>
