    [JSInvokable]
    public async Task SelectProductTypeByShortcut(int number)
    {
        if (!_selectingProduct || number is < 1 or > 9) return;
        var type = PickerOrderedTypes.ElementAtOrDefault(number - 1);
        if (type is not null && (!IsLive || type.UnsupportedReason is null)) await CreateProductFromType(type);
        await InvokeAsync(StateHasChanged);
    }

    [JSInvokable]
    public Task MoveProductCategoryByShortcut(int direction)
    {
        if (!_selectingProduct || direction is not (-1 or 1)) return Task.CompletedTask;
        var categories = PickerOrderedCategories;
        if (categories.Count == 0) return Task.CompletedTask;
        var index = categories.ToList().FindIndex(x => x.Id == _selectedCategoryId);
        SelectCategory(categories[Math.Clamp(index + direction, 0, categories.Count - 1)].Id);
        return InvokeAsync(StateHasChanged);
    }

    [JSInvokable]
    public Task CloseProductPickerByShortcut()
    {
        if (!_selectingProduct) return Task.CompletedTask;
        CloseProductPicker();
        return InvokeAsync(StateHasChanged);
    }

