@using System.Globalization
@using System.Text.Json
@implements IAsyncDisposable
@inject IJSRuntime JS
@inject LKvitai.MES.BuildingBlocks.WebUI.Services.IBuildVersionAccessor BuildVersion
@using LKvitai.MES.Modules.Sales.Contracts.OrderEntry
<NavigationLock ConfirmExternalNavigation="@(IsLive && (HeaderDirty || ProductDirty || AddressDirty || PaymentDirty || ConfirmationDirty || Entry.HasPendingCommand))" OnBeforeInternalNavigation="GuardNavigationAsync" />

<div class="demo-layer" role="dialog" aria-modal="true" aria-label="@L["Workspace.OrderEntry"].Value" @ref="_layerElement">
    @if (_loading)
    {
        <div class="panel demo-editor__banner" role="status">@L["Workspace.LoadingReferences"].Value</div>
    }
    else if (_loadError is not null)
    {
        <div class="panel demo-editor__banner" role="alert">@_loadError <button class="btn btn--ghost" @onclick="ReloadLiveAsync">@L["Common.Retry"].Value</button><button class="btn btn--ghost" @onclick="CloseAsync">@L["Common.BackToOrders"].Value</button></div>
    }
    else
    {
    <div class="demo-workspace-notifications">
    @if (_busy || IsLive && !_pendingRestored)
    {
        <div class="demo-editor__banner" role="status">@(_busy ? L["Workspace.SavingLoading"].Value : L["Workspace.LoadingSavedInput"].Value)</div>
    }
    @if (!_busy && Entry.HasPendingCommand)
    {
        <div class="demo-editor__banner" role="alert">@L["Recovery.Interrupted"].Value <button class="btn btn--primary" @onclick="RecoverCommandAsync">@L["Recovery.CheckRetry"].Value</button> <button class="btn btn--ghost" @onclick="OpenOtherOrders">@L["Recovery.OtherOrders"].Value</button></div>
    }
    @if(Entry.LegacyPendingId is not null)
    {
        <div class="demo-editor__banner" role="status">@L["Recovery.EarlierNeedsCheck"].Value <button class="btn btn--ghost" disabled="@_busy" @onclick="CheckLegacySaveAsync">@L["Recovery.CheckEarlier"].Value</button></div>
    }
    @if(_legacySaveOutcome is { } earlier)
    {
        <div class="demo-editor__banner" role="status">@L["Recovery.EarlierAvailable"].Value <a href="@($"entry/{earlier.OrderId}")">@L["Recovery.OpenItsOrder"].Value</a></div>
    }
    @foreach(var pending in Entry.OtherPendingSaves)
    {
        <div class="demo-editor__banner" role="status">@L["Recovery.AnotherPending"].Value @if(pending.OrderId is { } orderId){<a href="@($"entry/{orderId}")">@L["Recovery.OpenThatOrder"].Value</a>}else{<button class="btn btn--ghost" @onclick="OpenOtherOrders">@L["Recovery.OpenUnfinished"].Value</button>}</div>
    }
    @if(Entry.PendingRestoreWarning is { } storageWarning){<div class="demo-editor__banner" role="status">@storageWarning</div>}
    @if (!string.IsNullOrEmpty(_noticeText))
    {
        <div @key="_noticeVersion" class="sales-toast sales-toast--@_noticeKind" role="@(_noticeKind == "success" ? "status" : "alert")" aria-atomic="true">
            <span class="sales-toast__icon" aria-hidden="true">@(_noticeKind == "success" ? "✓" : "!")</span>
            <div><strong>@_noticeTitle</strong><p>@_noticeText</p>
                @if(_lastInvalidField is not null && _noticeKind == "error") { <button class="sales-toast__action" type="button" @onclick="FocusProductErrorAsync">@L["Workspace.GoToField"].Value</button> }
            </div>
            <button class="sales-toast__close" type="button" aria-label="@L["Workspace.DismissMessage"].Value" @onclick="DismissNotice">×</button>
        </div>
    }
    </div>
    <fieldset disabled="@(_busy || Entry.HasPendingCommand || IsLive && !_pendingRestored)" style="display:contents">
    @if (_order is null)
    {
        <button class="demo-backdrop" type="button" aria-label="@L["Workspace.CloseNew"].Value" @onclick="CloseAsync"></button>
        <aside class="demo-drawer" aria-labelledby="demo-new-title">
            <div class="demo-drawer__head">
                <div><div class="eyebrow mono">@L["Workspace.SalesOrders"].Value</div><h2 id="demo-new-title">@L["Workspace.NewOrder"].Value</h2></div>
                <button class="demo-icon-button" type="button" aria-label="@L["Common.Close"].Value" @onclick="CloseAsync">×</button>
            </div>
            <div class="demo-drawer__body">
                <p class="demo-notice">@(IsLive ? L["Workspace.LiveEntryHelp"].Value : L["Workspace.SnapshotPreview", Catalog.SnapshotDate].Value)</p>
                <label class="demo-label" for="demo-number">@L["Workspace.OrderNumber"].Value <span class="demo-required">*</span></label>
                <input id="demo-number" class="demo-input mono" value="@_rawNumber" @oninput="OnNumberInput"
                       placeholder="@L["Workspace.NumberExample"].Value" autocomplete="off" aria-describedby="demo-number-help" />
                <div id="demo-number-help" class="demo-help">@L["Workspace.NumberHelp"].Value</div>
                @if (SeriesSuggestions.Count > 0)
                {
                    <div class="demo-suggestions" aria-label="@L["Workspace.MatchingSeries"].Value">
                        @foreach (var suggestion in SeriesSuggestions)
                        {
                            <button type="button" @onclick="() => ChooseSeries(suggestion)">@suggestion<span class="mono">@L["Workspace.Series"].Value</span></button>
                        }
                    </div>
                }
                @if (HasNumberPreview)
                {
                    <div class="demo-number-preview"><span>@L["Workspace.NumberPreview"].Value</span><strong class="mono">@PreviewNumber</strong></div>
                }
                else if (!string.IsNullOrWhiteSpace(_rawNumber) && _numberTouched)
                {
                    <div class="demo-field-error" role="alert">@NumberError</div>
                }
                @if (!string.IsNullOrWhiteSpace(_lastAutofilledSeries))
                {
                    <div class="demo-help">@L["Workspace.SeriesDefaults", _lastAutofilledSeries].Value</div>
                }

                <div class="demo-form-grid">
                    <div>
                        <label class="demo-label" for="demo-customer">@L["Common.Customer"].Value <span class="demo-required">*</span></label>
                        @if (IsLive) { @ReferenceSelect("demo-customer", Catalog.Customers, _customerId, value => { _customerId=value; _customer=ReferenceName(Catalog.Customers,value); }, existingLabel: _customer) } else { <input id="demo-customer" class="demo-input" @bind="_customer" placeholder="@L["Workspace.CustomerName"].Value" /> }
                    </div>
                    <div>
                        <label class="demo-label" for="demo-store">@L["Workspace.Store"].Value <span class="demo-required">*</span></label>
                        @if (IsLive) { @ReferenceSelect("demo-store", Catalog.Stores, _storeId, value => { _storeId=value; _store=ReferenceName(Catalog.Stores,value); }, existingLabel: _store) } else { <input id="demo-store" class="demo-input" @bind="_store" placeholder="@L["Workspace.StoreBranch"].Value" /> }
                    </div>
                    <div>
                        <label class="demo-label" for="demo-manager">@L["Common.Manager"].Value</label>
                        @if (IsLive) { @ReferenceSelect("demo-manager", Catalog.Employees, _managerId, value => { _managerId=value; _manager=ReferenceName(Catalog.Employees,value); }, existingLabel: _manager) } else { <input id="demo-manager" class="demo-input" @bind="_manager" placeholder="@L["Common.Manager"].Value" /> }
                    </div>
                    <div>
                        <label class="demo-label" for="demo-consultant">@L["Common.Consultant"].Value</label>
                        @if (IsLive) { @ReferenceSelect("demo-consultant", Catalog.Employees, _consultantId, value => { _consultantId=value; _consultant=ReferenceName(Catalog.Employees,value); }, existingLabel: _consultant) } else { <input id="demo-consultant" class="demo-input" @bind="_consultant" placeholder="@L["Common.Consultant"].Value" /> }
                    </div>
                    <div>
                        <label class="demo-label" for="demo-date">@L["Common.OrderDate"].Value</label>
                        <input id="demo-date" type="date" class="demo-input mono" value="@_date" @onchange="e => _date = e.Value?.ToString() ?? _date" />
                    </div>
                    <div>
                        <label class="demo-label" for="demo-due">@L["Common.DueDate"].Value</label>
                        <input id="demo-due" type="date" class="demo-input mono" value="@_due" @onchange="e => _due = e.Value?.ToString() ?? _due" />
                    </div>
                </div>
                @if (!string.IsNullOrWhiteSpace(_formError))
                {
                    <div class="demo-field-error demo-field-error--block" role="alert">@_formError</div>
                }
            </div>
            <div class="demo-drawer__foot">
                <button class="btn btn--ghost" type="button" @onclick="CloseAsync">@L["Common.Cancel"].Value</button>
                <button class="btn btn--primary" type="button" @onclick="CreateDraft">@(IsLive ? L["Workspace.CreateOpen"].Value : L["Workspace.CreateDraftOpen"].Value)</button>
            </div>
        </aside>
    }
    else
    {
        <div class="demo-editor order-workspace">
            @if (!_selectingProduct && _configuringLine is null)
            {
                <CustomerPrivacyNotice IsRestricted="IsPrivacyRestricted" OnBack="CloseAsync" />
            }
            <header class="order-head">
                <strong class="order-head__number mono">@_order.Number</strong>
                <span class="chip chip--entered">@(IsLive ? _order.StateName : L["Workspace.StageEntered"].Value)</span>
                @if (OrderStepIndex > 0) { <span class="order-head__next mono">@L["Order.NextState", OrderStepIndex, NextOrderState].Value</span> }
                @if (IsLive && (HeaderDirty || ProductDirty || AddressDirty)) { <span class="order-head__dirty">@L["Workspace.UnsavedChanges"].Value</span> }
                <div class="order-head__actions">
                    <button class="btn btn--ghost" type="button" @onclick="CloseAsync">@(IsLive ? L["Common.BackToOrders"].Value : L["Workspace.DiscardReturn"].Value)</button>
                    @if (IsLive) { <button class="btn btn--ghost order-head__cancel" type="button" disabled="@(!_order.WritesAllowed || _order.Cancelled || _order.StateId is not (4 or 7) || _order.CancellationUnavailableReason is not null)" title="@ApiMessage(_order.CancellationUnavailableReason)" @onclick="CancelLiveOrderAsync">@L["Workspace.CancelOrder"].Value</button> }
                </div>
            </header>
            <div class="order-grid">
                <aside class="order-context">
                    <section class="order-card" aria-labelledby="order-people-title">
                        <div class="order-card__head"><h2 id="order-people-title">@L["Workspace.PeopleDates"].Value</h2><button type="button" @onclick='() => OpenOrderDrawer("people")'>@L["Common.Edit"].Value</button></div>
                        <dl class="order-card__facts">
                            <dt>@L["Common.Customer"].Value</dt><dd title="@_order.Customer">@DisplayContext(_order.Customer)</dd>
                            <dt>@L["Workspace.Store"].Value</dt><dd title="@_order.Store">@DisplayContext(_order.Store)</dd>
                            <dt>@L["Common.Manager"].Value</dt><dd title="@_order.Manager">@DisplayContext(_order.Manager)</dd>
                            <dt>@L["Common.Consultant"].Value</dt><dd class="@(string.IsNullOrWhiteSpace(_order.Consultant) ? "order-card__missing" : "")" title="@_order.Consultant">@(string.IsNullOrWhiteSpace(_order.Consultant) ? L["Order.Unspecified"].Value : _order.Consultant)</dd>
                            <dt>@L["Common.OrderDate"].Value</dt><dd class="mono">@OrderFormat.Date(_order.Date)</dd>
                            <dt>@L["Common.DueDate"].Value</dt><dd class="mono">@OrderFormat.Date(_order.Due)</dd>
                            <dt>@L["Workspace.MountingDate"].Value</dt><dd class="mono">@(_order.MountingDate is { } mountingDate ? OrderFormat.Date(mountingDate) : "—")</dd>
                            <dt>@L["Workspace.Priority"].Value</dt><dd>@DisplayPriority</dd>
                        </dl>
                    </section>
                    <section class="order-card @(HasOrderAddress ? "" : "order-card--empty")" aria-labelledby="order-address-title">
                        <div class="order-card__head"><h2 id="order-address-title">@L["Common.Address"].Value</h2><button type="button" @onclick='() => OpenOrderDrawer("address")'>@(HasOrderAddress ? L["Common.Edit"].Value : L["Common.Add"].Value)</button></div>
                        @if (HasOrderAddress)
                        {
                            <div class="order-card__address"><strong>@_order.Street @_order.Building@(!string.IsNullOrWhiteSpace(_order.Flat) ? "-" + _order.Flat : "")</strong><span>@_order.City</span><span class="mono">@_order.Phone</span></div>
                        }
                        else { <p>@L["Order.AddressEmpty"].Value</p> }
                    </section>
                    <section class="order-card" aria-labelledby="order-employees-title">
                        <div class="order-card__head"><h2 id="order-employees-title">@L["Workspace.ResponsibleEmployees"].Value</h2><button type="button" @onclick='() => OpenOrderDrawer("employees")'>@L["Common.Add"].Value</button></div>
                        @foreach (var employee in _order.Employees)
                        {
                            <div class="order-card__employee"><span><strong>@DisplayDuty(employee.Duty)</strong> — @employee.Name <small class="mono">@OrderFormat.Date(employee.Date)</small></span><button class="demo-small-remove" type="button" disabled="@(IsLive && !_order.WritesAllowed)" title="@L["Workspace.RemoveAssignment"].Value" @onclick="() => RemoveEmployeeAsync(employee)">×</button></div>
                        }
                    </section>
                    @if (!IsPrivacyRestricted)
                    {
                        <section class="order-card order-card--note" aria-labelledby="order-note-title">
                            <div class="order-card__head"><h2 id="order-note-title">@L["Common.Note"].Value</h2><button type="button" @onclick='() => OpenOrderDrawer("history")'>@L["Order.NoteHistory", _order.NoteHistory.Count].Value</button></div>
                            <textarea class="demo-textarea" maxlength="128" readonly="@(IsLive && (!_order.CanEdit || !_order.WritesAllowed))" @bind="_order.Note" placeholder="@L["Workspace.OrderNote"].Value"></textarea>
                        </section>
                    }
                </aside>
                <section class="panel order-lines" aria-labelledby="order-lines-title">
                    <div class="panel__head order-lines__head"><div><h2 id="order-lines-title">@L["Workspace.ProductsServices"].Value</h2><span>@L["Order.LinesAndPieces", _order.Lines.Count, _order.Lines.Sum(x => x.Quantity)].Value</span></div>
                        <div class="demo-panel__actions"><button class="btn btn--ghost" type="button" disabled="@(IsLive && (!_order.WritesAllowed || _order.Cancelled))" @onclick="() => OpenAccessoryPicker(null)">@L["Workspace.AddPriedai"].Value</button><button class="btn btn--primary" type="button" disabled="@(IsLive && (!_order.WritesAllowed || _order.Cancelled))" @onclick="OpenProductPicker" aria-keyshortcuts="N">@L["Workspace.AddProductService"].Value</button></div>
                    </div>
                    @if (_order.Lines.Count == 0) { <div class="demo-empty order-lines__empty">@L["Workspace.NoLines"].Value</div> }
                    else
                    {
                        <div class="order-lines__scroll"><table class="lk-table order-lines__table"><colgroup><col class="order-lines__index"/><col class="order-lines__product"/><col class="order-lines__parameters"/><col class="order-lines__qty"/><col class="order-lines__price"/><col class="order-lines__amount"/><col class="order-lines__actions"/></colgroup>
                            <thead><tr><th>#</th><th>@L["Workspace.Item"].Value</th><th>@L["Common.Details"].Value</th><th class="is-num">@L["Workspace.Qty"].Value</th><th class="is-num">@L["Common.Price"].Value</th><th class="is-num">@L["Common.Amount"].Value</th><th></th></tr></thead>
                            <tbody>
                            @for (var index = 0; index < _order.Lines.Count; index++)
                            {
                                var line = _order.Lines[index]; var lineNumber = index + 1;
                                <tr class="order-lines__row"><td class="mono order-lines__number">@lineNumber</td><td><div class="demo-line-name"><div class="demo-line-sketch"><CategoryIcon Category="@line.Category" /></div><div class="order-lines__product-text"><button class="demo-line-open" type="button" @onclick="() => OpenConfigurator(line)">@line.Name ↗</button><small>@line.Category</small></div></div></td>
                                <td class="mono order-lines__params">@LineParameterSummary(line)</td>
                                <td class="is-num"><input class="demo-table-input mono" readonly="@IsLive" type="number" min="0.001" step="0.001" aria-label="@L["Product.QuantityFor", line.Name].Value" @bind="line.Quantity" /></td>
                                <td class="is-num"><input class="demo-table-input mono" readonly="@IsLive" type="number" min="0" step="0.01" aria-label="@L["Product.PriceFor", line.Name].Value" @bind="line.Price" /></td>
                                <td class="is-num mono order-lines__sum">@OrderFormat.Money(IsLive ? line.ServerAmount ?? line.Quantity * line.Price : line.Quantity * line.Price)</td>
                                <td class="demo-line-actions">@if (line.Kind == "Product") { <button type="button" title="@L["Product.AddToProduct"].Value" disabled="@(IsLive && (!line.CanEdit || !_order.WritesAllowed))" @onclick="() => OpenAccessoryPicker(line)">+</button> }<button type="button" title="@L["Workspace.RemoveLine"].Value" disabled="@(IsLive && (!line.CanDelete || !_order.WritesAllowed))" @onclick="() => RemoveLine(line)">×</button></td></tr>
                                @foreach (var accessory in line.Accessories)
                                {
                                    <tr class="order-lines__acc"><td></td><td>@if (IsLive) { <button type="button" class="demo-line-open" @onclick="() => EditAccessoryAsync(line, accessory)">↳ @accessory.Name</button> } else { <span>↳ @accessory.Name</span> }</td><td class="mono">@L["Order.AccessoryToLine", lineNumber].Value · @accessory.Unit</td><td class="is-num"><input class="demo-table-input mono" readonly="@IsLive" type="number" min="0.001" step="0.001" aria-label="@L["Product.QuantityFor", accessory.Name].Value" @bind="accessory.Quantity" /></td><td class="is-num"><input class="demo-table-input mono" readonly="@IsLive" type="number" min="0" step="0.01" aria-label="@L["Product.PriceFor", accessory.Name].Value" @bind="accessory.Price" /></td><td class="is-num mono">@OrderFormat.Money(accessory.Quantity * accessory.Price)</td><td class="demo-line-actions"><button type="button" title="@L["Product.RemoveAccessory"].Value" disabled="@(IsLive && (!line.CanEdit || !_order.WritesAllowed))" @onclick="() => RemoveAccessory(line, accessory)">×</button></td></tr>
                                }
                            }
                            </tbody></table></div>
                    }
                </section>
                <aside class="order-side"><section class="panel demo-receipt">
                    <div class="panel__head"><h2>@L["Workspace.Receipt"].Value</h2><span>@(IsLive ? L["Workspace.LegacyAmount"].Value : L["Workspace.PreviewAmount"].Value)</span></div>
                    <div class="demo-receipt__row"><span>@L["Workspace.BeforeDiscount"].Value</span><strong class="mono">@OrderFormat.Money(_order.BeforeDiscount)</strong></div>
                    <div class="demo-receipt__row"><span>@L["Workspace.Discountable"].Value</span><strong class="mono">@OrderFormat.Money(_order.DiscountableAmount)</strong></div>
                    <div class="demo-receipt__discount">
                        <div class="order-discount-grid">
                            <div><label class="demo-label" for="receipt-discount">@L["Order.DiscountShort"].Value</label><input id="receipt-discount" readonly="@(IsLive && (!_order.CanEdit || !_order.WritesAllowed))" type="number" min="-100" max="100" step="0.01" class="demo-input mono" @bind="_order.DiscountPercent" @bind:after="NormalizeDiscount" /></div>
                            <div><label class="demo-label" for="receipt-fixed-price">@L["Order.FixedPriceShort"].Value</label><input id="receipt-fixed-price" readonly="@(IsLive && (!_order.CanEdit || !_order.WritesAllowed))" title="@L["Workspace.SetFinalPrice"].Value" type="number" min="0" step="0.01" class="demo-input mono" value="@(_finalPriceInput ?? _order.Total.ToString("0.00", CultureInfo.InvariantCulture))" @onchange="SetFixedPrice" /></div>
                        </div>
                        @if (!string.IsNullOrWhiteSpace(_discountError)) { <div class="demo-field-error">@_discountError</div> }
                    </div>
                    <div class="demo-receipt__row"><span>@(_order.DiscountPercent < 0 ? L["Workspace.Markup"].Value : L["Workspace.Discount"].Value)</span><strong class="mono">@OrderFormat.Money(Math.Abs(_order.DiscountAmount))</strong></div>
                    <div class="demo-receipt__row demo-receipt__row--total"><span>@L["Common.Total"].Value</span><strong class="mono">@OrderFormat.Money(_order.Total)</strong></div>
                    <div class="demo-receipt__row"><span>@L["Common.Paid"].Value</span><strong class="mono">@OrderFormat.Money(_order.Paid)</strong></div>
                    <div class="demo-receipt__row"><span>@L["Common.Debt"].Value</span><strong class="mono">@OrderFormat.Money(_order.Debt)</strong></div>
                    <button class="btn btn--primary" type="button" disabled="@(IsLive && !_order.WritesAllowed)" @onclick="SavePreview">@(IsLive ? L["Workspace.SaveOrder"].Value : L["Workspace.SaveDraft"].Value)</button>
                    <p class="order-save-help">@(IsLive ? (_order.WritesAllowed ? L["Workspace.SaveHelp"].Value : L["Workspace.ReadOnlyTest"].Value) : L["Workspace.DraftHelp"].Value)</p>
                    @if (!string.IsNullOrWhiteSpace(_saveMessage)) { <div class="demo-save-message @(_saveIsError ? "demo-save-message--error" : "")" role="status">@_saveMessage</div> }
                    <button class="btn btn--ghost" type="button" disabled="@(!CanConfirmLiveProducts)" title="@(!CanConfirmLiveProducts ? L["Confirmation.Unavailable"].Value : null)" @onclick="OpenConfirmationAsync">@L["Confirmation.ConfirmProduction"].Value</button>
                </section><section class="panel order-payments">                    <div class="demo-receipt__payments">
                        <div><strong>@L["Common.Payments"].Value</strong><button class="btn btn--ghost" type="button" disabled="@(IsLive && !CanPostLivePayment)" title="@(IsLive && !CanPostLivePayment ? L["Payment.UnavailableOrder"].Value : null)" @onclick="OpenPaymentSheet">@L["Payment.AddNew"].Value</button></div>
                        @if (_order.Payments.Count == 0)
                        {
                            <p>@(IsLive ? L["Payment.NoRecorded"].Value : L["Payment.NoDraft"].Value)</p>
                        }
                        @foreach (var payment in _order.Payments)
                        {
                            <div class="demo-payment-row"><span>@DisplayPaymentMethod(payment.Method)<br /><small class="mono">@(payment.HasDate ? OrderFormat.Date(payment.Date) : "—") · @payment.Reference @payment.ReceiverOrRegister</small></span><strong class="mono">@(IsLive ? payment.Amount.ToString("N2",CultureInfo.GetCultureInfo("lt-LT")) + " " + payment.CurrencyCode : OrderFormat.Money(payment.Amount))</strong>@if(!IsLive) { <button class="demo-small-remove" type="button" title="@L["Payment.Remove"].Value" @onclick="() => _order.Payments.Remove(payment)">×</button> }</div>
                        }
                    </div>
                </section></aside>
            </div>
            @if (_orderDrawer is not null)
            {
                <button class="order-drawer-backdrop" type="button" aria-label="@L["Common.Close"].Value" @onclick="CloseOrderDrawer"></button>
                <aside class="demo-drawer order-drawer" role="dialog" aria-modal="true" aria-labelledby="order-drawer-title" @ref="_orderDrawerElement">
                    <div class="demo-drawer__head"><h2 id="order-drawer-title">@OrderDrawerTitle</h2><button class="demo-icon-button" type="button" aria-label="@L["Common.Close"].Value" @onclick="CloseOrderDrawer">×</button></div>
                    <div class="demo-drawer__body">
                        @if (_orderDrawer == "people")
                        {
<section class="panel demo-panel demo-reference-panel">
                        <div class="panel__head"><h2>@L["Workspace.PeopleDates"].Value</h2><span>@L["Workspace.EditableFields"].Value</span></div>
                        <div class="demo-panel__body demo-summary-grid">
                            <div><label class="demo-label" for="edit-customer">@L["Common.Customer"].Value</label>@if (IsLive) { @ReferenceSelect("edit-customer", Catalog.Customers, _order.CustomerId, value => { _order.CustomerId=value; _order.Customer=ReferenceName(Catalog.Customers,value); }, !_order.CanEdit || !_order.WritesAllowed, _order.Customer) } else { <input id="edit-customer" class="demo-input" @bind="_order.Customer" /> }</div>
                            <div><label class="demo-label" for="edit-manager">@L["Common.Manager"].Value</label>@if (IsLive) { @ReferenceSelect("edit-manager", Catalog.Employees, _order.ManagerId, value => { _order.ManagerId=value; _order.Manager=ReferenceName(Catalog.Employees,value); }, !_order.CanEdit || !_order.WritesAllowed, _order.Manager) } else { <input id="edit-manager" class="demo-input" @bind="_order.Manager" /> }</div>
                            <div><label class="demo-label" for="edit-store">@L["Workspace.Store"].Value</label>@if (IsLive) { @ReferenceSelect("edit-store", Catalog.Stores, _order.StoreId, value => { _order.StoreId=value; _order.Store=ReferenceName(Catalog.Stores,value); }, !_order.WritesAllowed, _order.Store) } else { <input id="edit-store" class="demo-input" @bind="_order.Store" /> }</div>
                            <div><label class="demo-label" for="edit-consultant">@L["Common.Consultant"].Value</label>@if (IsLive) { @ReferenceSelect("edit-consultant", Catalog.Employees, _order.ConsultantId, value => { _order.ConsultantId=value; _order.Consultant=ReferenceName(Catalog.Employees,value); }, !_order.CanEdit || !_order.WritesAllowed, _order.Consultant) } else { <input id="edit-consultant" class="demo-input" @bind="_order.Consultant" /> }</div>
