                                        <div><label class="demo-label" for="config-height">Height</label><div class="lk-stepper @ProductFieldClass("height") @(InvalidHeight ? "is-invalid" : "")"><button type="button" tabindex="-1" aria-label="Decrease height" @onclick="() => StepHeight(-10)">−</button><input id="config-height" type="text" inputmode="decimal" data-select-on-focus aria-invalid="@(ProductError("height") is not null ? "true" : "false")" aria-describedby="config-height-error" min="@(IsLive ? 1 : 200)" step="10" @bind="_configuringLine.HeightMm" @bind:culture="CultureInfo.InvariantCulture" @bind:event="oninput" @bind:after="RecalculateConfiguredParameters" /><span class="unit">mm</span><button type="button" tabindex="-1" aria-label="Increase height" @onclick="() => StepHeight(10)">+</button></div>@if (InvalidHeight) { <div class="lk-field-error">Enter a positive height.</div> }@ProductFieldError("height")</div>
                                    }
                                    <div><label class="demo-label" for="config-quantity">Quantity</label><div class="lk-stepper @ProductFieldClass("quantity")"><button type="button" tabindex="-1" aria-label="Decrease quantity" @onclick="() => StepQuantity(-1)">−</button><input id="config-quantity" type="text" inputmode="decimal" data-select-on-focus aria-invalid="@(ProductError("quantity") is not null ? "true" : "false")" aria-describedby="config-quantity-error" min="@(IsLive ? "0.001" : _configuringLine.Kind == "Product" ? "1" : "0.001")" step="@(IsLive ? "0.001" : _configuringLine.Kind == "Product" ? "1" : "0.001")" @bind="_configuringLine.Quantity" @bind:culture="CultureInfo.InvariantCulture" @bind:event="oninput" @bind:after="RecalculateConfiguredParameters" /><span class="unit">@_configuringLine.Unit</span><button type="button" tabindex="-1" aria-label="Increase quantity" @onclick="() => StepQuantity(1)">+</button></div>@ProductFieldError("quantity")</div>
