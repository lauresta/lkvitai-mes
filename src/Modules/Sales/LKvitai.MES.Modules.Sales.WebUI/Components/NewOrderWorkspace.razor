</div>

@code {
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public long? LegacyOrderId { get; set; }

    private ElementReference _layerElement;
    private IJSObjectReference? _draftModule;
    private DotNetObjectReference<NewOrderWorkspace>? _draftReference;
    private bool _historyActive;
    private string? _orderDrawer;
    private ElementReference _orderDrawerElement;
    private bool _orderDrawerFocusPending;
    private bool HasOrderAddress => _order is not null && (_order.StreetId is not null || !string.IsNullOrWhiteSpace(_order.Street) || !string.IsNullOrWhiteSpace(_order.Phone));
    private string DisplayPriority => ReferenceName(_priorities, _order?.PriorityId) is { Length: > 0 } name ? name : _order?.Priority ?? "—";
    private static string DisplayContext(string? value) => string.IsNullOrWhiteSpace(value) ? "—" : value;
    private string OrderDrawerTitle => _orderDrawer switch
    {
        "people" => L["Workspace.PeopleDates"].Value,
        "address" => L["Common.Address"].Value,
        "employees" => L["Workspace.ResponsibleEmployees"].Value,
        "history" => L["Order.NoteHistory", _order?.NoteHistory.Count ?? 0].Value,
        _ => ""
    };
    private int OrderStepIndex => _order is null || _order.Cancelled ? 0 : _order.StateName.Trim().ToUpperInvariant() switch
    {
        "SKIRTINGAI" or "SKIRTINGOS BŪSENOS" or "MIXED" or "DIFFERENT STATES" => 0,
        "PATVIRTINTAS" or "PATVIRTINTAS GAMYBAI" or "APPROVED" => 2,
        "GAMINAMAS" or "IN PRODUCTION" => 3,
        "PAGAMINTAS" or "MADE" => 4,
        "FILIALUI" or "IŠSIŲSTAS Į FILIALĄ" or "SENT TO BRANCH" => 5,
        "ATIDUOTAS" or "IŠDUOTAS KLIENTUI" or "DELIVERED" => 6,
        _ => 1
    };
    private string NextOrderState => OrderStepIndex switch
    {
        1 => L["Workspace.StageConfirmed"].Value,
        2 => L["Workspace.StageManufacturing"].Value,
        3 => L["Workspace.StageManufactured"].Value,
        4 => L["Workspace.StageBranch"].Value,
        5 => L["Workspace.StageDelivered"].Value,
        _ => "—"
    };
    private static string LineParameterSummary(DemoOrderLine line)
    {
        var details = new List<string>();
        if (line.WidthMm > 0 || line.HeightMm > 0) details.Add($"{line.WidthMm} × {line.HeightMm} mm");
        else details.Add(line.Unit);
        if (!string.IsNullOrWhiteSpace(line.ControlType)) details.Add(line.ControlType);
        if (!string.IsNullOrWhiteSpace(line.ColourCode)) details.Add(line.ColourCode);
        return string.Join(" · ", details);
    }
    private void OpenOrderDrawer(string drawer) { _orderDrawer = drawer; _orderDrawerFocusPending = true; }
    private void CloseOrderDrawer() { _orderDrawer = null; _orderDrawerFocusPending = false; }
    private async Task SaveOrderDrawerAsync()
    {
        await SavePreview();
        if (!_saveIsError) CloseOrderDrawer();
    }
    [JSInvokable] public Task CloseOrderDrawerByShortcut()
    {
        CloseOrderDrawer();
        return InvokeAsync(StateHasChanged);
    }
    [JSInvokable] public async Task OpenOrderProductByShortcut()
    {
        if (_order is not null && !_selectingProduct && _configuringLine is null && _orderDrawer is null && (!IsLive || _order.WritesAllowed && !_order.Cancelled)) await OpenProductPicker();
        await InvokeAsync(StateHasChanged);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_loading || _loadError is not null) return;
        if (_draftReference is null)
        {
            _draftReference = DotNetObjectReference.Create(this);
            if (IsLive)
            {
                try { await Entry.RestorePendingAsync(); }
                catch(SalesOrderEntryFailure ex){_liveError=ex.Message;}
                _pendingRestored=true;
                await InvokeAsync(StateHasChanged);
            }
            var moduleVersion = BuildVersion.Get();
            _draftModule = await JS.InvokeAsync<IJSObjectReference>("import", "./js/sales-draft.js?v=" + Uri.EscapeDataString(moduleVersion.GitSha ?? moduleVersion.Version ?? "order-screen-2c"));
            await _draftModule.InvokeVoidAsync("register", _draftReference, _layerElement);
        }
        if (_draftModule is null) return;
        if (_orderDrawerFocusPending && _orderDrawer is not null)
        {
            _orderDrawerFocusPending = false;
            await _draftModule.InvokeVoidAsync("openOrderDrawer", _orderDrawerElement);
        }
        else if (_orderDrawer is null)
        {
            await _draftModule.InvokeVoidAsync("closeOrderDrawer");
        }
        if (_pickerFocusPending && _selectingProduct)
        {
            _pickerFocusPending = false;
            await _catalogSearchElement.FocusAsync();
        }
        await _draftModule.InvokeVoidAsync("updateNoticePosition");
        if (_focusInvalidField is { } invalidField)
        {
            _focusInvalidField=null;
            await _draftModule.InvokeVoidAsync("focusInvalidField", invalidField);
        }
        var productVisible = _selectingProduct || _configuringLine is not null;
        if (productVisible && !_historyActive)
        {
            await _draftModule.InvokeVoidAsync("openProduct");
            _historyActive = true;
        }
        else if (!productVisible && _historyActive)
        {
            _historyActive = false;
            await _draftModule.InvokeVoidAsync("closeProduct");
        }
        if(_paymentFocusReceiver && _paymentSheetOpen && PaymentDownstreamEnabled)
        {
            _paymentFocusReceiver=false;
            await _paymentReceiverElement.FocusAsync();
        }
    }

