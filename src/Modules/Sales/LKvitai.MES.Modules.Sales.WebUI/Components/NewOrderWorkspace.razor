    private void NormalizeDiscount()
    {
        if (_order is null) return;
        _order.DiscountPercent = Math.Clamp(_order.DiscountPercent, -100m, 100m);
        _discountError = "";
    }

    private async Task SetFixedPrice(ChangeEventArgs e)
    {
        if(IsLive){await SetLiveFinalPriceAsync(e);return;}
        if (_order is null) return;
        if (!decimal.TryParse(e.Value?.ToString(), NumberStyles.Number, CultureInfo.InvariantCulture, out var requested)
            || requested < 0 || _order.DiscountableAmount <= 0)
        {
            _discountError = L["Workspace.PriceDiscountable"].Value;
            return;
        }
        var percent = (_order.BeforeDiscount - requested) * 100m / _order.DiscountableAmount;
        if (percent is < -100m or > 100m)
        {
            _discountError = L["Workspace.PriceOverLimit"].Value;
            return;
        }
        _order.DiscountPercent = Math.Round(percent, 2, MidpointRounding.AwayFromZero);
        _discountError = "";
    }

    private async Task SavePreview()
    {
        if (IsLive) { await SaveLiveOrderAsync(); return; }
        if (_order is null) return;
        _saveIsError = true;
        if (string.IsNullOrWhiteSpace(_order.Customer) || string.IsNullOrWhiteSpace(_order.Store))
            _saveMessage = L["Workspace.CustomerStoreRequired"].Value;
        else if (_order.Due < _order.Date)
            _saveMessage = L["Workspace.DueBeforeDate"].Value;
        else if (_order.Lines.Count == 0)
            _saveMessage = L["Workspace.AddLineRequired"].Value;
        else if (_order.Lines.Any(x => x.Quantity <= 0 || x.Price < 0 || x.Kind == "Product" && (x.WidthMm < 200 || x.HeightMm < 200)
                    || x.Accessories.Any(a => a.Quantity <= 0 || a.Price < 0)))
            _saveMessage = L["Workspace.CheckLines"].Value;
        else if (_order.Lines.Any(x => !string.IsNullOrWhiteSpace(x.ColourCode) && x.ColourId is null))
            _saveMessage = L["Product.StaticCodeRequired"].Value;
        else
        {
            _saveIsError = false;
            _saveMessage = L["Workspace.PreviewChecked"].Value;
        }
    }

