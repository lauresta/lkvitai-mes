                        <button class="btn btn--ghost" type="button" disabled title="Warranty handling is outside order entry.">Warranty repair</button>
                        <button class="btn btn--ghost demo-danger-action" type="button" disabled="@(!IsLive || !_configuringLine.CanDelete || !_order.WritesAllowed)" @onclick="() => DeleteLiveProductAsync(_configuringLine)">Delete</button>
