                                    <div><label class="demo-label" for="config-price">@L["Common.Price"]</label><div class="lk-price"><div class="field"><input id="config-price" type="number" min="0" step="0.01" @bind="_configuringLine.Price" @bind:event="oninput" placeholder="@L["Product.PriceFocus"]" /><span>€</span></div><button class="btn btn--ghost" type="button" disabled title="@L["Preview.Milestone2"]">@L["Product.FromPriceList"]</button><span class="hint">@L["Preview.PriceLater"]</span></div></div>
                                </div>
                                @if (_configuringLine.Kind == "Product" && !string.IsNullOrWhiteSpace(_configuringLine.ColourCode) && _configuringLine.ColourId is null)
