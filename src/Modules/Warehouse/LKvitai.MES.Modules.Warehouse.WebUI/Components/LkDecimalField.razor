@typeparam T
@using System.Globalization
@using LKvitai.MES.Modules.Warehouse.WebUI.Infrastructure

<MudTextField T="string"
              Text="@_text"
              TextChanged="OnTextChangedAsync"
              Label="@Label"
              Variant="@Variant"
              Margin="@Margin"
              Placeholder="@Placeholder"
              Disabled="@Disabled"
              Adornment="@Adornment"
              AdornmentText="@AdornmentText"
              InputMode="@(InputMode.@decimal)"
              Error="@(_error is not null)"
              ErrorText="@_error"
              Class="@Class"
              Style="@Style" />

@code {
    private string _text = string.Empty;
    private string? _error;
    private T? _lastValue;
    private bool _initialised;

    [Parameter] public T? Value { get; set; }
    [Parameter] public EventCallback<T?> ValueChanged { get; set; }
    [Parameter] public string? Label { get; set; }
    [Parameter] public string? Placeholder { get; set; }
    [Parameter] public Variant Variant { get; set; } = Variant.Text;
    [Parameter] public Margin Margin { get; set; } = Margin.None;
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public Adornment Adornment { get; set; } = Adornment.None;
    [Parameter] public string? AdornmentText { get; set; }
    [Parameter] public string? Class { get; set; }
    [Parameter] public string? Style { get; set; }
    [Parameter] public decimal? Min { get; set; }
    [Parameter] public decimal? Max { get; set; }
    [Parameter] public string Format { get; set; } = "0.####";

    protected override void OnParametersSet()
    {
        if (!_initialised || !EqualityComparer<T?>.Default.Equals(Value, _lastValue))
        {
            _initialised = true;
            _lastValue = Value;
            _text = FormatValue(Value);
            _error = null;
        }
    }

    private async Task OnTextChangedAsync(string? text)
    {
        _text = text ?? string.Empty;

        if (!DecimalInputParser.TryParse(text, out var parsed))
        {
            _error = L["Common.InvalidNumber"].Value;
            return;
        }

        if (parsed.HasValue && ((Min.HasValue && parsed < Min) || (Max.HasValue && parsed > Max)))
        {
            _error = L["Common.NumberOutOfRange"].Value;
            return;
        }

        _error = null;
        var typed = ToTyped(parsed);
        _lastValue = typed;
        _text = FormatValue(typed);
        await ValueChanged.InvokeAsync(typed);
    }

    private static T? ToTyped(decimal? parsed)
    {
        if (typeof(T) == typeof(decimal))
        {
            return (T)(object)(parsed ?? 0m);
        }

        return (T?)(object?)parsed;
    }

    private string FormatValue(T? value)
    {
        decimal? number = value switch
        {
            decimal d => d,
            null => null,
            _ => null
        };

        if (!number.HasValue)
        {
            return string.Empty;
        }

        if (typeof(T) == typeof(decimal) && number == 0m)
        {
            return 0m.ToString(Format, CultureInfo.CurrentUICulture);
        }

        return number.Value.ToString(Format, CultureInfo.CurrentUICulture);
    }
}
