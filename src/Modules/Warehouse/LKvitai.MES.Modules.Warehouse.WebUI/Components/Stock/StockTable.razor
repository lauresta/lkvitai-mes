<DataTable TItem="AvailableStockItemDto"
           Items="Items"
           TotalCount="TotalCount"
           EmptyMessage="@L["Stock.StockTable.NoStockFoundMatchingFilters"]"
           Columns="@Columns"
           RowTemplate="@RowTemplate" />

@code {
    [Parameter]
    public IReadOnlyList<AvailableStockItemDto> Items { get; set; } = Array.Empty<AvailableStockItemDto>();

    [Parameter]
    public int TotalCount { get; set; }

    private RenderFragment Columns => @<text>
        <th scope="col">@L["Common.Warehouse"]</th>
        <th scope="col">@L["Common.Location"]</th>
        <th scope="col">SKU</th>
        <th scope="col" class="text-end">@L["Stock.StockTable.PhysicalQty"]</th>
        <th scope="col" class="text-end">@L["Stock.StockTable.ReservedQty"]</th>
        <th scope="col" class="text-end">@L["Stock.StockTable.AvailableQty"]</th>
        <th scope="col">@L["Stock.StockTable.LastUpdated"]</th>
    </text>;

    private RenderFragment<AvailableStockItemDto> RowTemplate => item => @<text>
        <td>@item.WarehouseId</td>
        <td>@item.Location</td>
        <td>@item.SKU</td>
        <td class="text-end">@item.PhysicalQty.ToString("N2")</td>
        <td class="text-end">@item.ReservedQty.ToString("N2")</td>
        <td class="text-end">@item.AvailableQty.ToString("N2")</td>
        <td>
            @item.LastUpdated.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss")
            <span class="ms-2"><StaleBadge LastUpdated="item.LastUpdated" /></span>
        </td>
    </text>;
}
