@* Kainų istorija: base / purchase / group price changes; system ids show as "Sistema". *@
<ItemCardPanel Title="@L["AdminItemDetail.PriceHistory"]"
               TestId="admin-item-detail-price-history"
               IsLoading="State.IsLoading"
               Error="State.Error"
               OnRetry="OnRetry"
               OnDismiss="State.ClearError">
    @if (IsEmpty)
    {
        <div class="ic-empty">@L["AdminItemDetail.NoPriceChangesYet"]</div>
    }
    else if (Rows.Count > 0)
    {
        <div class="ic-table-wrap">
            <table class="lk-table ic-table">
                <thead>
                <tr>
                    <th>@L["AdminItemDetail.When"]</th>
                    <th>@L["Common.Type"]</th>
                    <th class="is-num">@L["AdminItemDetail.Old"]</th>
                    <th class="is-num">@L["AdminItemDetail.New"]</th>
                    <th>@L["AdminItemDetail.ChangedBy"]</th>
                    <th>@L["Common.Reason"]</th>
                </tr>
                </thead>
                <tbody>
                @foreach (var row in Rows)
                {
                    <tr data-testid="admin-item-detail-price-history-row">
                        <td class="mono ic-muted-text">@ItemCardFormat.Timestamp(row.ChangedAt)</td>
                        <td>@PriceType(row)</td>
                        <td class="@OldClass(row)">@ItemCardFormat.Money(row.OldAmount)</td>
                        <td class="is-num"><strong>@ItemCardFormat.Money(row.NewAmount)</strong></td>
                        <td>@Actor(row.ChangedBy)</td>
                        <td class="ic-muted-text">@Reason(row)</td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
</ItemCardPanel>

@code {
    [Parameter, EditorRequired] public PanelState<IReadOnlyList<ItemPriceHistoryDto>> State { get; set; } = default!;
    [Parameter] public EventCallback OnRetry { get; set; }

    private IReadOnlyList<ItemPriceHistoryDto> Rows => State.Value ?? Array.Empty<ItemPriceHistoryDto>();

    private bool IsEmpty => State.HasValue && Rows.Count == 0;

    private static string OldClass(ItemPriceHistoryDto row) => row.OldAmount.HasValue ? "is-num" : "is-num ic-muted";

    private static string Reason(ItemPriceHistoryDto row) => string.IsNullOrWhiteSpace(row.Reason) ? ItemCardFormat.Dash : row.Reason;

    private string PriceType(ItemPriceHistoryDto row) => row.PriceType switch
    {
        "Base" => L["AdminItemDetail.BasePrice"].Value,
        "Purchase" => L["AdminItemDetail.PurchasePrice"].Value,
        "GroupOverride" => L["AdminItemDetail.GroupOverride"].Value,
        _ => row.PriceType
    };

    private string Actor(string? actor) => ItemCardErrors.Actor(L, actor);
}
