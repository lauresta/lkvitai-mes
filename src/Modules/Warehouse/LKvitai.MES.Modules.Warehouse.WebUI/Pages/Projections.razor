@page "/projections"
@inject ProjectionsClient ProjectionsClient
@inject ToastService ToastService
@inject IJSRuntime JavaScript
@using System.Diagnostics

<PageTitle>@L["Projections.ProjectionsCikadaMES"]</PageTitle>

<h3>@L["Projections.Projections"]</h3>

@if (_apiError is not null)
{
    <ErrorBanner Message="@BuildErrorMessage(_apiError)"
                 TraceId="@_apiError.TraceId"
                 OnRetry="RetryAsync"
                 OnDismiss="DismissError" />

    <div class="alert alert-warning">
        <div class="d-flex justify-content-between align-items-center">
            <span>@BuildFriendlyHint(_apiError, _lastFailedOperation)</span>
            <button class="btn btn-sm btn-outline-secondary" @onclick="CopyErrorAsync">@L["Projections.CopyError"]</button>
        </div>
    </div>
}

<div class="card shadow-sm mb-3">
    <div class="card-header d-flex justify-content-between align-items-center">
        <span>@L["Projections.ProjectionLag"]</span>
        <button class="btn btn-sm btn-outline-secondary" @onclick="RefreshLagFromToolbarAsync">@L["Common.Refresh"]</button>
    </div>
    <div class="card-body">
        @if (_projectionLag.Count == 0)
        {
            <span class="text-muted">@L["Projections.NoProjectionLagDataAvailable"]</span>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-sm">
                    <thead>
                    <tr>
                        <th>@L["Common.Projection"]</th>
                        <th>@L["Common.Status"]</th>
                        <th>@L["Projections.LagS"]</th>
                        <th>@L["Projections.LagEvents"]</th>
                        <th>@L["Common.LastUpdated"]</th>
                    </tr>
                    </thead>
                    <tbody>
                    @foreach (var row in _projectionLag)
                    {
                        <tr>
                            <td>@row.ProjectionName</td>
                            <td>@WarehouseStatusText.Get(L, row.Status)</td>
                            <td>@(row.LagSeconds?.ToString("0.##") ?? "-")</td>
                            <td>@(row.LagEvents?.ToString() ?? "-")</td>
                            <td>
                                @if (row.LastUpdated.HasValue)
                                {
                                    @row.LastUpdated.Value.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss")
                                    <span class="ms-2"><StaleBadge LagSeconds="@row.LagSeconds" LastUpdated="@row.LastUpdated.Value.UtcDateTime" /></span>
                                }
                                else
                                {
                                    <span class="text-muted">@L["Projections.Unknown"]</span>
                                }
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

<div class="card shadow-sm mb-3">
    <div class="card-header">@L["Projections.RebuildVerify"]</div>
    <div class="card-body">
        <div class="mb-3">
            <label class="form-label">@L["Common.Projection"]</label>
            <select class="form-select" value="@_selectedProjection" @onchange="OnProjectionChanged">
                @foreach (var projection in _projections)
                {
                    <option value="@projection">@projection</option>
                }
            </select>
        </div>

        <div class="d-flex gap-2 mb-3">
            <button class="btn btn-primary" @onclick="OpenRebuildConfirmation" disabled="@_isBusy">
                @L["Projections.Rebuild"]
            </button>
            <button class="btn btn-outline-primary" @onclick="VerifyAsync" disabled="@_isBusy">
                @L["Projections.Verify"]
            </button>
        </div>

        @if (_selectedProjection == "OnHandValue" && _valuePreview is not null)
        {
            <section class="panel p-3 mb-3" data-testid="valuation-rebuild-preview">
                <p>@L["Projections.ValuePreviewExplanation"]</p>
                <div class="table-responsive">
                    <table class="table table-sm">
                        <thead><tr>
                            <th>@L["Common.SKU"]</th><th>@L["Common.Status"]</th>
                            <th>@L["Projections.BeforeQty"]</th><th>@L["Projections.AfterQty"]</th>
                            <th>@L["Projections.BeforeCost"]</th><th>@L["Projections.AfterCost"]</th>
                            <th>@L["Projections.BeforeValue"]</th><th>@L["Projections.AfterValue"]</th>
                        </tr></thead>
                        <tbody>
                        @foreach (var row in _valuePreview.Rows)
                        {
                            <tr><td class="font-monospace">@row.Sku</td><td>@L[$"Projections.Change.{row.Change}"]</td>
                                <td class="font-monospace">@Amount(row.Before?.Qty)</td><td class="font-monospace">@Amount(row.After?.Qty)</td>
                                <td class="font-monospace">@Amount(row.Before?.UnitCost)</td><td class="font-monospace">@Amount(row.After?.UnitCost)</td>
                                <td class="font-monospace">@Amount(row.Before?.TotalValue)</td><td class="font-monospace">@Amount(row.After?.TotalValue)</td></tr>
                        }
                        </tbody>
                    </table>
                </div>
                <AuthorizeView Roles="WarehouseAdmin">
                    <Authorized>
                        <label for="valuation-rebuild-reason" class="form-label">@L["Projections.ApplyReason"]</label>
                        <input id="valuation-rebuild-reason" class="form-control mb-2" maxlength="2000" @bind="_applyReason" @bind:event="oninput" />
                        <button class="btn btn-primary" data-testid="valuation-rebuild-apply" @onclick="ApplyValuePreviewAsync"
                                disabled="@(_isBusy || string.IsNullOrWhiteSpace(_applyReason))">@L["Projections.ApplyPreview"]</button>
                    </Authorized>
                </AuthorizeView>
            </section>
        }
        @if (_valueMessage is not null)
        {
            <p role="status" data-testid="valuation-rebuild-message">@_valueMessage</p>
        }

        @if (_rebuildResult is not null)
        {
            var resultClass = _rebuildResult.ChecksumMatch && _rebuildResult.Swapped
                ? "border-success"
                : "border-danger";

            <div class="card mb-3 @resultClass">
                <div class="card-header">@L["Projections.RebuildResult"]</div>
                <div class="card-body">
                    <dl class="row mb-0">
                        <dt class="col-sm-4">@L["Common.Projection"]</dt>
                        <dd class="col-sm-8">@_rebuildResult.ProjectionName</dd>

                        <dt class="col-sm-4">@L["Projections.EventsProcessed"]</dt>
                        <dd class="col-sm-8">@_rebuildResult.EventsProcessed</dd>

                        <dt class="col-sm-4">@L["Projections.ChecksumMatch"]</dt>
                        <dd class="col-sm-8">@_rebuildResult.ChecksumMatch</dd>

                        <dt class="col-sm-4">@L["Projections.Swapped"]</dt>
                        <dd class="col-sm-8">@_rebuildResult.Swapped</dd>

                        <dt class="col-sm-4">@L["Projections.Duration"]</dt>
                        <dd class="col-sm-8">@_rebuildResult.Duration</dd>
                    </dl>
                </div>
            </div>
        }

        @if (_verifyResult is not null)
        {
            var verifyClass = _verifyResult.ChecksumMatch
                ? "alert-success"
                : "alert-danger";

            <div class="alert @verifyClass mb-0" role="alert">
                <strong>@L["Projections.Verify53ada8"]</strong> ChecksumMatch=@_verifyResult.ChecksumMatch,
                ProductionRows=@_verifyResult.ProductionRowCount,
                ShadowRows=@_verifyResult.ShadowRowCount
            </div>
        }
    </div>
</div>

<div class="card shadow-sm mb-3" data-testid="warehouse-consolidation">
    <div class="card-header">@L["Projections.Consolidation.Title"]</div>
    <div class="card-body">
        <p>@L["Projections.Consolidation.Explanation"]</p>
        <button class="btn btn-outline-primary mb-3" data-testid="warehouse-consolidation-check"
                @onclick="CheckConsolidationAsync" disabled="@_isBusy">@L["Projections.Consolidation.Check"]</button>

        @if (_consolidation is not null)
        {
            <p class="mb-2">@L["Projections.Consolidation.Target"]: <strong class="font-monospace">@_consolidation.TargetWarehouse</strong></p>
            @if (_consolidation.Rows.Count == 0)
            {
                <p class="text-muted" data-testid="warehouse-consolidation-empty">@L["Projections.Consolidation.Nothing"]</p>
            }
            else
            {
                <p>@L["Projections.Consolidation.Summary", MovableCount, _consolidation.Rows.Count - MovableCount]</p>
                <div class="table-responsive">
                    <table class="table table-sm">
                        <thead><tr>
                            <th>@L["Common.Warehouse"]</th><th>@L["Common.Location"]</th><th>SKU</th>
                            <th class="text-end">@L["Common.Quantity"]</th><th>@L["Common.Status"]</th>
                        </tr></thead>
                        <tbody>
                        @foreach (var row in _consolidation.Rows)
                        {
                            <tr>
                                <td class="font-monospace">@row.Warehouse</td>
                                <td class="font-monospace">@row.Location</td>
                                <td class="font-monospace">@row.Sku</td>
                                <td class="text-end font-monospace">@Amount(row.Quantity)</td>
                                <td>
                                    <span class="@ConsolidationChip(row.Status)">@L[$"Projections.Consolidation.Status.{row.Status}"]</span>
                                    @if (row.Reason is not null)
                                    {
                                        <span class="text-muted small ms-1">@L[$"Projections.Consolidation.Reason.{row.Reason}"]</span>
                                    }
                                </td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
                @if (MovableCount > 0)
                {
                    <AuthorizeView Roles="WarehouseAdmin">
                        <Authorized>
                            <label for="warehouse-consolidation-reason" class="form-label">@L["Projections.ApplyReason"]</label>
                            <input id="warehouse-consolidation-reason" class="form-control mb-2" maxlength="2000"
                                   @bind="_consolidationReason" @bind:event="oninput" />
                            <button class="btn btn-primary" data-testid="warehouse-consolidation-apply" @onclick="ApplyConsolidationAsync"
                                    disabled="@(_isBusy || string.IsNullOrWhiteSpace(_consolidationReason))">@L["Projections.Consolidation.Apply"]</button>
                        </Authorized>
                    </AuthorizeView>
                }
            }
        }
        @if (_consolidationMessage is not null)
        {
            <p role="status" class="mt-2" data-testid="warehouse-consolidation-message">@_consolidationMessage</p>
        }
    </div>
</div>

<div class="card shadow-sm">
    <div class="card-header">@L["Projections.Runbook"]</div>
    <div class="card-body">
        <p class="mb-2">@L["Projections.UseThisQuickChecklistBeforeAndAfterProjectionRebuilds"]</p>
        <ol class="mb-2">
            <li>@L["Projections.CheckLagTableAboveAndConfirmProjectionStatus"]</li>
            <li>@L["Projections.RunVerifyFirstUseRebuildOnlyWhenMismatchOrCorruptionIsConfirme"]</li>
            <li>@L["Projections.AfterRebuildVerifyChecksumMatchTrueAndLagReturnsToHealthy"]</li>
            <li>@L["Projections.CaptureTraceIdForFailedOperationsAndShareWithSupport"]</li>
        </ol>
    </div>
</div>

<ConfirmDialog Title="@L["Projections.RebuildProjection"]"
               Message="@L["Projections.AreYouSureThisWillRebuildTheProjectionFromScratch"]"
               ConfirmText="@L["Projections.Rebuild"]"
               IsVisible="@_showRebuildConfirm"
               OnConfirm="ConfirmRebuildAsync"
               OnCancel="CancelRebuildConfirm" />

@code {
    private static readonly string[] _projections =
    [
        "LocationBalance",
        "AvailableStock",
        "OutboundOrderSummary",
        "ShipmentSummary",
        "DispatchHistory",
        "OnHandValue",
        "InboundShipmentSummary"
    ];

    private OnHandValuePreviewDto? _valuePreview;
    private string _applyReason = string.Empty;
    private string? _valueMessage;
    private static string Amount(decimal? value) => value?.ToString("N4", System.Globalization.CultureInfo.CurrentUICulture) ?? "–";

    private async Task ApplyValuePreviewAsync()
    {
        if (_valuePreview is null || string.IsNullOrWhiteSpace(_applyReason)) return;
        _isBusy = true;
        _valueMessage = null;
        try
        {
            await ProjectionsClient.ApplyOnHandValueAsync(_valuePreview, _applyReason);
            _valuePreview = null;
            _applyReason = string.Empty;
            _valueMessage = L["Projections.ApplySucceeded"];
        }
        catch (ApiException ex) when (ex.StatusCode == 409)
        {
            _valuePreview = null;
            _valueMessage = L["Projections.PreviewStale"];
        }
        catch (ApiException ex) { _apiError = ex; }
        finally { _isBusy = false; }
    }

    private ConsolidationPreviewDto? _consolidation;
    private string _consolidationReason = string.Empty;
    private string? _consolidationMessage;
    private int MovableCount => _consolidation?.Rows.Count(x => x.Status == "Movable") ?? 0;
    private static string ConsolidationChip(string status) => status switch
    {
        "Movable" => "chip chip--ok",
        "Blocked" => "chip chip--danger",
        _ => "chip chip--slate"
    };

    private async Task CheckConsolidationAsync()
    {
        _isBusy = true;
        _apiError = null;
        _consolidationMessage = null;
        try { _consolidation = await ProjectionsClient.PreviewWarehouseConsolidationAsync(); }
        catch (ApiException ex) { _apiError = ex; }
        finally { _isBusy = false; }
    }

    private async Task ApplyConsolidationAsync()
    {
        if (string.IsNullOrWhiteSpace(_consolidationReason)) return;
        _isBusy = true;
        _apiError = null;
        try
        {
            var result = await ProjectionsClient.ApplyWarehouseConsolidationAsync(_consolidationReason);
            _consolidationMessage = L["Projections.Consolidation.Applied", result.Moved.Count, result.SkippedRows];
            _consolidationReason = string.Empty;
            _consolidation = await ProjectionsClient.PreviewWarehouseConsolidationAsync();
        }
        catch (ApiException ex) { _apiError = ex; }
        finally { _isBusy = false; }
    }

    private string _selectedProjection = "LocationBalance";
    private bool _isBusy;
    private bool _showRebuildConfirm;
    private ApiException? _apiError;
    private FailedOperation _lastFailedOperation = FailedOperation.RefreshLag;
    private RebuildResultDto? _rebuildResult;
    private VerifyResultDto? _verifyResult;
    private List<ProjectionLagStatusDto> _projectionLag = [];

    protected override async Task OnInitializedAsync()
    {
        await RefreshLagAsync(clearErrorOnSuccess: true);
    }

    private void OnProjectionChanged(ChangeEventArgs args)
    {
        _selectedProjection = args.Value?.ToString() ?? "LocationBalance";
        _valuePreview = null;
        _valueMessage = null;
        _applyReason = string.Empty;
    }

    private void OpenRebuildConfirmation()
    {
        _showRebuildConfirm = true;
    }

    private void CancelRebuildConfirm()
    {
        _showRebuildConfirm = false;
    }

    private async Task ConfirmRebuildAsync()
    {
        _showRebuildConfirm = false;
        _isBusy = true;
        _apiError = null;

        try
        {
            if (_selectedProjection == "OnHandValue")
            {
                _valuePreview = null;
                _valueMessage = null;
                _applyReason = string.Empty;
                _valuePreview = await ProjectionsClient.PreviewOnHandValueAsync();
                _rebuildResult = null;
                _verifyResult = null;
                return;
            }
            _rebuildResult = await ProjectionsClient.RebuildAsync(_selectedProjection);
            _verifyResult = null;

            if (_rebuildResult.ChecksumMatch && _rebuildResult.Swapped)
            {
                ToastService.ShowSuccess(L["Projections.Toast.RebuildCompletedFor", _selectedProjection].Value);
            }
            else
            {
                ToastService.ShowWarning(L["Projections.Toast.RebuildFinishedWithMismatchFor", _selectedProjection].Value);
            }
        }
        catch (ApiException ex)
        {
            _apiError = ex;
            _lastFailedOperation = FailedOperation.Rebuild;
            ToastService.ShowError(BuildErrorMessage(ex));
        }
        catch (Exception ex)
        {
            _apiError = new ApiException(
                new ProblemDetailsModel
                {
                    Title = "Projection rebuild failed",
                    Detail = ex.Message,
                    Status = 500,
                    TraceId = Activity.Current?.Id
                },
                500);
            _lastFailedOperation = FailedOperation.Rebuild;
            ToastService.ShowError(WarehouseErrorText.Get(L, _apiError));
        }
        finally
        {
            _isBusy = false;
            await RefreshLagAsync();
        }
    }

    private async Task VerifyAsync()
    {
        _isBusy = true;
        _apiError = null;

        try
        {
            _verifyResult = await ProjectionsClient.VerifyAsync(_selectedProjection);
            if (_verifyResult.ChecksumMatch)
            {
                ToastService.ShowSuccess(L["Projections.Toast.VerifySucceededFor", _selectedProjection].Value);
            }
            else
            {
                ToastService.ShowWarning(L["Projections.Toast.VerifyMismatchFor", _selectedProjection].Value);
            }
        }
        catch (ApiException ex)
        {
            _apiError = ex;
            _lastFailedOperation = FailedOperation.Verify;
            ToastService.ShowError(BuildErrorMessage(ex));
        }
        catch (Exception ex)
        {
            _apiError = new ApiException(
                new ProblemDetailsModel
                {
                    Title = "Projection verify failed",
                    Detail = ex.Message,
                    Status = 500,
                    TraceId = Activity.Current?.Id
                },
                500);
            _lastFailedOperation = FailedOperation.Verify;
            ToastService.ShowError(WarehouseErrorText.Get(L, _apiError));
        }
        finally
        {
            _isBusy = false;
            await RefreshLagAsync();
        }
    }

    private async Task RefreshLagFromToolbarAsync()
    {
        await RefreshLagAsync(clearErrorOnSuccess: true);
    }

    private async Task RefreshLagAsync(bool clearErrorOnSuccess = false)
    {
        try
        {
            var rows = await ProjectionsClient.GetProjectionLagAsync();
            _projectionLag = rows.ToList();

            if (clearErrorOnSuccess && _lastFailedOperation == FailedOperation.RefreshLag)
            {
                _apiError = null;
            }
        }
        catch (ApiException ex)
        {
            _apiError = ex;
            _lastFailedOperation = FailedOperation.RefreshLag;
        }
    }

    private async Task RetryAsync()
    {
        switch (_lastFailedOperation)
        {
            case FailedOperation.Rebuild:
                await ConfirmRebuildAsync();
                return;
            case FailedOperation.Verify:
                await VerifyAsync();
                return;
            default:
                await RefreshLagAsync(clearErrorOnSuccess: true);
                return;
        }
    }

    private async Task CopyErrorAsync()
    {
        if (_apiError is null)
        {
            return;
        }

        var payload = $"traceId={_apiError.TraceId}; message={BuildErrorMessage(_apiError)}";
        await JavaScript.InvokeVoidAsync("navigator.clipboard.writeText", payload);
        ToastService.ShowSuccess(L["Projections.Toast.ErrorDetailsCopied"].Value);
    }

    private void DismissError() => _apiError = null;

    private string BuildFriendlyHint(ApiException error, FailedOperation operation)
    {
        if (operation == FailedOperation.RefreshLag)
        {
            return "Projection lag status could not be refreshed. Retry and check health endpoint availability.";
        }

        var text = BuildErrorMessage(error);
        if (text.Contains("not implemented", StringComparison.OrdinalIgnoreCase) ||
            text.Contains("not supported", StringComparison.OrdinalIgnoreCase))
        {
            return "Selected projection is not supported for rebuild. Choose one of the supported projections in the selector.";
        }

        if (text.Contains("checksum", StringComparison.OrdinalIgnoreCase))
            return L["Projections.ValuePreviewExplanation"];

        if (text.Contains("42P01", StringComparison.OrdinalIgnoreCase) ||
            text.Contains("schema", StringComparison.OrdinalIgnoreCase) ||
            text.Contains("shadow", StringComparison.OrdinalIgnoreCase))
        {
            return "Projection rebuild failed due to database schema mismatch. Run shadow cleanup and schema validation, then retry.";
        }

        return "Projection operation failed. Use the runbook below and copy the error details for investigation.";
    }

    private string BuildErrorMessage(ApiException error)
    {
        if (error.ProblemDetails?.Errors is { Count: > 0 } fieldErrors)
        {
            var flattened = fieldErrors
                .SelectMany(entry => entry.Value.Select(message => $"{entry.Key}: {message}"));
            var details = string.Join("; ", flattened);
            return string.IsNullOrWhiteSpace(details) ? WarehouseErrorText.Get(L, error) : $"{WarehouseErrorText.Get(L, error)} {details}";
        }

        if (!string.IsNullOrWhiteSpace(error.ProblemDetails?.Detail))
        {
            return $"{WarehouseErrorText.Get(L, error)} {error.ProblemDetails.Detail}";
        }

        return WarehouseErrorText.Get(L, error);
    }

    private enum FailedOperation
    {
        RefreshLag,
        Rebuild,
        Verify
    }
}
