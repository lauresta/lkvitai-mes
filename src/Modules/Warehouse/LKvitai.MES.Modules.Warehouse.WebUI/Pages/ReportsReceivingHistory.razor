@page "/reports/receiving-history"
@inject ReportsClient ReportsClient
@inject IJSRuntime JavaScript
@inject ToastService ToastService

<PageTitle>@L["ReportsReceivingHistory.ReceivingHistoryCikadaMES"]</PageTitle>

<h3>@L["ReportsReceivingHistory.ReceivingHistoryReport"]</h3>

@if (_apiError is not null)
{
    <ErrorBanner Message="@BuildErrorMessage(_apiError)"
                 TraceId="@_apiError.TraceId"
                 OnRetry="LoadAsync"
                 OnDismiss="@(() => _apiError = null)" />
}

<div class="card shadow-sm mb-3">
    <div class="card-body">
        <div class="row g-2 align-items-end">
            <div class="col-md-2">
                <label class="form-label">@L["ReportsReceivingHistory.SupplierId"]</label>
                <input class="form-control" type="number" @bind="_supplierId" />
            </div>
            <div class="col-md-3">
                <label class="form-label">@L["Common.Status"]</label>
                <select class="form-select" @bind="_status">
                    <option value="">@L["Common.All"]</option>
                    <option value="Draft">@L["ReportsReceivingHistory.Draft"]</option>
                    <option value="Partial">@L["ReportsReceivingHistory.Partial"]</option>
                    <option value="Complete">@L["Common.Complete"]</option>
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label">@L["ReportsReceivingHistory.ExpectedFrom"]</label>
                <input class="form-control" type="date" @bind="_dateFrom" />
            </div>
            <div class="col-md-3">
                <label class="form-label">@L["ReportsReceivingHistory.ExpectedTo"]</label>
                <input class="form-control" type="date" @bind="_dateTo" />
            </div>
            <div class="col-md-2 d-grid">
                <button class="btn btn-primary" @onclick="ApplyFiltersAsync">@L["Common.Apply"]</button>
            </div>
            <div class="col-md-2 d-grid">
                <button class="btn btn-outline-secondary" @onclick="ExportCsvAsync">@L["Common.ExportCSV"]</button>
            </div>
        </div>
    </div>
</div>

<div class="card shadow-sm position-relative">
    <LoadingSpinner IsLoading="@_isLoading" />
    <div class="card-body">
        <div class="mb-2"><strong>@L["ReportsReceivingHistory.Total", _totalCount]</strong></div>
        <div class="table-responsive">
            <table class="table table-sm table-hover align-middle">
                <thead>
                <tr>
                    <th>@L["ReportsReceivingHistory.ShipmentId"]</th>
                    <th>@L["Common.Reference"]</th>
                    <th>@L["Common.Supplier"]</th>
                    <th>@L["Common.Expected"]</th>
                    <th>@L["Common.Status"]</th>
                    <th>@L["ReportsReceivingHistory.ExpectedQty"]</th>
                    <th>@L["ReportsReceivingHistory.ReceivedQty"]</th>
                    <th class="text-end">@L["Pricing.PurchaseTotal"]</th>
                    <th class="text-end" title="@L["Pricing.CurrentPriceHint"]">@L["Pricing.CostTotal"]</th>
                    <th class="text-end" title="@L["Pricing.CurrentPriceHint"]">@L["Pricing.SaleTotal"]</th>
                </tr>
                </thead>
                <tbody>
                @if (_items.Count == 0)
                {
                    <tr>
                        <td colspan="10" class="text-muted">@L["Common.NoRowsFound"]</td>
                    </tr>
                }
                else
                {
                    @foreach (var row in _items)
                    {
                        <tr>
                            <td>@row.Id</td>
                            <td>@row.ReferenceNumber</td>
                            <td>@row.SupplierName</td>
                            <td>@row.ExpectedDate?.ToString("yyyy-MM-dd")</td>
                            <td>@WarehouseStatusText.Get(L, row.Status)</td>
                            <td>@row.TotalExpectedQty</td>
                            <td>@row.TotalReceivedQty</td>
                            <td class="text-end is-money is-num">@Money.Format(row.TotalExpectedValue)</td>
                            <td class="text-end is-money is-num">@Money.Format(row.TotalCostValue)</td>
                            <td class="text-end is-money is-num">@Money.Format(row.TotalSaleValue)</td>
                        </tr>
                    }
                }
                </tbody>
            </table>
        </div>

        @if (_totalCount > 0)
        {
            <Pagination CurrentPage="@_pageNumber"
                        TotalPages="@TotalPages"
                        PageSize="@_pageSize"
                        OnPageChanged="OnPageChangedAsync"
                        OnPageSizeChanged="OnPageSizeChangedAsync" />
        }
    </div>
</div>

@code {
    private readonly List<ReceivingHistoryRowDto> _items = [];
    private ApiException? _apiError;
    private bool _isLoading;
    private int _pageNumber = 1;
    private int _pageSize = 50;
    private int _totalCount;

    private int? _supplierId;
    private string? _status;
    private DateTime? _dateFrom;
    private DateTime? _dateTo;

    private int TotalPages => Math.Max(1, (int)Math.Ceiling(_totalCount / (double)Math.Max(1, _pageSize)));

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private async Task ApplyFiltersAsync()
    {
        _pageNumber = 1;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _isLoading = true;
        _apiError = null;

        try
        {
            var dateFrom = ParseDate(_dateFrom);
            var dateTo = ParseDate(_dateTo);

            var response = await ReportsClient.GetReceivingHistoryAsync(
                _supplierId,
                _status,
                dateFrom,
                dateTo,
                _pageNumber,
                _pageSize);

            _items.Clear();
            _items.AddRange(response.Items);
            _totalCount = response.TotalCount;
        }
        catch (ApiException ex)
        {
            _apiError = ex;
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task OnPageChangedAsync(int page)
    {
        _pageNumber = Math.Max(1, page);
        await LoadAsync();
    }

    private async Task OnPageSizeChangedAsync(int size)
    {
        _pageSize = Math.Clamp(size, 1, 1000);
        _pageNumber = 1;
        await LoadAsync();
    }

    private async Task ExportCsvAsync()
    {
        try
        {
            var bytes = await ReportsClient.DownloadReceivingHistoryCsvAsync(
                _supplierId,
                _status,
                ParseDate(_dateFrom),
                ParseDate(_dateTo));

            await JavaScript.InvokeVoidAsync(
                "csvExport.downloadBytes",
                "receiving-history-report.csv",
                "text/csv",
                Convert.ToBase64String(bytes));
        }
        catch (ApiException ex)
        {
            _apiError = ex;
            ToastService.ShowError(BuildErrorMessage(ex));
        }
    }

    private static DateOnly? ParseDate(DateTime? value)
    {
        return value.HasValue
            ? DateOnly.FromDateTime(value.Value.Date)
            : null;
    }

    private string BuildErrorMessage(ApiException error)
    {
        if (!string.IsNullOrWhiteSpace(error.ProblemDetails?.Detail))
        {
            return $"{WarehouseErrorText.Get(L, error)} {error.ProblemDetails.Detail}";
        }

        return WarehouseErrorText.Get(L, error);
    }
}
