@page "/cycle-counts/{Id:guid}/discrepancies"
@using LKvitai.MES.Modules.Warehouse.WebUI.Infrastructure
@using LKvitai.MES.Modules.Warehouse.WebUI.Services
@inject ItemPricesClient ItemPricesClient
@inject CycleCountsClient CycleCountsClient
@inject NavigationManager NavigationManager
@inject ToastService ToastService
@inject IConfiguration Configuration

<PageTitle>@L["CycleCounts.Discrepancies.CycleCountDiscrepanciesCikadaMES"]</PageTitle>

<h1>@L["CycleCounts.Discrepancies.CycleCountDiscrepancies"]</h1>

<div class="card shadow-sm position-relative">
    <LoadingSpinner IsLoading="_isLoading || _isSubmitting" />
    <div class="card-body">
        <div class="d-flex justify-content-end mb-3">
            <button class="btn btn-outline-secondary" @onclick="BackAsync">@L["Common.Back"]</button>
        </div>

        <div class="table-responsive">
            <table class="table table-hover align-middle">
                <thead>
                    <tr>
                        <th>@L["Common.Location"]</th>
                        <th>@L["Common.Item"]</th>
                        <th>@L["CycleCounts.Discrepancies.SystemQty"]</th>
                        <th>@L["CycleCounts.Discrepancies.PhysicalQty"]</th>
                        <th>@L["CycleCounts.Discrepancies.Variance"]</th>
                        <th>@L["CycleCounts.Discrepancies.Variance393303"]</th>
                        <th>@L["Pricing.Cost"]</th>
                        <th>@L["Pricing.Sale"]</th>
                        <th>@L["CycleCounts.Discrepancies.ValueImpact"]</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @if (_rows.Count == 0)
                    {
                        <tr>
                            <td colspan="10">
                                <EmptyState Title="@L["CycleCounts.Discrepancies.NoDiscrepanciesFound"]"
                                            Message="@L["CycleCounts.Discrepancies.NoVarianceLinesRequireApproval"]"
                                            IconCss="bi bi-check2-circle"
                                            OnAction="BackAsync" />
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var row in _rows)
                        {
                            <tr>
                                <td>@row.LocationCode</td>
                                <td>@row.ItemCode</td>
                                <td>@row.SystemQty</td>
                                <td>@row.PhysicalQty</td>
                                <td>@row.Variance</td>
                                <td>@row.VariancePercent%</td>
                                <td class="mono">@Money.FormatUnit(_priceMap.Get(row.ItemId, null)?.EffectiveCost)</td>
                                <td class="mono">@Money.Format(_priceMap.Get(row.ItemId, null)?.BasePrice)</td>
                                <td class="mono">@Money.Format(_priceMap.Value(row.Variance, row.ItemId, null))</td>
                                <td>
                                    <button class="btn btn-sm btn-primary" @onclick="() => OpenApprove(row)">@L["Common.Approve"]</button>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@if (_pendingApproval is not null)
{
    <div class="modal show d-block" tabindex="-1" style="background: rgba(0, 0, 0, 0.45);">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">@L["CycleCounts.Discrepancies.ApproveAdjustment"]</h5>
                    <button type="button" class="btn-close" @onclick="CloseApprove"></button>
                </div>
                <div class="modal-body">
                    <label class="form-label">@L["Common.ApprovedBy"]</label>
                    <input class="form-control mb-3" value="@_approvedBy" readonly />
                    <label class="form-label">@L["Common.Reason"]</label>
                    <textarea class="form-control" rows="3" @bind="_approvalReason"></textarea>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-outline-secondary" @onclick="CloseApprove">@L["Common.Cancel"]</button>
                    <button class="btn btn-primary" @onclick="ConfirmApproveAsync" disabled="@_isSubmitting">@L["CycleCounts.Discrepancies.Confirm"]</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    [Parameter]
    public Guid Id { get; set; }

    private readonly List<DiscrepancyLineDto> _rows = [];
    private PriceMap _priceMap = PriceMap.Empty;
    private bool _isLoading;
    private bool _isSubmitting;
    private DiscrepancyLineDto? _pendingApproval;
    private string _approvalReason = "Cycle count correction";
    private string _approvedBy = "webui-admin";

    protected override async Task OnParametersSetAsync()
    {
        _approvedBy = Configuration["WarehouseApi:UserId"]?.Trim() ?? "webui-admin";
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _isLoading = true;
        try
        {
            var rows = await CycleCountsClient.GetDiscrepanciesAsync(Id);
            _rows.Clear();
            _rows.AddRange(rows);
            _priceMap = await ItemPricesClient.GetMapAsync(_rows.Select(x => ((int?)x.ItemId, (string?)null)));
        }
        catch (ApiException ex)
        {
            ToastService.ShowError(WarehouseErrorText.Get(L, ex));
        }
        finally
        {
            _isLoading = false;
        }
    }

    private void OpenApprove(DiscrepancyLineDto row)
    {
        _pendingApproval = row;
        _approvalReason = "Cycle count correction";
    }

    private void CloseApprove()
    {
        _pendingApproval = null;
    }

    private async Task ConfirmApproveAsync()
    {
        if (_pendingApproval is null)
        {
            return;
        }

        if (string.IsNullOrWhiteSpace(_approvalReason))
        {
            ToastService.ShowError(L["CycleCounts.Discrepancies.Toast.ReasonIsRequired"].Value);
            return;
        }

        _isSubmitting = true;
        try
        {
            await CycleCountsClient.ApproveAdjustmentAsync(Id, new ApproveAdjustmentRequestDto
            {
                CommandId = Guid.NewGuid(),
                LineIds = [_pendingApproval.LineId],
                ApprovedBy = _approvedBy,
                Reason = _approvalReason.Trim()
            });

            ToastService.ShowSuccess(L["CycleCounts.Discrepancies.Toast.AdjustmentApproved"].Value);
            _rows.RemoveAll(x => x.LineId == _pendingApproval.LineId);
            _pendingApproval = null;
        }
        catch (ApiException ex)
        {
            ToastService.ShowError(WarehouseErrorText.Get(L, ex));
        }
        finally
        {
            _isSubmitting = false;
        }
    }

    private Task BackAsync()
    {
        NavigationManager.NavigateTo("/warehouse/cycle-counts");
        return Task.CompletedTask;
    }
}
