@page "/inbound/shipments/{Id:int}"
@inject ReceivingClient ReceivingClient
@inject NavigationManager NavigationManager
@inject ToastService ToastService
@inject ItemPricesClient ItemPricesClient

<PageTitle>@L["InboundShipmentDetail.InboundShipmentDetailCikadaMES"]</PageTitle>

<h1>@L["InboundShipmentDetail.InboundShipmentDetail"]</h1>

@if (_apiError is not null)
{
    <ErrorBanner Message="@BuildErrorMessage(_apiError)"
                 TraceId="@_apiError.TraceId"
                 OnRetry="LoadAsync"
                 OnDismiss="DismissError" />
}

<div class="card shadow-sm position-relative mb-3">
    <LoadingSpinner IsLoading="_isLoading || _isSubmitting" />

    <div class="card-body">
        @if (_shipment is null)
        {
            <EmptyState Title="@L["InboundShipmentDetail.ShipmentNotFound"]"
                        Message="@L["InboundShipmentDetail.InboundShipmentDoesNotExistOrIsUnavailable"]"
                        IconCss="bi bi-box-arrow-in-down"
                        OnAction="BackToListAsync" />
        }
        else
        {
            <div class="d-flex justify-content-between align-items-start flex-wrap gap-2 mb-3">
                <div>
                    <h4 class="mb-1">ISH-@_shipment.Id</h4>
                    <div class="text-muted">@_shipment.ReferenceNumber</div>
                    <div class="small text-muted">@L["InboundShipmentDetail.Supplier", _shipment.SupplierName, _shipment.SupplierId]</div>
                    <div class="small text-muted">@L["InboundShipmentDetail.Expected", _shipment.ExpectedDate?.ToString("yyyy-MM-dd") ?? "-"]</div>
                </div>
                <div class="d-flex align-items-center gap-2">
                    <span class="badge @GetStatusBadge(_shipment.Status)">@WarehouseStatusText.Get(L, _shipment.Status)</span>
                    @if (!string.Equals(_shipment.Purchase?.PostingStatus, "Posted", StringComparison.OrdinalIgnoreCase))
                    {
                        <button class="btn btn-outline-primary btn-sm" @onclick="OpenEdit">@L["Common.Edit"]</button>
                    }
                    @if (_shipment.Status is "Draft" or "Partial" && TotalReceived < TotalExpected)
                    {
                        <button class="btn btn-outline-primary btn-sm" disabled="@_isSubmitting" @onclick="CloseShortAsync">@L["Completion.CloseShort"]</button>
                    }
                    <button class="btn btn-outline-secondary btn-sm" @onclick="BackToList">@L["Common.Back"]</button>
                    <button class="btn btn-outline-secondary btn-sm" @onclick="LoadAsync">@L["Common.Refresh"]</button>
                </div>
            </div>

            <div class="alert alert-light border d-flex justify-content-between align-items-center flex-wrap gap-2">
                <div>
                    <strong>@L["InboundShipmentDetail.Received"]</strong> @TotalReceived.ToString("0.##") / @TotalExpected.ToString("0.##")
                    (<span>@CompletionPercent.ToString("0.0")%</span>)
                </div>
                <button class="btn btn-sm btn-outline-primary" @onclick="OpenQcQueue">@L["InboundShipmentDetail.OpenQCQueue"]</button>
            </div>

            @if (_shipment.Purchase is { } purchase)
            {
                var posted = string.Equals(purchase.PostingStatus, "Posted", StringComparison.OrdinalIgnoreCase);
                <div class="card border mb-3" data-testid="purchase-document">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-2">
                            <h5 class="mb-0">@L["Purchase.Document"]</h5>
                            <span class="badge @(posted ? "bg-success" : "bg-secondary")" data-testid="posting-status">
                                @(posted ? L["Purchase.Posted"] : L["Purchase.NotPosted"])
                            </span>
                        </div>
                        @if (posted)
                        {
                            <div class="small text-muted mb-2">@L["Purchase.PostedBy", purchase.PostedAt?.ToLocalTime().ToString("yyyy-MM-dd HH:mm") ?? "-", purchase.PostedBy ?? "-"]</div>
                            <div class="lk-state lk-state--ok mb-2">@L["Purchase.DocumentLocked"]</div>
                        }
                        <div class="row g-3">
                            <div class="col-md-3">
                                <div class="small text-muted">@L["InboundShipmentCreate.InvoiceNumber"]</div>
                                <div>@(_shipment.InvoiceNumber ?? "-")</div>
                                <div class="small text-muted mt-2">@L["InboundShipmentCreate.InvoiceDate"]</div>
                                <div>@(_shipment.InvoiceDate?.ToString("yyyy-MM-dd") ?? "-")</div>
                                <div class="small text-muted mt-2">@L["Purchase.Currency"]</div>
                                <div>@purchase.Currency</div>
                            </div>
                            <div class="col-md-5">
                                <table class="table table-sm mb-0">
                                    <thead><tr><th></th><th class="text-end">@purchase.Currency</th><th class="text-end">EUR</th></tr></thead>
                                    <tbody>
                                        <tr><td>@L["Purchase.NetAmount"]</td><td class="text-end is-money is-num">@Money.Format(purchase.NetAmount)</td><td class="text-end is-money is-num" data-testid="net-eur">@Money.Format(purchase.NetEur)</td></tr>
                                        <tr><td>@L["Purchase.VatAmount"]</td><td class="text-end is-money is-num">@Money.Format(purchase.VatAmount)</td><td class="text-end is-money is-num">@Money.Format(purchase.VatEur)</td></tr>
                                        <tr><td>@L["Purchase.GrossAmount"]</td><td class="text-end is-money is-num">@Money.Format(purchase.GrossAmount)</td><td class="text-end is-money is-num">@Money.Format(purchase.GrossEur)</td></tr>
                                    </tbody>
                                </table>
                            </div>
                            <div class="col-md-4">
                                <div class="small text-muted">@L["Purchase.Rate"]</div>
                                @if (purchase.RateUnitsPerEur.HasValue)
                                {
                                    <div data-testid="fx-rate">1 EUR = @purchase.RateUnitsPerEur.Value.ToString("0.########", System.Globalization.CultureInfo.InvariantCulture) @purchase.Currency</div>
                                    <div class="small text-muted">@purchase.RateDate?.ToString("yyyy-MM-dd") - @purchase.RateSource @(purchase.RateReason is null ? "" : $"({purchase.RateReason})")</div>
                                    @if (!posted)
                                    {
                                        <div class="small text-muted">@L["Purchase.RatePreliminary"]</div>
                                    }
                                }
                                else
                                {
                                    <div>-</div>
                                }
                                <div class="small text-muted mt-2">@L["Purchase.VatTreatment"]</div>
                                <div>@(purchase.VatTreatment ?? purchase.DefaultVatTreatment ?? "-")</div>
                                <div class="small text-muted mt-2">@L["Purchase.AccountingRoute"]</div>
                                <div>@(purchase.AccountingRoute == "ManualInAgnum" ? L["Purchase.Route.ManualInAgnum"] : L["Purchase.Route.Auto"])</div>
                            </div>
                        </div>

                        @if (!posted)
                        {
                            var problems = _postProblems ?? purchase.Problems;
                            @if (problems.Count > 0)
                            {
                                <ul class="mt-3 mb-2 text-danger" data-testid="posting-problems">
                                    @foreach (var problem in problems)
                                    {
                                        <li>@ProblemText(problem)</li>
                                    }
                                </ul>
                            }

                            @if (purchase.CanSetManualRate && !string.Equals(purchase.Currency, "EUR", StringComparison.OrdinalIgnoreCase))
                            {
                                <div class="row g-2 mt-1">
                                    <div class="col-md-3">
                                        <label class="form-label">@L["Purchase.ManualRate"]</label>
                                        <input type="number" min="0" step="0.00000001" class="form-control" @bind="_manualRate" />
                                    </div>
                                    <div class="col-md-5">
                                        <label class="form-label">@L["Purchase.ManualRateReason"]</label>
                                        <input class="form-control" @bind="_manualRateReason" />
                                    </div>
                                </div>
                            }

                            <div class="mt-3">
                                <button class="btn btn-primary" disabled="@_isSubmitting" @onclick="PostAsync" data-testid="post-document">@L["Purchase.Post"]</button>
                            </div>
                        }
                    </div>
                </div>
            }

            @if (_shipment.AdditionalCosts.Count > 0)
            {
                <div class="alert alert-light border">
                    <strong>@L["InboundShipmentDetail.AdditionalCosts"]</strong>
                    @foreach (var cost in _shipment.AdditionalCosts)
                    {
                        <span class="badge bg-light text-dark border me-1">@cost.CostType: @cost.Amount.ToString("0.00") @cost.Currency@(cost.AmountEur.HasValue ? $" = {cost.AmountEur.Value:0.00} EUR" : "")</span>
                    }
                </div>
            }

            <div class="card border mb-3">
                <div class="card-body">
                    <div class="row g-2 align-items-end">
                        <div class="col-md-3">
                            <label class="form-label">@L["InboundShipmentDetail.ScanBarcode"]</label>
                            <input class="form-control" @bind="_scanBarcode" placeholder="@L["InboundShipmentDetail.ScanItemBarcode"]" />
                        </div>
                        <div class="col-md-2">
                            <button class="btn btn-outline-secondary" @onclick="ResolveByBarcode">@L["InboundShipmentDetail.Resolve"]</button>
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">@L["Common.Line"]</label>
                            <select class="form-select" @bind="_selectedLineId">
                                <option value="">@L["InboundShipmentDetail.SelectLine"]</option>
                                @foreach (var line in _shipment.Lines.Where(x => !x.IsService))
                                {
                                    <option value="@line.LineId">@L["InboundShipmentDetail.Line", line.ItemSku, line.ItemName, line.LineId]</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-2">
                            <label class="form-label">@L["InboundShipmentDetail.ReceiveQty"]</label>
                            <input type="number" min="0.01" step="0.01" class="form-control" @bind="_receivedQty" />
                        </div>
                        <div class="col-md-2 d-flex">
                            <button class="btn btn-primary mt-auto" @onclick="ReceiveAsync" disabled="@(_isSubmitting || _shipment.Status is "Complete" or "Cancelled")">@L["Common.Receive"]</button>
                        </div>
                    </div>

                    <div class="row g-2 mt-1">
                        <div class="col-md-2">
                            <label class="form-label">@L["InboundShipmentDetail.UnitPricec63fff", SelectedLineHasPrice ? "" : "(required)"]</label>
                            <input type="number" min="0" step="0.0001" class="form-control @(SelectedLineHasPrice ? "" : "border-warning")" @bind="_unitPrice" placeholder="@SelectedLinePricePlaceholder" />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">@L["Common.LotNumber"]</label>
                            <input class="form-control" @bind="_lotNumber" />
                        </div>
                        <div class="col-md-2">
                            <label class="form-label">@L["InboundShipmentDetail.ProductionDate"]</label>
                            <input type="date" class="form-control" @bind="_productionDate" />
                        </div>
                        <div class="col-md-2">
                            <label class="form-label">@L["InboundShipmentDetail.ExpiryDate"]</label>
                            <input type="date" class="form-control" @bind="_expiryDate" />
                        </div>
                        <div class="col-md-2">
                            <label class="form-label">@L["Common.Notes"]</label>
                            <input class="form-control" @bind="_notes" />
                        </div>
                    </div>
                    @if (!SelectedLineHasPrice)
                    {
                        <div class="small text-warning mt-1">@L["InboundShipmentDetail.ThisLineHasNoPurchasePriceYetEnterTheUnitPriceBeforeReceivingW"]</div>
                    }
                </div>
            </div>

            <div class="table-responsive">
                <table class="table table-sm table-hover align-middle">
                    <thead>
                        <tr>
                            <th>@L["Common.Line"]</th>
                            <th></th>
                            <th>@L["Common.Item"]</th>
                            <th>@L["Common.Barcode"]</th>
                            <th>@L["Common.Expected"]</th>
                            <th>@L["InboundShipmentDetail.Received27548c"]</th>
                            <th>@L["Common.Remaining"]</th>
                            <th>@L["InboundShipmentDetail.UnitPrice"]</th>
                            <th class="text-end">@L["Pricing.Cost"]</th>
                            <th class="text-end">@L["Pricing.Sale"]</th>
                            <th>@L["InboundShipmentDetail.Flags"]</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var line in _shipment.Lines.OrderBy(x => x.LineId))
                        {
                            <tr class="@(line.LineId == SelectedLineId ? "table-primary" : null)">
                                <td>@line.LineId</td>
                                <td>
                                    @if (!string.IsNullOrWhiteSpace(line.PrimaryThumbnailUrl))
                                    {
                                        <img src="@line.PrimaryThumbnailUrl" alt="@line.ItemSku" loading="lazy" style="width:36px;height:36px;object-fit:cover;border-radius:4px;" />
                                    }
                                    else
                                    {
                                        <div class="bg-light border text-muted d-flex align-items-center justify-content-center" style="width:36px;height:36px;border-radius:4px;">-</div>
                                    }
                                </td>
                                <td>
                                    <div>@line.ItemSku</div>
                                    <div class="small text-muted">@line.ItemName</div>
                                </td>
                                <td>@(line.PrimaryBarcode ?? "-")</td>
                                <td>@line.ExpectedQty.ToString("0.##") @line.BaseUoM</td>
                                <td>@line.ReceivedQty.ToString("0.##") @line.BaseUoM</td>
                                <td>@Math.Max(0m, line.ExpectedQty - line.ReceivedQty).ToString("0.##") @line.BaseUoM</td>
                                <td>
                                    @if (line.UnitPrice.HasValue)
                                    {
                                        @($"{line.UnitPrice.Value:0.####} {line.Currency ?? "EUR"}")
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning text-dark">@L["InboundShipmentDetail.NotSet"]</span>
                                    }
                                </td>
                                <td class="text-end is-money is-num">@Money.FormatUnit(_priceMap.Get(line.ItemId, line.ItemSku)?.EffectiveCost)</td>
                                <td class="text-end is-money is-num">@Money.Format(_priceMap.Get(line.ItemId, line.ItemSku)?.BasePrice)</td>
                                <td>
                                    @if (line.IsService)
                                    {
                                        <span class="badge bg-secondary me-1">@L["InboundShipmentDetail.SERVICE", line.CostType ?? "Other"]</span>
                                    }
                                    @if (line.RequiresLotTracking)
                                    {
                                        <span class="badge bg-warning text-dark me-1">LOT</span>
                                    }
                                    @if (line.RequiresQC)
                                    {
                                        <span class="badge bg-info text-dark">QC</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

@code {
    [Parameter]
    public int Id { get; set; }

    private InboundShipmentDetailDto? _shipment;
    private PriceMap _priceMap = PriceMap.Empty;
    private ApiException? _apiError;
    private bool _isLoading;
    private bool _isSubmitting;

    private string _scanBarcode = string.Empty;
    private string _selectedLineId = string.Empty;
    private decimal _receivedQty = 1m;
    private string _lotNumber = string.Empty;
    private DateTime? _productionDate;
    private DateTime? _expiryDate;
    private string _notes = string.Empty;
    private decimal? _unitPrice;
    private string _currency = "EUR";

    private int? SelectedLineId => int.TryParse(_selectedLineId, out var lineId) ? lineId : null;

    private InboundShipmentLineDetailDto? SelectedLine
        => _shipment?.Lines.FirstOrDefault(x => x.LineId == SelectedLineId);

    private bool SelectedLineHasPrice => SelectedLine?.UnitPrice.HasValue == true || _unitPrice.HasValue;

    private string SelectedLinePricePlaceholder
        => SelectedLine?.UnitPrice.HasValue == true
            ? $"currently {SelectedLine.UnitPrice.Value:0.####}"
            : "required before receiving";

    private decimal TotalExpected => _shipment?.Lines.Sum(x => x.ExpectedQty) ?? 0m;
    private decimal TotalReceived => _shipment?.Lines.Sum(x => x.ReceivedQty) ?? 0m;
    private decimal CompletionPercent => TotalExpected <= 0m ? 0m : (TotalReceived / TotalExpected) * 100m;

    protected override async Task OnParametersSetAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _isLoading = true;
        _apiError = null;

        try
        {
            _shipment = await ReceivingClient.GetShipmentByIdAsync(Id);
            _priceMap = await ItemPricesClient.GetMapAsync(_shipment.Lines.Select(x => ((int?)x.ItemId, (string?)x.ItemSku)));

            if (_shipment.Lines.Count > 0 && !SelectedLineId.HasValue)
            {
                _selectedLineId = _shipment.Lines.OrderBy(x => x.LineId).First().LineId.ToString();
            }
        }
        catch (ApiException ex)
        {
            _apiError = ex;
            _shipment = null;
            _priceMap = PriceMap.Empty;
            ToastService.ShowError(BuildErrorMessage(ex));
        }
        finally
        {
            _isLoading = false;
        }
    }

    private decimal? _manualRate;
    private string? _manualRateReason;
    private IReadOnlyList<PostingProblemDto>? _postProblems;

    private string ProblemText(PostingProblemDto problem)
    {
        var localized = L["Purchase.Problem." + problem.Code];
        if (localized.ResourceNotFound)
        {
            return problem.Text;
        }

        // Figures and names come from the server text.
        return problem.Code is "LinesTotalMismatch" or "SupplierNotPostable" or "PostingRuleMissing"
            ? $"{localized.Value} ({problem.Text})"
            : localized.Value;
    }

    private async Task PostAsync()
    {
        if (_shipment is null)
        {
            return;
        }

        _isSubmitting = true;
        _apiError = null;
        _postProblems = null;
        try
        {
            _shipment = await ReceivingClient.PostShipmentAsync(
                _shipment.Id, new PostShipmentRequestDto { ManualRateUnitsPerEur = _manualRate, ManualRateReason = _manualRateReason });
            ToastService.ShowSuccess(L["Purchase.PostedToast"].Value);
        }
        catch (ApiException ex) when (ex.StatusCode == 422 && ex.ProblemDetails?.Detail is { } detail && detail.Contains('|'))
        {
            _postProblems = detail.Split('\n', StringSplitOptions.RemoveEmptyEntries)
                .Select(x => x.Split('|', 2))
                .Select(p => new PostingProblemDto { Code = p[0], Text = p.Length > 1 ? p[1] : p[0] })
                .ToList();
            ToastService.ShowError(L["Purchase.NotPostedToast"].Value);
        }
        catch (ApiException ex)
        {
            _apiError = ex;
            ToastService.ShowError(BuildErrorMessage(ex));
        }
        finally
        {
            _isSubmitting = false;
        }
    }

    private void ResolveByBarcode()
    {
        if (_shipment is null || string.IsNullOrWhiteSpace(_scanBarcode))
        {
            return;
        }

        var barcode = _scanBarcode.Trim();
        var matched = _shipment.Lines.FirstOrDefault(x =>
            string.Equals(x.PrimaryBarcode, barcode, StringComparison.OrdinalIgnoreCase));

        if (matched is null)
        {
            ToastService.ShowWarning(L["InboundShipmentDetail.Toast.BarcodeNotFoundInThisShipmentLines"].Value);
            return;
        }

        _selectedLineId = matched.LineId.ToString();
        ToastService.ShowSuccess(L["InboundShipmentDetail.Toast.SelectedLine", matched.LineId, matched.ItemSku].Value);
    }

    private async Task CloseShortAsync()
    {
        _isSubmitting = true;
        try
        {
            await ReceivingClient.CloseShortAsync(Id, _notes);
            await LoadAsync();
            ToastService.ShowSuccess(L["Completion.ClosedShort"].Value);
        }
        catch (ApiException ex) { _apiError = ex; ToastService.ShowError(BuildErrorMessage(ex)); }
        finally { _isSubmitting = false; }
    }

    private async Task ReceiveAsync()
    {
        if (_shipment is null)
        {
            return;
        }

        if (!SelectedLineId.HasValue)
        {
            ToastService.ShowError(L["InboundShipmentDetail.Toast.SelectLineToReceive"].Value);
            return;
        }

        if (_receivedQty <= 0m)
        {
            ToastService.ShowError(L["InboundShipmentDetail.Toast.ReceivedQtyMustBeGreaterThanZero"].Value);
            return;
        }

        if (!SelectedLineHasPrice)
        {
            ToastService.ShowError(L["InboundShipmentDetail.Toast.EnterTheUnitPriceBeforeReceivingThisLine"].Value);
            return;
        }

        if (_unitPrice is < 0m)
        {
            ToastService.ShowError(L["InboundShipmentDetail.Toast.UnitPriceMustBeGreaterThanOrEqualToZero"].Value);
            return;
        }

        _isSubmitting = true;
        _apiError = null;

        try
        {
            var request = new ReceiveShipmentLineRequestDto
            {
                LineId = SelectedLineId.Value,
                ReceivedQty = _receivedQty,
                LotNumber = string.IsNullOrWhiteSpace(_lotNumber) ? null : _lotNumber.Trim(),
                ProductionDate = _productionDate.HasValue ? DateOnly.FromDateTime(_productionDate.Value.Date) : null,
                ExpiryDate = _expiryDate.HasValue ? DateOnly.FromDateTime(_expiryDate.Value.Date) : null,
                Notes = string.IsNullOrWhiteSpace(_notes) ? null : _notes.Trim(),
                UnitPrice = _unitPrice
            };

            var response = await ReceivingClient.ReceiveItemsAsync(_shipment.Id, request);
            ToastService.ShowSuccess(L["InboundShipmentDetail.Toast.ReceivedUnitsTo", response.ReceivedQty, response.DestinationLocationCode].Value);

            _lotNumber = string.Empty;
            _notes = string.Empty;
            _receivedQty = 1m;
            _scanBarcode = string.Empty;
            _unitPrice = null;

            await LoadAsync();
        }
        catch (ApiException ex)
        {
            _apiError = ex;
            ToastService.ShowError(BuildErrorMessage(ex));
        }
        finally
        {
            _isSubmitting = false;
        }
    }

    private void OpenQcQueue()
    {
        NavigationManager.NavigateTo("/warehouse/inbound/qc");
    }

    private void OpenEdit()
    {
        NavigationManager.NavigateTo($"/warehouse/inbound/shipments/{Id}/edit");
    }

    private void BackToList()
    {
        NavigationManager.NavigateTo("/warehouse/inbound/shipments");
    }

    private Task BackToListAsync()
    {
        BackToList();
        return Task.CompletedTask;
    }

    private void DismissError()
    {
        _apiError = null;
    }

    private static string GetStatusBadge(string status) => status.ToUpperInvariant() switch
    {
        "DRAFT" => "bg-secondary",
        "PARTIAL" => "bg-warning text-dark",
        "COMPLETE" => "bg-success",
        _ => "bg-secondary"
    };

    private string BuildErrorMessage(ApiException ex)
    {
        if (!string.IsNullOrWhiteSpace(WarehouseErrorText.Get(L, ex)))
        {
            return WarehouseErrorText.Get(L, ex);
        }

        return ex.ProblemDetails?.Detail
               ?? ex.ProblemDetails?.Title
               ?? L["InboundShipmentDetail.RequestFailed"].Value;
    }
}
