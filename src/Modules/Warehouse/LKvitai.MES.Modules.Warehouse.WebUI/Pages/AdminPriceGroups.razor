@page "/admin/price-groups"
@inject MasterDataAdminClient AdminClient
@inject ToastService ToastService
@inject IDialogService DialogService

<PageTitle>@L["AdminPriceGroups.PriceGroupsCikadaMES"]</PageTitle>

<div data-testid="admin-price-groups-page">
    <h3>@L["AdminPriceGroups.PriceGroups"]</h3>

    @if (_apiError is not null)
    {
        <div data-testid="admin-price-groups-error">
            <SharedErrorAlert Message="@BuildErrorMessage(_apiError)"
                              TraceId="@_apiError.TraceId"
                              OnRetry="ReloadAsync"
                              OnDismiss="@(() => _apiError = null)" />
        </div>
    }

    <MudPaper Outlined="true" Elevation="0" Class="panel items-list-panel">
        <div class="panel__head">
            <span class="panel__title">@L["AdminPriceGroups.Groups"] <small>@L["AdminPriceGroups.Total", _groups.Count]</small></span>
            <div class="panel__actions">
                <MudButton Variant="Variant.Outlined" Color="Color.Primary" OnClick="RefreshAsync">@L["Common.Refresh"]</MudButton>
                <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="OpenCreateDialogAsync">@L["AdminPriceGroups.CreateGroup"]</MudButton>
            </div>
        </div>

        <MudDataGrid T="PriceGroupDto" Items="@_groups" Dense="true" Hover="true" FixedHeader="true" Loading="@_isLoading">
            <Columns>
                <PropertyColumn Property="x => x.Code" Title="@L["Common.Code"]" />
                <PropertyColumn Property="x => x.Name" Title="@L["Common.Name"]" />
                <TemplateColumn Title="@L["Common.Status"]">
                    <CellTemplate>
                        <span class="@(context.Item.IsActive ? "chip chip--ok" : "chip chip--locked")">@(context.Item.IsActive ? L["Common.Active"] : L["Common.Inactive"])</span>
                    </CellTemplate>
                </TemplateColumn>
                <TemplateColumn Title="">
                    <CellTemplate>
                        <MudButton Size="Size.Small" Variant="Variant.Outlined" OnClick="@(() => SelectGroupAsync(context.Item))">@L["AdminPriceGroups.Customers"]</MudButton>
                        <MudButton Size="Size.Small" Variant="Variant.Outlined" OnClick="@(() => OpenEditDialogAsync(context.Item))">@L["Common.Edit"]</MudButton>
                        <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Error" OnClick="@(() => DeleteAsync(context.Item))">@L["Common.Delete"]</MudButton>
                    </CellTemplate>
                </TemplateColumn>
            </Columns>
            <NoRecordsContent>
                <div class="lots-grid__empty">
                    <span class="lots-grid__empty-title">@L["AdminPriceGroups.NoPriceGroups"]</span>
                    <span>@L["AdminPriceGroups.CreateOneToStartOverridingItemPricesPerCustomerTier"]</span>
                </div>
            </NoRecordsContent>
        </MudDataGrid>
    </MudPaper>

    @if (_selectedGroup is not null)
    {
        <MudPaper Outlined="true" Elevation="0" Class="panel items-detail-panel">
            <div class="panel__head">
                <span class="panel__title">@L["AdminPriceGroups.CustomersIn", _selectedGroup.Name]</span>
            </div>

            <div class="lk-toolbar">
                <MudAutocomplete T="CustomerLookupDto"
                                 Label="@L["AdminPriceGroups.AssignCustomer"]"
                                 Variant="Variant.Outlined"
                                 Margin="Margin.Dense"
                                 SearchFunc="SearchCustomersAsync"
                                 ToStringFunc="@(x => x is null ? string.Empty : $"{x.CustomerCode} - {x.Name}")"
                                 ValueChanged="AssignCustomerAsync"
                                 ResetValueOnEmptyText="true"
                                 CoerceValue="true"
                                 MinCharacters="1"
                                 Placeholder="@L["AdminPriceGroups.SearchCustomersByNameOrCode"]" />
            </div>

            @if (_groupCustomers.Count == 0)
            {
                <div class="lots-grid__empty">
                    <span class="lots-grid__empty-title">@L["AdminPriceGroups.NoCustomersAssigned"]</span>
                </div>
            }
            else
            {
                <table class="lk-table">
                    <thead>
                    <tr>
                        <th>@L["Common.Code"]</th>
                        <th>@L["Common.Name"]</th>
                        <th></th>
                    </tr>
                    </thead>
                    <tbody>
                    @foreach (var customer in _groupCustomers)
                    {
                        <tr>
                            <td class="mono">@customer.CustomerCode</td>
                            <td>@customer.Name</td>
                            <td class="text-end">
                                <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Error" OnClick="@(() => UnassignCustomerAsync(customer))">@L["Common.Remove"]</MudButton>
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            }
        </MudPaper>
    }
</div>

@code {
    private readonly List<PriceGroupDto> _groups = [];
    private readonly List<PriceGroupCustomerDto> _groupCustomers = [];
    private PriceGroupDto? _selectedGroup;
    private bool _isLoading;
    private ApiException? _apiError;

    protected override async Task OnInitializedAsync()
    {
        await ReloadAsync();
    }

    private async Task ReloadAsync()
    {
        _isLoading = true;
        _apiError = null;

        try
        {
            var rows = await AdminClient.GetPriceGroupsAsync();
            _groups.Clear();
            _groups.AddRange(rows.OrderBy(x => x.Code));
        }
        catch (ApiException ex)
        {
            _apiError = ex;
        }
        finally
        {
            _isLoading = false;
        }
    }

    private Task RefreshAsync() => ReloadAsync();

    private async Task SelectGroupAsync(PriceGroupDto group)
    {
        _selectedGroup = group;
        try
        {
            var customers = await AdminClient.GetPriceGroupCustomersAsync(group.Id);
            _groupCustomers.Clear();
            _groupCustomers.AddRange(customers);
        }
        catch (ApiException ex)
        {
            ToastService.ShowError(BuildErrorMessage(ex));
        }
    }

    private async Task<IEnumerable<CustomerLookupDto>> SearchCustomersAsync(string value)
    {
        try
        {
            return await AdminClient.SearchCustomersAsync(value);
        }
        catch (ApiException)
        {
            return Array.Empty<CustomerLookupDto>();
        }
    }

    private async Task AssignCustomerAsync(CustomerLookupDto? customer)
    {
        if (customer is null || _selectedGroup is null)
        {
            return;
        }

        try
        {
            await AdminClient.SetCustomerPriceGroupAsync(customer.Id, _selectedGroup.Id);
            ToastService.ShowSuccess(L["AdminPriceGroups.Toast.AssignedTo", customer.Name, _selectedGroup.Name].Value);
            await SelectGroupAsync(_selectedGroup);
        }
        catch (ApiException ex)
        {
            ToastService.ShowError(BuildErrorMessage(ex));
        }
    }

    private async Task UnassignCustomerAsync(PriceGroupCustomerDto customer)
    {
        if (_selectedGroup is null)
        {
            return;
        }

        try
        {
            await AdminClient.SetCustomerPriceGroupAsync(customer.Id, null);
            ToastService.ShowWarning(L["AdminPriceGroups.Toast.RemovedFrom", customer.Name, _selectedGroup.Name].Value);
            await SelectGroupAsync(_selectedGroup);
        }
        catch (ApiException ex)
        {
            ToastService.ShowError(BuildErrorMessage(ex));
        }
    }

    private async Task OpenCreateDialogAsync()
    {
        var parameters = new DialogParameters<AdminPriceGroupEditorDialog>
        {
            { x => x.IsEdit, false }
        };

        var dialog = await DialogService.ShowAsync<AdminPriceGroupEditorDialog>(L["AdminPriceGroups.CreatePriceGroup"].Value, parameters);
        var result = await dialog.Result;
        if (result is null || result.Canceled || result.Data is not CreateOrUpdatePriceGroupRequest request)
        {
            return;
        }

        try
        {
            await AdminClient.CreatePriceGroupAsync(request);
            ToastService.ShowSuccess(L["AdminPriceGroups.Toast.PriceGroupCreated"].Value);
            await ReloadAsync();
        }
        catch (ApiException ex)
        {
            ToastService.ShowError(BuildErrorMessage(ex));
        }
    }

    private async Task OpenEditDialogAsync(PriceGroupDto group)
    {
        var parameters = new DialogParameters<AdminPriceGroupEditorDialog>
        {
            { x => x.IsEdit, true },
            { x => x.Group, group }
        };

        var dialog = await DialogService.ShowAsync<AdminPriceGroupEditorDialog>(L["AdminPriceGroups.EditPriceGroup"].Value, parameters);
        var result = await dialog.Result;
        if (result is null || result.Canceled || result.Data is not CreateOrUpdatePriceGroupRequest request)
        {
            return;
        }

        try
        {
            await AdminClient.UpdatePriceGroupAsync(group.Id, request);
            ToastService.ShowSuccess(L["AdminPriceGroups.Toast.PriceGroupUpdated"].Value);
            await ReloadAsync();
        }
        catch (ApiException ex)
        {
            ToastService.ShowError(BuildErrorMessage(ex));
        }
    }

    private async Task DeleteAsync(PriceGroupDto group)
    {
        try
        {
            await AdminClient.DeletePriceGroupAsync(group.Id);
            ToastService.ShowWarning(L["AdminPriceGroups.Toast.PriceGroupDeleted"].Value);
            if (_selectedGroup?.Id == group.Id)
            {
                _selectedGroup = null;
                _groupCustomers.Clear();
            }

            await ReloadAsync();
        }
        catch (ApiException ex)
        {
            ToastService.ShowError(BuildErrorMessage(ex));
        }
    }

    private string BuildErrorMessage(ApiException error)
    {
        if (!string.IsNullOrWhiteSpace(error.ProblemDetails?.Detail))
        {
            return $"{WarehouseErrorText.Get(L, error)} {error.ProblemDetails.Detail}";
        }

        return WarehouseErrorText.Get(L, error);
    }
}
