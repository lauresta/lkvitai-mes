@page "/transfers/{Id:guid}/execute"
@using LKvitai.MES.Modules.Warehouse.WebUI.Infrastructure
@using LKvitai.MES.Modules.Warehouse.WebUI.Services
@inject ItemPricesClient ItemPricesClient
@inject TransfersClient TransfersClient
@inject MasterDataAdminClient MasterDataAdminClient
@inject NavigationManager NavigationManager
@inject ToastService ToastService

<PageTitle>@L["Transfers.Execute.ExecuteTransferCikadaMES"]</PageTitle>

<h1>@L["Transfers.Execute.ExecuteTransfer"]</h1>

@if (_apiError is not null)
{
    <ErrorBanner Message="@BuildErrorMessage(_apiError)"
                 TraceId="@_apiError.TraceId"
                 ShowRetry="@_apiError.IsRetryable"
                 OnRetry="LoadAsync"
                 OnDismiss="DismissError" />
}

<div class="card shadow-sm position-relative">
    <LoadingSpinner IsLoading="_isLoading || _isSubmitting" />

    <div class="card-body">
        @if (_transfer is null)
        {
            <EmptyState Title="@L["Transfers.Execute.TransferNotFound"]"
                        Message="@L["Transfers.Execute.TransferDoesNotExistOrIsUnavailable"]"
                        IconCss="bi bi-arrow-left-right"
                        OnAction="BackToListAsync" />
        }
        else
        {
            <div class="d-flex justify-content-between align-items-start flex-wrap gap-2 mb-3">
                <div>
                    <h4 class="mb-1">@_transfer.TransferNumber</h4>
                    <div class="text-muted">@_transfer.FromWarehouse -> @_transfer.ToWarehouse</div>
                    <div class="small text-muted">@L["Transfers.Execute.Status", _transfer.Status]</div>
                </div>
                <div class="d-flex align-items-center gap-2">
                    <button class="btn btn-outline-secondary btn-sm" @onclick="BackToList">@L["Common.Back"]</button>
                    <button class="btn btn-outline-secondary btn-sm" @onclick="LoadAsync">@L["Common.Refresh"]</button>
                    <button class="btn btn-primary btn-sm" @onclick="OpenConfirm" disabled="@(!CanExecute || _isSubmitting)">@L["Common.Execute"]</button>
                </div>
            </div>

            <div class="table-responsive">
                <table class="table table-sm table-hover align-middle">
                    <thead>
                        <tr>
                            <th>@L["Common.Item"]</th>
                            <th>@L["Common.Qty"]</th>
                            <th>@L["Pricing.Cost"]</th>
                            <th>@L["Pricing.Sale"]</th>
                            <th>@L["Common.ValueCurrentCost"]</th>
                            <th>@L["Transfers.Execute.FromLocation"]</th>
                            <th>@L["Common.ToLocation"]</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var line in _transfer.Lines)
                        {
                            <tr>
                                <td>@GetItemName(line.ItemId)</td>
                                <td>@line.Qty.ToString("0.##")</td>
                                <td class="mono">@Money.Format(_priceMap.Get(line.ItemId, null)?.EffectiveCost)</td>
                                <td class="mono">@Money.Format(_priceMap.Get(line.ItemId, null)?.BasePrice)</td>
                                <td class="mono">@Money.Format(_priceMap.Value(line.Qty, line.ItemId, null))</td>
                                <td>@GetLocationName(line.FromLocationId)</td>
                                <td>@GetLocationName(line.ToLocationId)</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

@if (_confirmExecute)
{
    <div class="modal show d-block transfer-execute-modal-backdrop" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">@L["Transfers.Execute.ConfirmExecution"]</h5>
                    <button type="button" class="btn-close" @onclick="CloseConfirm"></button>
                </div>
                <div class="modal-body">
                    @L["Transfers.Execute.ExecuteTransferStockWillBeMoved"]
                </div>
                <div class="modal-footer">
                    <button class="btn btn-outline-secondary" @onclick="CloseConfirm">@L["Common.Cancel"]</button>
                    <button class="btn btn-primary" @onclick="ConfirmExecuteAsync" disabled="@_isSubmitting">@L["Transfers.Execute.Confirm"]</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    [Parameter]
    public Guid Id { get; set; }

    private TransferDto? _transfer;
    private ApiException? _apiError;
    private bool _isLoading;
    private bool _isSubmitting;
    private bool _confirmExecute;
    private readonly List<AdminItemDto> _items = new();
    private readonly List<AdminLocationDto> _locations = new();
    private PriceMap _priceMap = PriceMap.Empty;

    private bool CanExecute => string.Equals(_transfer?.Status, "APPROVED", StringComparison.OrdinalIgnoreCase);

    protected override async Task OnParametersSetAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _isLoading = true;
        _apiError = null;

        try
        {
            _transfer = await TransfersClient.GetTransferByIdAsync(Id);
            _priceMap = await ItemPricesClient.GetMapAsync(_transfer.Lines.Select(x => ((int?)x.ItemId, (string?)null)));

            var items = await MasterDataAdminClient.GetItemsAsync(null, null, "Active", 1, 500);
            _items.Clear();
            _items.AddRange(items.Items);

            var locations = await MasterDataAdminClient.GetLocationsAsync(null, "Active", true, 1, 500);
            _locations.Clear();
            _locations.AddRange(locations.Items);
        }
        catch (ApiException ex)
        {
            _apiError = ex;
            _transfer = null;
            ToastService.ShowError(BuildErrorMessage(ex));
        }
        finally
        {
            _isLoading = false;
        }
    }

    private void OpenConfirm()
    {
        _confirmExecute = true;
    }

    private void CloseConfirm()
    {
        _confirmExecute = false;
    }

    private async Task ConfirmExecuteAsync()
    {
        _isSubmitting = true;
        _apiError = null;

        try
        {
            await TransfersClient.ExecuteTransferAsync(
                Id,
                new ExecuteTransferRequestDto
                {
                    CommandId = Guid.NewGuid()
                });

            _confirmExecute = false;
            ToastService.ShowSuccess(L["Transfers.Execute.Toast.TransferExecutedSuccessfully"].Value);
            await LoadAsync();
        }
        catch (ApiException ex)
        {
            _confirmExecute = false;
            _apiError = ex;
            ToastService.ShowError(BuildErrorMessage(ex));
        }
        finally
        {
            _isSubmitting = false;
        }
    }

    private void BackToList()
    {
        NavigationManager.NavigateTo("/warehouse/transfers");
    }

    private Task BackToListAsync()
    {
        BackToList();
        return Task.CompletedTask;
    }

    private void DismissError()
    {
        _apiError = null;
    }

    private string GetItemName(int itemId)
        => _items.FirstOrDefault(i => i.Id == itemId) is { } item
            ? $"{item.InternalSKU} - {item.Name}"
            : $"#{itemId}";

    private string GetLocationName(int locationId)
        => _locations.FirstOrDefault(l => l.Id == locationId)?.Code
            ?? $"#{locationId}";

    private string BuildErrorMessage(ApiException ex)
    {
        if (ex.IsBusinessError && !string.IsNullOrWhiteSpace(ex.ProblemDetails?.Detail))
        {
            return ex.ProblemDetails.Detail;
        }

        if (!string.IsNullOrWhiteSpace(WarehouseErrorText.Get(L, ex)))
        {
            return WarehouseErrorText.Get(L, ex);
        }

        return ex.ProblemDetails?.Detail
               ?? ex.ProblemDetails?.Title
               ?? L["Execute.RequestFailed"].Value;
    }
}

<style>
    .transfer-execute-modal-backdrop {
        position: fixed;
        inset: 0;
        z-index: 2000;
        background: rgba(0, 0, 0, 0.45);
    }
</style>
