@page "/transfers/create"
@using LKvitai.MES.Modules.Warehouse.WebUI.Infrastructure
@using LKvitai.MES.Modules.Warehouse.WebUI.Services
@inject ItemPricesClient ItemPricesClient
@inject TransfersClient TransfersClient
@inject MasterDataAdminClient MasterDataAdminClient
@inject StockClient StockApiClient
@inject NavigationManager NavigationManager
@inject ToastService ToastService

<PageTitle>@L["Transfers.Create.CreateTransferCikadaMES"]</PageTitle>

<h1>@L["Transfers.Create.CreateTransfer"]</h1>

@if (_apiError is not null)
{
    <ErrorBanner Message="@BuildErrorMessage(_apiError)"
                 TraceId="@_apiError.TraceId"
                 OnRetry="LoadLookupDataAsync"
                 OnDismiss="DismissError" />
}

<div class="card shadow-sm position-relative">
    <LoadingSpinner IsLoading="_isLoading || _isSubmitting" />

    <div class="card-body">
        <div class="row g-3">
            <div class="col-md-3">
                <label class="form-label">@L["Common.Warehouse"]</label>
                <input class="form-control" value="@_warehouseCode" readonly />
            </div>
            <div class="col-md-3 d-flex align-items-end">
                <button class="btn btn-outline-secondary" @onclick="BackToList">@L["Common.Back"]</button>
            </div>
        </div>

        <hr />

        <div class="d-flex justify-content-between align-items-center mb-2">
            <h5 class="mb-0">@L["Transfers.Create.TransferLines"]</h5>
            <button class="btn btn-sm btn-outline-primary" @onclick="AddLine" disabled="@_isSubmitting">@L["Transfers.Create.AddLine"]</button>
        </div>

        @if (_lines.Count == 0)
        {
            <EmptyState Title="@L["Transfers.Create.NoLinesAdded"]"
                        Message="@L["Transfers.Create.NoLinesAddedAddYourFirstLine"]"
                        IconCss="bi bi-list-ul"
                        OnAction="AddLineAsync" />
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead>
                        <tr>
                            <th style="width: 35%;">@L["Common.Item"]</th>
                            <th style="width: 15%;">@L["Common.Qty"]</th>
                            <th>@L["Pricing.Cost"]</th>
                            <th>@L["Pricing.Sale"]</th>
                            <th>@L["Common.ValueCurrentCost"]</th>
                            <th style="width: 20%;">@L["Transfers.Create.FromLocation"]</th>
                            <th style="width: 20%;">@L["Common.ToLocation"]</th>
                            <th style="width: 10%;">@L["Common.Actions"]</th>
                        </tr>
                    </thead>
                    <tbody>
                        @for (var i = 0; i < _lines.Count; i++)
                        {
                            var line = _lines[i];
                            <tr>
                                <td>
                                    <ItemSearchPicker ItemId="@line.ItemId"
                                                      ItemSelected="@(item => OnLineItemSelectedAsync(line, item))" />
                                    <ItemPriceHint ItemId="@line.ItemId" />
                                </td>
                                <td>
                                    <input type="number" min="0.01" step="0.01" class="form-control" @bind="line.Qty" />
                                </td>
                                <td class="mono">@Money.FormatUnit(_priceMap.Get(line.ItemId, null)?.EffectiveCost)</td>
                                <td class="mono">@Money.Format(_priceMap.Get(line.ItemId, null)?.BasePrice)</td>
                                <td class="mono">@Money.Format(_priceMap.Value(line.Qty, line.ItemId, null))</td>
                                <td>
                                    <select class="form-select" @bind="line.FromLocationId">
                                        <option value="">@L["Transfers.Create.FromLocation764e83"]</option>
                                        @foreach (var location in _locations)
                                        {
                                            <option value="@location.Id">@location.Code (@location.Type)</option>
                                        }
                                    </select>
                                </td>
                                <td>
                                    <select class="form-select" @bind="line.ToLocationId">
                                        <option value="">@L["Transfers.Create.ToLocation"]</option>
                                        @foreach (var location in _locations)
                                        {
                                            <option value="@location.Id">@location.Code (@location.Type)</option>
                                        }
                                    </select>
                                </td>
                                <td>
                                    <button class="btn btn-sm btn-outline-danger"
                                            disabled="@(_isSubmitting || _lines.Count == 1)"
                                            @onclick="() => RemoveLine(i)">
                                        @L["Common.Remove"]
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }

        <div class="d-flex justify-content-end mt-3">
            <button class="btn btn-primary" @onclick="CreateAsync" disabled="@_isSubmitting">@L["Common.Submit"]</button>
        </div>
    </div>
</div>

@code {
    private readonly List<AdminItemDto> _items = [];
    private readonly List<AdminLocationDto> _locations = [];
    private readonly List<TransferLineModel> _lines = [];
    private PriceMap _priceMap = PriceMap.Empty;

    private bool _isLoading;
    private bool _isSubmitting;
    private ApiException? _apiError;

    private string _warehouseCode = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        _lines.Add(new TransferLineModel());
        await LoadLookupDataAsync();
    }

    private async Task LoadLookupDataAsync()
    {
        _isLoading = true;
        _apiError = null;

        try
        {
            _warehouseCode = (await StockApiClient.GetCurrentWarehouseAsync()).Code;

            var locations = await MasterDataAdminClient.GetLocationsAsync(null, "Active", true, 1, 500);
            _locations.Clear();
            _locations.AddRange(locations.Items);
        }
        catch (ApiException ex)
        {
            _apiError = ex;
            ToastService.ShowError(BuildErrorMessage(ex));
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task OnLineItemSelectedAsync(TransferLineModel line, AdminItemDto? item)
    {
        line.ItemId = item?.Id;
        if (item is not null && _items.All(x => x.Id != item.Id))
        {
            _items.Add(item);
        }

        // Prices are loaded only for the items actually picked.
        _priceMap = await ItemPricesClient.GetMapAsync(_items.Select(x => ((int?)x.Id, (string?)x.InternalSKU)));
    }

    private void AddLine()
    {
        _lines.Add(new TransferLineModel());
    }

    private Task AddLineAsync()
    {
        AddLine();
        return Task.CompletedTask;
    }

    private void RemoveLine(int index)
    {
        if (index < 0 || index >= _lines.Count || _lines.Count == 1)
        {
            return;
        }

        _lines.RemoveAt(index);
    }

    private async Task CreateAsync()
    {
        var lines = _lines
            .Where(x => x.ItemId.HasValue && x.FromLocationId.HasValue && x.ToLocationId.HasValue && x.Qty > 0m)
            .Select(x => new TransferLineDto
            {
                ItemId = x.ItemId!.Value,
                Qty = x.Qty,
                FromLocationId = x.FromLocationId!.Value,
                ToLocationId = x.ToLocationId!.Value
            })
            .ToList();

        if (lines.Count == 0)
        {
            ToastService.ShowError(L["Transfers.Create.Toast.AddAtLeastOneValidTransferLine"].Value);
            return;
        }

        if (lines.Any(x => x.FromLocationId == x.ToLocationId))
        {
            ToastService.ShowError(L["Transfers.Create.Toast.TransferLineCannotMoveToSameLocation"].Value);
            return;
        }

        _isSubmitting = true;
        _apiError = null;

        try
        {
            var request = new CreateTransferRequestDto
            {
                CommandId = Guid.NewGuid(),
                FromWarehouse = _warehouseCode,
                ToWarehouse = _warehouseCode,
                Lines = lines
            };

            var created = await TransfersClient.CreateTransferAsync(request);
            ToastService.ShowSuccess(L["Transfers.Create.Toast.TransferCreated", created.TransferNumber].Value);
            NavigationManager.NavigateTo("/warehouse/transfers");
        }
        catch (ApiException ex)
        {
            _apiError = ex;
            ToastService.ShowError(BuildErrorMessage(ex));
        }
        finally
        {
            _isSubmitting = false;
        }
    }

    private void BackToList()
    {
        NavigationManager.NavigateTo("/warehouse/transfers");
    }

    private void DismissError()
    {
        _apiError = null;
    }

    private string BuildErrorMessage(ApiException ex)
    {
        if (!string.IsNullOrWhiteSpace(WarehouseErrorText.Get(L, ex)))
        {
            return WarehouseErrorText.Get(L, ex);
        }

        return ex.ProblemDetails?.Detail
               ?? ex.ProblemDetails?.Title
               ?? L["Create.RequestFailed"].Value;
    }

    private sealed class TransferLineModel
    {
        public int? ItemId { get; set; }
        public decimal Qty { get; set; } = 1m;
        public int? FromLocationId { get; set; }
        public int? ToLocationId { get; set; }
    }
}
