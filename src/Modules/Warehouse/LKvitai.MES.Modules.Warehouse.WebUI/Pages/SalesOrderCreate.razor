@page "/sales/orders/create"
@inject SalesOrdersClient SalesOrdersClient
@inject NavigationManager NavigationManager
@inject ToastService ToastService

<PageTitle>@L["SalesOrderCreate.CreateSalesOrderCikadaMES"]</PageTitle>

<h1>@L["SalesOrderCreate.CreateSalesOrder"]</h1>

@if (_apiError is not null)
{
    <ErrorBanner Message="@BuildErrorMessage(_apiError)"
                 TraceId="@_apiError.TraceId"
                 OnRetry="LoadLookupDataAsync"
                 OnDismiss="DismissError" />
}

<div class="card shadow-sm position-relative">
    <LoadingSpinner IsLoading="_isLoading || _isSubmitting" />

    <div class="card-body">
        <div class="row g-3">
            <div class="col-md-6">
                <label class="form-label" for="customer">@L["Common.Customer"]</label>
                <select id="customer"
                        class="form-select"
                        @bind="_selectedCustomerId"
                        @bind:after="OnCustomerChangedAsync">
                    <option value="">@L["SalesOrderCreate.SelectCustomer"]</option>
                    @foreach (var customer in _customers)
                    {
                        <option value="@customer.Id">@customer.CustomerCode - @customer.Name</option>
                    }
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label" for="delivery-date">@L["SalesOrderCreate.RequestedDeliveryDate"]</label>
                <input id="delivery-date" type="date" class="form-control" @bind="_requestedDeliveryDate" />
            </div>
            <div class="col-md-3 d-flex align-items-end">
                <button class="btn btn-outline-secondary" @onclick="BackToList" disabled="@_isSubmitting">@L["SalesOrderCreate.BackToList"]</button>
            </div>
        </div>

        <hr />

        <h5>@L["SalesOrderCreate.ShippingAddress"]</h5>
        <div class="row g-2">
            <div class="col-md-6">
                <label class="form-label">@L["Common.Street"]</label>
                <input class="form-control" @bind="_shippingStreet" />
            </div>
            <div class="col-md-3">
                <label class="form-label">@L["Common.City"]</label>
                <input class="form-control" @bind="_shippingCity" />
            </div>
            <div class="col-md-3">
                <label class="form-label">@L["Common.State"]</label>
                <input class="form-control" @bind="_shippingState" />
            </div>
            <div class="col-md-3">
                <label class="form-label">@L["SalesOrderCreate.Zip"]</label>
                <input class="form-control" @bind="_shippingZipCode" />
            </div>
            <div class="col-md-3">
                <label class="form-label">@L["Common.Country"]</label>
                <input class="form-control" @bind="_shippingCountry" />
            </div>
        </div>

        <hr />

        <div class="d-flex justify-content-between align-items-center mb-2">
            <h5 class="mb-0">@L["SalesOrderCreate.OrderLines"]</h5>
            <button class="btn btn-sm btn-outline-primary" @onclick="AddLine" disabled="@_isSubmitting">@L["SalesOrderCreate.AddLine"]</button>
        </div>

        @if (_lines.Count == 0)
        {
            <EmptyState Title="@L["SalesOrderCreate.NoLinesAdded"]"
                        Message="@L["SalesOrderCreate.AddAtLeastOneLineItem"]"
                        IconCss="bi bi-list-ul"
                        OnAction="AddLineAsync" />
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead>
                        <tr>
                            <th style="width: 50%;">@L["Common.Item"]</th>
                            <th style="width: 15%;">@L["Common.Qty"]</th>
                            <th style="width: 20%;">@L["SalesOrderCreate.UnitPrice"]</th>
                            <th style="width: 15%;">@L["Common.Actions"]</th>
                        </tr>
                    </thead>
                    <tbody>
                        @for (var i = 0; i < _lines.Count; i++)
                        {
                            var line = _lines[i];
                            <tr>
                                <td>
                                    <ItemSearchPicker ItemId="@line.ItemId"
                                                      ItemSelected="@(item => OnLineItemSelectedAsync(line, item))" />
                                    <ItemPriceHint ItemId="@line.ItemId" />
                                </td>
                                <td>
                                    <input class="form-control" type="number" min="0.01" step="0.01" @bind="line.Qty" />
                                </td>
                                <td>
                                    <input class="form-control" type="number" min="0" step="0.01" @bind="line.UnitPrice" />
                                </td>
                                <td>
                                    <button class="btn btn-sm btn-outline-danger"
                                            @onclick="() => RemoveLine(i)"
                                            disabled="@(_isSubmitting || _lines.Count == 1)">
                                        @L["Common.Remove"]
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }

        <div class="d-flex justify-content-end mt-3">
            <button class="btn btn-primary" @onclick="CreateAsync" disabled="@_isSubmitting">@L["SalesOrderCreate.CreateSalesOrder"]</button>
        </div>
    </div>
</div>

@code {
    private readonly List<SalesOrderCustomerLookupDto> _customers = [];
    private readonly List<AdminItemDto> _items = [];
    private readonly List<LineFormModel> _lines = [];
    private readonly Dictionary<int, decimal> _priceOverridesByItemId = [];
    private bool _isLoading;
    private bool _isSubmitting;
    private ApiException? _apiError;

    private string _selectedCustomerId = string.Empty;
    private DateTime? _requestedDeliveryDate;

    private string _shippingStreet = string.Empty;
    private string _shippingCity = string.Empty;
    private string _shippingState = string.Empty;
    private string _shippingZipCode = string.Empty;
    private string _shippingCountry = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        _lines.Add(new LineFormModel());
        await LoadLookupDataAsync();
    }

    private async Task LoadLookupDataAsync()
    {
        _isLoading = true;
        _apiError = null;

        try
        {
            var customers = await SalesOrdersClient.GetCustomersAsync();
            _customers.Clear();
            _customers.AddRange(customers);
        }
        catch (ApiException ex)
        {
            _apiError = ex;
            ToastService.ShowError(BuildErrorMessage(ex));
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task OnCustomerChangedAsync()
    {
        _priceOverridesByItemId.Clear();

        if (!Guid.TryParse(_selectedCustomerId, out var customerId))
        {
            foreach (var line in _lines) ApplyEffectivePrice(line);
            return;
        }

        var customer = _customers.FirstOrDefault(x => x.Id == customerId);
        if (customer?.DefaultShippingAddress is not null)
        {
            _shippingStreet = customer.DefaultShippingAddress.Street;
            _shippingCity = customer.DefaultShippingAddress.City;
            _shippingState = customer.DefaultShippingAddress.State;
            _shippingZipCode = customer.DefaultShippingAddress.ZipCode;
            _shippingCountry = customer.DefaultShippingAddress.Country;
        }

        if (customer?.PriceGroupId is { } priceGroupId)
        {
            try
            {
                var overrides = await SalesOrdersClient.GetPriceGroupItemPricesAsync(priceGroupId);
                foreach (var row in overrides)
                {
                    _priceOverridesByItemId[row.ItemId] = row.Amount;
                }
            }
            catch (ApiException)
            {
                // Keep the form usable if price-group lookup fails; unit price stays manually editable.
            }
        }

        foreach (var line in _lines)
        {
            ApplyEffectivePrice(line);
        }
    }

    private Task OnLineItemSelectedAsync(LineFormModel line, AdminItemDto? item)
    {
        line.ItemId = item?.Id;
        if (item is not null && _items.All(x => x.Id != item.Id))
        {
            _items.Add(item);
        }

        ApplyEffectivePrice(line);
        return Task.CompletedTask;
    }

    private void ApplyEffectivePrice(LineFormModel line)
    {
        if (line.ItemId is not { } itemId)
        {
            line.UnitPrice = null;
            return;
        }

        if (_priceOverridesByItemId.TryGetValue(itemId, out var overrideAmount))
        {
            line.UnitPrice = overrideAmount;
            return;
        }

        var item = _items.FirstOrDefault(x => x.Id == itemId);
        line.UnitPrice = item?.BasePrice;
    }

    private void AddLine()
    {
        _lines.Add(new LineFormModel());
    }

    private Task AddLineAsync()
    {
        AddLine();
        return Task.CompletedTask;
    }

    private void RemoveLine(int index)
    {
        if (index < 0 || index >= _lines.Count || _lines.Count == 1)
        {
            return;
        }

        _lines.RemoveAt(index);
    }

    private async Task CreateAsync()
    {
        if (!Guid.TryParse(_selectedCustomerId, out var customerId))
        {
            ToastService.ShowError(L["SalesOrderCreate.Toast.SelectACustomer"].Value);
            return;
        }

        var selectedLines = _lines.Where(x => x.ItemId.HasValue).ToList();
        if (selectedLines.Any(x => !x.UnitPrice.HasValue))
        {
            ToastService.ShowError(L["SalesOrderCreate.Toast.EnterPriceForEveryItem"].Value);
            return;
        }

        if (selectedLines.Any(x => x.Qty <= 0m || x.UnitPrice < 0m))
        {
            ToastService.ShowError(L["SalesOrderCreate.Toast.AddAtLeastOneValidLineItemQty0"].Value);
            return;
        }

        var normalizedLines = selectedLines
            .Select(x => new SalesOrderLineCreateRequestDto
            {
                ItemId = x.ItemId!.Value,
                Qty = x.Qty,
                UnitPrice = x.UnitPrice!.Value
            })
            .ToList();

        if (normalizedLines.Count == 0)
        {
            ToastService.ShowError(L["SalesOrderCreate.Toast.AddAtLeastOneValidLineItemQty0"].Value);
            return;
        }

        _isSubmitting = true;
        _apiError = null;

        try
        {
            var request = new SalesOrderCreateRequestDto
            {
                CommandId = Guid.NewGuid(),
                CustomerId = customerId,
                RequestedDeliveryDate = _requestedDeliveryDate,
                ShippingAddress = BuildShippingAddress(),
                Lines = normalizedLines
            };

            var created = await SalesOrdersClient.CreateSalesOrderAsync(request);
            ToastService.ShowSuccess(L["SalesOrderCreate.Toast.SalesOrderCreated", created.OrderNumber].Value);
            NavigationManager.NavigateTo($"/warehouse/sales/orders/{created.Id}");
        }
        catch (ApiException ex)
        {
            _apiError = ex;
            ToastService.ShowError(BuildErrorMessage(ex));
        }
        finally
        {
            _isSubmitting = false;
        }
    }

    private SalesOrderAddressDto? BuildShippingAddress()
    {
        if (string.IsNullOrWhiteSpace(_shippingStreet) &&
            string.IsNullOrWhiteSpace(_shippingCity) &&
            string.IsNullOrWhiteSpace(_shippingState) &&
            string.IsNullOrWhiteSpace(_shippingZipCode) &&
            string.IsNullOrWhiteSpace(_shippingCountry))
        {
            return null;
        }

        return new SalesOrderAddressDto
        {
            Street = _shippingStreet.Trim(),
            City = _shippingCity.Trim(),
            State = _shippingState.Trim(),
            ZipCode = _shippingZipCode.Trim(),
            Country = _shippingCountry.Trim()
        };
    }

    private void BackToList()
    {
        NavigationManager.NavigateTo("/warehouse/sales/orders");
    }

    private void DismissError()
    {
        _apiError = null;
    }

    private string BuildErrorMessage(ApiException ex)
    {
        if (!string.IsNullOrWhiteSpace(WarehouseErrorText.Get(L, ex)))
        {
            return WarehouseErrorText.Get(L, ex);
        }

        return ex.ProblemDetails?.Detail
               ?? ex.ProblemDetails?.Title
               ?? L["SalesOrderCreate.RequestFailed"].Value;
    }

    private sealed class LineFormModel
    {
        public int? ItemId { get; set; }
        public decimal Qty { get; set; } = 1m;
        public decimal? UnitPrice { get; set; }
    }
}
