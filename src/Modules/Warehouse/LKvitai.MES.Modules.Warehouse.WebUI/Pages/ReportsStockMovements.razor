@page "/reports/stock-movements"
@using LKvitai.MES.Modules.Warehouse.WebUI.Infrastructure
@inject ReportsClient ReportsClient
@inject ItemPricesClient ItemPricesClient
@inject IJSRuntime JavaScript
@inject ToastService ToastService

<PageTitle>@L["ReportsStockMovements.StockMovementsCikadaMES"]</PageTitle>

<h1>@L["ReportsStockMovements.StockMovementHistory"]</h1>

@if (_apiError is not null)
{
    <ErrorBanner Message="@BuildErrorMessage(_apiError)"
                 TraceId="@_apiError.TraceId"
                 OnRetry="LoadAsync"
                 OnDismiss="DismissError" />
}

<div class="card shadow-sm mb-3">
    <div class="card-body">
        <div class="row g-2 align-items-end">
            <div class="col-md-2">
                <label class="form-label">@L["Common.Start"]</label>
                <input type="date" class="form-control" @bind="_startDate" />
            </div>
            <div class="col-md-2">
                <label class="form-label">@L["Common.End"]</label>
                <input type="date" class="form-control" @bind="_endDate" />
            </div>
            <div class="col-md-1">
                <label class="form-label">@L["Common.ItemID"]</label>
                <input type="number" class="form-control" @bind="_itemId" />
            </div>
            <div class="col-md-1">
                <label class="form-label">@L["Common.LocationId"]</label>
                <input type="number" class="form-control" @bind="_locationId" />
            </div>
            <div class="col-md-2">
                <label class="form-label">@L["Common.Operator"]</label>
                <input class="form-control" @bind="_operatorId" />
            </div>
            <div class="col-md-2">
                <label class="form-label">@L["ReportsStockMovements.MovementType"]</label>
                <select class="form-select" @bind="_movementType">
                    <option value="">@L["Common.All"]</option>
                    <option value="Receive">@L["Common.Receive"]</option>
                    <option value="Transfer">@L["ReportsStockMovements.Transfer"]</option>
                    <option value="Pick">@L["Common.Pick"]</option>
                    <option value="Adjust">@L["ReportsStockMovements.Adjust"]</option>
                    <option value="Dispatch">@L["ReportsStockMovements.Dispatch"]</option>
                </select>
            </div>
            <div class="col-md-2 d-flex gap-2">
                <button class="btn btn-primary" @onclick="ApplyFiltersAsync" disabled="@_isLoading">@L["Common.Apply"]</button>
                <button class="btn btn-outline-success" @onclick="ExportCsvAsync" disabled="@_isLoading">CSV</button>
            </div>
        </div>
    </div>
</div>

<div class="card shadow-sm position-relative">
    <LoadingSpinner IsLoading="_isLoading" />

    <div class="card-body">
        <div class="mb-2"><strong>@L["ReportsStockMovements.Total", _totalCount]</strong></div>

        <div class="table-responsive">
            <table class="table table-sm table-hover align-middle">
                <thead>
                    <tr>
                        <th>@L["Common.Timestamp"]</th>
                        <th>@L["Common.Type"]</th>
                        <th>SKU</th>
                        <th>@L["Common.From"]</th>
                        <th>@L["Common.To"]</th>
                        <th>@L["Common.Qty"]</th>
                        <th class="text-end" title="@L["Pricing.CurrentPriceHint"]">@L["Pricing.Cost"]</th>
                        <th class="text-end" title="@L["Pricing.CurrentPriceHint"]">@L["Pricing.Sale"]</th>
                        <th class="text-end">@L["Common.ValueCurrentCost"]</th>
                        <th>@L["Common.Operator"]</th>
                        <th>@L["Common.Reason"]</th>
                        <th>@L["Common.Reference"]</th>
                    </tr>
                </thead>
                <tbody>
                    @if (_rows.Count == 0)
                    {
                        <tr>
                            <td colspan="12" class="text-muted">@L["ReportsStockMovements.NoStockMovementsFound"]</td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var row in _rows)
                        {
                            <tr>
                                <td>@row.Timestamp.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</td>
                                <td>@row.MovementType</td>
                                <td>@row.ItemSku</td>
                                <td>@(row.FromLocationCode ?? "-")</td>
                                <td>@(row.ToLocationCode ?? "-")</td>
                                <td>@row.Qty.ToString("0.##") @row.BaseUoM</td>
                                <td class="text-end is-money is-num">@Money.FormatUnit(row.UnitCost)</td>
                                <td class="text-end is-money is-num">@Money.Format(_priceMap.Get(row.ItemId, row.ItemSku)?.BasePrice)</td>
                                <td class="text-end is-money is-num">@Money.Format(row.Value)</td>
                                <td>@(row.Operator ?? "-")</td>
                                <td>@(row.Reason ?? "-")</td>
                                <td>@row.Reference</td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>

        @if (_totalCount > 0)
        {
            <Pagination CurrentPage="_page"
                        TotalPages="TotalPages"
                        PageSize="_pageSize"
                        OnPageChanged="OnPageChangedAsync"
                        OnPageSizeChanged="OnPageSizeChangedAsync" />
        }
    </div>
</div>

@code {
    private readonly List<StockMovementRowDto> _rows = [];
    private PriceMap _priceMap = PriceMap.Empty;
    private ApiException? _apiError;
    private bool _isLoading;

    private DateTime? _startDate = DateTime.UtcNow.AddDays(-7);
    private DateTime? _endDate = DateTime.UtcNow;
    private int? _itemId;
    private int? _locationId;
    private string _operatorId = string.Empty;
    private string _movementType = string.Empty;
    private int _page = 1;
    private int _pageSize = 50;
    private int _totalCount;

    private int TotalPages => Math.Max(1, (int)Math.Ceiling(_totalCount / (double)Math.Max(1, _pageSize)));

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private async Task ApplyFiltersAsync()
    {
        _page = 1;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _isLoading = true;
        _apiError = null;

        try
        {
            var result = await ReportsClient.GetStockMovementsAsync(
                ParseDateOffset(_startDate, true),
                ParseDateOffset(_endDate, false),
                _itemId,
                _locationId,
                _operatorId,
                _movementType,
                _page,
                _pageSize);

            _rows.Clear();
            _rows.AddRange(result.Movements);
            _priceMap = await ItemPricesClient.GetMapAsync(_rows.Select(x => ((int?)x.ItemId, (string?)x.ItemSku)));
            _totalCount = result.TotalCount;
        }
        catch (ApiException ex)
        {
            _apiError = ex;
            ToastService.ShowError(BuildErrorMessage(ex));
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task ExportCsvAsync()
    {
        try
        {
            var bytes = await ReportsClient.DownloadStockMovementsCsvAsync(
                ParseDateOffset(_startDate, true),
                ParseDateOffset(_endDate, false),
                _itemId,
                _locationId,
                _operatorId,
                _movementType);

            await JavaScript.InvokeVoidAsync(
                "csvExport.downloadBytes",
                $"stock-movements-{DateTime.UtcNow:yyyyMMdd}.csv",
                "text/csv",
                Convert.ToBase64String(bytes));
        }
        catch (ApiException ex)
        {
            _apiError = ex;
            ToastService.ShowError(BuildErrorMessage(ex));
        }
    }

    private async Task OnPageChangedAsync(int page)
    {
        _page = Math.Max(1, page);
        await LoadAsync();
    }

    private async Task OnPageSizeChangedAsync(int size)
    {
        _pageSize = Math.Clamp(size, 1, 500);
        _page = 1;
        await LoadAsync();
    }

    private static DateTimeOffset? ParseDateOffset(DateTime? input, bool startOfDay)
    {
        if (!input.HasValue)
        {
            return null;
        }

        var date = input.Value.Date;
        var value = startOfDay
            ? new DateTimeOffset(date, TimeSpan.Zero)
            : new DateTimeOffset(date.AddDays(1).AddTicks(-1), TimeSpan.Zero);

        return value;
    }

    private void DismissError()
    {
        _apiError = null;
    }

    private string BuildErrorMessage(ApiException ex)
    {
        if (!string.IsNullOrWhiteSpace(WarehouseErrorText.Get(L, ex)))
        {
            return WarehouseErrorText.Get(L, ex);
        }

        return ex.ProblemDetails?.Detail
               ?? ex.ProblemDetails?.Title
               ?? L["ReportsStockMovements.RequestFailed"].Value;
    }
}
