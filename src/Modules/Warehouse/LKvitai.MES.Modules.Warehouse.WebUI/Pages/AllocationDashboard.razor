@page "/sales/allocations"
@inject SalesOrdersClient SalesOrdersClient
@inject NavigationManager NavigationManager
@inject ToastService ToastService

<PageTitle>@L["AllocationDashboard.AllocationDashboardCikadaMES"]</PageTitle>

<h1>@L["AllocationDashboard.Title"]</h1>

@if (_apiError is not null)
{
    <ErrorBanner Message="@BuildErrorMessage(_apiError)"
                 TraceId="@_apiError.TraceId"
                 OnRetry="LoadAsync"
                 OnDismiss="DismissError" />
}

<div class="d-flex justify-content-end mb-2">
    <button class="btn btn-outline-secondary" @onclick="LoadAsync" disabled="@(_isLoading || _isBusy)">@L["Common.Refresh"]</button>
</div>

<div class="card shadow-sm mb-3 position-relative">
    <LoadingSpinner IsLoading="_isLoading || _isBusy" />
    <div class="card-body">
        <h5>@L["AllocationDashboard.PendingApprovals"]</h5>
        <div class="table-responsive">
            <table class="table table-sm align-middle">
                <thead>
                    <tr>
                        <th>@L["Common.Order"]</th>
                        <th>@L["Common.Customer"]</th>
                        <th>@L["Common.TotalAmount"]</th>
                        <th>@L["Common.Created"]</th>
                        <th>@L["Common.Actions"]</th>
                    </tr>
                </thead>
                <tbody>
                    @if (_pendingApprovals.Count == 0)
                    {
                        <tr><td colspan="5" class="text-muted">@L["AllocationDashboard.NoOrdersPendingApproval"]</td></tr>
                    }
                    else
                    {
                        @foreach (var order in _pendingApprovals)
                        {
                            <tr>
                                <td><a href="@($"/warehouse/sales/orders/{order.Id}")">@order.OrderNumber</a></td>
                                <td>@order.CustomerName</td>
                                <td class="is-money is-num">@Money.Format(order.TotalAmount)</td>
                                <td>@order.OrderDate.ToString("yyyy-MM-dd HH:mm")</td>
                                <td>
                                    <button class="btn btn-sm btn-warning"
                                            @onclick="() => ApproveAsync(order.Id, order.OrderNumber)"
                                            disabled="@_isBusy">
                                        @L["Common.Approve"]
                                    </button>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<div class="card shadow-sm mb-3 position-relative">
    <LoadingSpinner IsLoading="_isLoading || _isBusy" />
    <div class="card-body">
        <h5>@L["AllocationDashboard.PendingStock"]</h5>
        <div class="table-responsive">
            <table class="table table-sm align-middle">
                <thead>
                    <tr>
                        <th>@L["Common.Order"]</th>
                        <th>@L["Common.Customer"]</th>
                        <th>@L["Common.Lines"]</th>
                        <th>@L["Common.TotalAmount"]</th>
                        <th>@L["Common.Actions"]</th>
                    </tr>
                </thead>
                <tbody>
                    @if (_pendingStock.Count == 0)
                    {
                        <tr><td colspan="5" class="text-muted">@L["AllocationDashboard.NoOrdersPendingStock"]</td></tr>
                    }
                    else
                    {
                        @foreach (var order in _pendingStock)
                        {
                            <tr>
                                <td><a href="@($"/warehouse/sales/orders/{order.Id}")">@order.OrderNumber</a></td>
                                <td>@order.CustomerName</td>
                                <td>@order.Lines.Count</td>
                                <td class="is-money is-num">@Money.Format(order.TotalAmount)</td>
                                <td>
                                    <button class="btn btn-sm btn-outline-secondary" @onclick="() => OpenOrder(order.Id)">
                                        @L["Common.View"]
                                    </button>
                                    <button class="btn btn-sm btn-outline-warning ms-1" disabled title="@L["AllocationDashboard.ManualReallocateEndpointIsNotAvailableInCurrentAPISurface"]">
                                        @L["AllocationDashboard.Reallocate"]
                                    </button>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<div class="card shadow-sm position-relative">
    <LoadingSpinner IsLoading="_isLoading || _isBusy" />
    <div class="card-body">
        <h5>@L["AllocationDashboard.AllocatedOrders"]</h5>
        <div class="table-responsive">
            <table class="table table-sm align-middle">
                <thead>
                    <tr>
                        <th>@L["Common.Order"]</th>
                        <th>@L["Common.Customer"]</th>
                        <th>@L["Common.Reservation"]</th>
                        <th>@L["Common.TotalAmount"]</th>
                        <th>@L["Common.Actions"]</th>
                    </tr>
                </thead>
                <tbody>
                    @if (_allocated.Count == 0)
                    {
                        <tr><td colspan="5" class="text-muted">@L["AllocationDashboard.NoAllocatedOrders"]</td></tr>
                    }
                    else
                    {
                        @foreach (var order in _allocated)
                        {
                            <tr>
                                <td><a href="@($"/warehouse/sales/orders/{order.Id}")">@order.OrderNumber</a></td>
                                <td>@order.CustomerName</td>
                                <td>@(order.ReservationId?.ToString() ?? "-")</td>
                                <td class="is-money is-num">@Money.Format(order.TotalAmount)</td>
                                <td>
                                    <button class="btn btn-sm btn-primary"
                                            @onclick="() => ReleaseAsync(order.Id, order.OrderNumber)"
                                            disabled="@_isBusy">
                                        @L["AllocationDashboard.ReleaseToPicking"]
                                    </button>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@code {
    private readonly List<SalesOrderDto> _pendingApprovals = [];
    private readonly List<SalesOrderDto> _pendingStock = [];
    private readonly List<SalesOrderDto> _allocated = [];
    private ApiException? _apiError;
    private bool _isLoading;
    private bool _isBusy;

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _isLoading = true;
        _apiError = null;

        try
        {
            var pendingApprovals = await SalesOrdersClient.GetSalesOrdersAsync(
                "PENDING_APPROVAL",
                null,
                null,
                null,
                1,
                100);

            var pendingStock = await SalesOrdersClient.GetSalesOrdersAsync(
                "PENDING_STOCK",
                null,
                null,
                null,
                1,
                100);

            var allocated = await SalesOrdersClient.GetSalesOrdersAsync(
                "ALLOCATED",
                null,
                null,
                null,
                1,
                100);

            _pendingApprovals.Clear();
            _pendingApprovals.AddRange(pendingApprovals.Items.OrderByDescending(x => x.OrderDate));

            _pendingStock.Clear();
            _pendingStock.AddRange(pendingStock.Items.OrderByDescending(x => x.OrderDate));

            _allocated.Clear();
            _allocated.AddRange(allocated.Items.OrderByDescending(x => x.OrderDate));
        }
        catch (ApiException ex)
        {
            _apiError = ex;
            ToastService.ShowError(BuildErrorMessage(ex));
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task ApproveAsync(Guid id, string orderNumber)
    {
        _isBusy = true;
        _apiError = null;

        try
        {
            await SalesOrdersClient.ApproveSalesOrderAsync(id);
            ToastService.ShowSuccess(L["AllocationDashboard.Toast.OrderApproved", orderNumber].Value);
            await LoadAsync();
        }
        catch (ApiException ex)
        {
            _apiError = ex;
            ToastService.ShowError(BuildErrorMessage(ex));
        }
        finally
        {
            _isBusy = false;
        }
    }

    private async Task ReleaseAsync(Guid id, string orderNumber)
    {
        _isBusy = true;
        _apiError = null;

        try
        {
            await SalesOrdersClient.ReleaseSalesOrderAsync(id);
            ToastService.ShowSuccess(L["AllocationDashboard.Toast.OrderReleasedToPicking", orderNumber].Value);
            await LoadAsync();
        }
        catch (ApiException ex)
        {
            _apiError = ex;
            ToastService.ShowError(BuildErrorMessage(ex));
        }
        finally
        {
            _isBusy = false;
        }
    }

    private void OpenOrder(Guid id)
    {
        NavigationManager.NavigateTo($"/warehouse/sales/orders/{id}");
    }

    private void DismissError()
    {
        _apiError = null;
    }

    private string BuildErrorMessage(ApiException ex)
    {
        if (!string.IsNullOrWhiteSpace(WarehouseErrorText.Get(L, ex)))
        {
            return WarehouseErrorText.Get(L, ex);
        }

        return ex.ProblemDetails?.Detail
               ?? ex.ProblemDetails?.Title
               ?? L["AllocationDashboard.RequestFailed"].Value;
    }
}
