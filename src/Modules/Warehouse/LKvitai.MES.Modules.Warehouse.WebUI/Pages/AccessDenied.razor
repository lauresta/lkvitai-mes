@page "/access-denied"
@layout LoginLayout
@attribute [Microsoft.AspNetCore.Authorization.AllowAnonymous]

<PageTitle>@L["AccessDenied.AccessDeniedCikadaMES"]</PageTitle>

<section class="login-panel">
    <div class="login-brand">
        <img src="_content/LKvitai.MES.BuildingBlocks.WebUI/brand/icon-512.png" alt="Cikada.MES" />
        <div>
            <h1>@L["AccessDenied.AccessDenied"]</h1>
            <p>@L["AccessDenied.YourAccountDoesNotHavePermissionToOpenThisPage"]</p>
        </div>
    </div>

    <a class="btn btn-primary w-100" href="dashboard">@L["AccessDenied.BackToDashboard"]</a>
</section>
