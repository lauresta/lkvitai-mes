@page "/reports/traceability"
@inject ReportsClient ReportsClient
@inject ItemPricesClient ItemPricesClient
@inject ToastService ToastService

<PageTitle>@L["ReportsTraceability.TraceabilityCikadaMES"]</PageTitle>

<h1>@L["ReportsTraceability.ReportLotToOrder"]</h1>

@if (_apiError is not null)
{
    <ErrorBanner Message="@BuildErrorMessage(_apiError)"
                 TraceId="@_apiError.TraceId"
                 OnRetry="SearchAsync"
                 OnDismiss="DismissError" />
}

<div class="card shadow-sm mb-3">
    <div class="card-body">
        <div class="row g-2 align-items-end">
            <div class="col-md-3">
                <label class="form-label">@L["Common.LotNumber"]</label>
                <input class="form-control" @bind="_lotNumber" placeholder="LOT-2026-001" />
            </div>
            <div class="col-md-3">
                <label class="form-label">@L["ReportsTraceability.ItemSKU"]</label>
                <input class="form-control" @bind="_itemSku" placeholder="FG-0001" />
            </div>
            <div class="col-md-3">
                <label class="form-label">@L["ReportsTraceability.SalesOrder"]</label>
                <input class="form-control" @bind="_salesOrder" placeholder="SO-0001" />
            </div>
            <div class="col-md-3">
                <label class="form-label">@L["Common.Supplier"]</label>
                <input class="form-control" @bind="_supplier" placeholder="ACME" />
            </div>
            <div class="col-md-12 d-flex gap-2 mt-2">
                <button class="btn btn-primary" @onclick="SearchAsync" disabled="@_isLoading">@L["Common.Search"]</button>
                <button class="btn btn-outline-secondary" @onclick="ResetAsync" disabled="@_isLoading">@L["Common.Reset"]</button>
            </div>
        </div>
    </div>
</div>

<div class="card shadow-sm position-relative">
    <LoadingSpinner IsLoading="_isLoading" />

    <div class="card-body">
        @if (_entries.Count == 0)
        {
            <EmptyState Title="@L["ReportsTraceability.NoTraceabilityEntries"]"
                        Message="@L["ReportsTraceability.SetAtLeastOneFilterAndRunSearch"]"
                        IconCss="bi bi-diagram-3"
                        OnAction="SearchAsync" />
        }
        else
        {
            @foreach (var entry in _entries)
            {
                <div class="border rounded p-3 mb-3">
                    <div class="d-flex justify-content-between flex-wrap gap-2 mb-2">
                        <div>
                            <div class="fw-semibold">@L["ReportsTraceability.Lot", entry.Lot.LotNumber]</div>
                            <div class="small text-muted">@entry.Lot.ItemSku - @entry.Lot.ItemName</div>
                            <div class="small">
                                @L["Pricing.Cost"]: <span class="is-money is-num">@Money.Format(_priceMap.Get(null, entry.Lot.ItemSku)?.EffectiveCost)</span>
                                &middot; @L["Pricing.Sale"]: <span class="is-money is-num">@Money.Format(_priceMap.Get(null, entry.Lot.ItemSku)?.BasePrice)</span>
                            </div>
                        </div>
                        @if (entry.IsApproximate)
                        {
                            <span class="badge bg-warning text-dark">@L["ReportsTraceability.ApproximateLinkage"]</span>
                        }
                    </div>

                    <div class="row g-2">
                        <div class="col-md-4">
                            <div class="border rounded p-2 h-100">
                                <div class="small text-muted mb-1">@L["ReportsTraceability.Upstream"]</div>
                                @if (entry.Upstream is null)
                                {
                                    <div class="text-muted">@L["ReportsTraceability.NoReceivingSourceFound"]</div>
                                }
                                else
                                {
                                    <div>@L["ReportsTraceability.Supplier", entry.Upstream.Supplier]</div>
                                    <div>@L["ReportsTraceability.Shipment", entry.Upstream.InboundShipment]</div>
                                    <div>@L["ReportsTraceability.Receipt", entry.Upstream.ReceiptDate.ToLocalTime().ToString("yyyy-MM-dd HH:mm")]</div>
                                    <div>@L["ReportsTraceability.Qty", entry.Upstream.QtyReceived.ToString("0.##")]</div>
                                }
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="border rounded p-2 h-100">
                                <div class="small text-muted mb-1">@L["ReportsTraceability.Current"]</div>
                                <div>@L["ReportsTraceability.Location", entry.Current.Location ?? "-"]</div>
                                <div>@L["ReportsTraceability.AvailableQty", entry.Current.AvailableQty.ToString("0.##")]</div>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="border rounded p-2 h-100">
                                <div class="small text-muted mb-1">@L["ReportsTraceability.DownstreamSales"]</div>
                                @if (entry.Downstream.SalesOrders.Count == 0)
                                {
                                    <div class="text-muted">@L["ReportsTraceability.NoShippedSalesOrdersFound"]</div>
                                }
                                else
                                {
                                    @foreach (var so in entry.Downstream.SalesOrders)
                                    {
                                        <div class="mb-1">
                                            <div class="fw-semibold">@so.OrderNumber (@so.Customer)</div>
                                            <div class="small text-muted">@L["ReportsTraceability.QtyShipped", so.QtyShipped.ToString("0.##"), so.ShippedDate?.ToLocalTime().ToString("yyyy-MM-dd") ?? "-"]</div>
                                            <div class="small text-muted">@L["ReportsTraceability.Tracking", so.TrackingNumber ?? "-"]</div>
                                        </div>
                                    }
                                }
                            </div>
                        </div>
                    </div>
                </div>
            }
        }
    </div>
</div>

@code {
    private readonly List<TraceabilityEntryResponseDto> _entries = [];
    private PriceMap _priceMap = PriceMap.Empty;
    private ApiException? _apiError;
    private bool _isLoading;

    private string _lotNumber = string.Empty;
    private string _itemSku = string.Empty;
    private string _salesOrder = string.Empty;
    private string _supplier = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        await SearchAsync();
    }

    private async Task SearchAsync()
    {
        _isLoading = true;
        _apiError = null;

        try
        {
            var result = await ReportsClient.GetTraceabilityAsync(_lotNumber, _itemSku, _salesOrder, _supplier);
            _entries.Clear();
            _entries.AddRange(result.Entries);
            _priceMap = await ItemPricesClient.GetMapAsync(_entries.Select(x => ((int?)null, (string?)x.Lot.ItemSku)));
        }
        catch (ApiException ex)
        {
            _apiError = ex;
            ToastService.ShowError(BuildErrorMessage(ex));
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task ResetAsync()
    {
        _lotNumber = string.Empty;
        _itemSku = string.Empty;
        _salesOrder = string.Empty;
        _supplier = string.Empty;
        await SearchAsync();
    }

    private void DismissError()
    {
        _apiError = null;
    }

    private string BuildErrorMessage(ApiException ex)
    {
        if (!string.IsNullOrWhiteSpace(WarehouseErrorText.Get(L, ex)))
        {
            return WarehouseErrorText.Get(L, ex);
        }

        return ex.ProblemDetails?.Detail
               ?? ex.ProblemDetails?.Title
               ?? L["ReportsTraceability.RequestFailed"].Value;
    }
}
