@page "/locations/{Id:int}"

<PageTitle>@L["WarehouseLocationDetail.LocationDetails"]</PageTitle>

<h1>@L["WarehouseLocationDetail.LocationDetails"]</h1>
<p class="text-muted">@L["WarehouseLocationDetail.LocationID", Id]</p>
<p>
    @L["WarehouseLocationDetail.ManageLocationMetadataInTheAdminLocationWorkspace"]
</p>
<a class="btn btn-outline-secondary" href="admin/locations">@L["WarehouseLocationDetail.OpenAdminLocations"]</a>

@code {
    [Parameter]
    public int Id { get; set; }
}
