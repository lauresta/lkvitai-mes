@page "/outbound/orders/{Id:guid}"
@inject OutboundClient OutboundClient
@inject NavigationManager NavigationManager
@inject ToastService ToastService
@using LKvitai.MES.Modules.Warehouse.WebUI.Infrastructure
@using LKvitai.MES.Modules.Warehouse.WebUI.Services
@inject ItemPricesClient ItemPricesClient

<PageTitle>@L["OutboundOrderDetail.OutboundOrderDetailCikadaMES"]</PageTitle>

<h1>@L["OutboundOrderDetail.OutboundOrderDetail"]</h1>

@if (_apiError is not null)
{
    <ErrorBanner Message="@BuildErrorMessage(_apiError)"
                 TraceId="@_apiError.TraceId"
                 OnRetry="ReloadAsync"
                 OnDismiss="DismissError" />
}

<div class="card shadow-sm position-relative">
    <LoadingSpinner IsLoading="_isLoading" />

    <div class="card-body">
        @if (_order is null && !_isLoading)
        {
            <p class="text-muted mb-0">@L["OutboundOrderDetail.OrderNotFound"]</p>
        }
        else if (_order is not null)
        {
            <div class="d-flex justify-content-between flex-wrap gap-2 mb-3">
                <div>
                    <h4 class="mb-1">@_order.OrderNumber</h4>
                    <div class="text-muted">@L["OutboundOrderDetail.Customer", _order.CustomerName ?? "-"]</div>
                </div>
                <div class="d-flex gap-2">
                    <button class="btn btn-outline-secondary" @onclick="BackToList">@L["Common.Back"]</button>
                    @if (CanPack)
                    {
                        <button class="btn btn-primary" @onclick="OpenPackingStation">@L["OutboundOrderDetail.OpenPackingStation"]</button>
                    }
                </div>
            </div>

            <dl class="row mb-3">
                <dt class="col-sm-3">@L["Common.Status"]</dt>
                <dd class="col-sm-9"><span class="badge @GetStatusBadgeClass(_order.Status)">@WarehouseStatusText.Get(L, _order.Status)</span></dd>

                <dt class="col-sm-3">@L["OutboundOrderDetail.OrderDate"]</dt>
                <dd class="col-sm-9">@FormatDate(_order.OrderDate)</dd>

                <dt class="col-sm-3">@L["OutboundOrderDetail.RequestedShipDate"]</dt>
                <dd class="col-sm-9">@FormatDate(_order.RequestedShipDate)</dd>

                <dt class="col-sm-3">@L["OutboundOrderDetail.ReservationId"]</dt>
                <dd class="col-sm-9"><code>@_order.ReservationId</code></dd>

                @if (_order.Shipment is not null)
                {
                    <dt class="col-sm-3">@L["Common.Shipment"]</dt>
                    <dd class="col-sm-9">
                        @_order.Shipment.ShipmentNumber
                        @if (!string.IsNullOrWhiteSpace(_order.Shipment.TrackingNumber))
                        {
                            <span class="ms-2 text-muted">@L["OutboundOrderDetail.Tracking", _order.Shipment.TrackingNumber]</span>
                        }
                    </dd>
                }
            </dl>

            <div class="table-responsive mb-3">
                <table class="table table-sm align-middle">
                    <thead>
                        <tr>
                            <th>@L["Common.Item"]</th>
                            <th>@L["Common.Barcode"]</th>
                            <th>@L["Common.Qty"]</th>
                            <th class="text-end">@L["Pricing.Cost"]</th>
                            <th class="text-end">@L["Pricing.Sale"]</th>
                            <th class="text-end">@L["Common.Value"]</th>
                            <th>@L["Common.Picked"]</th>
                            <th>@L["Common.Shipped"]</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var line in _order.Lines)
                        {
                            var salePrice = line.SaleUnitPrice ?? _priceMap.Get(line.ItemId, line.ItemSku)?.BasePrice;
                            <tr>
                                <td>
                                    <strong>@line.ItemSku</strong><br />
                                    <span class="text-muted">@line.ItemName</span>
                                </td>
                                <td>@(line.PrimaryBarcode ?? "-")</td>
                                <td>@line.Qty</td>
                                <td class="text-end is-money is-num">@Money.Format(_priceMap.Get(line.ItemId, line.ItemSku)?.EffectiveCost)</td>
                                <td class="text-end is-money is-num">@Money.Format(salePrice)</td>
                                <td class="text-end is-money is-num">@Money.Format(salePrice * line.Qty)</td>
                                <td>@line.PickedQty</td>
                                <td>@line.ShippedQty</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            @if (_order.SalesOrderId.HasValue)
            {
                <div class="border rounded p-3 bg-light-subtle">
                    <h5 class="mb-3">@L["OutboundOrderDetail.OrderActions"]</h5>

                    <div class="d-flex flex-wrap gap-2 mb-2">
                        @if (CanRelease)
                        {
                            <button class="btn btn-outline-primary" @onclick="ReleaseAsync" disabled="@_isSubmitting">@L["OutboundOrderDetail.Release"]</button>
                        }

                        @if (CanCancel)
                        {
                            <button class="btn btn-outline-danger" @onclick="CancelAsync" disabled="@_isSubmitting">@L["Common.Cancel"]</button>
                        }
                    </div>

                    @if (CanCancel)
                    {
                        <label class="form-label" for="cancel-reason">@L["OutboundOrderDetail.CancellationReason"]</label>
                        <input id="cancel-reason" class="form-control" type="text" @bind="_cancelReason" />
                    }
                </div>
            }
        }
    </div>
</div>

@code {
    [Parameter]
    public Guid Id { get; set; }

    private OutboundOrderDetailDto? _order;
    private PriceMap _priceMap = PriceMap.Empty;
    private bool _isLoading;
    private bool _isSubmitting;
    private ApiException? _apiError;
    private string _cancelReason = "Customer requested cancellation";

    protected override async Task OnParametersSetAsync()
    {
        await ReloadAsync();
    }

    private async Task ReloadAsync()
    {
        _isLoading = true;
        _apiError = null;

        try
        {
            _order = await OutboundClient.GetOutboundOrderAsync(Id);
            _priceMap = await ItemPricesClient.GetMapAsync(_order.Lines.Select(x => ((int?)x.ItemId, (string?)x.ItemSku)));
        }
        catch (ApiException ex)
        {
            _apiError = ex;
            _order = null;
        }
        finally
        {
            _isLoading = false;
        }
    }

    private void DismissError()
    {
        _apiError = null;
    }

    private void BackToList()
    {
        NavigationManager.NavigateTo("/warehouse/outbound/orders");
    }

    private void OpenPackingStation()
    {
        NavigationManager.NavigateTo($"/warehouse/outbound/pack/{Id}");
    }

    private async Task ReleaseAsync()
    {
        if (_isSubmitting)
        {
            return;
        }

        if (_order?.SalesOrderId is null)
        {
            return;
        }

        _isSubmitting = true;

        try
        {
            await OutboundClient.ReleaseSalesOrderAsync(_order.SalesOrderId.Value);
            ToastService.ShowSuccess(L["OutboundOrderDetail.Toast.OrderReleasedSuccessfully"].Value);
            await ReloadAsync();
        }
        catch (ApiException ex)
        {
            _apiError = ex;
            ToastService.ShowError(BuildErrorMessage(ex));
        }
        finally
        {
            _isSubmitting = false;
        }
    }

    private async Task CancelAsync()
    {
        if (_isSubmitting)
        {
            return;
        }

        if (_order?.SalesOrderId is null)
        {
            return;
        }

        if (string.IsNullOrWhiteSpace(_cancelReason))
        {
            ToastService.ShowError(L["OutboundOrderDetail.Toast.CancellationReasonIsRequired"].Value);
            return;
        }

        _isSubmitting = true;

        try
        {
            await OutboundClient.CancelSalesOrderAsync(_order.SalesOrderId.Value, _cancelReason.Trim());
            ToastService.ShowSuccess(L["OutboundOrderDetail.Toast.OrderCancelledSuccessfully"].Value);
            await ReloadAsync();
        }
        catch (ApiException ex)
        {
            _apiError = ex;
            ToastService.ShowError(BuildErrorMessage(ex));
        }
        finally
        {
            _isSubmitting = false;
        }
    }

    private bool CanPack => _order is not null &&
                            string.Equals(_order.Status, "PICKED", StringComparison.OrdinalIgnoreCase);

    private bool CanRelease => _order is not null &&
                               _order.SalesOrderId.HasValue &&
                               string.Equals(_order.Status, "ALLOCATED", StringComparison.OrdinalIgnoreCase);

    private bool CanCancel => _order is not null &&
                              _order.SalesOrderId.HasValue &&
                              !string.Equals(_order.Status, "SHIPPED", StringComparison.OrdinalIgnoreCase) &&
                              !string.Equals(_order.Status, "DELIVERED", StringComparison.OrdinalIgnoreCase) &&
                              !string.Equals(_order.Status, "CANCELLED", StringComparison.OrdinalIgnoreCase);

    private static string FormatDate(DateTimeOffset? value)
        => value.HasValue ? value.Value.ToLocalTime().ToString("yyyy-MM-dd HH:mm") : "-";

    private string BuildErrorMessage(ApiException ex)
        => !string.IsNullOrWhiteSpace(WarehouseErrorText.Get(L, ex))
            ? WarehouseErrorText.Get(L, ex)
            : "Request failed.";

    private static string GetStatusBadgeClass(string status)
        => status.ToUpperInvariant() switch
        {
            "ALLOCATED" => "bg-info text-dark",
            "PICKING" => "bg-primary",
            "PICKED" => "bg-secondary",
            "PACKED" => "bg-warning text-dark",
            "SHIPPED" => "bg-success",
            "DELIVERED" => "bg-success",
            "CANCELLED" => "bg-danger",
            _ => "bg-light text-dark"
        };
}
