@page "/admin/lots"
@using LKvitai.MES.Modules.Warehouse.WebUI.Infrastructure
@using LKvitai.MES.Modules.Warehouse.WebUI.Services
@inject ItemPricesClient ItemPricesClient
@inject LotsClient LotsClient
@using System.Diagnostics

<PageTitle>@L["Admin.Lots.LotsCikadaMES"]</PageTitle>

<div data-testid="lots-page">
<h3>@L["Admin.Lots.Lots"]</h3>

@if (_apiError is not null)
{
    <div data-testid="lots-error">
        <ErrorBanner Message="@BuildErrorMessage(_apiError)"
                     TraceId="@_apiError.TraceId"
                     OnRetry="LoadAsync"
                     OnDismiss="@(() => _apiError = null)" />
    </div>
}

<MudPaper Outlined="true" Elevation="0" Class="panel lots-list-panel lots-filter">
    <div class="lk-toolbar lots-filter-toolbar">
        <div class="lk-field--filter lots-field lots-field--grow lots-filter__search" data-testid="lots-search">
            <MudTextField T="string"
                          Variant="Variant.Outlined"
                          Margin="Margin.Dense"
                          @bind-Value="_search"
                          Placeholder="@L["Admin.Lots.LotNumberSKUItemName"]"
                          InputAttributes="@LotsFilterSearchAttributes" />
        </div>
        <div class="lk-field--filter lots-field lots-filter__status">
            <MudSelect T="string"
                       Variant="Variant.Outlined"
                       Margin="Margin.Dense"
                       @bind-Value="_status"
                       InputAttributes="@LotsFilterStatusAttributes">
                <MudSelectItem T="string" Value="@string.Empty">@L["Common.All"]</MudSelectItem>
                <MudSelectItem T="string" Value="@("Active")">@L["Common.Active"]</MudSelectItem>
                <MudSelectItem T="string" Value="@("ExpiringSoon")">@L["Common.ExpiringSoon"]</MudSelectItem>
                <MudSelectItem T="string" Value="@("Expired")">@L["Admin.Lots.Expired"]</MudSelectItem>
                <MudSelectItem T="string" Value="@("Depleted")">@L["Admin.Lots.Depleted"]</MudSelectItem>
            </MudSelect>
        </div>
        <div class="lk-field--filter lots-field lots-filter__page-size">
            <div data-testid="lots-page-size">
                <MudSelect T="int"
                           Variant="Variant.Outlined"
                           Margin="Margin.Dense"
                           Value="@_pageSize"
                           ValueChanged="OnPageSizeChangedAsync"
                           InputAttributes="@LotsPageSizeAttributes">
                    <MudSelectItem T="int" Value="25">25</MudSelectItem>
                    <MudSelectItem T="int" Value="50">50</MudSelectItem>
                    <MudSelectItem T="int" Value="100">100</MudSelectItem>
                </MudSelect>
            </div>
        </div>
        <div class="lots-filter__actions">
            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       OnClick="ApplyFiltersAsync"
                       UserAttributes="@LotsSearchButtonAttributes">
                @L["Common.Filter"]
            </MudButton>
            <MudButton Variant="Variant.Outlined"
                       Color="Color.Primary"
                       OnClick="RefreshAsync"
                       UserAttributes="@LotsRefreshAttributes">
                @L["Common.Refresh"]
            </MudButton>
        </div>
    </div>

    <div class="lots-grid-head">
        <strong data-testid="lots-summary">@L["Admin.Lots.Total", _totalCount]</strong>
        <span class="mono" data-testid="lots-current-page">@L["Admin.Lots.Page", _currentPage]</span>
    </div>

    <MudDataGrid T="LotListItemDto"
                 @ref="_grid"
                 @key="_gridRenderKey"
                 ServerData="LoadServerDataAsync"
                 Filterable="false"
                 SortMode="SortMode.Single"
                 Dense="true"
                 Hover="true"
                 RowsPerPage="@_pageSize"
                 Loading="@_isLoading"
                 Class="lk-grid lots-grid"
                 @attributes="@LotsGridAttributes">
        <Columns>
            <PropertyColumn Property="x => x.LotNumber" Title="@L["Common.Lot"]" />
            <TemplateColumn Title="@L["Common.Item"]">
                <CellTemplate>
                    @($"{context.Item.ItemSku} - {context.Item.ItemName}")
                </CellTemplate>
            </TemplateColumn>
            <TemplateColumn Title="@L["Common.Qty"]">
                <CellTemplate>@context.Item.Qty.ToString("0.###")</CellTemplate>
            </TemplateColumn>
            <TemplateColumn Title="@L["Pricing.Cost"]">
                <CellTemplate><span class="is-money is-num">@Money.FormatUnit(_priceMap.Get(null, context.Item.ItemSku)?.EffectiveCost)</span></CellTemplate>
            </TemplateColumn>
            <TemplateColumn Title="@L["Pricing.Sale"]">
                <CellTemplate><span class="is-money is-num">@Money.Format(_priceMap.Get(null, context.Item.ItemSku)?.BasePrice)</span></CellTemplate>
            </TemplateColumn>
            <TemplateColumn Title="@L["Common.Value"]">
                <CellTemplate><span class="is-money is-num">@Money.Format(_priceMap.Value(context.Item.Qty, null, context.Item.ItemSku))</span></CellTemplate>
            </TemplateColumn>
            <TemplateColumn Title="@L["Common.Reserved"]">
                <CellTemplate>@context.Item.ReservedQty.ToString("0.###")</CellTemplate>
            </TemplateColumn>
            <TemplateColumn Title="@L["Common.Available"]">
                <CellTemplate>@context.Item.AvailableQty.ToString("0.###")</CellTemplate>
            </TemplateColumn>
            <PropertyColumn Property="x => x.BaseUom" Title="UoM" />
            <TemplateColumn Title="@L["Admin.Lots.Production"]">
                <CellTemplate>@FormatDate(context.Item.ProductionDate)</CellTemplate>
            </TemplateColumn>
            <TemplateColumn Title="@L["Common.Expiry"]">
                <CellTemplate>@FormatDate(context.Item.ExpiryDate)</CellTemplate>
            </TemplateColumn>
            <PropertyColumn Property="x => x.Status" Title="@L["Common.Status"]" />
        </Columns>
        <NoRecordsContent>
            <div class="lots-grid__empty">
                <span class="lots-grid__empty-title">@L["Admin.Lots.NoLotsFound"]</span>
                <span>
                    No lots match the current filter.
                    @if (HasAppliedFilters)
                    {
                        <button type="button" class="lots-grid__empty-action" @onclick="ClearFiltersAsync">@L["Common.ClearFilters"]</button>
                    }
                </span>
            </div>
        </NoRecordsContent>
        <PagerContent>
            <div class="lots-pager" data-testid="lots-pager">
                <MudDataGridPager T="LotListItemDto" />
            </div>
        </PagerContent>
    </MudDataGrid>
</MudPaper>
</div>

@code {
    private MudDataGrid<LotListItemDto>? _grid;
    private PriceMap _priceMap = PriceMap.Empty;
    private string _search = string.Empty;
    private string _status = string.Empty;
    private string? _appliedSearch;
    private string? _appliedStatus;
    private int _pageSize = 50;
    private int _totalCount;
    private int _currentPage = 1;
    private int _gridRenderKey;
    private bool _isLoading;
    private ApiException? _apiError;

    private static readonly Dictionary<string, object> LotsGridAttributes = new() { ["data-testid"] = "lots-grid" };
    private Dictionary<string, object> LotsFilterSearchAttributes => new() { ["data-testid"] = "lots-search-input", ["aria-label"] = L["Aria.Search"].Value };
    private Dictionary<string, object> LotsFilterStatusAttributes => new() { ["data-testid"] = "lots-status", ["aria-label"] = L["Aria.Status"].Value };
    private Dictionary<string, object> LotsPageSizeAttributes => new() { ["data-testid"] = "lots-page-size", ["aria-label"] = L["Aria.PageSize"].Value };
    private static readonly Dictionary<string, object> LotsRefreshAttributes = new() { ["data-testid"] = "lots-refresh" };
    private static readonly Dictionary<string, object> LotsSearchButtonAttributes = new() { ["data-testid"] = "lots-search-btn" };

    private async Task ApplyFiltersAsync()
    {
        _appliedSearch = string.IsNullOrWhiteSpace(_search) ? null : _search.Trim();
        _appliedStatus = string.IsNullOrWhiteSpace(_status) ? null : _status;
        _gridRenderKey++;
        await InvokeAsync(StateHasChanged);
    }

    private async Task OnPageSizeChangedAsync(int pageSize)
    {
        _pageSize = Math.Clamp(pageSize, 1, 500);
        _gridRenderKey++;
        await InvokeAsync(StateHasChanged);
    }

    private bool HasAppliedFilters =>
        !string.IsNullOrWhiteSpace(_appliedSearch) || !string.IsNullOrWhiteSpace(_appliedStatus);

    private async Task ClearFiltersAsync()
    {
        _search = string.Empty;
        _status = string.Empty;
        _appliedSearch = null;
        _appliedStatus = null;
        _gridRenderKey++;
        await InvokeAsync(StateHasChanged);
    }

    private async Task RefreshAsync()
    {
        if (_grid is null)
        {
            return;
        }

        await _grid.ReloadServerData();
    }

    private Task LoadAsync() => RefreshAsync();

    private async Task<GridData<LotListItemDto>> LoadServerDataAsync(GridState<LotListItemDto> state)
    {
        _isLoading = true;
        _apiError = null;
        _currentPage = state.Page + 1;

        var requestedPageSize = state.PageSize > 0 ? state.PageSize : _pageSize;
        _pageSize = requestedPageSize;

        try
        {
            var result = await LotsClient.GetLotsAsync(_appliedSearch, _appliedStatus, state.Page + 1, requestedPageSize);
            _priceMap = await ItemPricesClient.GetMapAsync(result.Items.Select(x => ((int?)null, (string?)x.ItemSku)));
            _totalCount = result.TotalCount;

            return new GridData<LotListItemDto>
            {
                Items = result.Items,
                TotalItems = result.TotalCount
            };
        }
        catch (ApiException ex)
        {
            _apiError = ex;
            _totalCount = 0;

            return new GridData<LotListItemDto>
            {
                Items = Array.Empty<LotListItemDto>(),
                TotalItems = 0
            };
        }
        catch (Exception ex)
        {
            _apiError = new ApiException(
                new ProblemDetailsModel
                {
                    Title = "Lots query failed",
                    Detail = ex.Message,
                    Status = 500,
                    TraceId = Activity.Current?.Id
                },
                500);
            _totalCount = 0;

            return new GridData<LotListItemDto>
            {
                Items = Array.Empty<LotListItemDto>(),
                TotalItems = 0
            };
        }
        finally
        {
            _isLoading = false;
        }
    }

    private static string FormatDate(DateOnly? value)
        => value?.ToString("yyyy-MM-dd") ?? "-";

    private string BuildErrorMessage(ApiException error)
    {
        if (!string.IsNullOrWhiteSpace(error.ProblemDetails?.Detail))
        {
            return $"{WarehouseErrorText.Get(L, error)} {error.ProblemDetails.Detail}";
        }

        return WarehouseErrorText.Get(L, error);
    }
}
