@page "/cross-dock"
@inject AdvancedWarehouseClient AdvancedClient
@inject ToastService ToastService
@using LKvitai.MES.Modules.Warehouse.WebUI.Infrastructure
@using LKvitai.MES.Modules.Warehouse.WebUI.Services
@inject ItemPricesClient ItemPricesClient

<PageTitle>@L["CrossDock.CrossDockCikadaMES"]</PageTitle>


<h3>@L["CrossDock.CrossDockTracking"]</h3>

@if (_error is not null)
{
    <ErrorBanner Message="@WarehouseErrorText.Get(L, _error)"
                 TraceId="@_error.TraceId"
                 OnRetry="LoadAsync"
                 OnDismiss="DismissError" />
}

<div class="card shadow-sm mb-3">
    <div class="card-body">
        <h5>@L["CrossDock.CreateCrossDockMatch"]</h5>
        <div class="row g-2 align-items-end">
            <div class="col-md-3">
                <label class="form-label">@L["CrossDock.InboundShipmentLineId"]</label>
                <input class="form-control" @bind="_inboundId" type="number" min="1" />
            </div>
            <div class="col-md-3">
                <label class="form-label">@L["CrossDock.OutboundOrderId"]</label>
                <input class="form-control" @bind="_outboundId" placeholder="GUID" />
            </div>
            <div class="col-md-2">
                <label class="form-label">@L["Common.ItemID"]</label>
                <input class="form-control" type="number" @bind="_itemId" />
            </div>
            <div class="col-md-2">
                <label class="form-label">@L["Common.Qty"]</label>
                <input class="form-control" type="number" step="0.01" @bind="_qty" />
            </div>
            <div class="col-md-2">
                <button class="btn btn-primary w-100" @onclick="CreateAsync" disabled="@_isBusy">@L["Common.Create"]</button>
            </div>
        </div>
    </div>
</div>

<div class="card shadow-sm">
    <div class="card-body">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h5 class="mb-0">@L["CrossDock.CrossDockQueue"]</h5>
            <button class="btn btn-outline-secondary btn-sm" @onclick="LoadAsync" disabled="@_isBusy">@L["Common.Refresh"]</button>
        </div>

        @if (_rows.Count == 0)
        {
            <EmptyState Title="@L["CrossDock.NoCrossDockRecords"]"
                        Message="@L["CrossDock.LinkOnly"]"
                        IconCss="bi bi-arrow-left-right"
                        OnAction="LoadAsync" />
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-sm align-middle">
                    <thead>
                        <tr>
                            <th>@L["CrossDock.Number"]</th>
                            <th>@L["Common.Item"]</th>
                            <th>@L["Common.Qty"]</th>
                            <th class="text-end">@L["Pricing.Cost"]</th>
                            <th class="text-end">@L["Pricing.Sale"]</th>
                            <th class="text-end">@L["Common.Value"]</th>
                            <th>@L["Common.Status"]</th>
                            <th>@L["Common.Created"]</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var row in _rows)
                        {
                            <tr>
                                <td>@row.CrossDockNumber</td>
                                <td>@row.ItemId</td>
                                <td>@row.Qty</td>
                                <td class="text-end is-money is-num">@Money.FormatUnit(_priceMap.Get(row.ItemId, null)?.EffectiveCost)</td>
                                <td class="text-end is-money is-num">@Money.Format(_priceMap.Get(row.ItemId, null)?.BasePrice)</td>
                                <td class="text-end is-money is-num">@Money.Format(_priceMap.Value(row.Qty, row.ItemId, null))</td>
                                <td><span class="badge bg-secondary">@WarehouseStatusText.Get(L, row.Status)</span></td>
                                <td>@row.CreatedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</td>
                                <td class="d-flex gap-1">
                                    <button class="btn btn-sm btn-outline-success" @onclick='() => SetStatusAsync(row.Id, "MATCHED")'>@L["CrossDock.Match"]</button>
                                    <button class="btn btn-sm btn-outline-primary" @onclick='() => SetStatusAsync(row.Id, "COMPLETED")'>@L["Common.Complete"]</button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

@code {
    private readonly List<CrossDockDto> _rows = [];
    private PriceMap _priceMap = PriceMap.Empty;
    private string _inboundId = string.Empty;
    private string _outboundId = string.Empty;
    private int _itemId = 1;
    private decimal _qty = 1;
    private ApiException? _error;
    private bool _isBusy;

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        await ExecuteAsync(async () =>
        {
            var rows = await AdvancedClient.GetCrossDocksAsync();
            _rows.Clear();
            _rows.AddRange(rows);
            _priceMap = await ItemPricesClient.GetMapAsync(_rows.Select(x => ((int?)x.ItemId, (string?)null)));
        });
    }

    private async Task CreateAsync()
    {
        if (!int.TryParse(_inboundId, out var inboundId) || inboundId <= 0 || !Guid.TryParse(_outboundId, out var outboundId))
        {
            ToastService.ShowError(L["CrossDock.Toast.InvalidLinkIds"].Value);
            return;
        }

        await ExecuteAsync(async () =>
        {
            await AdvancedClient.CreateCrossDockAsync(new CrossDockCreateRequestDto(inboundId, outboundId, _itemId, _qty));
            ToastService.ShowSuccess(L["CrossDock.Toast.CrossDockRecordCreated"].Value);
            _inboundId = string.Empty;
            _outboundId = string.Empty;
            await LoadAsync();
        });
    }

    private async Task SetStatusAsync(Guid id, string status)
    {
        await ExecuteAsync(async () =>
        {
            await AdvancedClient.UpdateCrossDockStatusAsync(id, status);
            await LoadAsync();
        });
    }

    private async Task ExecuteAsync(Func<Task> action)
    {
        _isBusy = true;
        _error = null;

        try
        {
            await action();
        }
        catch (ApiException ex)
        {
            _error = ex;
            ToastService.ShowError(WarehouseErrorText.Get(L, ex));
        }
        finally
        {
            _isBusy = false;
        }
    }

    private void DismissError()
    {
        _error = null;
    }
}
