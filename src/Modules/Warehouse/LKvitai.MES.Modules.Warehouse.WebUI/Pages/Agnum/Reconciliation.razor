@page "/agnum/reconcile"
@using LKvitai.MES.Modules.Warehouse.WebUI.Infrastructure
@using LKvitai.MES.Modules.Warehouse.WebUI.Models
@using LKvitai.MES.Modules.Warehouse.WebUI.Services
@inject AgnumClient AgnumClient
@inject ItemPricesClient ItemPricesClient

<PageTitle>@L["Agnum.Reconciliation.AgnumReconciliation"]</PageTitle>

<h1>@L["Agnum.Reconciliation.AgnumReconciliation"]</h1>

@if (_apiError is not null)
{
    <ErrorBanner Message="@BuildErrorMessage(_apiError)"
                 TraceId="@_apiError.TraceId"
                 OnRetry="LoadReconciliationAsync"
                 OnDismiss="DismissError" />
}

<div class="card shadow-sm position-relative">
    <LoadingSpinner IsLoading="_isLoading" />

    <div class="card-body">
        <div class="row g-3 align-items-end">
            <div class="col-12 col-md-4">
                <label class="form-label">@L["Agnum.Reconciliation.VirtualWarehouse"]</label>
                <select class="form-select" @bind="_selectedSndId" @bind:after="LoadReconciliationAsync">
                    @foreach (var warehouse in _warehouses)
                    {
                        <option value="@warehouse.SndId">
                            @warehouse.AgnumName (@warehouse.SndId) - @warehouse.MesVirtualWarehouseCode
                        </option>
                    }
                </select>
            </div>
            <div class="col-12 col-md-4">
                <label class="form-label">@L["Common.Search"]</label>
                <input class="form-control" @bind="_search" @bind:event="oninput" @bind:after="LoadVisiblePricesAsync" placeholder="@L["Agnum.Reconciliation.SKUOrProductName"]" />
            </div>
            <div class="col-12 col-md-2">
                <div class="form-check">
                    <input id="only-discrepancies"
                           class="form-check-input"
                           type="checkbox"
                           @bind="_onlyDiscrepancies" />
                    <label class="form-check-label" for="only-discrepancies">@L["Agnum.Reconciliation.OnlyShowDiscrepancies"]</label>
                </div>
            </div>
            <div class="col-12 col-md-2 d-flex gap-2">
                <button class="btn btn-outline-secondary" type="button" @onclick="LoadAsync" disabled="@_isLoading">@L["Common.Refresh"]</button>
            </div>
        </div>

        <div class="d-flex flex-wrap gap-3 text-muted small mt-3">
            <span>@L["Agnum.Reconciliation.Rows", FilteredRows.Count]</span>
            <span>@L["Agnum.Reconciliation.VirtualSummary", FilteredRows.Sum(x => x.VirtualQty).ToString("0.###")]</span>
            <span>@L["Agnum.Reconciliation.DistributedSummary", FilteredRows.Sum(x => x.DistributedQty).ToString("0.###")]</span>
            <span>@L["Agnum.Reconciliation.MesPhysicalSummary", FilteredRows.Sum(x => x.MesPhysicalQty).ToString("0.###")]</span>
            <span>@L["Agnum.Reconciliation.DeltaSummary", FilteredRows.Sum(x => x.Delta).ToString("0.###")]</span>
        </div>

        <div class="table-responsive mt-3">
            <table class="table table-sm align-middle">
                <thead>
                <tr>
                    <th>@L["Agnum.Reconciliation.AgnumCode"]</th>
                    <th>@L["Agnum.Reconciliation.SKUMES"]</th>
                    <th>@L["Agnum.Reconciliation.ItemName"]</th>
                    <th class="text-end">@L["Agnum.Reconciliation.VirtualBalanceAgnum"]</th>
                    <th class="text-end">@L["Agnum.Reconciliation.DistributedToMES"]</th>
                    <th class="text-end">@L["Common.Remaining"]</th>
                    <th class="text-end">@L["Agnum.Reconciliation.MESPhysicalActual"]</th>
                    <th class="text-end">@L["Agnum.Reconciliation.Delta"]</th>
                    <th class="text-end">@L["Pricing.Cost"]</th>
                    <th class="text-end">@L["Pricing.Sale"]</th>
                    <th class="text-end">@L["Common.ValueCurrentCost"]</th>
                    <th>@L["Common.Status"]</th>
                </tr>
                </thead>
                <tbody>
                @if (FilteredRows.Count == 0)
                {
                    <tr>
                        <td colspan="12" class="text-muted py-3">@L["Agnum.Reconciliation.NoReconciliationRowsFound"]</td>
                    </tr>
                }
                else
                {
                    @foreach (var row in FilteredRows.Take(500))
                    {
                        <tr>
                            <td class="font-monospace">@row.AgnumCode</td>
                            <td class="font-monospace">@(row.Sku ?? "-")</td>
                            <td>@(row.ItemName ?? "-")</td>
                            <td class="text-end">@row.VirtualQty.ToString("0.###")</td>
                            <td class="text-end">@row.DistributedQty.ToString("0.###")</td>
                            <td class="text-end">@row.RemainingQty.ToString("0.###")</td>
                            <td class="text-end">@row.MesPhysicalQty.ToString("0.###")</td>
                            <td class="text-end">
                                <span class="@GetDeltaChipClass(row.Delta)">@row.Delta.ToString("0.###")</span>
                            </td>
                            <td class="text-end is-money is-num">@Money.Format(_priceMap.Get(null, row.Sku)?.EffectiveCost)</td>
                            <td class="text-end is-money is-num">@Money.Format(_priceMap.Get(null, row.Sku)?.BasePrice)</td>
                            <td class="text-end is-money is-num">@Money.Format(_priceMap.Value(row.Delta, null, row.Sku))</td>
                            <td><span class="@GetStatusChipClass(row.Status)">@WarehouseStatusText.Get(L, row.Status)</span></td>
                        </tr>
                    }
                }
                </tbody>
            </table>
        </div>

        @if (FilteredRows.Count > 500)
        {
            <div class="text-muted small">@L["Agnum.Reconciliation.ShowingFirst500RowsUseSearchToNarrowTheList"]</div>
        }
    </div>
</div>

@code {
    private const decimal DeltaTolerance = 0.0001m;

    private readonly List<AgnumVirtualWarehouseDto> _warehouses = [];
    private IReadOnlyList<AgnumReconciliationRowDto> _rows = Array.Empty<AgnumReconciliationRowDto>();
    private PriceMap _priceMap = PriceMap.Empty;
    private ApiException? _apiError;
    private bool _isLoading;
    private bool _onlyDiscrepancies = true;
    private int _selectedSndId;
    private string? _search;

    private List<AgnumReconciliationRowDto> FilteredRows
    {
        get
        {
            IEnumerable<AgnumReconciliationRowDto> query = _rows;

            if (_onlyDiscrepancies)
            {
                query = query.Where(x => Math.Abs(x.Delta) > DeltaTolerance || x.Status == "NotLinked");
            }

            if (!string.IsNullOrWhiteSpace(_search))
            {
                var term = _search.Trim();
                query = query.Where(x =>
                    (x.Sku?.Contains(term, StringComparison.OrdinalIgnoreCase) ?? false)
                    || (x.ItemName?.Contains(term, StringComparison.OrdinalIgnoreCase) ?? false)
                    || x.AgnumCode.Contains(term, StringComparison.OrdinalIgnoreCase));
            }

            return query.ToList();
        }
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _isLoading = true;
        _apiError = null;

        try
        {
            _warehouses.Clear();
            _warehouses.AddRange(await AgnumClient.GetVirtualWarehousesAsync());
            if (_selectedSndId <= 0)
            {
                _selectedSndId = _warehouses.FirstOrDefault(x => x.IsImportEnabled)?.SndId
                    ?? _warehouses.FirstOrDefault()?.SndId
                    ?? 0;
            }

            await LoadReconciliationAsync();
        }
        catch (ApiException ex)
        {
            _apiError = ex;
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task LoadReconciliationAsync()
    {
        if (_selectedSndId <= 0)
        {
            _rows = Array.Empty<AgnumReconciliationRowDto>();
            return;
        }

        _isLoading = true;
        _apiError = null;

        try
        {
            _rows = await AgnumClient.GetReconciliationDataAsync(_selectedSndId);
            await LoadVisiblePricesAsync();
        }
        catch (ApiException ex)
        {
            _apiError = ex;
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task LoadVisiblePricesAsync()
    {
        _priceMap = await ItemPricesClient.GetMapAsync(
            FilteredRows.Take(500).Select(x => ((int?)null, x.Sku)));
    }

    private void DismissError()
    {
        _apiError = null;
    }

    private static string GetDeltaChipClass(decimal delta)
    {
        if (delta > DeltaTolerance)
        {
            return "chip chip--ok";
        }

        if (delta < -DeltaTolerance)
        {
            return "chip chip--danger";
        }

        return "chip chip--slate";
    }

    private static string GetStatusChipClass(string status)
        => status switch
        {
            "Matched" => "chip chip--ok",
            "Over" => "chip chip--info",
            "Under" => "chip chip--danger",
            "NotLinked" => "chip chip--slate",
            _ => "chip chip--slate"
        };

    private string BuildErrorMessage(ApiException ex)
        => WarehouseErrorText.Get(L, ex)
           ?? ex.ProblemDetails?.Detail
           ?? ex.ProblemDetails?.Title
           ?? L["Reconciliation.RequestFailed"].Value;
}
