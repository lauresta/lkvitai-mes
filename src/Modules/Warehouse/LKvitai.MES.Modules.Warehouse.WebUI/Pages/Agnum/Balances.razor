@page "/agnum/balances"
@using LKvitai.MES.Modules.Warehouse.WebUI.Infrastructure
@using LKvitai.MES.Modules.Warehouse.WebUI.Models
@using LKvitai.MES.Modules.Warehouse.WebUI.Services
@inject AgnumClient AgnumClient
@inject MasterDataAdminClient MasterDataAdminClient
@inject ItemPricesClient ItemPricesClient
@inject StockClient StockClient

<PageTitle>@L["Agnum.Balances.AgnumBalances"]</PageTitle>

<h1>@L["Agnum.Balances.AgnumBalances"]</h1>

@if (_apiError is not null)
{
    <ErrorBanner Message="@BuildErrorMessage(_apiError)"
                 TraceId="@_apiError.TraceId"
                 OnRetry="LoadAsync"
                 OnDismiss="DismissError" />
}

<div class="card shadow-sm position-relative">
    <LoadingSpinner IsLoading="_isLoading" />

    <div class="card-body">
        <div class="row g-3 align-items-end">
            <div class="col-12 col-md-4">
                <label class="form-label">@L["Agnum.Balances.VirtualWarehouse"]</label>
                <select class="form-select" @bind="_selectedSndId" @bind:after="LoadBalancesAsync">
                    @foreach (var warehouse in _warehouses)
                    {
                        <option value="@warehouse.SndId">
                            @warehouse.AgnumName (@warehouse.SndId) - @warehouse.MesVirtualWarehouseCode
                        </option>
                    }
                </select>
            </div>
            <div class="col-12 col-md-4">
                <label class="form-label">@L["Common.Search"]</label>
                <input class="form-control" @bind="_search" @bind:event="oninput" @bind:after="LoadVisiblePricesAsync" placeholder="@L["Agnum.Balances.SKUOrAgnumProductId"]" />
            </div>
            <div class="col-12 col-md-4 d-flex gap-2">
                <button class="btn btn-outline-secondary" type="button" @onclick="LoadAsync" disabled="@_isLoading">@L["Common.Refresh"]</button>
            </div>
        </div>

        <div class="d-flex flex-wrap gap-3 text-muted small mt-3">
            <span>@L["Agnum.Balances.Rows", FilteredRows.Count]</span>
            <span>@L["Agnum.Balances.TotalQty", FilteredRows.Sum(x => x.Quantity).ToString("0.###")]</span>
            <span>@L["Agnum.Balances.DisplayedValue"] <span class="is-money is-num">@Money.Format(VisibleValue)</span></span>
            <span>@L["Pricing.WithoutCost", FilteredRows.Take(500).Count(x => x.Quantity != 0m && !_priceMap.Value(x.Quantity, x.ItemId, x.Sku).HasValue)]</span>
            <span>@L["Agnum.Balances.DistributedSummary", FilteredRows.Sum(x => x.DistributedQty).ToString("0.###")]</span>
            <span>@L["Agnum.Balances.Remaining", FilteredRows.Sum(x => x.RemainingQty).ToString("0.###")]</span>
            <span>@L["Agnum.Balances.MesPhysicalSummary", FilteredRows.Sum(x => x.MesPhysicalQty).ToString("0.###")]</span>
            @if (_balances?.ImportedAt is not null)
            {
                <span>@L["Agnum.Balances.Imported9c7986", _balances.ImportedAt.Value.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss")]</span>
            }
            @if (_balances?.RunId is not null)
            {
                <span>@L["Agnum.Balances.Run", _balances.RunId]</span>
            }
        </div>

        <div class="table-responsive mt-3">
            <table class="table table-sm align-middle">
                <thead>
                <tr>
                    <th>SKU</th>
                    <th>@L["Agnum.Balances.AgnumProduct"]</th>
                    <th>@L["Agnum.Balances.MESItem"]</th>
                    <th class="text-end">@L["Common.Quantity"]</th>
                    <th class="text-end">@L["Pricing.Cost"]</th>
                    <th class="text-end">@L["Pricing.Sale"]</th>
                    <th class="text-end">@L["Common.Value"]</th>
                    <th class="text-end">@L["Agnum.Balances.Distributed"]</th>
                    <th class="text-end">@L["Common.Remaining"]</th>
                    <th class="text-end">@L["Agnum.Balances.MESPhysical"]</th>
                    <th class="text-end">@L["Agnum.Balances.Delta"]</th>
                    <th>@L["Agnum.Balances.Locations"]</th>
                    <th>UoM</th>
                    <th>@L["Agnum.Balances.Imported"]</th>
                    <th></th>
                </tr>
                </thead>
                <tbody>
                @if (FilteredRows.Count == 0)
                {
                    <tr>
                        <td colspan="15" class="text-muted py-3">@L["Agnum.Balances.NoAgnumBalancesFound"]</td>
                    </tr>
                }
                else
                {
                    @foreach (var row in FilteredRows.Take(500))
                    {
                        <tr>
                            <td class="font-monospace">@row.Sku</td>
                            <td class="font-monospace">@row.AgnumProductId</td>
                            <td>@(row.ItemId?.ToString() ?? "-")</td>
                            <td class="text-end">@row.Quantity.ToString("0.###")</td>
                            <td class="text-end is-money is-num">@Money.FormatUnit(_priceMap.Get(row.ItemId, row.Sku)?.EffectiveCost)</td>
                            <td class="text-end is-money is-num">@Money.Format(_priceMap.Get(row.ItemId, row.Sku)?.BasePrice)</td>
                            <td class="text-end is-money is-num">@Money.Format(_priceMap.Value(row.Quantity, row.ItemId, row.Sku))</td>
                            <td class="text-end">@row.DistributedQty.ToString("0.###")</td>
                            <td class="text-end">@row.RemainingQty.ToString("0.###")</td>
                            <td class="text-end">@row.MesPhysicalQty.ToString("0.###")</td>
                            <td class="text-end">
                                <span class="@GetDeltaChipClass(row.MesPhysicalQty - row.DistributedQty)">
                                    @((row.MesPhysicalQty - row.DistributedQty).ToString("0.###"))
                                </span>
                            </td>
                            <td>
                                @if (row.MesLocations.Count == 0)
                                {
                                    <span class="text-muted">-</span>
                                }
                                else
                                {
                                    @foreach (var location in row.MesLocations.Take(2))
                                    {
                                        <a class="font-monospace me-2"
                                           href="@BuildLocationHref(row, location)">
                                            @location.LocationCode (@location.Qty.ToString("0.###"))
                                        </a>
                                    }
                                    @if (row.MesLocations.Count > 2)
                                    {
                                        <span class="chip chip--slate">@L["Agnum.Balances.More", row.MesLocations.Count - 2]</span>
                                    }
                                }
                            </td>
                            <td>@row.Uom</td>
                            <td>@row.ImportedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss")</td>
                            <td class="text-end">
                                <button class="btn btn-sm btn-outline-primary"
                                        type="button"
                                        disabled="@string.IsNullOrWhiteSpace(row.Sku)"
                                        @onclick="() => BeginDistributionAsync(row)">
                                    @L["Agnum.Balances.Distribute"]
                                </button>
                            </td>
                        </tr>
                    }
                }
                </tbody>
            </table>
        </div>

        @if (_distributionRow is not null)
        {
            <div class="border rounded p-3 mt-3 bg-light">
                <div class="d-flex justify-content-between align-items-start gap-3">
                    <div>
                        <div class="fw-semibold">@L["Agnum.Balances.Distributeaf448a", _distributionRow.Sku ?? "-"]</div>
                        <div class="text-muted small">
                            @L["Agnum.Balances.RemainingFromAgnumProduct", _distributionRow.RemainingQty.ToString("0.###"), _distributionRow.Uom, _distributionRow.AgnumProductId]
                        </div>
                    </div>
                    <button class="btn-close" type="button" aria-label="@L["Common.Close"]" @onclick="CancelDistribution"></button>
                </div>

                <div class="row g-3 align-items-end mt-1">
                    <div class="col-12 col-md-4">
                        <label class="form-label">@L["Common.Warehouse"]</label>
                        <input class="form-control" value="@_distributionWarehouse?.Code" readonly />
                    </div>
                    <div class="col-12 col-md-4">
                        <label class="form-label">@L["Common.Location"]</label>
                        <select class="form-select" @bind="_distributionLocationCode" disabled="@(_isLoadingLocations || _distributionLocations.Count == 0)">
                            <option value="">@L["Common.SelectLocation"]</option>
                            @foreach (var location in _distributionLocations)
                            {
                                <option value="@location.Code">@location.Code (@location.Type)</option>
                            }
                        </select>
                    </div>
                    <div class="col-12 col-md-2">
                        <label class="form-label">@L["Common.Quantity"]</label>
                        <input class="form-control"
                               type="number"
                               min="0.0001"
                               max="@_distributionRow.RemainingQty"
                               step="0.0001"
                               @bind="_distributionQuantity" />
                    </div>
                    <div class="col-12 col-md-2 d-flex gap-2">
                        <button class="btn btn-primary"
                                type="button"
                                disabled="@(!CanSubmitDistribution)"
                                @onclick="SubmitDistributionAsync">
                            @L["Common.Submit"]
                        </button>
                    </div>
                </div>

                @if (!string.IsNullOrWhiteSpace(_distributionMessage))
                {
                    <div class="text-muted small mt-2">@_distributionMessage</div>
                }
            </div>
        }

        @if (FilteredRows.Count > 500)
        {
            <div class="text-muted small">@L["Agnum.Balances.ShowingFirst500RowsUseSearchToNarrowTheList"]</div>
        }
    </div>
</div>

@code {
    private readonly List<AgnumVirtualWarehouseDto> _warehouses = [];
    private AgnumBalancesResponseDto? _balances;
    private PriceMap _priceMap = PriceMap.Empty;
    private ApiException? _apiError;
    private bool _isLoading;
    private bool _isSubmittingDistribution;
    private bool _isLoadingLocations;
    private int _selectedSndId;
    private string? _search;
    private AdminWarehouseDto? _distributionWarehouse;
    private readonly List<AdminLocationDto> _distributionLocations = [];
    private AgnumBalanceRowDto? _distributionRow;
    private string _distributionLocationCode = string.Empty;
    private decimal _distributionQuantity;
    private string? _distributionMessage;

    private bool CanSubmitDistribution =>
        !_isSubmittingDistribution
        && _distributionRow is not null
        && _distributionWarehouse is not null
        && !string.IsNullOrWhiteSpace(_distributionLocationCode)
        && _distributionQuantity > 0m
        && _distributionQuantity <= _distributionRow.RemainingQty;

    private List<AgnumBalanceRowDto> FilteredRows
    {
        get
        {
            var rows = _balances?.Balances ?? Array.Empty<AgnumBalanceRowDto>();
            if (string.IsNullOrWhiteSpace(_search))
            {
                return rows.ToList();
            }

            var term = _search.Trim();
            return rows
                .Where(x =>
                    (x.Sku?.Contains(term, StringComparison.OrdinalIgnoreCase) ?? false)
                    || x.AgnumProductId.ToString().Contains(term, StringComparison.OrdinalIgnoreCase))
                .ToList();
        }
    }

    private decimal? VisibleValue
    {
        get
        {
            var rows = FilteredRows.Take(500).ToList();
            if (rows.Count == 0) return null;

            var values = rows.Where(x => x.Quantity != 0m)
                .Select(x => _priceMap.Value(x.Quantity, x.ItemId, x.Sku)).ToList();
            return values.Sum(x => x ?? 0m);
        }
    }

    private async Task LoadVisiblePricesAsync()
    {
        var rows = FilteredRows.Take(500).ToList();
        _priceMap = await ItemPricesClient.GetMapAsync(rows.Select(x => (x.ItemId, x.Sku)));
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _isLoading = true;
        _apiError = null;

        try
        {
            _warehouses.Clear();
            _warehouses.AddRange(await AgnumClient.GetVirtualWarehousesAsync());
            // The warehouse is not a choice: stock is distributed to the one configured warehouse.
            var current = await StockClient.GetCurrentWarehouseAsync();
            var warehouses = await MasterDataAdminClient.GetWarehousesAsync(null, "Active", false, 1, 200);
            _distributionWarehouse = warehouses.Items.FirstOrDefault(x =>
                string.Equals(x.Code, current.Code, StringComparison.OrdinalIgnoreCase));
            if (_selectedSndId <= 0)
            {
                _selectedSndId = _warehouses.FirstOrDefault(x => x.IsImportEnabled)?.SndId
                    ?? _warehouses.FirstOrDefault()?.SndId
                    ?? 0;
            }

            await LoadBalancesAsync();
        }
        catch (ApiException ex)
        {
            _apiError = ex;
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task LoadBalancesAsync()
    {
        if (_selectedSndId <= 0)
        {
            _balances = null;
            _priceMap = PriceMap.Empty;
            return;
        }

        _isLoading = true;
        _apiError = null;

        try
        {
            _balances = await AgnumClient.GetBalancesAsync(_selectedSndId);
            await LoadVisiblePricesAsync();
            _distributionRow = null;
            _distributionLocations.Clear();
        }
        catch (ApiException ex)
        {
            _apiError = ex;
        }
        finally
        {
            _isLoading = false;
        }
    }

    private void DismissError()
    {
        _apiError = null;
    }

    private async Task BeginDistributionAsync(AgnumBalanceRowDto row)
    {
        _distributionRow = row;
        _distributionMessage = null;
        _distributionQuantity = row.RemainingQty > 0m ? row.RemainingQty : 0m;
        _distributionLocationCode = string.Empty;

        await LoadDistributionLocationsAsync();
    }

    private async Task LoadDistributionLocationsAsync()
    {
        _distributionLocations.Clear();
        _distributionLocationCode = string.Empty;

        if (_distributionWarehouse is null)
        {
            return;
        }

        var warehouseId = _distributionWarehouse.Id;

        _isLoadingLocations = true;
        _apiError = null;

        try
        {
            var locations = await MasterDataAdminClient.GetLocationsAsync(
                null,
                "Active",
                false,
                1,
                500,
                warehouseId,
                "Bin,Shelf");

            _distributionLocations.AddRange(locations.Items);
            _distributionLocationCode = _distributionLocations.FirstOrDefault()?.Code ?? string.Empty;
        }
        catch (ApiException ex)
        {
            _apiError = ex;
        }
        finally
        {
            _isLoadingLocations = false;
        }
    }

    private async Task SubmitDistributionAsync()
    {
        var warehouse = _distributionWarehouse;
        if (_distributionRow is null || warehouse is null)
        {
            _distributionMessage = L["Agnum.Balances.WarehouseNotConfigured"].Value;
            return;
        }

        _isSubmittingDistribution = true;
        _apiError = null;
        _distributionMessage = null;

        try
        {
            await AgnumClient.DistributeAsync(
                _distributionRow.Id,
                _distributionLocationCode,
                warehouse.Code,
                _distributionQuantity,
                Guid.Empty);

            await LoadBalancesAsync();
        }
        catch (ApiException ex)
        {
            _apiError = ex;
        }
        finally
        {
            _isSubmittingDistribution = false;
        }
    }

    private void CancelDistribution()
    {
        _distributionRow = null;
        _distributionMessage = null;
        _distributionLocations.Clear();
        _distributionLocationCode = string.Empty;
        _distributionQuantity = 0m;
    }

    private string BuildErrorMessage(ApiException ex)
        => WarehouseErrorText.Get(L, ex)
           ?? ex.ProblemDetails?.Detail
           ?? ex.ProblemDetails?.Title
           ?? L["Balances.RequestFailed"].Value;

    private static string GetDeltaChipClass(decimal delta)
    {
        if (delta > 0m)
        {
            return "chip chip--ok";
        }

        if (delta < 0m)
        {
            return "chip chip--danger";
        }

        return "chip chip--slate";
    }

    private static string BuildLocationHref(AgnumBalanceRowDto row, AgnumPhysicalLocationDto location)
    {
        var query = new Dictionary<string, string?>
        {
            ["selected"] = location.LocationCode,
            ["location"] = location.LocationCode,
            ["sku"] = row.Sku
        };

        return Microsoft.AspNetCore.WebUtilities.QueryHelpers.AddQueryString(
            "/warehouse/visualization/3d",
            query);
    }
}
