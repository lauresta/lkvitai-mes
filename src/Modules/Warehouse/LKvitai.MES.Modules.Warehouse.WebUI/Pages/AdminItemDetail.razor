@page "/admin/items/{Id:int}"

<PageTitle>@L["AdminItemDetail.ItemDetailsCikadaMES"]</PageTitle>

<div class="ic-page" data-testid="admin-item-detail-page">
    <nav class="ic-crumbs" aria-label="@L["AdminItemDetail.Items"]">
        <a class="ic-crumbs__link" href="admin/items" data-testid="admin-item-detail-back">@L["AdminItemDetail.Items"]</a>
        <span>/</span>
        <span class="mono">@(Item?.InternalSKU ?? Id.ToString(System.Globalization.CultureInfo.InvariantCulture))</span>
    </nav>

    @if (_item.Error is not null)
    {
        <div data-testid="admin-item-detail-error">
            <SharedErrorAlert Message="@ItemCardErrors.Describe(L, _item.Error)"
                              TraceId="@_item.Error.TraceId"
                              OnRetry="ReloadAllAsync"
                              OnDismiss="_item.ClearError" />
        </div>
    }

    @if (Item is null)
    {
        @if (_item.IsLoading)
        {
            <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
        }
        else
        {
            <MudPaper Outlined="true" Elevation="0" Class="panel" data-testid="admin-item-detail-fields">
                <div class="lots-grid__empty">
                    <span class="lots-grid__empty-title">@L["AdminItemDetail.ItemNotFound"]</span>
                    <span>@L["AdminItemDetail.TheItemCouldNotBeLoaded"]</span>
                </div>
            </MudPaper>
        }
    }
    else
    {
        <ItemCardHeader Item="Item"
                        Stock="_stockSummary"
                        StockLoading="_stock.IsLoading"
                        Incoming="IncomingSummary"
                        UnitCost="OnHandRow?.UnitCost"
                        FirstSupplier="_suppliers.Value?.FirstOrDefault()"
                        CanMove="CanMove"
                        CanAdjust="CanAdjust"
                        Show3DHref="@Show3DHref"
                        SavePrice="SaveBasePriceAsync"
                        SaveMin="SaveMinQtyAsync"
                        OnMove="() => OpenMoveDialogAsync(null)"
                        OnAdjust="() => OpenAdjustDialogAsync(null)"
                        OnPhotoClick="() => SelectTab(ItemCardTabs.Photos)"
                        OnAllFields="() => SelectTab(ItemCardTabs.Data)"
                        OnAssignBarcode="() => OpenEditDialogAsync(BarcodeField)" />

        <div class="ic-body">
            <div class="ic-main">
                <ItemCardTabsBar Active="@Tab" Counts="TabCounts" OnSelect="SelectTab" />

                @switch (Tab)
                {
                    case ItemCardTabs.Movements:
                        <ItemMovementsTab Item="Item" State="_movements" Timeline="_timeline" OnRetry="LoadMovementsAsync" />
                        break;
                    case ItemCardTabs.Prices:
                        <ItemPricesTab Item="Item"
                                       OnHand="_onHand"
                                       Overrides="_overrides"
                                       Suppliers="_suppliers"
                                       PriceHistory="_priceHistory"
                                       PurchaseHistory="_purchaseHistory"
                                       OnRetryOnHand="LoadOnHandAsync"
                                       OnRetryOverrides="LoadOverridesAsync"
                                       OnRetrySuppliers="LoadSuppliersAsync"
                                       OnRetryPriceHistory="LoadPriceHistoryAsync"
                                       OnRetryPurchaseHistory="LoadPurchaseHistoryAsync" />
                        break;
                    case ItemCardTabs.Photos:
                        <ItemPhotosTab Item="Item" OnChanged="ReloadItemAsync" />
                        break;
                    case ItemCardTabs.Data:
                        <ItemDataTab Item="Item" OnEdit="() => OpenEditDialogAsync(null)" />
                        break;
                    default:
                        <ItemLocationsTab Item="Item"
                                          Stock="_stock"
                                          Reservations="_reservations"
                                          Rows="_stockRows"
                                          Summary="_stockSummary"
                                          OnRetryStock="LoadStockAsync"
                                          OnRetryReservations="LoadReservationsAsync"
                                          OnMove="OpenMoveDialogAsync"
                                          OnAdjust="OpenAdjustDialogAsync" />
                        break;
                }
            </div>

            <ItemCardRail Unit="@Item.BaseUoM"
                          Timeline="_timeline"
                          TotalMovements="MovementTotal"
                          Movements="_movements"
                          Incoming="_incoming"
                          Reservations="_reservations"
                          OnAllMovements="() => SelectTab(ItemCardTabs.Movements)"
                          OnRetryMovements="LoadMovementsAsync"
                          OnRetryIncoming="LoadIncomingAsync"
                          OnRetryReservations="LoadReservationsAsync" />
        </div>
    }
</div>
