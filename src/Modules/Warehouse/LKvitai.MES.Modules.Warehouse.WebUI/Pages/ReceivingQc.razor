@page "/inbound/qc"
@using LKvitai.MES.Modules.Warehouse.WebUI.Infrastructure
@using LKvitai.MES.Modules.Warehouse.WebUI.Services
@inject ItemPricesClient ItemPricesClient
@inject ReceivingClient ReceivingClient
@inject ToastService ToastService

<PageTitle>@L["ReceivingQc.ReceivingQCCikadaMES"]</PageTitle>

<h1>@L["ReceivingQc.ReceivingQCQueue"]</h1>

@if (_apiError is not null)
{
    <ErrorBanner Message="@BuildErrorMessage(_apiError)"
                 TraceId="@_apiError.TraceId"
                 OnRetry="LoadAsync"
                 OnDismiss="DismissError" />
}

<div class="card shadow-sm mb-3">
    <div class="card-body">
        <div class="row g-2 align-items-end">
            <div class="col-md-4">
                <label class="form-label">@L["ReceivingQc.ScanSKULot"]</label>
                <input class="form-control" @bind="_search" placeholder="@L["ReceivingQc.FG0001OrLOT202601"]" />
            </div>
            <div class="col-md-4">
                <label class="form-label">@L["ReceivingQc.ReasonCodeForFail"]</label>
                <input class="form-control" @bind="_reasonCode" placeholder="DAMAGED" />
            </div>
            <div class="col-md-2 d-grid">
                <button class="btn btn-outline-secondary" @onclick="LoadAsync" disabled="@(_isLoading || _isSubmitting)">@L["Common.Refresh"]</button>
            </div>
        </div>
    </div>
</div>

<div class="card shadow-sm position-relative">
    <LoadingSpinner IsLoading="_isLoading || _isSubmitting" />

    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-sm table-hover align-middle">
                <thead>
                    <tr>
                        <th>SKU</th>
                        <th>@L["Common.Item"]</th>
                        <th>@L["Common.Lot"]</th>
                        <th>@L["Common.Qty"]</th>
                        <th class="text-end">@L["Pricing.Cost"]</th>
                        <th class="text-end">@L["Pricing.Sale"]</th>
                        <th>UoM</th>
                        <th>@L["ReceivingQc.InspectorNotes"]</th>
                        <th>@L["Common.Actions"]</th>
                    </tr>
                </thead>
                <tbody>
                    @if (FilteredRows.Count == 0)
                    {
                        <tr>
                            <td colspan="9">
                                <EmptyState Title="@L["ReceivingQc.NoQCPendingRows"]"
                                            Message="@L["ReceivingQc.ReceivingQCQueueIsEmptyForCurrentFilters"]"
                                            IconCss="bi bi-shield-check"
                                            ActionLabel="Refresh"
                                            OnAction="LoadAsync" />
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var row in FilteredRows)
                        {
                            <tr>
                                <td>@row.ItemSku</td>
                                <td>@row.ItemName</td>
                                <td>@(row.LotNumber ?? "-")</td>
                                <td>@row.Qty.ToString("0.##")</td>
                                <td class="text-end is-money is-num">@Money.Format(_priceMap.Get(row.ItemId, row.ItemSku)?.EffectiveCost)</td>
                                <td class="text-end is-money is-num">@Money.Format(_priceMap.Get(row.ItemId, row.ItemSku)?.BasePrice)</td>
                                <td>@row.BaseUoM</td>
                                <td>
                                    <input class="form-control form-control-sm"
                                           value="@GetNotes(row)"
                                           @onchange="args => SetNotes(row, args.Value?.ToString())" />
                                </td>
                                <td class="d-flex gap-1">
                                    <button class="btn btn-sm btn-success"
                                            @onclick="() => PassAsync(row)"
                                            disabled="@_isSubmitting">
                                        @L["ReceivingQc.Pass"]
                                    </button>
                                    <button class="btn btn-sm btn-danger"
                                            @onclick="() => FailAsync(row)"
                                            disabled="@_isSubmitting">
                                        @L["ReceivingQc.Fail"]
                                    </button>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@code {
    private readonly List<QcPendingRowDto> _rows = [];
    private PriceMap _priceMap = PriceMap.Empty;
    private readonly Dictionary<string, string> _notesByKey = new(StringComparer.OrdinalIgnoreCase);
    private ApiException? _apiError;
    private bool _isLoading;
    private bool _isSubmitting;

    private string _search = string.Empty;
    private string _reasonCode = string.Empty;

    private IReadOnlyList<QcPendingRowDto> FilteredRows =>
        _rows.Where(MatchesSearch).ToList();

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _isLoading = true;
        _apiError = null;

        try
        {
            var rows = await ReceivingClient.GetPendingQcAsync();
            _rows.Clear();
            _rows.AddRange(rows);
            _priceMap = await ItemPricesClient.GetMapAsync(_rows.Select(x => ((int?)x.ItemId, (string?)x.ItemSku)));
        }
        catch (ApiException ex)
        {
            _apiError = ex;
            ToastService.ShowError(BuildErrorMessage(ex));
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task PassAsync(QcPendingRowDto row)
    {
        await SubmitQcAsync(row, isPass: true);
    }

    private async Task FailAsync(QcPendingRowDto row)
    {
        if (string.IsNullOrWhiteSpace(_reasonCode))
        {
            ToastService.ShowError(L["ReceivingQc.Toast.ReasonCodeIsRequiredForQCFail"].Value);
            return;
        }

        await SubmitQcAsync(row, isPass: false);
    }

    private async Task SubmitQcAsync(QcPendingRowDto row, bool isPass)
    {
        _isSubmitting = true;
        _apiError = null;

        try
        {
            var request = new QcActionRequestDto
            {
                ItemId = row.ItemId,
                LotId = row.LotId,
                Qty = row.Qty,
                ReasonCode = isPass ? null : _reasonCode.Trim(),
                InspectorNotes = GetNotes(row)
            };

            var result = isPass
                ? await ReceivingClient.PassQcAsync(request)
                : await ReceivingClient.FailQcAsync(request);

            ToastService.ShowSuccess(L["ReceivingQc.Toast.QCCompletedMovedTo", (isPass ? L["Status.Pass"].Value : L["Status.Fail"].Value), result.DestinationLocationCode].Value);
            await LoadAsync();
        }
        catch (ApiException ex)
        {
            _apiError = ex;
            ToastService.ShowError(BuildErrorMessage(ex));
        }
        finally
        {
            _isSubmitting = false;
        }
    }

    private bool MatchesSearch(QcPendingRowDto row)
    {
        if (string.IsNullOrWhiteSpace(_search))
        {
            return true;
        }

        var filter = _search.Trim();
        return row.ItemSku.Contains(filter, StringComparison.OrdinalIgnoreCase)
               || row.ItemName.Contains(filter, StringComparison.OrdinalIgnoreCase)
               || (row.LotNumber?.Contains(filter, StringComparison.OrdinalIgnoreCase) ?? false);
    }

    private string BuildKey(QcPendingRowDto row)
    {
        return $"{row.ItemId}:{row.LotId?.ToString() ?? "-"}";
    }

    private string GetNotes(QcPendingRowDto row)
    {
        var key = BuildKey(row);
        return _notesByKey.TryGetValue(key, out var value) ? value : string.Empty;
    }

    private void SetNotes(QcPendingRowDto row, string? value)
    {
        var key = BuildKey(row);
        if (string.IsNullOrWhiteSpace(value))
        {
            _notesByKey.Remove(key);
            return;
        }

        _notesByKey[key] = value.Trim();
    }

    private void DismissError()
    {
        _apiError = null;
    }

    private string BuildErrorMessage(ApiException ex)
    {
        if (!string.IsNullOrWhiteSpace(WarehouseErrorText.Get(L, ex)))
        {
            return WarehouseErrorText.Get(L, ex);
        }

        return ex.ProblemDetails?.Detail
               ?? ex.ProblemDetails?.Title
               ?? L["ReceivingQc.RequestFailed"].Value;
    }
}
