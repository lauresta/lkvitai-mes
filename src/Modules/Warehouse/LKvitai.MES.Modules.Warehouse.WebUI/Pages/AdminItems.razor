@page "/admin/items"
@using System.Diagnostics
@using LKvitai.MES.Modules.Warehouse.WebUI.Infrastructure.ItemsList
@implements IAsyncDisposable
@inject MasterDataAdminClient AdminClient
@inject UomClient UomClient
@inject ToastService ToastService
@inject NavigationManager NavigationManager
@inject IDialogService DialogService
@inject IJSRuntime JS

<PageTitle>@L["AdminItems.AdminItemsCikadaMES"]</PageTitle>

<div data-testid="admin-items-page">
    <h3>@L["AdminItems.ItemsManagement"]</h3>

    @if (_apiError is not null)
    {
        <div data-testid="admin-items-error">
            <SharedErrorAlert Message="@BuildErrorMessage(_apiError)"
                              TraceId="@_apiError.TraceId"
                              OnRetry="ReloadAsync"
                              OnDismiss="@(() => _apiError = null)" />
        </div>
    }

    <MudPaper Outlined="true" Elevation="0" Class="panel items-list-panel lots-filter">
        <div class="lk-toolbar lots-filter-toolbar items-filter-toolbar">
            <div class="lk-field--filter lots-field lots-field--grow items-filter__search" data-testid="admin-items-search">
                <MudTextField T="string"
                              Variant="Variant.Outlined"
                              Margin="Margin.Dense"
                              @bind-Value="_search"
                              Immediate="true"
                              OnKeyUp="OnSearchKeyUpAsync"
                              Placeholder="@L["AdminItems.SKUNameBarcode"]"
                              InputAttributes="@ItemsSearchAttributes" />
            </div>
            <div class="lk-field--filter lots-field items-filter__category">
                <MudSelect T="string"
                           Variant="Variant.Outlined"
                           Margin="Margin.Dense"
                           @bind-Value="_categoryFilter"
                           InputAttributes="@ItemsCategoryAttributes">
                    <MudSelectItem T="string" Value="@string.Empty">@L["AdminItems.AllCategories"]</MudSelectItem>
                    @foreach (var category in _categories)
                    {
                        <MudSelectItem T="string" Value="@category.Id.ToString()">@($"{category.Code} - {category.Name}")</MudSelectItem>
                    }
                </MudSelect>
            </div>
            <div class="lk-field--filter lots-field items-filter__status">
                <MudSelect T="string"
                           Variant="Variant.Outlined"
                           Margin="Margin.Dense"
                           @bind-Value="_status"
                           InputAttributes="@ItemsStatusAttributes">
                    <MudSelectItem T="string" Value="@string.Empty">@L["AdminItems.AllStatuses"]</MudSelectItem>
                    <MudSelectItem T="string" Value="@("Active")">@L["Common.Active"]</MudSelectItem>
                    <MudSelectItem T="string" Value="@("Discontinued")">@L["AdminItems.Discontinued"]</MudSelectItem>
                    <MudSelectItem T="string" Value="@("Obsolete")">@L["AdminItems.Obsolete"]</MudSelectItem>
                </MudSelect>
            </div>
            <div class="lk-field--filter lots-field items-filter__intrastat" data-testid="admin-items-intrastat-missing">
                <MudCheckBox T="bool" Dense="true" @bind-Value="_intrastatMissing" Label="@L["Intrastat.Items.FilterMissing"]" />
            </div>
            <div class="lk-field--filter lots-field items-filter__page-size">
                <div data-testid="admin-items-page-size">
                    <MudSelect T="int"
                               Variant="Variant.Outlined"
                               Margin="Margin.Dense"
                               Value="@_state.PageSize"
                               ValueChanged="OnPageSizeChangedAsync"
                               InputAttributes="@ItemsPageSizeAttributes">
                        <MudSelectItem T="int" Value="25">25</MudSelectItem>
                        <MudSelectItem T="int" Value="50">50</MudSelectItem>
                        <MudSelectItem T="int" Value="100">100</MudSelectItem>
                    </MudSelect>
                </div>
            </div>
            <div class="lots-filter__actions items-filter__actions">
                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           OnClick="ApplyFiltersAsync"
                           UserAttributes="@ItemsSearchButtonAttributes">
                    @L["Common.Filter"]
                </MudButton>
                <MudButton Variant="Variant.Outlined"
                           Color="Color.Primary"
                           OnClick="RefreshAsync"
                           UserAttributes="@ItemsRefreshAttributes">
                    @L["Common.Refresh"]
                </MudButton>
                <MudButton Variant="Variant.Outlined"
                           Color="Color.Primary"
                           OnClick="OpenCreateDialogAsync"
                           UserAttributes="@ItemsCreateAttributes">
                    @L["Common.Create"]
                </MudButton>
                <MudButton Variant="Variant.Outlined"
                           Color="Color.Primary"
                           OnClick="OpenIntrastatBulkAsync"
                           UserAttributes="@ItemsIntrastatBulkAttributes">
                    @L["Intrastat.Bulk.Button", _selected.Count]
                </MudButton>
            </div>
        </div>

        <div class="lots-grid-head items-grid-head">
            <strong data-testid="admin-items-summary">@L["AdminItems.Total", _totalCount]</strong>
            <span class="mono" data-testid="admin-items-current-page">@L["AdminItems.Page", _state.Page]</span>
            <div class="stock-view-toggle items-view-toggle" role="group" aria-label="@L["AdminItems.View.Aria"]" data-testid="admin-items-view-toggle">
                <MudButton Size="Size.Small"
                           Variant="@ViewVariant(ItemsViewMode.Table)"
                           Color="Color.Primary"
                           OnClick="@(() => SetViewAsync(ItemsViewMode.Table))"
                           UserAttributes="@ItemsViewTableAttributes">@L["AdminItems.View.Table"]</MudButton>
                <MudButton Size="Size.Small"
                           Variant="@ViewVariant(ItemsViewMode.Cards)"
                           Color="Color.Primary"
                           OnClick="@(() => SetViewAsync(ItemsViewMode.Cards))"
                           UserAttributes="@ItemsViewCardsAttributes">@L["AdminItems.View.Cards"]</MudButton>
            </div>
        </div>

        <div @ref="_listRoot" class="items-list-root">
        @if (_state.ViewMode == ItemsViewMode.Cards)
        {
            @CardsView
        }
        else
        {
        <MudDataGrid T="AdminItemDto"
                     @ref="_grid"
                     @key="_gridRenderKey"
                     ServerData="LoadServerDataAsync"
                     Filterable="false"
                     SortMode="SortMode.Single"
                     Dense="true"
                     Hover="true"
                     FixedHeader="true"
                     RowsPerPage="@_state.PageSize"
                     CurrentPage="@(_state.Page - 1)"
                     Loading="@_isLoading"
                     MultiSelection="true"
                     SelectedItems="_selected"
                     SelectedItemsChanged="OnSelectedItemsChanged"
                     Class="lk-grid lots-grid items-grid"
                     @attributes="@ItemsGridAttributes">
            <Columns>
                <SelectColumn T="AdminItemDto" />
                <TemplateColumn Title="@L["AdminItems.Image"]" Sortable="false">
                    <CellTemplate>
                        <button type="button"
                                class="@ThumbClass(context.Item)"
                                @attributes="@ThumbAttributes(context.Item)"
                                @onclick="@(() => OpenPhotosDialogAsync(context.Item))">
                            @if (HasPhoto(context.Item))
                            {
                                <img src="@context.Item.PrimaryThumbnailUrl"
                                     alt="@context.Item.Name"
                                     loading="lazy" />
                            }
                            else
                            {
                                <span aria-hidden="true">+</span>
                            }
                        </button>
                    </CellTemplate>
                </TemplateColumn>
                <TemplateColumn Title="SKU">
                    <CellTemplate>
                        <button type="button"
                                class="row-action sku-link"
                                @onclick="@(() => OpenDetails(context.Item.Id))">
                            @context.Item.InternalSKU
                        </button>
                    </CellTemplate>
                </TemplateColumn>
                <TemplateColumn Title="@L["Common.Actions"]" Sortable="false">
                    <CellTemplate>
                        <MudMenu Dense="true"
                                 AnchorOrigin="Origin.BottomLeft"
                                 TransformOrigin="Origin.TopLeft">
                            <ActivatorContent>
                                <MudButton Variant="Variant.Outlined"
                                           Color="Color.Primary"
                                           Size="Size.Small"
                                           Class="items-actions-button"
                                           aria-label="@L["AdminItems.ActionsFor", context.Item.InternalSKU]">
                                    @L["Common.Actions"]
                                </MudButton>
                            </ActivatorContent>
                            <ChildContent>
                                <MudMenuItem OnClick="@(() => OpenEditDialogAsync(context.Item))">@L["Common.Edit"]</MudMenuItem>
                                <MudMenuItem OnClick="@(() => OpenDetails(context.Item.Id))">@L["Common.Details"]</MudMenuItem>
                                <MudMenuItem OnClick="@(() => OpenPhotosDialogAsync(context.Item))">@L["AdminItems.Photos"]</MudMenuItem>
                                <MudMenuItem Disabled="@IsDiscontinued(context.Item)"
                                             OnClick="@(() => RequestDeactivate(context.Item))">
                                    @L["AdminItems.Deactivate"]
                                </MudMenuItem>
                            </ChildContent>
                        </MudMenu>
                    </CellTemplate>
                </TemplateColumn>
                <TemplateColumn Title="@L["Common.Name"]">
                    <CellTemplate>
                        <span class="items-name" title="@context.Item.Name">@context.Item.Name</span>
                    </CellTemplate>
                </TemplateColumn>
                <TemplateColumn Title="@L["Common.Tags"]" Sortable="false">
                    <CellTemplate>
                        <div class="item-tags item-tags--compact">
                            @if (context.Item.Tags.Count == 0)
                            {
                                <span class="item-tags__empty">@L["AdminItems.NoTags"]</span>
                            }
                            else
                            {
                                @foreach (var tag in context.Item.Tags.Take(3))
                                {
                                    <span class="chip chip--reserved item-tag-chip">#@tag</span>
                                }
                                @if (context.Item.Tags.Count > 3)
                                {
                                    <span class="chip chip--locked item-tag-chip">+@(context.Item.Tags.Count - 3)</span>
                                }
                            }
                        </div>
                    </CellTemplate>
                </TemplateColumn>
                <PropertyColumn Property="x => x.CategoryName" Title="@L["Common.Category"]" />
                <PropertyColumn Property="x => x.BaseUoM" Title="UoM" />
                <TemplateColumn Title="@L["Common.Status"]">
                    <CellTemplate>
                        <span class="@StatusChipClass(context.Item.Status)">@WarehouseStatusText.Get(L, context.Item.Status)</span>
                    </CellTemplate>
                </TemplateColumn>
                <TemplateColumn Title="Intrastat" Sortable="false">
                    <CellTemplate>
                        @if (IsIntrastatMissing(context.Item))
                        {
                            <span class="chip chip--locked" title="@L["Intrastat.Items.MissingHint"]">@L["Intrastat.Items.Missing"]</span>
                        }
                    </CellTemplate>
                </TemplateColumn>
                <TemplateColumn Title="@L["Common.Lot"]">
                    <CellTemplate>
                        <span class="@BoolChipClass(context.Item.RequiresLotTracking)">@(context.Item.RequiresLotTracking ? L["AdminItems.Lot"] : L["Common.No"])</span>
                    </CellTemplate>
                </TemplateColumn>
                <TemplateColumn Title="QC">
                    <CellTemplate>
                        <span class="@BoolChipClass(context.Item.RequiresQC)">@(context.Item.RequiresQC ? "QC" : L["Common.No"])</span>
                    </CellTemplate>
                </TemplateColumn>
                <TemplateColumn Title="@L["Common.Weight"]">
                    <CellTemplate>
                        <span class="is-num">@FormatDecimal(context.Item.Weight)</span>
                    </CellTemplate>
                </TemplateColumn>
                <TemplateColumn Title="@L["Common.Volume"]">
                    <CellTemplate>
                        <span class="is-num">@FormatDecimal(context.Item.Volume)</span>
                    </CellTemplate>
                </TemplateColumn>
                <TemplateColumn Title="@L["Common.BasePrice"]">
                    <CellTemplate>
                        <span class="is-money is-num">@FormatMoney(context.Item.BasePrice)</span>
                    </CellTemplate>
                </TemplateColumn>
                <TemplateColumn Title="@L["AdminItems.Purchase"]">
                    <CellTemplate>
                        <span class="is-money is-num">@FormatMoney(context.Item.PurchasePrice)</span>
                    </CellTemplate>
                </TemplateColumn>
                <TemplateColumn Title="@L["Common.Barcode"]">
                    <CellTemplate>
                        <span class="mono">@FormatNullable(context.Item.PrimaryBarcode)</span>
                    </CellTemplate>
                </TemplateColumn>
                <TemplateColumn Title="@L["Common.Updated"]">
                    <CellTemplate>
                        <span class="mono">@FormatDate(context.Item.UpdatedAt ?? context.Item.CreatedAt)</span>
                    </CellTemplate>
                </TemplateColumn>
            </Columns>
            <NoRecordsContent>
                @EmptyState
            </NoRecordsContent>
            <PagerContent>
                <div class="lots-pager" data-testid="admin-items-pager">
                    <MudDataGridPager T="AdminItemDto" />
                </div>
            </PagerContent>
        </MudDataGrid>
        }
        </div>
    </MudPaper>

    <SharedConfirmDialog IsVisible="@(_deactivateTarget is not null)"
                         Title="@L["AdminItems.DeactivateItem"]"
                         Message="@DeactivateMessage"
                         ConfirmText="@L["AdminItems.Deactivate"]"
                         OnConfirm="ConfirmDeactivateAsync"
                         OnCancel="@(() => _deactivateTarget = null)" />
</div>

@code {
    private MudDataGrid<AdminItemDto>? _grid;
    private readonly List<AdminCategoryDto> _categories = [];
    private readonly List<UnitOfMeasureDto> _units = [];
    private readonly List<string> _itemTags = [];

    private string _search = string.Empty;
    private string _status = string.Empty;
    private string _categoryFilter = string.Empty;
    private string? _appliedSearch;
    private string? _appliedStatus;
    private int? _appliedCategoryId;
    private bool _intrastatMissing;
    private bool _appliedIntrastatMissing;
    private HashSet<AdminItemDto> _selected = [];
    private readonly ItemsListState _state = new();
    private int _totalCount;
    private List<AdminItemDto> _cardItems = [];
    private ElementReference _listRoot;
    private bool _previewAttached;
    private int _gridRenderKey;
    private bool _isLoading;
    private ApiException? _apiError;
    private AdminItemDto? _deactivateTarget;

    private static readonly DialogOptions ItemDialogOptions = new()
    {
        MaxWidth = MaxWidth.Medium,
        FullWidth = true,
        CloseButton = true
    };

    private static readonly DialogOptions PhotoDialogOptions = new()
    {
        MaxWidth = MaxWidth.Large,
        FullWidth = true,
        CloseButton = true
    };

    [SupplyParameterFromQuery(Name = ItemsListView.QueryKey)]
    public string? ViewQuery { get; set; }

    private static readonly Dictionary<string, object> ItemsViewTableAttributes = new() { ["data-testid"] = "admin-items-view-table" };
    private static readonly Dictionary<string, object> ItemsViewCardsAttributes = new() { ["data-testid"] = "admin-items-view-cards" };
    private static readonly Dictionary<string, object> ItemsGridAttributes = new() { ["data-testid"] = "admin-items-grid" };
    private Dictionary<string, object> ItemsSearchAttributes => new() { ["data-testid"] = "admin-items-search-input", ["aria-label"] = L["Aria.Search"].Value };
    private Dictionary<string, object> ItemsCategoryAttributes => new() { ["data-testid"] = "admin-items-category", ["aria-label"] = L["Aria.Category"].Value };
    private Dictionary<string, object> ItemsStatusAttributes => new() { ["data-testid"] = "admin-items-status", ["aria-label"] = L["Aria.Status"].Value };
    private Dictionary<string, object> ItemsPageSizeAttributes => new() { ["data-testid"] = "admin-items-page-size-select", ["aria-label"] = L["Aria.PageSize"].Value };
    private static readonly Dictionary<string, object> ItemsSearchButtonAttributes = new() { ["data-testid"] = "admin-items-search-btn" };
    private static readonly Dictionary<string, object> ItemsRefreshAttributes = new() { ["data-testid"] = "admin-items-refresh" };
    private static readonly Dictionary<string, object> ItemsCreateAttributes = new() { ["data-testid"] = "admin-items-create" };
    private static readonly Dictionary<string, object> ItemsIntrastatBulkAttributes = new() { ["data-testid"] = "admin-items-intrastat-bulk" };

    private static readonly DialogOptions BulkDialogOptions = new()
    {
        MaxWidth = MaxWidth.Small,
        FullWidth = true,
        CloseButton = true
    };

    private string DeactivateMessage => _deactivateTarget is null
        ? string.Empty
        : L["AdminItems.DeactivateConfirmation", _deactivateTarget.InternalSKU, _deactivateTarget.Name].Value;

    private bool HasAppliedFilters =>
        !string.IsNullOrWhiteSpace(_appliedSearch) ||
        !string.IsNullOrWhiteSpace(_appliedStatus) ||
        _appliedCategoryId.HasValue ||
        _appliedIntrastatMissing;

    private bool _initialized;

    protected override async Task OnInitializedAsync()
    {
        _state.SwitchView(ItemsListView.FromQuery(ViewQuery));
        await LoadLookupsAsync();
        if (_state.ViewMode == ItemsViewMode.Cards)
        {
            await LoadCardsAsync();
        }

        _initialized = true;
    }

    protected override async Task OnParametersSetAsync()
    {
        if (!_initialized)
        {
            return;
        }

        // Back/forward or a pasted link changed ?view=: follow it.
        var mode = ItemsListView.FromQuery(ViewQuery);
        if (_state.SwitchView(mode) && mode == ItemsViewMode.Cards)
        {
            await LoadCardsAsync();
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        await AttachPhotoPreviewAsync();
        await ApplyRememberedViewAsync();
    }

    public async ValueTask DisposeAsync()
    {
        if (!_previewAttached)
        {
            return;
        }

        try
        {
            await JS.InvokeVoidAsync("itemsPhotoPreview.detach", _listRoot);
        }
        catch (Exception ex) when (ex is JSDisconnectedException or InvalidOperationException or JSException)
        {
            // Circuit is gone: the page and its listeners go with it.
        }
    }

    private async Task AttachPhotoPreviewAsync()
    {
        try
        {
            await JS.InvokeVoidAsync("itemsPhotoPreview.attach", _listRoot, L["AdminItems.Preview.Hint"].Value);
            _previewAttached = true;
        }
        catch (Exception ex) when (ex is JSDisconnectedException or InvalidOperationException or JSException)
        {
            // No preview then: tapping the thumbnail still opens the photos dialog.
        }
    }

    private async Task ApplyRememberedViewAsync()
    {
        try
        {
            var stored = await JS.InvokeAsync<string?>("itemsPhotoPreview.readView");
            var remembered = ItemsListView.RememberedFor(ViewQuery, stored);
            if (remembered.HasValue)
            {
                await SetViewAsync(remembered.Value);
            }
        }
        catch (Exception ex) when (ex is JSDisconnectedException or InvalidOperationException or JSException)
        {
            // Nothing remembered: stay on the table.
        }
    }

    private async Task SetViewAsync(ItemsViewMode mode)
    {
        if (!_state.SwitchView(mode))
        {
            return;
        }

        await RememberViewAsync(mode);
        var uri = NavigationManager.GetUriWithQueryParameter(ItemsListView.QueryKey, ItemsListView.ToQuery(mode));
        NavigationManager.NavigateTo(uri, replace: true);
        if (mode == ItemsViewMode.Cards)
        {
            await LoadCardsAsync();
        }
    }

    private async Task RememberViewAsync(ItemsViewMode mode)
    {
        try
        {
            await JS.InvokeVoidAsync("itemsPhotoPreview.saveView", ItemsListView.ToStorage(mode));
        }
        catch (Exception ex) when (ex is JSDisconnectedException or InvalidOperationException or JSException)
        {
            // Not remembered: the URL still carries the mode.
        }
    }

    private Variant ViewVariant(ItemsViewMode mode)
        => _state.ViewMode == mode ? Variant.Filled : Variant.Outlined;

    private async Task ReloadAsync()
    {
        await LoadLookupsAsync();
        await RefreshAsync();
    }

    private async Task LoadLookupsAsync()
    {
        try
        {
            _apiError = null;
            var categoriesTask = AdminClient.GetCategoriesAsync();
            var unitsTask = UomClient.GetUnitsAsync(null, null);
            var tagsTask = AdminClient.GetItemTagsAsync(limit: 100);
            await Task.WhenAll(categoriesTask, unitsTask, tagsTask);

            _categories.Clear();
            _categories.AddRange(categoriesTask.Result.OrderBy(x => x.Code, StringComparer.OrdinalIgnoreCase));

            _units.Clear();
            _units.AddRange(unitsTask.Result.OrderBy(x => x.Code, StringComparer.OrdinalIgnoreCase));

            _itemTags.Clear();
            _itemTags.AddRange(tagsTask.Result.OrderBy(x => x, StringComparer.OrdinalIgnoreCase));
        }
        catch (ApiException ex)
        {
            _apiError = ex;
        }
    }

    private async Task ApplyFiltersAsync()
    {
        _appliedSearch = string.IsNullOrWhiteSpace(_search) ? null : _search.Trim();
        _appliedStatus = string.IsNullOrWhiteSpace(_status) ? null : _status;
        _appliedCategoryId = int.TryParse(_categoryFilter, out var categoryId) ? categoryId : null;
        _appliedIntrastatMissing = _intrastatMissing;
        _selected = [];
        _state.ResetPage();
        await ReloadViewAsync();
    }

    private async Task OnPageSizeChangedAsync(int pageSize)
    {
        _state.SetPageSize(pageSize);
        await ReloadViewAsync();
    }

    private async Task OnCardsPageChangedAsync(int page)
    {
        _state.SetPage(page);
        await LoadCardsAsync();
    }

    /// <summary>Filters or page size changed: the table re-creates its grid, the cards load their page.</summary>
    private async Task ReloadViewAsync()
    {
        _gridRenderKey++;
        if (_state.ViewMode == ItemsViewMode.Cards)
        {
            await LoadCardsAsync();
            return;
        }

        await InvokeAsync(StateHasChanged);
    }

    private async Task ClearFiltersAsync()
    {
        _search = string.Empty;
        _status = string.Empty;
        _categoryFilter = string.Empty;
        _intrastatMissing = false;
        _appliedSearch = null;
        _appliedStatus = null;
        _appliedCategoryId = null;
        _appliedIntrastatMissing = false;
        _selected = [];
        _state.ResetPage();
        await ReloadViewAsync();
    }

    private async Task RefreshAsync()
    {
        if (_state.ViewMode == ItemsViewMode.Cards)
        {
            await LoadCardsAsync();
            return;
        }

        if (_grid is null)
        {
            return;
        }

        await _grid.ReloadServerData();
    }

    private async Task<GridData<AdminItemDto>> LoadServerDataAsync(GridState<AdminItemDto> state)
    {
        _isLoading = true;
        _state.AdoptGridPaging(state.Page, state.PageSize);

        try
        {
            return await LoadPageAsync(_state.Page, _state.PageSize);
        }
        finally
        {
            _isLoading = false;
            // The summary above the grid is outside the grid component: re-render it with the new total.
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task LoadCardsAsync()
    {
        _isLoading = true;
        await InvokeAsync(StateHasChanged);
        try
        {
            var data = await LoadPageAsync(_state.Page, _state.PageSize);
            _cardItems = data.Items.ToList();
            if (_cardItems.Count == 0 && _totalCount > 0 && _state.Page > 1)
            {
                // The page vanished (items removed or filtered out): show the last one.
                _state.SetPage(ItemsListState.PageCount(_totalCount, _state.PageSize));
                data = await LoadPageAsync(_state.Page, _state.PageSize);
                _cardItems = data.Items.ToList();
            }
        }
        finally
        {
            _isLoading = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    /// <summary>One page of items for the applied filters; shared by the table and the cards.</summary>
    private async Task<GridData<AdminItemDto>> LoadPageAsync(int page, int pageSize)
    {
        _apiError = null;
        try
        {
            var result = await AdminClient.GetItemsAsync(
                _appliedSearch,
                _appliedCategoryId,
                _appliedStatus,
                page,
                pageSize,
                intrastatMissing: _appliedIntrastatMissing);

            _totalCount = result.TotalCount;
            _selected = ItemsSelection.Reconcile(_selected, result.Items);
            return new GridData<AdminItemDto>
            {
                Items = result.Items,
                TotalItems = result.TotalCount
            };
        }
        catch (ApiException ex)
        {
            _apiError = ex;
            _totalCount = 0;
            return EmptyGridData();
        }
        catch (Exception ex)
        {
            _apiError = new ApiException(
                new ProblemDetailsModel
                {
                    Title = "Items query failed",
                    Detail = ex.Message,
                    Status = 500,
                    TraceId = Activity.Current?.Id
                },
                500);
            _totalCount = 0;
            return EmptyGridData();
        }
    }

    private async Task OnSearchKeyUpAsync(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await ApplyFiltersAsync();
        }
    }

    private void OnSelectedItemsChanged(HashSet<AdminItemDto> items) => _selected = items;

    private static bool IsIntrastatMissing(AdminItemDto item)
        => IntrastatItemCheck.IsDataMissing(item.ItemType, item.CommodityCode, item.NetWeightKg, item.OriginCountry);

    private async Task OpenIntrastatBulkAsync()
    {
        var parameters = new DialogParameters
        {
            ["SelectedCount"] = _selected.Count,
            ["FilterCount"] = _totalCount,
            ["FilterIsNarrowed"] = HasAppliedFilters
        };

        var dialog = await DialogService.ShowAsync<AdminItemsIntrastatBulkDialog>(L["Intrastat.Bulk.Title"].Value, parameters, BulkDialogOptions);
        var result = await dialog.Result;
        if (result.Canceled || result.Data is not IntrastatBulkChoice choice)
        {
            return;
        }

        await ApplyIntrastatBulkAsync(choice);
    }

    private BulkIntrastatRequest BuildBulkRequest(IntrastatBulkChoice choice, bool dryRun) => new()
    {
        ItemIds = choice.UseFilter ? null : _selected.Select(x => x.Id).ToList(),
        Filter = choice.UseFilter ? new ItemSelectionFilterDto(_appliedSearch, _appliedCategoryId, _appliedStatus, _appliedIntrastatMissing) : null,
        CommodityCode = choice.CommodityCode,
        OriginCountry = choice.OriginCountry,
        SupplementaryUnit = choice.SupplementaryUnit,
        SupplementaryUnitFactor = choice.SupplementaryUnitFactor,
        DryRun = dryRun
    };

    private async Task ApplyIntrastatBulkAsync(IntrastatBulkChoice choice)
    {
        try
        {
            var preview = await AdminClient.SetItemsIntrastatAsync(BuildBulkRequest(choice, dryRun: true));
            if (preview.Changed == 0)
            {
                ToastService.ShowWarning(L["Intrastat.Bulk.NothingToChange", preview.Matched].Value);
                return;
            }

            var confirmed = await DialogService.ShowMessageBox(
                L["Intrastat.Bulk.Title"].Value,
                L["Intrastat.Bulk.Confirm", preview.Changed, preview.Matched].Value,
                yesText: L["Common.Apply"].Value,
                cancelText: L["Common.Cancel"].Value);
            if (confirmed != true)
            {
                return;
            }

            var applied = await AdminClient.SetItemsIntrastatAsync(BuildBulkRequest(choice, dryRun: false));
            ToastService.ShowSuccess(L["Intrastat.Bulk.Done", applied.Changed].Value);
            _selected = [];
            await RefreshAsync();
        }
        catch (ApiException ex)
        {
            ToastService.ShowError(BuildErrorMessage(ex));
        }
    }

    private static GridData<AdminItemDto> EmptyGridData() => new()
    {
        Items = Array.Empty<AdminItemDto>(),
        TotalItems = 0
    };

    private async Task OpenCreateDialogAsync()
    {
        var parameters = new DialogParameters
        {
            ["IsEdit"] = false,
            ["Categories"] = _categories,
            ["Units"] = _units,
            ["ExistingTags"] = _itemTags
        };

        var dialog = await DialogService.ShowAsync<AdminItemEditorDialog>(L["AdminItems.CreateItem"].Value, parameters, ItemDialogOptions);
        var result = await dialog.Result;
        if (result.Canceled || result.Data is not CreateOrUpdateItemRequest request)
        {
            return;
        }

        try
        {
            _apiError = null;
            await AdminClient.CreateItemAsync(request);
            ToastService.ShowSuccess(L["AdminItems.Toast.ItemCreated"].Value);
            await LoadLookupsAsync();
            await RefreshAsync();
        }
        catch (ApiException ex)
        {
            _apiError = ex;
            ToastService.ShowError(BuildErrorMessage(ex));
        }
    }

    private async Task OpenEditDialogAsync(AdminItemDto row)
    {
        try
        {
            _apiError = null;
            var item = await AdminClient.GetItemByIdAsync(row.Id);
            var parameters = new DialogParameters
            {
                ["IsEdit"] = true,
                ["Item"] = item,
                ["Categories"] = _categories,
                ["Units"] = _units,
                ["ExistingTags"] = _itemTags
            };

            var dialog = await DialogService.ShowAsync<AdminItemEditorDialog>(L["AdminItems.EditItem"].Value, parameters, ItemDialogOptions);
            var result = await dialog.Result;
            if (result.Canceled || result.Data is not CreateOrUpdateItemRequest request)
            {
                return;
            }

            await AdminClient.UpdateItemAsync(row.Id, request);
            ToastService.ShowSuccess(L["AdminItems.Toast.ItemUpdated"].Value);
            await LoadLookupsAsync();
            await RefreshAsync();
        }
        catch (ApiException ex)
        {
            _apiError = ex;
            ToastService.ShowError(BuildErrorMessage(ex));
        }
    }

    private async Task OpenPhotosDialogAsync(AdminItemDto row)
    {
        var parameters = new DialogParameters
        {
            ["ItemId"] = row.Id,
            ["InternalSKU"] = row.InternalSKU,
            ["Name"] = row.Name
        };

        var dialog = await DialogService.ShowAsync<AdminItemPhotosDialog>(L["AdminItemPhotosDialog.ItemPhotos"].Value, parameters, PhotoDialogOptions);
        var result = await dialog.Result;
        if (!result.Canceled && result.Data is true)
        {
            await RefreshAsync();
        }
    }

    private void RequestDeactivate(AdminItemDto row)
    {
        _deactivateTarget = row;
    }

    private async Task ConfirmDeactivateAsync()
    {
        if (_deactivateTarget is null)
        {
            return;
        }

        var target = _deactivateTarget;
        _deactivateTarget = null;

        try
        {
            _apiError = null;
            await AdminClient.DeactivateItemAsync(target.Id);
            ToastService.ShowWarning(L["AdminItems.Toast.ItemDeactivated"].Value);
            await RefreshAsync();
        }
        catch (ApiException ex)
        {
            _apiError = ex;
            ToastService.ShowError(BuildErrorMessage(ex));
        }
    }

    private void OpenDetails(int itemId)
    {
        NavigationManager.NavigateTo($"admin/items/{itemId}");
    }

    private static bool HasPhoto(AdminItemDto item) => !string.IsNullOrWhiteSpace(item.PrimaryThumbnailUrl);

    private static string ThumbClass(AdminItemDto item) => HasPhoto(item) ? "items-thumb" : "items-thumb items-thumb--empty";

    private Dictionary<string, object> ThumbAttributes(AdminItemDto item)
    {
        if (!HasPhoto(item))
        {
            var noImg = L["AdminItems.NoImg"].Value;
            return new Dictionary<string, object> { ["title"] = noImg, ["aria-label"] = noImg };
        }

        return new Dictionary<string, object>
        {
            ["title"] = L["AdminItems.OpenPhotos"].Value,
            ["data-preview-thumb"] = item.PrimaryThumbnailUrl!,
            ["data-preview-src"] = ItemsListView.OriginalUrl(item.PrimaryThumbnailUrl),
            ["data-preview-sku"] = item.InternalSKU,
            ["data-preview-name"] = item.Name
        };
    }

    private bool IsCardSelected(AdminItemDto item) => ItemsSelection.Contains(_selected, item.Id);

    private void ToggleCardSelection(AdminItemDto item) => _selected = ItemsSelection.Toggle(_selected, item);

    private string CardRange
    {
        get
        {
            if (_totalCount == 0)
            {
                return string.Empty;
            }

            var from = ((_state.Page - 1) * _state.PageSize) + 1;
            var to = Math.Min(_state.Page * _state.PageSize, _totalCount);
            return $"{from}–{to} / {_totalCount}";
        }
    }

    private RenderFragment EmptyState => @<div class="lots-grid__empty">
        <span class="lots-grid__empty-title">@L["AdminItems.NoItemsFound"]</span>
        <span>
            No items match the current filter.
            @if (HasAppliedFilters)
            {
                <button type="button" class="lots-grid__empty-action" @onclick="ClearFiltersAsync">@L["Common.ClearFilters"]</button>
            }
        </span>
    </div>;

    private RenderFragment CardsView => @<div class="items-cards-wrap" aria-busy="@_isLoading">
        @if (_isLoading)
        {
            <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="items-cards__progress" />
        }
        @if (_cardItems.Count == 0 && !_isLoading)
        {
            @EmptyState
        }
        else
        {
            <div class="items-cards" data-testid="admin-items-cards">
                @foreach (var item in _cardItems)
                {
                    @ItemCard(item)
                }
            </div>
        }
        <div class="items-cards__pager" data-testid="admin-items-cards-pager">
            <div class="items-cards__pager-size" data-testid="admin-items-cards-page-size">
                <MudSelect T="int"
                           Variant="Variant.Outlined"
                           Margin="Margin.Dense"
                           Value="@_state.PageSize"
                           ValueChanged="OnPageSizeChangedAsync"
                           InputAttributes="@ItemsPageSizeAttributes">
                    <MudSelectItem T="int" Value="25">25</MudSelectItem>
                    <MudSelectItem T="int" Value="50">50</MudSelectItem>
                    <MudSelectItem T="int" Value="100">100</MudSelectItem>
                </MudSelect>
            </div>
            <span class="mono items-cards__range">@CardRange</span>
            <MudPagination Count="@ItemsListState.PageCount(_totalCount, _state.PageSize)"
                           Selected="@_state.Page"
                           SelectedChanged="OnCardsPageChangedAsync"
                           Size="Size.Small"
                           Color="Color.Primary"
                           Class="items-cards__pagination" />
        </div>
    </div>;

    private RenderFragment ItemCard(AdminItemDto item) => @<a @key="item.Id"
                                                                class="@CardClass(item)"
                                                                href="admin/items/@item.Id"
                                                                data-testid="admin-items-card"
                                                                data-item-id="@item.Id">
        <button type="button"
                class="items-card__check"
                role="checkbox"
                aria-checked="@IsCardSelected(item)"
                aria-label="@item.InternalSKU"
                @onclick="@(() => ToggleCardSelection(item))"
                @onclick:preventDefault
                @onclick:stopPropagation>
            <span class="items-card__box">@(IsCardSelected(item) ? "✓" : string.Empty)</span>
        </button>
        <div class="@(HasPhoto(item) ? "items-card__photo" : "items-card__photo items-card__photo--empty")">
            @if (HasPhoto(item))
            {
                <img src="@item.PrimaryThumbnailUrl" alt="@item.Name" loading="lazy" />
            }
            else
            {
                <button type="button"
                        class="items-card__upload"
                        @onclick="@(() => OpenPhotosDialogAsync(item))"
                        @onclick:preventDefault
                        @onclick:stopPropagation>@L["AdminItems.UploadPhoto"]</button>
            }
        </div>
        <div class="items-card__body">
            <div class="items-card__row">
                <span class="items-card__sku">@item.InternalSKU</span>
                <span class="@ItemsListView.StatusDotClass(item.Status)"
                      title="@WarehouseStatusText.Get(L, item.Status)"
                      aria-label="@WarehouseStatusText.Get(L, item.Status)"></span>
            </div>
            <div class="items-card__name" title="@item.Name">@item.Name</div>
            <div class="items-card__row items-card__row--meta">
                <span class="items-card__meta">@item.CategoryName · @item.BaseUoM</span>
                <span class="@(item.BasePrice.HasValue ? "items-card__price" : "items-card__price items-card__price--none")">@(item.BasePrice.HasValue ? FormatMoney(item.BasePrice) : "-")</span>
            </div>
        </div>
    </a>;

    private string CardClass(AdminItemDto item)
        => IsCardSelected(item) ? "items-card items-card--selected" : "items-card";

    private static bool IsDiscontinued(AdminItemDto item)
        => string.Equals(item.Status, "Discontinued", StringComparison.OrdinalIgnoreCase);

    private static string StatusChipClass(string status) => status switch
    {
        "Active" => "chip chip--ok",
        "Obsolete" => "chip chip--low",
        "Discontinued" => "chip chip--locked",
        _ => "chip chip--reserved"
    };

    private static string BoolChipClass(bool value)
        => value ? "chip chip--reserved" : "chip chip--locked";

    private static string FormatDecimal(decimal? value)
        => value?.ToString("0.###") ?? "-";

    private static string FormatMoney(decimal? value) => LKvitai.MES.Modules.Warehouse.WebUI.Infrastructure.Money.Format(value);

    private static string FormatNullable(string? value)
        => string.IsNullOrWhiteSpace(value) ? "-" : value;

    private static string FormatDate(DateTimeOffset value)
        => value.ToLocalTime().ToString("yyyy-MM-dd");

    private string BuildErrorMessage(ApiException error)
    {
        if (!string.IsNullOrWhiteSpace(error.ProblemDetails?.Detail))
        {
            return $"{WarehouseErrorText.Get(L, error)} {error.ProblemDetails.Detail}";
        }

        return WarehouseErrorText.Get(L, error);
    }
}
