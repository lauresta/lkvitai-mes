@page "/analytics/quality"
@inject AdvancedWarehouseClient AdvancedClient
@inject ToastService ToastService
@using LKvitai.MES.Modules.Warehouse.WebUI.Infrastructure

<PageTitle>@L["AnalyticsQuality.QualityAnalyticsCikadaMES"]</PageTitle>


<h3>@L["AnalyticsQuality.QCDefectsAndLateShipments"]</h3>

@if (_error is not null)
{
    <ErrorBanner Message="@WarehouseErrorText.Get(L, _error)"
                 TraceId="@_error.TraceId"
                 OnRetry="LoadAsync"
                 OnDismiss="DismissError" />
}

<div class="row g-3 mb-3">
    <div class="col-md-6">
        <div class="card shadow-sm h-100">
            <div class="card-body">
                <div class="text-muted">@L["AnalyticsQuality.QCDefectCount"]</div>
                <div class="display-6">@(_analytics?.DefectCount ?? 0)</div>
            </div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="card shadow-sm h-100">
            <div class="card-body">
                <div class="text-muted">@L["AnalyticsQuality.LateShipments"]</div>
                <div class="display-6">@(_analytics?.LateShipmentsCount ?? 0)</div>
            </div>
        </div>
    </div>
</div>

<div class="row g-3">
    <div class="col-lg-5">
        <div class="card shadow-sm h-100">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <h5 class="mb-0">@L["AnalyticsQuality.TopDefectTypes"]</h5>
                    <button class="btn btn-outline-secondary btn-sm" @onclick="LoadAsync" disabled="@_isBusy">@L["Common.Refresh"]</button>
                </div>

                @if (_analytics is null || _analytics.DefectsByType.Count == 0)
                {
                    <EmptyState Title="@L["AnalyticsQuality.NoDefectsRecorded"]"
                                Message="@L["AnalyticsQuality.DefectAnalyticsAppearsWhenQCDefectsAreLogged"]"
                                IconCss="bi bi-shield-check"
                                OnAction="LoadAsync" />
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-sm">
                            <thead>
                                <tr>
                                    <th>@L["Common.Type"]</th>
                                    <th>@L["AnalyticsQuality.Count"]</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var row in _analytics.DefectsByType)
                                {
                                    <tr>
                                        <td>@row.DefectType</td>
                                        <td>@row.Count</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    </div>

    <div class="col-lg-7">
        <div class="card shadow-sm h-100">
            <div class="card-body">
                <h5>@L["AnalyticsQuality.LateShipments"]</h5>
                @if (_analytics is null || _analytics.LateShipments.Count == 0)
                {
                    <EmptyState Title="@L["AnalyticsQuality.NoLateShipments"]"
                                Message="@L["AnalyticsQuality.NoDelayedOutboundOrdersFoundInCurrentDataset"]"
                                IconCss="bi bi-truck"
                                OnAction="LoadAsync" />
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-sm">
                            <thead>
                                <tr>
                                    <th>@L["Common.Order"]</th>
                                    <th>@L["Common.Requested"]</th>
                                    <th>@L["Common.Shipped"]</th>
                                    <th>@L["AnalyticsQuality.CurrentStatus"]</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var row in _analytics.LateShipments)
                                {
                                    <tr>
                                        <td>@row.OrderNumber</td>
                                        <td>@(row.RequestedShipDate?.ToLocalTime().ToString("yyyy-MM-dd") ?? "-")</td>
                                        <td>@(row.ShippedAt?.ToLocalTime().ToString("yyyy-MM-dd") ?? "-")</td>
                                        <td>@WarehouseStatusText.Get(L, row.CurrentStatus)</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@code {
    private QcLateShipmentAnalyticsDto? _analytics;
    private ApiException? _error;
    private bool _isBusy;

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _isBusy = true;
        _error = null;

        try
        {
            _analytics = await AdvancedClient.GetQcLateShipmentAnalyticsAsync();
        }
        catch (ApiException ex)
        {
            _error = ex;
            ToastService.ShowError(WarehouseErrorText.Get(L, ex));
        }
        finally
        {
            _isBusy = false;
        }
    }

    private void DismissError()
    {
        _error = null;
    }
}
