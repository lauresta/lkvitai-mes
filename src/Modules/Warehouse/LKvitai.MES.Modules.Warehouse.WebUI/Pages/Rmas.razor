@page "/rmas"
@inject AdvancedWarehouseClient AdvancedClient
@inject ToastService ToastService
@using LKvitai.MES.Modules.Warehouse.WebUI.Infrastructure
@using LKvitai.MES.Modules.Warehouse.WebUI.Services
@inject ItemPricesClient ItemPricesClient

<PageTitle>@L["Rmas.RMAsCikadaMES"]</PageTitle>

<VolatileDataBanner />

<h3>@L["Rmas.ReturnsRMA"]</h3>

@if (_error is not null)
{
    <ErrorBanner Message="@WarehouseErrorText.Get(L, _error)"
                 TraceId="@_error.TraceId"
                 OnRetry="LoadAsync"
                 OnDismiss="DismissError" />
}

<div class="card shadow-sm mb-3">
    <div class="card-body">
        <h5>@L["Rmas.CreateRMA"]</h5>
        <div class="row g-2 align-items-end">
            <div class="col-md-4">
                <label class="form-label">@L["Rmas.SalesOrderId"]</label>
                <input class="form-control" @bind="_salesOrderIdInput" placeholder="GUID" />
            </div>
            <div class="col-md-3">
                <label class="form-label">@L["Common.ItemID"]</label>
                <input class="form-control" type="number" @bind="_itemId" />
            </div>
            <div class="col-md-2">
                <label class="form-label">@L["Common.Qty"]</label>
                <input class="form-control" type="number" step="0.01" @bind="_qty" />
            </div>
            <div class="col-md-3">
                <label class="form-label">@L["Common.Reason"]</label>
                <input class="form-control" @bind="_reason" placeholder="@L["Rmas.Damaged"]" />
            </div>
            <div class="col-md-12 mt-2">
                <button class="btn btn-primary" @onclick="CreateAsync" disabled="@_isBusy">@L["Rmas.CreateRMA"]</button>
            </div>
        </div>
    </div>
</div>

<div class="card shadow-sm">
    <div class="card-body">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h5 class="mb-0">@L["Rmas.RMAQueue"]</h5>
            <button class="btn btn-outline-secondary btn-sm" @onclick="LoadAsync" disabled="@_isBusy">@L["Common.Refresh"]</button>
        </div>

        @if (_rows.Count == 0)
        {
            <EmptyState Title="@L["Rmas.NoRMAs"]"
                        Message="@L["Rmas.CreateAnRMAForCustomerReturnsAndDispositionWorkflow"]"
                        IconCss="bi bi-arrow-counterclockwise"
                        OnAction="LoadAsync" />
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-sm align-middle">
                    <thead>
                        <tr>
                            <th>RMA</th>
                            <th>@L["Common.Status"]</th>
                            <th>@L["Common.Reason"]</th>
                            <th>@L["Common.Items"]</th>
                            <th class="text-end">@L["Pricing.Cost"]</th>
                            <th class="text-end">@L["Pricing.Sale"]</th>
                            <th class="text-end">@L["Common.Value"]</th>
                            <th>@L["Rmas.Credit"]</th>
                            <th>@L["Rmas.UpdatedBy"]</th>
                            <th>@L["Common.Actions"]</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var row in _rows)
                        {
                            <tr>
                                <td>@row.RmaNumber</td>
                                <td><span class="badge @GetStatusClass(row.Status)">@WarehouseStatusText.Get(L, row.Status)</span></td>
                                <td>@row.Reason</td>
                                <td class="mono">@string.Join(", ", row.Lines.Select(x => x.ItemId))</td>
                                <td class="text-end is-money is-num">@string.Join(" / ", row.Lines.Select(x => Money.FormatUnit(_priceMap.Get(x.ItemId, null)?.EffectiveCost)))</td>
                                <td class="text-end is-money is-num">@string.Join(" / ", row.Lines.Select(x => Money.Format(_priceMap.Get(x.ItemId, null)?.BasePrice)))</td>
                                <td class="text-end is-money is-num">@Money.Format(RmaValue(row)) <small>@L["Pricing.WithoutCost", row.Lines.Count(x => !_priceMap.Value(x.Qty, x.ItemId, null).HasValue)]</small></td>
                                <td>@(row.CreditAmount?.ToString("0.00") ?? "-")</td>
                                <td>@(row.UpdatedBy ?? row.CreatedBy)</td>
                                <td class="d-flex gap-1">
                                    @if (row.Status == "PendingReceipt")
                                    {
                                        <button class="btn btn-sm btn-outline-primary" @onclick="() => ReceiveAsync(row.Id)">@L["Common.Receive"]</button>
                                    }
                                    @if (row.Status is "Received" or "Inspected")
                                    {
                                        <button class="btn btn-sm btn-outline-success" @onclick='() => InspectAsync(row.Id, "RESTOCK")'>@L["Rmas.Restock"]</button>
                                        <button class="btn btn-sm btn-outline-danger" @onclick='() => InspectAsync(row.Id, "SCRAP")'>@L["Rmas.Scrap"]</button>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

@code {
    private readonly List<RmaDto> _rows = [];
    private PriceMap _priceMap = PriceMap.Empty;
    private string _salesOrderIdInput = string.Empty;
    private int _itemId = 1;
    private decimal _qty = 1;
    private string _reason = "Damaged";
    private ApiException? _error;
    private bool _isBusy;

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        await ExecuteAsync(async () =>
        {
            var rows = await AdvancedClient.GetRmasAsync();
            _rows.Clear();
            _rows.AddRange(rows.OrderByDescending(x => x.CreatedAt));
            _priceMap = await ItemPricesClient.GetMapAsync(_rows.SelectMany(x => x.Lines).Select(x => ((int?)x.ItemId, (string?)null)));
        });
    }

    private decimal? RmaValue(RmaDto row)
    {
        var values = row.Lines.Select(x => _priceMap.Value(x.Qty, x.ItemId, null)).ToList();
        return values.Sum(x => x ?? 0m);
    }

    private async Task CreateAsync()
    {
        if (!Guid.TryParse(_salesOrderIdInput, out var salesOrderId))
        {
            ToastService.ShowError(L["Rmas.Toast.SalesOrderIdMustBeAValidGUID"].Value);
            return;
        }

        await ExecuteAsync(async () =>
        {
            var payload = new RmaCreateDto(
                salesOrderId,
                _reason,
                [new RmaLineCreateDto(_itemId, _qty, _reason.ToUpperInvariant())]);

            await AdvancedClient.CreateRmaAsync(payload);
            ToastService.ShowSuccess(L["Rmas.Toast.RMACreated"].Value);
            _salesOrderIdInput = string.Empty;
            await LoadAsync();
        });
    }

    private async Task ReceiveAsync(Guid id)
    {
        await ExecuteAsync(async () =>
        {
            await AdvancedClient.ReceiveRmaAsync(id);
            await LoadAsync();
        });
    }

    private async Task InspectAsync(Guid id, string disposition)
    {
        await ExecuteAsync(async () =>
        {
            await AdvancedClient.InspectRmaAsync(id, disposition, disposition == "RESTOCK" ? 0m : null);
            await LoadAsync();
        });
    }

    private async Task ExecuteAsync(Func<Task> action)
    {
        _isBusy = true;
        _error = null;

        try
        {
            await action();
        }
        catch (ApiException ex)
        {
            _error = ex;
            ToastService.ShowError(WarehouseErrorText.Get(L, ex));
        }
        finally
        {
            _isBusy = false;
        }
    }

    private void DismissError()
    {
        _error = null;
    }

    private static string GetStatusClass(string status) => status switch
    {
        "Restocked" => "bg-success",
        "Scrapped" => "bg-danger",
        "Received" => "bg-info text-dark",
        "Inspected" => "bg-primary",
        _ => "bg-secondary"
    };
}
