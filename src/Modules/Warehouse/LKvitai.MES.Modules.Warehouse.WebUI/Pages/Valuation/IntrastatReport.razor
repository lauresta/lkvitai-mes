@page "/valuation/intrastat"
@using System.Globalization
@using LKvitai.MES.Modules.Warehouse.WebUI.Infrastructure
@using LKvitai.MES.Modules.Warehouse.WebUI.Models
@inject IntrastatClient Client
@inject IJSRuntime JavaScript
@inject ToastService ToastService

<PageTitle>@L["Intrastat.Title"]</PageTitle>

<h1>@L["Intrastat.Title"]</h1>
<p class="text-muted">@L["Intrastat.Intro"]</p>

@if (_apiError is not null)
{
    <ErrorBanner Message="@(_apiError.ProblemDetails?.Detail ?? _apiError.ProblemDetails?.Title ?? _apiError.Message)"
                 TraceId="@_apiError.TraceId"
                 OnDismiss="() => _apiError = null" />
}

<div class="card shadow-sm mb-4 position-relative">
    <LoadingSpinner IsLoading="_busy" />
    <div class="card-body">
        <div class="row g-3 align-items-end">
            <div class="col-12 col-md-4">
                <label class="form-label" for="intrastat-month">@L["Intrastat.Month"]</label>
                <input id="intrastat-month" type="month" class="form-control" @bind="_month" @bind:format="yyyy-MM" />
            </div>
            <div class="col-12 col-md-8 d-flex gap-2">
                <button class="btn btn-primary" type="button" disabled="@_busy" @onclick="LoadAsync">@L["Intrastat.Show"]</button>
                <button class="btn btn-outline-primary" type="button" disabled="@(_busy || _report is null)" @onclick="DownloadAsync">@L["Intrastat.DownloadCsv"]</button>
                <button class="btn btn-primary" type="button" data-testid="intrastat-download-xml" disabled="@(_busy || _report is null)" @onclick="DownloadXmlAsync">@L["Intrastat.DownloadXml"]</button>
            </div>
        </div>
    </div>
</div>

<details class="card shadow-sm mb-4" open="@(!_declarant.IsComplete)">
    <summary class="card-header">@L["Intrastat.Declarant.Title"]</summary>
    <div class="card-body">
        @if (!_declarant.IsComplete)
        {
            <div class="alert alert-warning" data-testid="intrastat-declarant-missing">@L["Intrastat.Declarant.Missing"]</div>
        }
        <div class="row g-3">
            <div class="col-12 col-md-4"><label class="form-label">@L["Intrastat.Declarant.VatCode"]</label><input class="form-control" maxlength="14" @bind="_declarant.VatCode" /></div>
            <div class="col-12 col-md-8"><label class="form-label">@L["Intrastat.Declarant.Name"]</label><input class="form-control" maxlength="1000" @bind="_declarant.Title" /></div>
            <div class="col-12 col-md-8"><label class="form-label">@L["Intrastat.Declarant.Street"]</label><input class="form-control" maxlength="60" @bind="_declarant.Street" /></div>
            <div class="col-12 col-md-4"><label class="form-label">@L["Intrastat.Declarant.ZipCode"]</label><input class="form-control" maxlength="20" @bind="_declarant.ZipCode" /></div>
            <div class="col-12 col-md-4"><label class="form-label">@L["Intrastat.Declarant.ContactPerson"]</label><input class="form-control" maxlength="60" @bind="_declarant.ContactPerson" /></div>
            <div class="col-12 col-md-4"><label class="form-label">@L["Intrastat.Declarant.Email"]</label><input class="form-control" maxlength="45" @bind="_declarant.Email" /></div>
            <div class="col-12 col-md-4"><label class="form-label">@L["Intrastat.Declarant.Phone"]</label><input class="form-control" maxlength="15" @bind="_declarant.Phone" /></div>
        </div>
        <button class="btn btn-primary mt-3" type="button" @onclick="SaveDeclarantAsync">@L["Intrastat.Declarant.Save"]</button>
    </div>
</details>

@if (_report is not null)
{
    @if (_report.TotalReturnValueEur != 0m)
    {
        <div class="alert alert-info" data-testid="intrastat-returns-note">@L["Intrastat.Xml.ReturnsNote"]</div>
    }

    @if (_report.Warnings.Count > 0)
    {
        <div class="alert alert-warning">
            @string.Format(L["Intrastat.Warnings"].Value, _report.Warnings.Count)
            <ul class="mb-0">
                @foreach (var w in _report.Warnings)
                {
                    <li>@w.Replace('|', ' ')</li>
                }
            </ul>
        </div>
    }

    @if (_report.Rows.Count == 0 && !_report.IsZeroReport)
    {
        <div class="alert alert-danger" data-testid="intrastat-nothing-declarable">@L["Intrastat.NothingDeclarable"]</div>
    }
    else if (_report.Rows.Count == 0)
    {
        <div class="alert alert-info" data-testid="intrastat-zero-report">@L["Intrastat.Empty"]</div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-sm align-middle">
                <thead>
                    <tr>
                        <th>@L["Intrastat.CommodityCode"]</th>
                        <th>@L["Intrastat.Country"]</th>
                        <th>@L["Intrastat.OriginCountry"]</th>
                        <th>@L["Intrastat.Nature"]</th>
                        <th>@L["Intrastat.Terms"]</th>
                        <th>@L["Intrastat.Mode"]</th>
                        <th class="text-end">@L["Intrastat.NetMass"]</th>
                        <th>@L["Intrastat.SuppUnit"]</th>
                        <th class="text-end">@L["Intrastat.SuppQty"]</th>
                        <th class="text-end">@L["Intrastat.Quantity"]</th>
                        <th class="text-end">@L["Intrastat.ValueEur"]</th>
                        <th class="text-end text-muted">@L["Intrastat.LandedCostEur"]</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var r in _report.Rows)
                    {
                        <tr class="@(r.IsReturn ? "table-warning" : null)">
                            <td class="mono">@r.CommodityCode @if (r.IsReturn) { <span class="badge text-bg-warning">@L["Intrastat.Return"]</span> }</td>
                            <td>@r.Country</td>
                            <td>@r.OriginCountry</td>
                            <td class="mono">@r.Nature</td>
                            <td class="mono">@r.DeliveryTerms</td>
                            <td class="mono">@r.TransportMode</td>
                            <td class="text-end mono">@r.NetMassKg.ToString("N3", Inv)</td>
                            <td>@r.SupplementaryUnit</td>
                            <td class="text-end mono">@(r.SupplementaryQuantity?.ToString("0.###", Inv))</td>
                            <td class="text-end mono">@r.Quantity.ToString("0.####", Inv)</td>
                            <td class="text-end mono">@r.ValueEur.ToString("N2", Inv)</td>
                            <td class="text-end mono text-muted">@(r.LandedValueEur?.ToString("N2", Inv))</td>
                        </tr>
                    }
                </tbody>
                <tfoot>
                    <tr class="fw-bold">
                        <td colspan="6">@L["Intrastat.Totals"]</td>
                        <td class="text-end mono">@_report.TotalNetMassKg.ToString("N3", Inv)</td>
                        <td colspan="2"></td>
                        <td class="text-end mono">@_report.TotalQuantity.ToString("0.####", Inv)</td>
                        <td class="text-end mono">@_report.TotalValueEur.ToString("N2", Inv)</td>
                        <td></td>
                    </tr>
                    @if (_report.TotalReturnValueEur != 0m)
                    {
                        <tr>
                            <td colspan="10">@L["Intrastat.ReturnsTotal"]</td>
                            <td class="text-end mono">@_report.TotalReturnValueEur.ToString("N2", Inv)</td>
                            <td></td>
                        </tr>
                    }
                </tfoot>
            </table>
        </div>
    }
}

@if (_versions.Count > 0)
{
    <h2 class="h5 mt-4">@L["Intrastat.Versions.Title"]</h2>
    <p class="text-muted">@L["Intrastat.Versions.Help"]</p>
    <div class="table-responsive">
        <table class="table table-sm align-middle" data-testid="intrastat-versions">
            <thead>
                <tr>
                    <th>@L["Intrastat.Versions.Version"]</th>
                    <th>@L["Intrastat.Versions.GeneratedAt"]</th>
                    <th>@L["Intrastat.Versions.GeneratedBy"]</th>
                    <th class="text-end">@L["Intrastat.Versions.Rows"]</th>
                    <th class="text-end">@L["Intrastat.ValueEur"]</th>
                    <th class="text-end">@L["Intrastat.NetMass"]</th>
                    <th>@L["Intrastat.Versions.Hash"]</th>
                    <th>@L["Intrastat.Versions.Filed"]</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var v in _versions)
                {
                    <tr>
                        <td class="mono">v@(v.Version)@(v.IsZeroReport ? " (0)" : "")</td>
                        <td>@v.GeneratedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm", Inv)</td>
                        <td>@v.GeneratedBy</td>
                        <td class="text-end mono">@v.RowCount</td>
                        <td class="text-end mono">@v.TotalValueEur.ToString("N2", Inv)</td>
                        <td class="text-end mono">@v.TotalNetMassKg.ToString("N3", Inv)</td>
                        <td class="mono">@v.Sha256[..8]</td>
                        <td>@(v.FiledAt is null ? "-" : v.FiledAt.Value.ToLocalTime().ToString("yyyy-MM-dd", Inv) + " " + v.FiledBy)</td>
                        <td class="text-nowrap">
                            <button class="btn btn-sm btn-outline-primary" type="button" @onclick="() => DownloadVersionAsync(v)">@L["Intrastat.Versions.Download"]</button>
                            @if (v.FiledAt is null)
                            {
                                <button class="btn btn-sm btn-outline-secondary" type="button" @onclick="() => MarkFiledAsync(v)">@L["Intrastat.Versions.MarkFiled"]</button>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@code {
    private static readonly CultureInfo Inv = CultureInfo.InvariantCulture;
    private DateTime _month = new(DateTime.Today.Year, DateTime.Today.Month, 1);
    private IntrastatReportDto? _report;
    private bool _busy;
    private ApiException? _apiError;
    private IntrastatDeclarantDto _declarant = new();
    private IReadOnlyList<IntrastatXmlVersionDto> _versions = [];

    protected override async Task OnInitializedAsync()
    {
        await LoadDeclarantAsync();
        await LoadAsync();
    }

    private async Task LoadDeclarantAsync()
    {
        try
        {
            _declarant = await Client.GetDeclarantAsync();
        }
        catch (ApiException ex)
        {
            _apiError = ex;
        }
    }

    private async Task SaveDeclarantAsync()
    {
        try
        {
            await Client.SaveDeclarantAsync(_declarant);
            await LoadDeclarantAsync();
            ToastService.ShowSuccess(L["Intrastat.Declarant.Saved"].Value);
        }
        catch (ApiException ex)
        {
            _apiError = ex;
            ToastService.ShowError(ex.Message);
        }
    }

    private async Task DownloadXmlAsync()
    {
        if (!_declarant.IsComplete)
        {
            ToastService.ShowError(L["Intrastat.Declarant.Missing"].Value);
            return;
        }

        try
        {
            _apiError = null;
            var bytes = await Client.GenerateXmlAsync(_month.Year, _month.Month);
            await LoadVersionsAsync();
            var latest = _versions.Count > 0 ? _versions[0].Version : 1;
            await JavaScript.InvokeVoidAsync("csvExport.downloadBytes",
                $"intrastat-arrivals-{_month:yyyy-MM}-v{latest}.xml", "application/xml", Convert.ToBase64String(bytes));
        }
        catch (ApiException ex)
        {
            _apiError = ex;
            ToastService.ShowError(ex.Message);
        }
    }

    private async Task DownloadVersionAsync(IntrastatXmlVersionDto version)
    {
        try
        {
            var bytes = await Client.GetXmlVersionFileAsync(version.Id);
            await JavaScript.InvokeVoidAsync("csvExport.downloadBytes",
                $"intrastat-arrivals-{version.Year:0000}-{version.Month:00}-v{version.Version}.xml", "application/xml", Convert.ToBase64String(bytes));
        }
        catch (ApiException ex)
        {
            _apiError = ex;
            ToastService.ShowError(ex.Message);
        }
    }

    private async Task MarkFiledAsync(IntrastatXmlVersionDto version)
    {
        try
        {
            await Client.MarkXmlFiledAsync(version.Id);
            await LoadVersionsAsync();
        }
        catch (ApiException ex)
        {
            _apiError = ex;
            ToastService.ShowError(ex.Message);
        }
    }

    private async Task LoadVersionsAsync()
    {
        try
        {
            _versions = await Client.GetXmlVersionsAsync(_month.Year, _month.Month);
        }
        catch (ApiException ex)
        {
            _apiError = ex;
        }
    }

    private async Task LoadAsync()
    {
        _busy = true;
        try
        {
            _apiError = null;
            _report = await Client.GetAsync(_month.Year, _month.Month);
            _versions = await Client.GetXmlVersionsAsync(_month.Year, _month.Month);
        }
        catch (ApiException ex)
        {
            _apiError = ex;
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task DownloadAsync()
    {
        try
        {
            var bytes = await Client.GetCsvAsync(_month.Year, _month.Month);
            await JavaScript.InvokeVoidAsync("csvExport.downloadBytes",
                $"intrastat-arrivals-{_month:yyyy-MM}.csv", "text/csv", Convert.ToBase64String(bytes));
        }
        catch (ApiException ex)
        {
            _apiError = ex;
            ToastService.ShowError(ex.Message);
        }
    }
}
