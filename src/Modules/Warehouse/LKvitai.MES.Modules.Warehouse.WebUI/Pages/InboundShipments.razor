@page "/inbound/shipments"
@using LKvitai.MES.Modules.Warehouse.WebUI.Infrastructure
@inject ReceivingClient ReceivingClient
@inject NavigationManager NavigationManager
@inject ToastService ToastService

<PageTitle>@L["InboundShipments.InboundShipmentsCikadaMES"]</PageTitle>

<h1>@L["InboundShipments.InboundShipments"]</h1>

@if (_apiError is not null)
{
    <ErrorBanner Message="@BuildErrorMessage(_apiError)"
                 TraceId="@_apiError.TraceId"
                 OnRetry="LoadAsync"
                 OnDismiss="DismissError" />
}

<div class="card shadow-sm mb-3">
    <div class="card-body">
        <div class="row g-2 align-items-end">
            <div class="col-md-2">
                <label class="form-label">@L["InboundShipments.SupplierId"]</label>
                <input type="number" class="form-control" @bind="_supplierId" />
            </div>
            <div class="col-md-2">
                <label class="form-label">@L["Common.Status"]</label>
                <select class="form-select" @bind="_status">
                    <option value="">@L["Common.All"]</option>
                    <option value="Draft">@L["InboundShipments.Draft"]</option>
                    <option value="Partial">@L["InboundShipments.Partial"]</option>
                    <option value="Complete">@L["Common.Complete"]</option>
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label">@L["InboundShipments.ExpectedFrom"]</label>
                <input type="date" class="form-control" @bind="_expectedFrom" />
            </div>
            <div class="col-md-2">
                <label class="form-label">@L["InboundShipments.ExpectedTo"]</label>
                <input type="date" class="form-control" @bind="_expectedTo" />
            </div>
            <div class="col-md-4 d-flex gap-2">
                <button class="btn btn-primary" @onclick="ApplyFiltersAsync" disabled="@_isLoading">@L["Common.Apply"]</button>
                <button class="btn btn-outline-secondary" @onclick="ResetFiltersAsync" disabled="@_isLoading">@L["Common.Reset"]</button>
                <button class="btn btn-outline-secondary" @onclick="LoadAsync" disabled="@_isLoading">@L["Common.Refresh"]</button>
                <button class="btn btn-success ms-auto" @onclick="OpenCreate">@L["InboundShipments.CreateInbound"]</button>
            </div>
        </div>
    </div>
</div>

<div class="card shadow-sm position-relative">
    <LoadingSpinner IsLoading="_isLoading" />
    <div class="card-body">
        <div class="mb-2"><strong>@L["InboundShipments.Total", _totalCount]</strong></div>

        <div class="table-responsive">
            <table class="table table-sm table-hover align-middle">
                <thead>
                    <tr>
                        <th>@L["Common.Shipment"]</th>
                        <th>@L["Common.Reference"]</th>
                        <th>@L["Common.Supplier"]</th>
                        <th>@L["Common.Status"]</th>
                        <th>@L["InboundShipments.ExpectedDate"]</th>
                        <th>@L["Common.Lines"]</th>
                        <th>@L["InboundShipments.ReceivedExpected"]</th>
                        <th class="text-end">@L["Pricing.PurchaseTotal"]</th>
                        <th class="text-end">@L["Pricing.CostTotal"]</th>
                        <th class="text-end">@L["Pricing.SaleTotal"]</th>
                        <th>@L["Common.Actions"]</th>
                    </tr>
                </thead>
                <tbody>
                    @if (_rows.Count == 0)
                    {
                        <tr>
                            <td colspan="11">
                                <EmptyState Title="@L["InboundShipments.NoInboundShipments"]"
                                            Message="@L["InboundShipments.CreateInboundShipmentToStartReceivingWorkflow"]"
                                            IconCss="bi bi-box-arrow-in-down"
                                            OnAction="OpenCreateAsync" />
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var row in _rows)
                        {
                            <tr>
                                <td>ISH-@row.Id</td>
                                <td>@row.ReferenceNumber</td>
                                <td>@row.SupplierName (@row.SupplierId)</td>
                                <td><span class="badge @GetStatusBadge(row.Status)">@WarehouseStatusText.Get(L, row.Status)</span></td>
                                <td>@row.ExpectedDate?.ToString("yyyy-MM-dd")</td>
                                <td>@row.TotalLines</td>
                                <td>@row.TotalReceivedQty.ToString("0.##") / @row.TotalExpectedQty.ToString("0.##")</td>
                                <td class="text-end is-money is-num">@Money.Format(row.TotalExpectedValue)</td>
                                <td class="text-end is-money is-num">@Money.Format(row.TotalCostValue)</td>
                                <td class="text-end is-money is-num">@Money.Format(row.TotalSaleValue)</td>
                                <td>
                                    <button class="btn btn-sm btn-outline-primary" @onclick="() => OpenDetails(row.Id)">@L["Common.View"]</button>
                                    @if (string.Equals(row.Status, "Draft", StringComparison.OrdinalIgnoreCase))
                                    {
                                        <button class="btn btn-sm btn-outline-secondary ms-1" @onclick="() => OpenEdit(row.Id)">@L["Common.Edit"]</button>
                                    }
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>

        @if (_totalCount > 0)
        {
            <Pagination CurrentPage="_pageNumber"
                        TotalPages="TotalPages"
                        PageSize="_pageSize"
                        OnPageChanged="OnPageChangedAsync"
                        OnPageSizeChanged="OnPageSizeChangedAsync" />
        }
    </div>
</div>

@code {
    private readonly List<InboundShipmentSummaryDto> _rows = [];
    private ApiException? _apiError;
    private bool _isLoading;
    private int? _supplierId;
    private string _status = string.Empty;
    private DateTime? _expectedFrom;
    private DateTime? _expectedTo;
    private int _pageNumber = 1;
    private int _pageSize = 50;
    private int _totalCount;

    private int TotalPages => Math.Max(1, (int)Math.Ceiling(_totalCount / (double)Math.Max(1, _pageSize)));

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private async Task ApplyFiltersAsync()
    {
        _pageNumber = 1;
        await LoadAsync();
    }

    private async Task ResetFiltersAsync()
    {
        _supplierId = null;
        _status = string.Empty;
        _expectedFrom = null;
        _expectedTo = null;
        _pageNumber = 1;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _isLoading = true;
        _apiError = null;

        try
        {
            var response = await ReceivingClient.GetShipmentsAsync(
                _supplierId,
                _status,
                ParseDate(_expectedFrom),
                ParseDate(_expectedTo),
                _pageNumber,
                _pageSize);

            _rows.Clear();
            _rows.AddRange(response.Items);
            _totalCount = response.TotalCount;
        }
        catch (ApiException ex)
        {
            _apiError = ex;
            ToastService.ShowError(BuildErrorMessage(ex));
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task OnPageChangedAsync(int page)
    {
        _pageNumber = Math.Max(1, page);
        await LoadAsync();
    }

    private async Task OnPageSizeChangedAsync(int size)
    {
        _pageSize = Math.Clamp(size, 1, 500);
        _pageNumber = 1;
        await LoadAsync();
    }

    private void OpenDetails(int id)
    {
        NavigationManager.NavigateTo($"/warehouse/inbound/shipments/{id}");
    }

    private void OpenEdit(int id)
    {
        NavigationManager.NavigateTo($"/warehouse/inbound/shipments/{id}/edit");
    }

    private void OpenCreate()
    {
        NavigationManager.NavigateTo("/warehouse/inbound/shipments/create");
    }

    private Task OpenCreateAsync()
    {
        OpenCreate();
        return Task.CompletedTask;
    }

    private void DismissError()
    {
        _apiError = null;
    }

    private static DateOnly? ParseDate(DateTime? date)
    {
        return date.HasValue ? DateOnly.FromDateTime(date.Value.Date) : null;
    }

    private static string GetStatusBadge(string status) => status.ToUpperInvariant() switch
    {
        "DRAFT" => "bg-secondary",
        "PARTIAL" => "bg-warning text-dark",
        "COMPLETE" => "bg-success",
        _ => "bg-secondary"
    };

    private string BuildErrorMessage(ApiException ex)
    {
        if (!string.IsNullOrWhiteSpace(WarehouseErrorText.Get(L, ex)))
        {
            return WarehouseErrorText.Get(L, ex);
        }

        return ex.ProblemDetails?.Detail
               ?? ex.ProblemDetails?.Title
               ?? L["InboundShipments.RequestFailed"].Value;
    }
}
