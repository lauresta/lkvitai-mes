@inject NavigationManager Navigation
@inject IConfiguration Configuration
@implements IDisposable

<nav aria-label="@L["NavMenu.WarehouseNavigation"]" class="sidebar__nav">

    <NavLink class="nav-dash" href="dashboard" Match="NavLinkMatch.All" ActiveClass="is-active">
        <i class="bi bi-speedometer2" title="@(Collapsed ? L["Nav.Dashboard"].Value : null)"></i>
        @if (!Collapsed) { <span>@L["Nav.Dashboard"]</span> }
    </NavLink>

    @foreach (var grp in _sections)
    {
        var isOpen = _openSection == grp.Key;
        var hasActive = grp.Items.Any(i => _currentPath.StartsWith(i.Href, StringComparison.OrdinalIgnoreCase));
        var sectionId = $"nav-sect-{grp.Key}";

        <div class="nav-section">
            <button class="nav-section-toggle @(isOpen ? "open" : "") @(hasActive ? "has-active" : "")"
                    aria-expanded="@isOpen.ToString().ToLower()"
                    aria-controls="@(Collapsed ? null : sectionId)"
                    title="@grp.Label"
                    @onclick="() => Toggle(grp.Key)">
                <i class="bi @grp.Icon" title="@(Collapsed ? grp.Label : null)"></i>
                @if (!Collapsed)
                {
                    <span class="nav-section-label">@grp.Label</span>
                    <i class="bi bi-chevron-down nav-chevron" aria-hidden="true"></i>
                }
            </button>

            @if (isOpen && !Collapsed)
            {
                <ul class="nav-section-items" id="@sectionId" role="list">
                    @foreach (var item in grp.Items)
                    {
                        var href = item.Href == WarehouseNavigation.HangfireHref
                            ? (Configuration["Hangfire:DashboardUrl"] ?? "#")
                            : item.Href;
                        <li>
                            @if (item.External)
                            {
                                <a class="nav-link" href="@href" target="_blank" rel="noopener noreferrer">
                                    <i class="bi @item.Icon" aria-hidden="true"></i>
                                    <span>@item.Label</span>
                                </a>
                            }
                            else
                            {
                                <NavLink class="nav-link" href="@item.Href"
                                         Match="NavLinkMatch.Prefix"
                                         ActiveClass="is-active">
                                    <i class="bi @item.Icon" aria-hidden="true"></i>
                                    <span>@item.Label</span>
                                </NavLink>
                            }
                        </li>
                    }
                </ul>
            }
        </div>
    }

</nav>

@code {
    [Parameter] public bool Collapsed { get; set; }

    private string? _openSection;
    private string _currentPath = "";

    private record NavItem(string Href, string Icon, string Label, bool External = false);
    private record NavSection(string Key, string Label, string Icon, NavItem[] Items);

    private NavSection[] _sections = [];

    protected override void OnInitialized()
    {
        // Built once per circuit: the UI language is fixed for the lifetime of the component.
        _sections = BuildSections();
        _currentPath = Navigation.ToBaseRelativePath(Navigation.Uri);
        Navigation.LocationChanged += OnLocationChanged;
        _openSection = FindSectionForPath(_currentPath);
    }

    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        _currentPath = Navigation.ToBaseRelativePath(e.Location);
        var active = FindSectionForPath(_currentPath);
        if (active is not null)
            _openSection = active;
        InvokeAsync(StateHasChanged);
    }

    private string? FindSectionForPath(string path)
    {
        foreach (var s in _sections)
        {
            if (s.Items.Any(i => path.StartsWith(i.Href, StringComparison.OrdinalIgnoreCase)))
                return s.Key;
        }
        return null;
    }

    private void Toggle(string key)
    {
        if (!Collapsed)
            _openSection = _openSection == key ? null : key;
    }

    public void Dispose()
    {
        Navigation.LocationChanged -= OnLocationChanged;
    }

    private NavSection[] BuildSections() => WarehouseNavigation.Sections
        .Select(section => new NavSection(
            section.Key,
            L[section.LabelKey].Value,
            section.Icon,
            section.Items.Select(item => new NavItem(item.Href, item.Icon, L[item.LabelKey].Value, item.External)).ToArray()))
        .ToArray();
}
