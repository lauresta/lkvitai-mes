                }
                else
                {
                    <div class="gamyba-history-grid">
                        <section class="gamyba-panel"><div class="gamyba-history-card"><div class="gamyba-history-card__barcode mono">@HistoryItem.Barcode</div><strong>@HistoryItem.Type · @HistoryItem.Width × @HistoryItem.Height</strong><p>@HistoryItem.Fabric · @HistoryItem.Quantity @L("pcs", "vnt.")</p>
