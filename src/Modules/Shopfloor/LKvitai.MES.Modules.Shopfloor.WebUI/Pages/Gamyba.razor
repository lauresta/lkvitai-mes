                                }
                            </section>
                            <aside class="gamyba-stack"><section class="gamyba-panel"><div class="gamyba-panel__head"><strong>@L("Data pilot", "Duomenų bandymas")</strong></div><div class="gamyba-sidebody"><span class="chip chip--info">@L("READ ONLY", "TIK PERŽIŪRA")</span><small>@L("Only the selected GU's legacy report rows are shown. Document layout and saved PDFs will be connected after comparison with Access.", "Rodomos tik pasirinkto GU legacy ataskaitos eilutės. Dokumento maketas ir išsaugoti PDF bus prijungti po palyginimo su Access.")</small></div></section></aside>
                        </div>
                    }
                }
                else
                {
                <div class="gamyba-pagehead"><div><div class="gamyba-eyebrow">SHOPFLOOR · G05 · @L("DOCUMENTS FOR", "DOKUMENTAI GU") <span class="mono">@CurrentTask.Number</span></div><h1>@L("Production documents", "Gamybos dokumentai")</h1></div><div class="gamyba-segment"><button type="button" class="@(_reportMode == "preview" ? "is-active" : "")" @onclick='() => _reportMode = "preview"'>@L("Print · PDF", "Spausdinti · PDF")</button><button type="button" class="@(_reportMode == "editor" ? "is-active" : "")" disabled="@(!Supervisor)" @onclick='() => _reportMode = "editor"'>@L("Template editor", "Šablono redaktorius")</button></div></div>
                @if(_reportMode == "preview")
                {
                    <div class="gamyba-docs-grid">
                        <section class="gamyba-panel"><div class="gamyba-panel__head"><strong>13 @L("reports", "ataskaitų")</strong><span>· DIC_ProjectReports gam</span></div><div class="gamyba-report-list">@foreach(var report in GamybaFixtures.Reports){<button type="button" class="@(_report == report ? "is-active" : "")" @onclick="() => _report = report"><span class="gamyba-report-radio"></span><span>@report</span><span class="mono">@ReportCount(report)</span></button>}</div></section>
                        <section class="gamyba-panel gamyba-docs-preview"><div class="gamyba-panel__head"><div><strong>@_report</strong><span class="mono"> · @_templateVersion · A4 @L("portrait", "vertikalus")</span></div><span class="mono">1 / 1</span></div>@if(!ReportItems.Any()){<div class="gamyba-empty"><strong>NoData</strong><span>@L("No rows. Printing is cancelled.", "Nėra eilučių. Spausdinimas atšauktas.")</span><span class="mono">Report_NoData → Cancel</span></div>}else{<div class="gamyba-docs-stage"><article class="gamyba-doc-paper"><header><div><strong>@_report</strong><span>UAB Lauresta · Gamyba</span></div><div class="mono"><strong>@CurrentTask.Number</strong><span>@DateTime.Today.ToString("yyyy-MM-dd")</span></div></header><div class="gamyba-doc-meta"><div>@L("Author", "Autorius") <strong>@CurrentTask.Author</strong></div><div>@L("Branch", "Filialas") <strong>@string.Join(", ", TaskItems(CurrentTask).Select(x => x.Branch).Distinct())</strong></div><div>@L("items", "gaminiai") <strong>@ReportItems.Count()</strong></div></div><table class="gamyba-table"><thead><tr><th>@L("Barcode", "Kodas")</th><th>@L("Order", "Užsakymas")</th><th>@L("Material", "Medžiaga")</th><th>@L("Size", "Matmenys")</th><th class="is-num">@L("Qty", "Kiekis")</th></tr></thead><tbody>@foreach(var item in ReportItems){<tr><td class="mono">@item.Barcode</td><td class="mono">@item.Order</td><td>@item.Fabric</td><td class="mono">@item.Width × @item.Height</td><td class="mono is-num">@item.Quantity</td></tr>}</tbody></table><footer><span>@L("Total", "Iš viso"): <strong>@ReportItems.Sum(x => x.Quantity)</strong> · @L("generated from", "sukurta iš"): GU</span><span class="mono">@_templateVersion · 1/1</span></footer></article></div>}</section>
                        <aside class="gamyba-stack"><section class="gamyba-panel"><div class="gamyba-sidebody"><button type="button" class="gamyba-btn gamyba-btn--primary" disabled="@(!ReportItems.Any())" @onclick="PrintReport">@L("Print… (browser dialog)", "Spausdinti… (naršyklėje)")</button><button type="button" class="gamyba-btn" @onclick="() => OpenArchivedPdf(_report)">@L("Open original PDF", "Atidaryti originalų PDF")</button><button type="button" class="gamyba-btn gamyba-btn--sand" disabled="@(!ReportItems.Any())" @onclick="NewReportVersion">@L("Create new version from current data", "Sukurti naują versiją iš dabartinių duomenų")</button><div class="gamyba-warning">@L("Composition changed after the last PDF. The original is kept; a new version will be marked generated from current data.", "Sudėtis keitėsi po paskutinio PDF. Originalas išsaugomas; nauja versija bus pažymėta kaip sukurta iš dabartinių duomenų.")</div><small>@L("Reprint never changes status or stock. Paper, orientation and 100% scale are set in the browser dialog.", "Pakartotinis spausdinimas nekeičia būsenos ar likučių. Popierius, orientacija ir 100% mastelis nustatomi naršyklėje.")</small></div></section><section class="gamyba-panel"><div class="gamyba-panel__head"><strong>@L("Versions · archive", "Versijos · archyvas")</strong></div><div class="gamyba-sidebody"><div class="gamyba-doc-version"><strong class="mono">v1</strong><div>@_report · @L("generated from GU commit", "sukurta iš GU")<small class="mono">2026-11-02 09:14 · Rūta M. · sha256 9f3a…c21e</small></div></div>@foreach(var pdf in CurrentTask.Pdfs){<div class="gamyba-doc-version"><strong class="mono">@_templateVersion</strong><div>@pdf<small>@L("Archived fixture", "Pavyzdinis archyvas")</small></div></div>}</div></section></aside>
                    </div>
                }
                else
                {
                    <div class="gamyba-editor-banner"><span class="gamyba-dot"></span><span><strong>@_report</strong> · @L("editing", "redaguojama") <span class="mono">v3-draft</span> · @L("published", "paskelbta") <span class="mono">@_templateVersion</span> · dataset <span class="mono">GamTaskLines v4</span></span><span>@L("Dataset fields only · no SQL · no EPL", "Tik duomenų laukai · be SQL · be EPL")</span></div>
                    <div class="gamyba-editor-grid"><section class="gamyba-panel"><div class="gamyba-panel__head"><strong>@L("Dataset fields", "Duomenų laukai")</strong></div><div class="gamyba-dataset-list">@foreach(var field in DatasetFields){var used = _columns.Any(x => x.Field == field.Field);<div><span class="mono">@field.Field</span><small class="mono">@field.Type</small>@if(used){<strong>@L("in use", "naudojamas")</strong>}else{<button type="button" @onclick="() => AddTemplateField(field.Field)">+ @L("Add", "Pridėti")</button>}</div>}</div><div class="gamyba-panel__foot">@L("A missing field requires an API dataset extension, not SQL in this editor.", "Jei lauko trūksta, reikia plėsti API duomenų rinkinį, ne rašyti SQL šiame redaktoriuje.")</div></section>
                        <section class="gamyba-panel gamyba-editor-preview"><div class="gamyba-panel__head"><div class="gamyba-segment"><button type="button" class="@(!_compareTemplates ? "is-active" : "")" @onclick='() => _compareTemplates = false'>@L("Draft", "Juodraštis")</button><button type="button" class="@(_compareTemplates ? "is-active" : "")" @onclick='() => _compareTemplates = true'>@L("Compare", "Palyginti")</button></div><span>@L("Click a column header to edit it", "Paspauskite stulpelio antraštę redagavimui")</span></div><div class="gamyba-editor-stage"><div class="gamyba-editor-sheet"><div class="gamyba-report-sheet__head"><strong>@_report</strong><span class="mono">v3-draft · @L("Draft", "Juodraštis")</span></div><table class="gamyba-table"><thead><tr>@foreach(var column in _columns){<th><button type="button" class="gamyba-editor-column @(_selectedColumn == column.Field ? "is-active" : "")" @onclick="() => _selectedColumn = column.Field">@column.Label</button></th>}</tr></thead><tbody>@foreach(var item in ReportItems.Take(3)){<tr>@foreach(var column in _columns){<td>@TemplateCell(item,column.Field)</td>}</tr>}</tbody></table></div>@if(_compareTemplates){<div class="gamyba-editor-sheet"><div class="gamyba-report-sheet__head"><strong>@_report</strong><span class="mono">@_templateVersion · @L("Published", "Paskelbta")</span></div><table class="gamyba-table"><thead><tr>@foreach(var column in _publishedColumns){<th>@column.Label</th>}</tr></thead><tbody>@foreach(var item in ReportItems.Take(3)){<tr>@foreach(var column in _publishedColumns){<td>@TemplateCell(item,column.Field)</td>}</tr>}</tbody></table></div>}</div></section>
                        <aside class="gamyba-stack"><section class="gamyba-panel"><div class="gamyba-panel__head"><strong>@L("Field", "Laukas") · <span class="mono">@_selectedColumn</span></strong></div>@if(CurrentColumn is null){<div class="gamyba-sidebody"><p>@L("Select a column in the draft preview.", "Pasirinkite stulpelį juodraščio peržiūroje.")</p></div>}else{<div class="gamyba-sidebody"><label class="gamyba-fieldlabel">@L("Label", "Pavadinimas")</label><input class="gamyba-input" @bind="CurrentColumn.Label" @bind:after="() => _templateDraftSaved = false" @onfocus="SelectFocusedInput" /><div class="gamyba-formrow"><label>@L("Position", "Vieta")<span class="gamyba-actions"><button type="button" class="gamyba-btn gamyba-btn--xs" @onclick="() => MoveTemplateField(-1)">←</button><button type="button" class="gamyba-btn gamyba-btn--xs" @onclick="() => MoveTemplateField(1)">→</button></span></label><label>@L("Width", "Plotis") %<input type="number" min="4" max="80" class="gamyba-input mono" @bind="CurrentColumn.Width" @bind:after="() => _templateDraftSaved = false" @onfocus="SelectFocusedInput" /></label></div><button type="button" class="gamyba-btn" @onclick="RemoveTemplateField">@L("Remove field", "Pašalinti lauką")</button></div>}</section><section class="gamyba-panel"><div class="gamyba-sidebody"><button type="button" class="gamyba-btn" disabled="@(_templateDraftSaved)" @onclick="SaveTemplate">@L("Save draft", "Išsaugoti juodraštį")</button><button type="button" class="gamyba-btn gamyba-btn--primary" disabled="@(!_templateDraftSaved)" @onclick="PublishTemplate">@L("Publish version", "Paskelbti versiją")</button><button type="button" class="gamyba-btn" @onclick="RollbackTemplate">@L("Revert to published", "Grąžinti paskelbtą")</button><small>@L("Published versions are immutable; the previous one stays available for rollback.", "Paskelbtos versijos nekintamos; ankstesnė lieka prieinama grąžinimui.")</small><div class="gamyba-doc-version"><strong class="mono">@_templateVersion</strong><div>@L("Published · added Note column", "Paskelbta · pridėta Pastaba")<small class="mono">2026-10-14</small></div></div><div class="gamyba-doc-version"><strong class="mono">v1</strong><div>@L("Published · imported from Access layout", "Paskelbta · perkelta iš Access")<small class="mono">2026-09-30</small></div></div></div></section></aside>
                    </div>
                }
                }
            }

            @if (_screen == "labels")
            {
                <div class="gamyba-pagehead"><div><div class="gamyba-eyebrow">SHOPFLOOR · G06 · ZEBRA / EPL</div><h1>@L("Label print queue", "Etikečių spausdinimo eilė")</h1></div><div class="gamyba-actions"><div class="gamyba-workstation"><span class="gamyba-dot"></span><strong>@L("Workstation", "Darbo vieta")</strong> CECH-02 · COM3 · ZD421 203dpi <span>|</span> @L("COM owner", "COM savininkas"): <div class="gamyba-segment"><button type="button" class="@(_comOwner == "agent" ? "is-active" : "")" @onclick='() => _comOwner = "agent"'>web-agent</button><button type="button" class="@(_comOwner == "access" ? "is-active" : "")" @onclick='() => _comOwner = "access"'>Access</button></div></div><button type="button" class="gamyba-btn" @onclick='() => _modal = "new-label-job"'>+ @L("New print job", "Nauja spausdinimo užduotis")</button></div></div>
                @if(_comOwner == "access")
                {
                    <div class="gamyba-warning"><strong>@L("COM3 is owned by Access on this workstation.", "COM3 šioje darbo vietoje priklauso Access.")</strong> @L("The web agent will not open the port; new jobs wait as Pending.", "Web agentas porto neatidarys; naujos užduotys lauks Pending.")</div>
                }
                <div class="gamyba-label-grid">
                    <section class="gamyba-panel"><div class="gamyba-tablewrap"><table class="gamyba-table"><thead><tr><th>@L("Job", "Užduotis")</th><th>GU</th><th>@L("Mode", "Režimas")</th><th>@L("State", "Būsena")</th><th>@L("Progress", "Pažanga")</th><th>@L("Counts", "Kiekiai")</th><th>@L("Note", "Pastaba")</th></tr></thead><tbody>@foreach(var job in _jobs){<tr class="gamyba-clickrow @(_labelJob == job.Number ? "is-selected" : "")" @onclick="() => _labelJob = job.Number"><td class="mono gamyba-accent"><strong>@job.Number</strong></td><td class="mono">@job.Task</td><td>@job.Mode</td><td><span class="chip @JobClass(job.State)">@job.State</span></td><td><div class="gamyba-progress"><span style="width:@($"{job.Sent * 100 / Math.Max(1, job.PhysicalLabels)}%")"></span></div><small class="mono">@job.Sent/@job.PhysicalLabels</small></td><td class="mono">@job.PhysicalLabels @L("physical", "fizinės")</td><td>@job.Note</td></tr>}</tbody></table></div><div class="gamyba-panel__foot">@L("Rows, product quantity and physical labels are separate counters.", "Eilutės, gaminių kiekis ir fizinės etiketės skaičiuojamos atskirai.")</div></section>
                    <section class="gamyba-panel"><div class="gamyba-panel__head"><strong class="mono">@CurrentJob.Number · @CurrentJob.Task</strong><span class="chip @JobClass(CurrentJob.State)">@CurrentJob.State</span></div>@if(CurrentJob.State == "Uncertain"){<div class="gamyba-warning"><strong>@L("No acknowledgement after a label.", "Po etiketės nėra patvirtinimo.")</strong> @L("Select exactly which labels to repeat.", "Pasirinkite tiksliai kurias etiketes kartoti.")</div>}<div class="gamyba-label-actions"><button type="button" class="gamyba-btn" disabled="@(CurrentJob.State is "Sent" or "Cancelled" or "Paused")" @onclick='() => ChangeJobState("Paused")'>❚❚ @L("Pause", "Pauzė")</button><button type="button" class="gamyba-btn" disabled="@(CurrentJob.State != "Paused")" @onclick='() => ChangeJobState("Pending")'>▶ @L("Resume", "Tęsti")</button><button type="button" class="gamyba-btn" disabled="@(CurrentJob.State is "Sent" or "Cancelled")" @onclick='() => ChangeJobState("Cancelled")'>@L("Cancel remaining", "Atšaukti likusias")</button><button type="button" class="gamyba-btn" disabled="@(!_reprintSelected.Any())" @onclick="QueueReprint">@L("Reprint selected", "Perspausdinti pasirinktas") (@_reprintSelected.Count)</button><button type="button" class="gamyba-btn" @onclick="AdvanceJob">@L("Send next", "Siųsti kitą")</button></div><div class="gamyba-tablewrap"><table class="gamyba-table"><thead><tr><th></th><th>#</th><th>@L("Kind", "Rūšis")</th><th>@L("Barcode", "Kodas")</th><th>@L("Text", "Tekstas")</th><th>@L("State", "Būsena")</th></tr></thead><tbody>@foreach(var n in Enumerable.Range(1, CurrentJob.PhysicalLabels)){<tr><td><input type="checkbox" checked="@_reprintSelected.Contains(n)" disabled="@(n <= CurrentJob.Sent || CurrentJob.State != "Uncertain")" @onchange="() => ToggleReprint(n)" /></td><td class="mono">@n</td><td><span class="gamyba-label-kind mono">@LabelKind(CurrentJob,n)</span></td><td class="mono">@LabelBarcode(CurrentJob,n)</td><td>@(LabelKind(CurrentJob,n) == "P1" ? L("Product label", "Gaminio etiketė") : LabelKind(CurrentJob,n) == "SEP" ? L("Group separator", "Grupės skirtukas") : L("Extra label", "Papildoma etiketė"))</td><td><span class="chip @JobClass(LabelState(CurrentJob,n))">@LabelState(CurrentJob,n)</span></td></tr>}</tbody></table></div><div class="gamyba-panel__foot">@L("Sent labels are not cancelled. Bytes sent do not prove physical printing.", "Išsiųstos etiketės neatšaukiamos. Išsiųsti baitai neįrodo fizinio spausdinimo.")</div></section>
                </div>
            }

            @if (_screen == "map")
            {
                <div class="gamyba-pagehead"><div><div class="gamyba-eyebrow">@L("DELIVERABLES", "REZULTATAI")</div><h1>@L("Screen map · states · open questions", "Ekranų žemėlapis · būsenos · klausimai")</h1></div></div>
                <div class="gamyba-map-grid">
                    <section class="gamyba-panel"><div class="gamyba-panel__head"><strong>@L("Screens and transitions", "Ekranai ir perėjimai")</strong></div><div class="gamyba-map-rows">
                        @foreach (var row in MapRows)
                        {
                            <div><span class="mono">@row.Code</span><button type="button" class="gamyba-textbutton" @onclick="() => OpenMapRow(row.Target)">@row.Screen</button><span>@row.Flow</span></div>
                        }
                    </div></section>
                    <section class="gamyba-panel"><div class="gamyba-panel__head"><strong>@L("States per frequent operation", "Būsenos dažnoms operacijoms")</strong></div><div class="gamyba-tablewrap"><table class="gamyba-table gamyba-matrix"><thead><tr><th></th>@foreach (var state in MatrixStates){<th>@state</th>}</tr></thead><tbody>
                        @foreach (var row in MatrixRows)
                        {
                            <tr><td><strong>@row.Operation</strong></td>@for (var i=0; i<row.States.Length; i++){var state=row.States[i];<td title="@MatrixStates[i]"><span class="gamyba-matrix-dot gamyba-matrix-dot--@state"></span></td>}</tr>
                        }
                    </tbody></table></div><div class="gamyba-matrix-legend"><span><i class="gamyba-matrix-dot gamyba-matrix-dot--y"></i>@L("covered", "padengta")</span><span><i class="gamyba-matrix-dot gamyba-matrix-dot--p"></i>@L("partial", "iš dalies")</span><span><i class="gamyba-matrix-dot gamyba-matrix-dot--q"></i>@L("business rule", "verslo taisyklė")</span><span><i class="gamyba-matrix-dot gamyba-matrix-dot--n"></i>n/a</span></div></section>
                </div>
                <section class="gamyba-map-questions"><div class="gamyba-panel__head"><strong>@L("Questions the design cannot settle", "Klausimai, kurių dizainas neišsprendžia")</strong><span>@L("business rules needed; marked ? in the UI", "reikia verslo taisyklių; UI pažymėta ?")</span></div><div class="gamyba-tablewrap"><table class="gamyba-table"><thead><tr><th>ID</th><th>@L("Where", "Kur")</th><th>@L("Question", "Klausimas")</th><th>@L("Design decision", "Dizaino sprendimas")</th></tr></thead><tbody>
                    @foreach (var question in MapQuestions)
                    {
                        <tr><td class="mono"><strong>@question.Id</strong></td><td>@question.Area</td><td>@question.Question</td><td>@question.Design</td></tr>
                    }
                </tbody></table></div></section>
            }

            @if(_modal is not null)
            {
                <div class="gamyba-modal-backdrop" @onclick="() => _modal = null"><section class="gamyba-modal @(_modal == "issue" ? "gamyba-modal--issue" : "")" role="dialog" aria-modal="true" @onclick:stopPropagation="true">
                    @if(_modal == "issue")
                    {
                        <div class="gamyba-panel__head"><div><span class="gamyba-eyebrow">GU · G02–G03</span><strong>@L("Issue selected rows to production", "Išduoti pasirinktas eilutes gamybai")</strong></div><button type="button" class="gamyba-textbutton" @onclick="() => _modal = null">Esc</button></div>
                        <div class="gamyba-sidebody">
                            <div class="gamyba-issue-stats"><div><span>@L("Target GU", "Tikslinė GU")</span><strong class="mono">@(_targetGu == "new" ? L("New GU", "Nauja GU") : _targetGu)</strong></div><div><span>@L("Rows", "Eilutės")</span><strong class="mono">@_selected.Count</strong></div><div><span>@L("Items", "Gaminiai")</span><strong class="mono">@_items.Where(x => _selected.Contains(x.Id)).Sum(x => x.Quantity)</strong></div><div><span>@L("Branches", "Filialai")</span><strong>@string.Join(", ", _items.Where(x => _selected.Contains(x.Id)).Select(x => x.Branch).Distinct())</strong></div></div>
                            @if (_items.Where(x => _selected.Contains(x.Id)).Select(x => x.Branch).Distinct().Count() > 1)
                            {
                                <div class="gamyba-warning">@L("This GU contains items from more than one branch.", "Šioje GU yra kelių filialų gaminiai.")</div>
                            }
                            <div class="gamyba-issue-rows">
                                @foreach (var item in _items.Where(x => _selected.Contains(x.Id)))
                                {
                                    <div class="@(item.Id == _issueConflictId ? "is-conflict" : "")"><span class="mono">@item.Order</span><span>@item.Type · @item.Fabric @if(item.Id == _issueConflictId){<strong>@L("CONFLICT", "KONFLIKTAS")</strong>}</span><span class="mono">@item.Width × @item.Height</span><b class="mono">@item.Quantity</b></div>
                                }
                            </div>
                            @if (_issuePhase == "idle")
                            {
                                <small>@L("Rights, state and version are checked again immediately before issue.", "Teisės, būsena ir versija tikrinamos dar kartą prieš išdavimą.")</small>
                            }
                            else if (_issuePhase == "busy")
                            {
                                <div class="gamyba-issue-busy"><strong>@L("Issuing portion…", "Išduodama porcija…")</strong><span class="mono">cmd @_pendingCommand</span><div class="gamyba-issue-progress"><span></span></div><small>@L("A second click is ignored while the command is running.", "Kol komanda vykdoma, antras paspaudimas ignoruojamas.")</small></div>
                            }
                            else if (_issuePhase == "timeout")
                            {
                                <div class="gamyba-warning"><strong>@L("No response.", "Nėra atsakymo.")</strong> @L("Check the original command result; do not issue again.", "Patikrinkite pirminės komandos rezultatą; neišduokite dar kartą.") <span class="mono">cmd @_pendingCommand</span></div>
                            }
                            else if (_issuePhase == "error")
                            {
                                <div class="gamyba-alert gamyba-alert--danger"><span><strong>@L("Issue blocked.", "Išdavimas blokuojamas.")</strong> @_issueProblem<br />@L("Nothing was issued.", "Niekas neišduota.")</span></div>
                            }
                            <div class="gamyba-actions gamyba-issue-footer"><button type="button" class="gamyba-btn" @onclick="() => _modal = null">@L("Cancel", "Atšaukti")</button>@if(_issuePhase == "error"){<button type="button" class="gamyba-btn" @onclick="RemoveIssueConflict">@L("Remove conflicting row", "Pašalinti konfliktuojančią eilutę")</button>}@if(_issuePhase == "timeout"){<button type="button" class="gamyba-btn gamyba-btn--primary" @onclick="CheckIssueResult">@L("Check result", "Tikrinti rezultatą")</button>}else{<button type="button" class="gamyba-btn gamyba-btn--primary" disabled="@(_issuePhase == "busy" || _selected.Count == 0)" @onclick="ConfirmIssue">@(_issuePhase == "busy" ? L("Issuing…", "Išduodama…") : L("Issue portion", "Išduoti porciją"))</button>}</div>
                        </div>
                    }
                    else if(_modal == "new-gt")
                    {
                        <div class="gamyba-panel__head"><strong>@L("New GT document", "Naujas GT dokumentas")</strong><button type="button" class="gamyba-textbutton" @onclick="() => _modal = null">×</button></div><div class="gamyba-sidebody"><div class="gamyba-formrow"><label>@L("Number", "Numeris")<input class="gamyba-input mono" value="@($"GT-261102-{_documents.Count + 2:000}")" readonly /></label><label>@L("Date", "Data")<input class="gamyba-input mono" value="2026-11-02" readonly /></label></div><span class="gamyba-fieldlabel">@L("Allowed operation", "Leidžiama operacija")</span><div class="gamyba-gt-options">@foreach(var op in new[] { "pagaminta", "filialui", "atiduota", "sandelis" }){var denied = (op == "atiduota" && !Supervisor) || (op == "sandelis" && Restricted);var transition=OperationTransition(op);<button type="button" class="@(_newGtOp == op ? "is-active" : "")" disabled="@denied" @onclick="() => _newGtOp = op"><span class="gamyba-report-radio"></span><strong>@op</strong><span class="mono">@transition.Before → @transition.After</span>@if(denied){<span class="gamyba-danger">@L("No rights", "Nėra teisių")</span>}</button>}</div><small>@L("Operations follow legacy state and user rights.", "Operacijos priklauso nuo legacy būsenos ir naudotojo teisių.")</small><div class="gamyba-actions"><button type="button" class="gamyba-btn" @onclick="() => _modal = null">@L("Cancel", "Atšaukti")</button><button type="button" class="gamyba-btn gamyba-btn--primary" @onclick="CreateDocument">@L("Create GT", "Sukurti GT")</button></div></div>
                    }
                    else if(_modal == "compare")
                    {
                        <div class="gamyba-panel__head"><strong>@L("Compare template versions", "Palyginti šablono versijas")</strong><button type="button" class="gamyba-textbutton" @onclick="() => _modal = null">×</button></div><div class="gamyba-sidebody"><p>@L("Published v2 and current draft. Previous published version remains available.", "Paskelbta v2 ir dabartinis juodraštis. Ankstesnė paskelbta versija lieka prieinama.")</p><div class="gamyba-template-list">@foreach(var column in _columns){<div><span class="mono">@column.Field</span><span>@column.Label</span><span class="mono">@column.Width%</span></div>}</div></div>
                    }
                    else if(_modal == "reprint")
                    {
                        <div class="gamyba-panel__head"><strong>@L("Selective reprint", "Pasirinktinis perspausdinimas")</strong><button type="button" class="gamyba-textbutton" @onclick="() => _modal = null">×</button></div>
                        <div class="gamyba-sidebody">
                            <p>@L("Only labels after the last acknowledged one may be repeated.", "Galima kartoti tik etiketes po paskutinės patvirtintos.")</p>
                            <div class="gamyba-pills">
                                @foreach(var n in Enumerable.Range(CurrentJob.Sent + 1, Math.Max(0, CurrentJob.PhysicalLabels - CurrentJob.Sent)))
                                {
                                    <label class="gamyba-fieldchip mono"><input type="checkbox" checked="@_reprintSelected.Contains(n)" @onchange="() => ToggleReprint(n)" /> #@n</label>
                                }
                            </div>
                            <button type="button" class="gamyba-btn gamyba-btn--primary" @onclick="QueueReprint">@L("Queue selected labels", "Į eilę pasirinktas etiketes")</button>
                        </div>
                    }
                    else if(_modal == "stop-print")
                    {
                        var stop = _stops.First(x => x.Number == _stopPrintNumber);
                        <div class="gamyba-panel__head"><strong>@L("Production stop document", "Gamybos stabdymo dokumentas") · @stop.Number</strong><button type="button" class="gamyba-textbutton" @onclick="() => _modal = null">×</button></div>
                        <div class="gamyba-sidebody"><div class="gamyba-report-sheet"><div class="gamyba-report-sheet__head"><strong>@L("Production stop", "Gamybos stabdymas")</strong><span class="mono">@stop.Number</span></div><div class="gamyba-facts"><div><span>@L("Date", "Data")</span><strong class="mono">@StopDate(stop.Number)</strong></div><div><span>@L("Order", "Užsakymas")</span><strong class="mono">@stop.Order</strong></div><div><span>@L("Reason", "Priežastis")</span><strong>@stop.Reason</strong></div><div><span>@L("Rows", "Eilutės")</span><strong class="mono">@stop.ItemIds.Count</strong></div></div><table class="gamyba-table"><thead><tr><th>@L("Barcode", "Kodas")</th><th>@L("Product", "Gaminys")</th></tr></thead><tbody>@foreach(var id in stop.ItemIds){var item = _items.First(x => x.Id == id);<tr><td class="mono">@item.Barcode</td><td>@item.Type · @item.Width×@item.Height</td></tr>}</tbody></table></div><button type="button" class="gamyba-btn" @onclick="PrintOutput">@L("Browser print", "Spausdinti naršyklėje")</button></div>
                    }
                    else if(_modal == "output")
                    {
                        <div class="gamyba-panel__head"><strong>@L("Production output document", "Produkcijos išdavimo dokumentas")</strong><button type="button" class="gamyba-textbutton" @onclick="() => _modal = null">×</button></div>
                        <div class="gamyba-sidebody">
                            <div class="gamyba-report-sheet"><div class="gamyba-report-sheet__head"><strong>@_outputPrintKind</strong><span class="mono">@_outputPreview</span></div><div class="gamyba-facts"><div><span>@L("Date", "Data")</span><strong class="mono">@CurrentFinished.Date</strong></div><div><span>@L("Recipient", "Gavėjas")</span><strong>@CurrentFinished.Recipient</strong></div><div><span>@L("Vehicle", "Transportas")</span><strong>@CurrentFinished.Vehicle</strong></div><div><span>@L("Items", "Gaminiai")</span><strong class="mono">@CurrentFinished.Count</strong></div><div><span>@L("Author", "Autorius")</span><strong>@CurrentFinished.Author</strong></div></div><p>@L("Preview uses fixture data; the official document layout will be connected to the report service.", "Peržiūroje naudojami pavyzdiniai duomenys; oficialus maketas bus prijungtas prie ataskaitų tarnybos.")</p></div>
                            <button type="button" class="gamyba-btn" @onclick="PrintOutput">@L("Browser print", "Spausdinti naršyklėje")</button>
                        </div>
                    }
                    else if(_modal == "scan-manual")
                    {
                        <div class="gamyba-panel__head"><strong>@L("Pick product manually", "Parinkti gaminį rankiniu būdu")</strong><button type="button" class="gamyba-textbutton" @onclick="() => _modal = null">×</button></div><div class="gamyba-sidebody"><label class="gamyba-fieldlabel">@L("Barcode", "Kodas")</label><input class="gamyba-input mono" @bind="_manualScan" placeholder="000000000000" /><button type="button" class="gamyba-btn gamyba-btn--primary" @onclick="UseManualScan">@L("Use barcode", "Naudoti kodą")</button></div>
                    }
                    else if(_modal == "scan-import")
                    {
                        <div class="gamyba-panel__head"><strong>@L("Import barcodes", "Importuoti kodus")</strong><button type="button" class="gamyba-textbutton" @onclick="() => _modal = null">×</button></div><div class="gamyba-sidebody"><p>@L("One barcode per line. Each gets a separate result.", "Po vieną kodą eilutėje. Kiekvienam pateikiamas atskiras rezultatas.")</p><textarea class="gamyba-input mono" rows="8" @bind="_importText"></textarea><button type="button" class="gamyba-btn gamyba-btn--primary" @onclick="ImportScans">@L("Import", "Importuoti")</button></div>
                    }
                    else if(_modal == "scan-errors")
                    {
                        <div class="gamyba-panel__head"><strong>@L("Scan error log", "Skenavimo klaidų žurnalas")</strong><button type="button" class="gamyba-textbutton" @onclick="() => _modal = null">×</button></div><div class="gamyba-history-lines">@foreach(var error in _scanErrors){<div><span class="mono">@error.Barcode</span><strong class="gamyba-danger">@L("REJECTED", "ATMESTA")</strong><span>@error.Reason</span></div>}</div>
                    }
                    else if(_modal == "archive")
                    {
                        <div class="gamyba-panel__head"><strong>@L("Original archive", "Originalus archyvas") · @_archiveReport</strong><button type="button" class="gamyba-textbutton" @onclick="() => _modal = null">×</button></div><div class="gamyba-sidebody"><div class="gamyba-warning">@L("Fixture archive preview. The original PDF remains unchanged; file storage is connected in a later stage.", "Pavyzdinė archyvo peržiūra. Originalus PDF nekeičiamas; failų saugykla bus prijungta kitame etape.")</div><div class="gamyba-report-sheet"><div class="gamyba-report-sheet__head"><strong>@_archiveReport</strong><span class="mono">@CurrentTask.Number · @L("archived", "archyvuota")</span></div><table class="gamyba-table"><thead><tr><th>@L("Barcode", "Kodas")</th><th>@L("Order", "Užsakymas")</th><th>@L("Product", "Gaminys")</th><th>@L("Size", "Matmenys")</th></tr></thead><tbody>@foreach(var item in TaskItems(CurrentTask)){<tr><td class="mono">@item.Barcode</td><td class="mono">@item.Order</td><td>@item.Type</td><td class="mono">@item.Width × @item.Height</td></tr>}</tbody></table></div></div>
                    }
                    else if(_modal == "new-label-job")
                    {
                        <div class="gamyba-panel__head"><strong>@L("New print job", "Nauja spausdinimo užduotis")</strong><button type="button" class="gamyba-textbutton" @onclick="() => _modal = null">Esc</button></div>
                        <div class="gamyba-sidebody">
                            <div class="gamyba-label-modes"><button type="button" class="@(_labelMode == "task" ? "is-active" : "")" @onclick='() => _labelMode = "task"'><strong>@L("Whole GU", "Visa GU")</strong><small>@L("Items + separators", "Gaminiai + skirtukai")</small></button><button type="button" class="@(_labelMode == "one" ? "is-active" : "")" @onclick='() => _labelMode = "one"'><strong>@L("One item", "Vienas gaminys")</strong><small>@L("One barcode", "Vienas kodas")</small></button><button type="button" class="@(_labelMode == "manual" ? "is-active" : "")" disabled="@(!Supervisor)" @onclick='() => _labelMode = "manual"'><strong>@L("Manual", "Rankinis")</strong><small>@L("Supervisor only", "Tik vadovui")</small></button></div>
                            @if(_labelMode == "one")
                            {
                                <label class="gamyba-fieldlabel">@L("Barcode", "Kodas")</label><input class="gamyba-input mono" list="gamyba-gu-barcodes" @bind="_labelText" @onfocus="SelectFocusedInput" placeholder="000000000000" /><datalist id="gamyba-gu-barcodes">@foreach(var item in TaskItems(CurrentTask)){<option value="@item.Barcode">@item.Type · @item.Order</option>}</datalist>
                            }
                            else if(_labelMode == "manual")
                            {
                                <div class="gamyba-formrow"><label>@L("Label text", "Etiketės tekstas")<input class="gamyba-input" @bind="_labelText" /></label><label>@L("Copies", "Kopijos")<input type="number" min="1" class="gamyba-input mono" @bind="_labelCopies" @onfocus="SelectFocusedInput" /></label></div>
                            }
                            <div class="gamyba-label-plan"><div><span>@L("Physical labels planned", "Planuojamos fizinės etiketės")</span><strong class="mono">@PlannedLabelCount</strong></div><span class="mono">@PlannedLabelDetail</span><small>@L("P1 is one label per row; quantity prints as text.", "P1 yra viena etiketė eilutei; kiekis spausdinamas tekstu.")</small></div>
                            <div class="gamyba-workstation"><span class="gamyba-dot"></span> CECH-02 · COM3 · @(_comOwner == "access" ? L("Access owns the port", "Prievadą naudoja Access") : L("Agent online", "Agentas prisijungęs"))</div>
                            <div class="gamyba-actions gamyba-issue-footer"><button type="button" class="gamyba-btn" @onclick="() => _modal = null">@L("Cancel", "Atšaukti")</button><button type="button" class="gamyba-btn gamyba-btn--primary" disabled="@(_labelMode == "manual" && !Supervisor)" @onclick="QueueLabels">@L("Queue print job", "Įtraukti į spausdinimo eilę")</button></div>
                        </div>
                    }
                </section></div>
            }
        </main>
        @if (PrototypeControls)
        {
        <div class="gamyba-demo">
            <strong>PROTOTYPE CONTROLS</strong>
            <span>@L("Not part of the product UI — switches used to walk through states.", "Ne produkto sąsaja — jungikliai būsenų peržiūrai.")</span>
            <span class="gamyba-demo__spacer"></span>
            <span>@L("Viewport", "Ekranas")</span>
            <div class="gamyba-demo__group"><button type="button" class="@(_viewport == "fit" ? "is-active" : "")" @onclick='() => _viewport = "fit"'>Fit</button><button type="button" class="@(_viewport == "1440" ? "is-active" : "")" @onclick='() => _viewport = "1440"'>1440×900</button><button type="button" class="@(_viewport == "1366" ? "is-active" : "")" @onclick='() => _viewport = "1366"'>1366×768</button></div>
            <span>@L("Role", "Rolė")</span>
            <div class="gamyba-demo__group"><button type="button" class="@(_role == "operator" ? "is-active" : "")" @onclick='() => _role = "operator"'>Operator</button><button type="button" class="@(_role == "supervisor" ? "is-active" : "")" @onclick='() => _role = "supervisor"'>Supervisor</button><button type="button" class="@(_role == "restricted" ? "is-active" : "")" @onclick='() => _role = "restricted"'>Restricted</button></div>
            <span>Simulate</span>
            <div class="gamyba-demo__group"><button type="button" class="@(_simConflict ? "is-active" : "")" @onclick='() => _simConflict = !_simConflict'>Access conflict</button><button type="button" class="@(_simNetwork ? "is-active" : "")" @onclick='() => _simNetwork = !_simNetwork'>Network loss</button><button type="button" class="@(_simSlow ? "is-active" : "")" @onclick='() => _simSlow = !_simSlow'>Slow server</button><button type="button" class="@(_simEmpty ? "is-active" : "")" @onclick='() => _simEmpty = !_simEmpty'>Empty queue</button><button type="button" class="@(_simNoMaterial ? "is-active" : "")" @onclick='() => _simNoMaterial = !_simNoMaterial'>No material</button><button type="button" class="@(_simZebraNoAck ? "is-active" : "")" @onclick='() => _simZebraNoAck = !_simZebraNoAck'>Zebra no ack</button><button type="button" class="@(_comOwner == "access" ? "is-active" : "")" @onclick='() => _comOwner = _comOwner == "access" ? "agent" : "access"'>Access COM</button></div>
        </div>
        }
    </div>
</div>
