                            <section class="gamyba-scan-status gamyba-scan-status--@(_scanOutcome == "" ? "idle" : _scanOutcome)"><div><i></i><strong>@(_scanOutcome == "" ? L["Gamyba.WAITINGFORSCAN"].Value : LocalizedScanOutcome())</strong><span class="mono">@DateTime.Now.ToString("HH:mm:ss")</span></div><b class="mono">@(_lastScanBarcode == "" ? "— — — —" : _lastScanBarcode)</b><p>@(_scanOutcome == "" ? L["Gamyba.ResultOfEachBarcodeAppearsHereLargeEnoughTo"].Value : _scanReason)</p></section>
                            <div class="gamyba-scan-stats"><div><span>@L["Gamyba.ACCEPTED"].Value</span><strong class="mono">@CurrentDocument.Scans.Count</strong></div><div><span>@L["Gamyba.REPEATED"].Value</span><strong class="mono">@(_scanOutcome == "repeat" ? 1 : 0)</strong></div><div><span>@L["Gamyba.REJECTED"].Value</span><strong class="mono">@_scanErrors.Count</strong></div></div><small class="gamyba-muted">@L["Gamyba.CountersStayWithTheGTDocument"].Value</small>
                        </div>
