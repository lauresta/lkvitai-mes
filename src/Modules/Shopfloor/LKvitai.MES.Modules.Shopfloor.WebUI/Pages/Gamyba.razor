                                    <div class="@(item.Id == _issueConflictId ? "is-conflict" : "")"><span class="mono">@item.Order</span><span>@item.Type · @item.Fabric @if(item.Id == _issueConflictId){<strong>@L["Gamyba.CONFLICT"].Value</strong>}</span><span class="mono">@item.Width × @item.Height</span><b class="mono">@item.Quantity</b></div>
                                }
                            </div>
                            @if (_issuePhase == "idle")
                            {
                                <small>@L["Gamyba.RightsStateAndVersionAreCheckedAgainImmediatelyBefore"].Value</small>
                            }
                            else if (_issuePhase == "busy")
                            {
                                <div class="gamyba-issue-busy"><strong>@L["Gamyba.IssuingPortion"].Value</strong><span class="mono">cmd @_pendingCommand</span><div class="gamyba-issue-progress"><span></span></div><small>@L["Gamyba.ASecondClickIsIgnoredWhileTheCommandIs"].Value</small></div>
                            }
                            else if (_issuePhase == "timeout")
                            {
                                <div class="gamyba-warning"><strong>@L["Gamyba.NoResponse"].Value</strong> @L["Gamyba.CheckTheOriginalCommandResultDoNotIssueAgain"].Value <span class="mono">cmd @_pendingCommand</span></div>
                            }
                            else if (_issuePhase == "error")
                            {
                                <div class="gamyba-alert gamyba-alert--danger"><span><strong>@L["Gamyba.IssueBlocked"].Value</strong> @_issueProblem<br />@L["Gamyba.NothingWasIssued"].Value</span></div>
                            }
                            <div class="gamyba-actions gamyba-issue-footer"><button type="button" class="gamyba-btn" @onclick="() => _modal = null">@L["Gamyba.Cancel"].Value</button>@if(_issuePhase == "error"){<button type="button" class="gamyba-btn" @onclick="RemoveIssueConflict">@L["Gamyba.RemoveConflictingRow"].Value</button>}@if(_issuePhase == "timeout"){<button type="button" class="gamyba-btn gamyba-btn--primary" @onclick="CheckIssueResult">@L["Gamyba.CheckResult"].Value</button>}else{<button type="button" class="gamyba-btn gamyba-btn--primary" disabled="@(_issuePhase == "busy" || _selected.Count == 0)" @onclick="ConfirmIssue">@(_issuePhase == "busy" ? L["Gamyba.Issuing"].Value : L["Gamyba.IssuePortion"].Value)</button>}</div>
                        </div>
                    }
                    else if(_modal == "new-gt")
                    {
                        <div class="gamyba-panel__head"><strong>@L["Gamyba.NewGTDocument"].Value</strong><button type="button" class="gamyba-textbutton" @onclick="() => _modal = null">×</button></div><div class="gamyba-sidebody"><div class="gamyba-formrow"><label>@L["Gamyba.Number"].Value<input class="gamyba-input mono" value="@($"GT-261102-{_documents.Count + 2:000}")" readonly /></label><label>@L["Gamyba.Date"].Value<input class="gamyba-input mono" value="2026-11-02" readonly /></label></div><span class="gamyba-fieldlabel">@L["Gamyba.AllowedOperation"].Value</span><div class="gamyba-gt-options">@foreach(var op in new[] { "pagaminta", "filialui", "atiduota", "sandelis" }){var denied = (op == "atiduota" && !Supervisor) || (op == "sandelis" && Restricted);var transition=OperationTransition(op);<button type="button" class="@(_newGtOp == op ? "is-active" : "")" disabled="@denied" @onclick="() => _newGtOp = op"><span class="gamyba-report-radio"></span><strong>@op</strong><span class="mono">@transition.Before → @transition.After</span>@if(denied){<span class="gamyba-danger">@L["Gamyba.NoRights"].Value</span>}</button>}</div><small>@L["Gamyba.OperationsFollowLegacyStateAndUserRights"].Value</small><div class="gamyba-actions"><button type="button" class="gamyba-btn" @onclick="() => _modal = null">@L["Gamyba.Cancel"].Value</button><button type="button" class="gamyba-btn gamyba-btn--primary" @onclick="CreateDocument">@L["Gamyba.CreateGT"].Value</button></div></div>
                    }
                    else if(_modal == "compare")
                    {
                        <div class="gamyba-panel__head"><strong>@L["Gamyba.CompareTemplateVersions"].Value</strong><button type="button" class="gamyba-textbutton" @onclick="() => _modal = null">×</button></div><div class="gamyba-sidebody"><p>@L["Gamyba.PublishedV2AndCurrentDraftPreviousPublishedVersionRemains"].Value</p><div class="gamyba-template-list">@foreach(var column in _columns){<div><span class="mono">@column.Field</span><span>@column.Label</span><span class="mono">@column.Width%</span></div>}</div></div>
                    }
                    else if(_modal == "reprint")
                    {
                        <div class="gamyba-panel__head"><strong>@L["Gamyba.SelectiveReprint"].Value</strong><button type="button" class="gamyba-textbutton" @onclick="() => _modal = null">×</button></div>
                        <div class="gamyba-sidebody">
                            <p>@L["Gamyba.OnlyLabelsAfterTheLastAcknowledgedOneMayBe"].Value</p>
                            <div class="gamyba-pills">
                                @foreach(var n in Enumerable.Range(CurrentJob.Sent + 1, Math.Max(0, CurrentJob.PhysicalLabels - CurrentJob.Sent)))
                                {
                                    <label class="gamyba-fieldchip mono"><input type="checkbox" checked="@_reprintSelected.Contains(n)" @onchange="() => ToggleReprint(n)" /> #@n</label>
                                }
                            </div>
                            <button type="button" class="gamyba-btn gamyba-btn--primary" @onclick="QueueReprint">@L["Gamyba.QueueSelectedLabels"].Value</button>
                        </div>
                    }
                    else if(_modal == "stop-print")
                    {
                        var stop = _stops.First(x => x.Number == _stopPrintNumber);
                        <div class="gamyba-panel__head"><strong>@L["Gamyba.ProductionStopDocument"].Value · @stop.Number</strong><button type="button" class="gamyba-textbutton" @onclick="() => _modal = null">×</button></div>
                        <div class="gamyba-sidebody"><div class="gamyba-report-sheet"><div class="gamyba-report-sheet__head"><strong>@L["Gamyba.ProductionStop"].Value</strong><span class="mono">@stop.Number</span></div><div class="gamyba-facts"><div><span>@L["Gamyba.Date"].Value</span><strong class="mono">@StopDate(stop.Number)</strong></div><div><span>@L["Gamyba.Order"].Value</span><strong class="mono">@stop.Order</strong></div><div><span>@L["Gamyba.Reason"].Value</span><strong>@stop.Reason</strong></div><div><span>@L["Gamyba.RowsEilutS"].Value</span><strong class="mono">@stop.ItemIds.Count</strong></div></div><table class="gamyba-table"><thead><tr><th>@L["Gamyba.Barcode"].Value</th><th>@L["Gamyba.Product"].Value</th></tr></thead><tbody>@foreach(var id in stop.ItemIds){var item = _items.First(x => x.Id == id);<tr><td class="mono">@item.Barcode</td><td>@item.Type · @item.Width×@item.Height</td></tr>}</tbody></table></div><button type="button" class="gamyba-btn" @onclick="PrintOutput">@L["Gamyba.BrowserPrint"].Value</button></div>
                    }
                    else if(_modal == "output")
                    {
                        <div class="gamyba-panel__head"><strong>@L["Gamyba.ProductionOutputDocument"].Value</strong><button type="button" class="gamyba-textbutton" @onclick="() => _modal = null">×</button></div>
                        <div class="gamyba-sidebody">
                            <div class="gamyba-report-sheet"><div class="gamyba-report-sheet__head"><strong>@_outputPrintKind</strong><span class="mono">@_outputPreview</span></div><div class="gamyba-facts"><div><span>@L["Gamyba.Date"].Value</span><strong class="mono">@CurrentFinished.Date</strong></div><div><span>@L["Gamyba.Recipient"].Value</span><strong>@CurrentFinished.Recipient</strong></div><div><span>@L["Gamyba.Vehicle"].Value</span><strong>@CurrentFinished.Vehicle</strong></div><div><span>@L["Gamyba.ItemsGaminiai"].Value</span><strong class="mono">@CurrentFinished.Count</strong></div><div><span>@L["Gamyba.Author"].Value</span><strong>@CurrentFinished.Author</strong></div></div><p>@L["Gamyba.PreviewUsesFixtureDataTheOfficialDocumentLayoutWill"].Value</p></div>
                            <button type="button" class="gamyba-btn" @onclick="PrintOutput">@L["Gamyba.BrowserPrint"].Value</button>
                        </div>
                    }
                    else if(_modal == "scan-manual")
                    {
                        <div class="gamyba-panel__head"><strong>@L["Gamyba.PickProductManually"].Value</strong><button type="button" class="gamyba-textbutton" @onclick="() => _modal = null">×</button></div><div class="gamyba-sidebody"><label class="gamyba-fieldlabel">@L["Gamyba.Barcode"].Value</label><input class="gamyba-input mono" @bind="_manualScan" placeholder="000000000000" /><button type="button" class="gamyba-btn gamyba-btn--primary" @onclick="UseManualScan">@L["Gamyba.UseBarcode"].Value</button></div>
                    }
                    else if(_modal == "scan-import")
                    {
                        <div class="gamyba-panel__head"><strong>@L["Gamyba.ImportBarcodes"].Value</strong><button type="button" class="gamyba-textbutton" @onclick="() => _modal = null">×</button></div><div class="gamyba-sidebody"><p>@L["Gamyba.OneBarcodePerLineEachGetsASeparateResult"].Value</p><textarea class="gamyba-input mono" rows="8" @bind="_importText"></textarea><button type="button" class="gamyba-btn gamyba-btn--primary" @onclick="ImportScans">@L["Gamyba.Import"].Value</button></div>
                    }
                    else if(_modal == "scan-errors")
                    {
                        <div class="gamyba-panel__head"><strong>@L["Gamyba.ScanErrorLog"].Value</strong><button type="button" class="gamyba-textbutton" @onclick="() => _modal = null">×</button></div><div class="gamyba-history-lines">@foreach(var error in _scanErrors){<div><span class="mono">@error.Barcode</span><strong class="gamyba-danger">@L["Gamyba.REJECTED"].Value</strong><span>@error.Reason</span></div>}</div>
                    }
                    else if(_modal == "archive")
                    {
                        <div class="gamyba-panel__head"><strong>@L["Gamyba.OriginalArchive"].Value · @_archiveReport</strong><button type="button" class="gamyba-textbutton" @onclick="() => _modal = null">×</button></div><div class="gamyba-sidebody"><div class="gamyba-warning">@L["Gamyba.FixtureArchivePreviewTheOriginalPDFRemainsUnchangedFile"].Value</div><div class="gamyba-report-sheet"><div class="gamyba-report-sheet__head"><strong>@_archiveReport</strong><span class="mono">@CurrentTask.Number · @L["Gamyba.Archived"].Value</span></div><table class="gamyba-table"><thead><tr><th>@L["Gamyba.Barcode"].Value</th><th>@L["Gamyba.Order"].Value</th><th>@L["Gamyba.Product"].Value</th><th>@L["Gamyba.Size"].Value</th></tr></thead><tbody>@foreach(var item in TaskItems(CurrentTask)){<tr><td class="mono">@item.Barcode</td><td class="mono">@item.Order</td><td>@item.Type</td><td class="mono">@item.Width × @item.Height</td></tr>}</tbody></table></div></div>
                    }
                    else if(_modal == "new-label-job")
                    {
                        <div class="gamyba-panel__head"><strong>@L["Gamyba.NewPrintJob"].Value</strong><button type="button" class="gamyba-textbutton" @onclick="() => _modal = null">Esc</button></div>
                        <div class="gamyba-sidebody">
                            <div class="gamyba-label-modes"><button type="button" class="@(_labelMode == "task" ? "is-active" : "")" @onclick='() => _labelMode = "task"'><strong>@L["Gamyba.WholeGU"].Value</strong><small>@L["Gamyba.ItemsSeparators"].Value</small></button><button type="button" class="@(_labelMode == "one" ? "is-active" : "")" @onclick='() => _labelMode = "one"'><strong>@L["Gamyba.OneItem"].Value</strong><small>@L["Gamyba.OneBarcode"].Value</small></button><button type="button" class="@(_labelMode == "manual" ? "is-active" : "")" disabled="@(!Supervisor)" @onclick='() => _labelMode = "manual"'><strong>@L["Gamyba.Manual"].Value</strong><small>@L["Gamyba.SupervisorOnly"].Value</small></button></div>
                            @if(_labelMode == "one")
                            {
                                <label class="gamyba-fieldlabel">@L["Gamyba.Barcode"].Value</label><input class="gamyba-input mono" list="gamyba-gu-barcodes" @bind="_labelText" @onfocus="SelectFocusedInput" placeholder="000000000000" /><datalist id="gamyba-gu-barcodes">@foreach(var item in TaskItems(CurrentTask)){<option value="@item.Barcode">@item.Type · @item.Order</option>}</datalist>
                            }
                            else if(_labelMode == "manual")
                            {
                                <div class="gamyba-formrow"><label>@L["Gamyba.LabelText"].Value<input class="gamyba-input" @bind="_labelText" /></label><label>@L["Gamyba.Copies"].Value<input type="number" min="1" class="gamyba-input mono" @bind="_labelCopies" @onfocus="SelectFocusedInput" /></label></div>
                            }
                            <div class="gamyba-label-plan"><div><span>@L["Gamyba.PhysicalLabelsPlanned"].Value</span><strong class="mono">@PlannedLabelCount</strong></div><span class="mono">@PlannedLabelDetail</span><small>@L["Gamyba.P1IsOneLabelPerRowQuantityPrintsAs"].Value</small></div>
                            <div class="gamyba-workstation"><span class="gamyba-dot"></span> CECH-02 · COM3 · @(_comOwner == "access" ? L["Gamyba.AccessOwnsThePort"].Value : L["Gamyba.AgentOnline"].Value)</div>
                            <div class="gamyba-actions gamyba-issue-footer"><button type="button" class="gamyba-btn" @onclick="() => _modal = null">@L["Gamyba.Cancel"].Value</button><button type="button" class="gamyba-btn gamyba-btn--primary" disabled="@(_labelMode == "manual" && !Supervisor)" @onclick="QueueLabels">@L["Gamyba.QueuePrintJob"].Value</button></div>
                        </div>
                    }
                </section></div>
            }
        </main>
        @if (PrototypeControls)
        {
        <div class="gamyba-demo">
            <strong>@L["Gamyba.PrototypeControls"]</strong>
            <span>@L["Gamyba.NotPartOfTheProductUISwitchesUsedTo"].Value</span>
            <span class="gamyba-demo__spacer"></span>
            <span>@L["Gamyba.Viewport"].Value</span>
            <div class="gamyba-demo__group"><button type="button" class="@(_viewport == "fit" ? "is-active" : "")" @onclick='() => _viewport = "fit"'>Fit</button><button type="button" class="@(_viewport == "1440" ? "is-active" : "")" @onclick='() => _viewport = "1440"'>1440×900</button><button type="button" class="@(_viewport == "1366" ? "is-active" : "")" @onclick='() => _viewport = "1366"'>1366×768</button></div>
            <span>@L["Gamyba.Role"].Value</span>
            <div class="gamyba-demo__group"><button type="button" class="@(_role == "operator" ? "is-active" : "")" @onclick='() => _role = "operator"'>@L["Gamyba.Operator"]</button><button type="button" class="@(_role == "supervisor" ? "is-active" : "")" @onclick='() => _role = "supervisor"'>@L["Gamyba.Supervisor"]</button><button type="button" class="@(_role == "restricted" ? "is-active" : "")" @onclick='() => _role = "restricted"'>@L["Gamyba.Restricted"]</button></div>
            <span>@L["Gamyba.Simulate"]</span>
            <div class="gamyba-demo__group"><button type="button" class="@(_simConflict ? "is-active" : "")" @onclick='() => _simConflict = !_simConflict'>@L["Gamyba.AccessConflict"]</button><button type="button" class="@(_simNetwork ? "is-active" : "")" @onclick='() => _simNetwork = !_simNetwork'>@L["Gamyba.NetworkLoss"]</button><button type="button" class="@(_simSlow ? "is-active" : "")" @onclick='() => _simSlow = !_simSlow'>@L["Gamyba.SlowServer"]</button><button type="button" class="@(_simEmpty ? "is-active" : "")" @onclick='() => _simEmpty = !_simEmpty'>@L["Gamyba.EmptyQueue"]</button><button type="button" class="@(_simNoMaterial ? "is-active" : "")" @onclick='() => _simNoMaterial = !_simNoMaterial'>@L["Gamyba.NoMaterial"]</button><button type="button" class="@(_simZebraNoAck ? "is-active" : "")" @onclick='() => _simZebraNoAck = !_simZebraNoAck'>@L["Gamyba.ZebraNoAck"]</button><button type="button" class="@(_comOwner == "access" ? "is-active" : "")" @onclick='() => _comOwner = _comOwner == "access" ? "agent" : "access"'>@L["Gamyba.AccessCom"]</button></div>
        </div>
        }
    </div>
</div>
