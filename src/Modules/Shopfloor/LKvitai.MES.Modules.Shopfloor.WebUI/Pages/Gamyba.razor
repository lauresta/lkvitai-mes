                            <small>@L("Repair reason and actual failure use separate legacy fields.", "Remonto priežastis ir faktinis gedimas saugomi atskiruose legacy laukuose.")</small>
                        </div></section>
                    </div>
                }
            }

            @if (_screen == "finished")
            {
                <div class="gamyba-pagehead"><div><div class="gamyba-eyebrow">SHOPFLOOR · G13</div><h1>@L("Finished goods", "Gatava produkcija")</h1><p>@L("Handover and dispatch documents. Invoice remains gated.", "Perdavimo ir siuntimo dokumentai. Sąskaita lieka apribota.")</p></div><button type="button" class="gamyba-btn gamyba-btn--primary" @onclick="NewDocument">+ @L("New handover", "Naujas perdavimas")</button></div>
