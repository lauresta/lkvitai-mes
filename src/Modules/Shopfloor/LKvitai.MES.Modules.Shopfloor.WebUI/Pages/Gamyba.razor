@page "/gamyba"
@layout GamybaLayout

<PageTitle>Cikada.MES · Shopfloor · Gamyba</PageTitle>

<div class="gamyba" @onkeydown="PageKey">
    <div class="gamyba-shell" style="width:@(_viewport == "fit" ? "100%" : _viewport + "px")">
        <div class="gamyba-test">
            <span class="gamyba-test__mark">▲</span>
            <strong>TEST ENVIRONMENT</strong>
            <span>@(LiveQueueEnabled ? L("The production queue reads the shared legacy database; issuing is disabled here.", "Gamybos eilė skaitoma iš bendros senosios bazės; išdavimas čia išjungtas.") : L("Data in this environment is not production data and may be reset without notice.", "Šios aplinkos duomenys nėra gamybiniai ir gali būti ištrinti be įspėjimo."))</span>
            <span class="gamyba-test__right mono">mes-test.lauresta.lt · fit</span>
        </div>
        <header class="gamyba-topbar">
            <button type="button" class="gamyba-brand" @onclick='() => Go("queue")'>
                <span class="gamyba-brand__mark"><svg viewBox="0 0 40 40" fill="none" stroke="currentColor" stroke-width="3.2" stroke-linecap="round"><path d="M12 15 C22 12.5 30 15.5 32 21" /><path d="M11 21 C21 19 28.5 22 31 27" /><circle cx="9" cy="18.5" r="2.8" fill="currentColor" stroke="none" /></svg></span>
                <span><strong>Cikada<span>.MES</span></strong><small>SHOPFLOOR · GAMYBA</small></span>
            </button>
            <span class="gamyba-separator"></span>
            <label class="gamyba-global-search">
                <span aria-hidden="true">⌕</span>
                <input id="gamyba-global-search" @bind="_globalSearch" @bind:event="oninput" placeholder="@L("Barcode, GU, GT or order… (Enter)", "Kodas, GU, GT arba užsakymas… (Enter)")" @onkeydown="GlobalSearchKey" />
                <kbd>F2</kbd>
            </label>
            <span class="gamyba-topbar__spacer"></span>
            <div class="gamyba-lang" aria-label="Language">
                <button type="button" class="@(_lang == "en" ? "is-active" : "")" @onclick='() => _lang = "en"'>EN</button>
                <button type="button" class="@(_lang == "lt" ? "is-active" : "")" @onclick='() => _lang = "lt"'>LT</button>
            </div>
            <div class="gamyba-env mono"><span>ENV <strong>TEST</strong></span><span>VER <strong>v0.6.0</strong></span></div>
            <div class="gamyba-user"><span>RM</span><div><strong>Rūta Markevičienė</strong><small>@RoleLabel</small></div></div>
        </header>
        <nav class="gamyba-tabs" aria-label="Gamyba">
            @foreach (var tab in Tabs)
            {
                <button type="button" class="@(_screen == tab.Key || (_screen == "task" && tab.Key == "tasks") || (_screen == "gt-detail" && tab.Key == "gt") ? "is-active" : "")" @onclick="() => GoLiveAwareAsync(tab.Key)">@L(tab.En, tab.Lt) @if(tab.Key == "queue" && !LiveQueueEnabled){<span class="gamyba-tabcount mono">@QueueItems.Count()</span>} @if(tab.Key == "tasks" && !LiveQueueEnabled){<span class="gamyba-tabcount mono">@_tasks.Count</span>} @if(tab.Key == "labels" && !LiveQueueEnabled){<span class="gamyba-tabcount gamyba-tabcount--danger mono">@_jobs.Count(x => x.State != "Sent")</span>}</button>
            }
            <button type="button" class="@(_screen == "map" ? "is-active" : "")" @onclick='() => Go("map")'>@L("Map · Questions", "Žemėlapis · Klausimai")</button>
        </nav>

        <main class="gamyba-main @(PrototypeControls ? "gamyba-main--demo" : "")">
            @if (LiveQueueEnabled && _screen is not ("queue" or "tasks" or "task" or "history" or "reports")
                && !(_screen == "stops" && _stopTab == "repairs"))
            {
                <div class="gamyba-alert gamyba-alert--info" role="status">@L("Preview: this screen uses sample data and does not change production.", "Peržiūra: šiame ekrane naudojami pavyzdiniai duomenys; gamyba nekeičiama.")</div>
            }
            @if (!string.IsNullOrWhiteSpace(_notice))
            {
                <div class="gamyba-alert gamyba-alert--@_noticeKind" role="alert"><span>@_notice</span><button type="button" @onclick='() => _notice = ""'>×</button></div>
            }

            @if (_screen == "queue")
            {
                @if (LiveQueueEnabled)
                {
                    @if (_fromSales is not null)
                    {
                        <div class="gamyba-source"><span class="gamyba-dot"></span><span><strong>@L("From Sales order", "Iš Sales užsakymo")</strong> <span class="mono">@_fromSales</span></span><button type="button" @onclick="ClearLiveOrderFilterAsync">@L("Show all", "Rodyti visus")</button></div>
                    }
                    <div class="gamyba-pagehead">
                        <div><div class="gamyba-eyebrow">SHOPFLOOR · G02</div><h1>@L("Ready for production", "Paruošta gamybai")</h1><p class="mono">@L("Live Access queue", "Gyva Access eilė") · @L("page", "puslapis") @_liveQueuePage · @(_liveQueue?.Items.Count ?? 0) @L("rows on this page", "eil. šiame puslapyje")</p></div>
                        <div class="gamyba-actions"><span class="chip chip--info">@L("READ ONLY", "TIK PERŽIŪRA")</span><button type="button" class="gamyba-btn" disabled="@_liveQueueLoading" @onclick="() => LoadLiveQueueAsync(_liveQueuePage)">@L("Refresh", "Atnaujinti")</button></div>
                    </div>
                    @if (_liveQueueError is not null)
                    {
                        <div class="gamyba-alert gamyba-alert--danger" role="alert">@_liveQueueError <button type="button" @onclick="() => LoadLiveQueueAsync(_liveQueuePage)">@L("Retry", "Kartoti")</button></div>
                    }
                    @if (_liveFacetError is not null){<div class="gamyba-alert gamyba-alert--warn" role="status">@_liveFacetError</div>}
                    <section class="gamyba-panel">
                        <div class="gamyba-toolbar">
                            <span class="gamyba-toolbar__label">@L("Branch", "Filialas")</span>
                            <div class="gamyba-segment"><button type="button" class="@(_liveDepartmentId is null ? "is-active" : "")" disabled="@_liveQueueLoading" @onclick='() => SetLiveQueueFilterAsync("branch", null)'>@L("All", "Visi")</button>@foreach (var facet in _liveFacets.Where(x => x.Kind == "branch")){<button type="button" class="@(_liveDepartmentId == facet.Id ? "is-active" : "")" disabled="@_liveQueueLoading" @onclick='() => SetLiveQueueFilterAsync("branch", facet.Id)'>@facet.Name <span class="mono">@facet.Rows</span></button>}</div>
                            <label class="gamyba-compact-select"><span>@L("Series", "Serija")</span><select value="@(_liveSeriesId?.ToString() ?? "")" disabled="@_liveQueueLoading" @onchange='args => SetLiveSelectAsync("series", args)'><option value="">@L("All", "Visos")</option>@foreach (var facet in _liveFacets.Where(x => x.Kind == "series" && (_liveDepartmentId is null || x.ParentId == _liveDepartmentId))){<option value="@facet.Id">@facet.Name · @facet.Rows</option>}</select></label>
                            <span class="gamyba-toolbar__label">@L("Type", "Tipas")</span>
                            <div class="gamyba-pills"><button type="button" class="@(_liveCategoryId is null ? "is-active" : "")" disabled="@_liveQueueLoading" @onclick='() => SetLiveQueueFilterAsync("category", null)'>@L("All", "Visi")</button>@foreach (var facet in _liveFacets.Where(x => x.Kind == "category")){<button type="button" class="@(_liveCategoryId == facet.Id ? "is-active" : "")" disabled="@_liveQueueLoading" @onclick='() => SetLiveQueueFilterAsync("category", facet.Id)'>@facet.Name <span class="mono">@facet.Rows</span></button>}</div>
                            <label class="gamyba-compact-select"><span>@L("Subtype", "Potipis")</span><select value="@(_liveTypeId?.ToString() ?? "")" disabled="@_liveQueueLoading" @onchange='args => SetLiveSelectAsync("type", args)'><option value="">@L("All", "Visi")</option>@foreach (var facet in _liveFacets.Where(x => x.Kind == "type" && (_liveCategoryId is null || x.ParentId == _liveCategoryId))){<option value="@facet.Id">@facet.Name · @facet.Rows</option>}</select></label>
                            <span class="gamyba-toolbar__label">@L("Priority", "Prioritetas")</span>
                            <div class="gamyba-pills"><button type="button" class="@(_livePriorityId is null ? "is-active" : "")" disabled="@_liveQueueLoading" @onclick='() => SetLiveQueueFilterAsync("priority", null)'>@L("All", "Visi")</button>@foreach (var facet in _liveFacets.Where(x => x.Kind == "priority")){<button type="button" class="@(_livePriorityId == facet.Id ? "is-active" : "")" disabled="@_liveQueueLoading" @onclick='() => SetLiveQueueFilterAsync("priority", facet.Id)'>@facet.Name <span class="mono">@facet.Rows</span></button>}</div>
                        </div>
                        <div class="gamyba-tablewrap"><table class="gamyba-table">
                            <thead><tr><th>@L("Order", "Užsakymas")</th><th>@L("Due", "Terminas")</th><th>@L("Type", "Tipas")</th><th>@L("Material", "Medžiaga")</th><th class="is-num">@L("Size", "Matmenys")</th><th class="is-num">@L("Qty", "Kiekis")</th><th>@L("Note", "Pastaba")</th><th>@L("State", "Būsena")</th><th>@L("Barcode", "Kodas")</th></tr></thead>
                            <tbody>
                            @foreach (var item in _liveQueue?.Items ?? [])
                            {
                                <tr><td><span class="gamyba-link mono">@item.OrderNumber</span><small>@item.Department</small></td><td class="mono">@item.DueDate?.ToString("yyyy-MM-dd") @if (!string.IsNullOrWhiteSpace(item.Priority)){<span class="chip chip--slate">@item.Priority</span>}</td><td>@item.ProductType</td><td><span class="gamyba-swatch"></span>@item.Colour</td><td class="is-num mono">@item.WidthMm × @item.HeightMm</td><td class="is-num mono"><strong>@item.Quantity</strong></td><td class="gamyba-note">@item.Notes</td><td><span class="chip chip--info">@item.State</span></td><td class="mono">@item.Barcode</td></tr>
                            }
                            </tbody>
                        </table>
                        @if (!_liveQueueLoading && _liveQueueError is null && _liveQueue?.Items.Count == 0)
                        {<div class="gamyba-empty"><strong>@L("No items in this queue", "Eilėje nėra gaminių")</strong></div>}
                        </div>
                        <div class="gamyba-panel__foot"><span>@L("Queue source", "Eilės šaltinis") <span class="mono">SP_fsubProduction · Loc_leidimas</span></span><span><button type="button" class="gamyba-btn gamyba-btn--xs" disabled="@(_liveQueueLoading || _liveQueuePage <= 1)" @onclick="() => LoadLiveQueueAsync(_liveQueuePage - 1)">← @L("Previous", "Atgal")</button> <span class="mono">@_liveQueuePage</span> <button type="button" class="gamyba-btn gamyba-btn--xs" disabled="@(_liveQueueLoading || _liveQueue?.HasMore != true)" @onclick="() => LoadLiveQueueAsync(_liveQueuePage + 1)">@L("Next", "Toliau") →</button></span></div>
                    </section>
                }
                else
                {
                @if (_fromSales is not null)
                {
                    <div class="gamyba-source"><span class="gamyba-dot"></span><span><strong>@L("From Sales order", "Iš Sales užsakymo")</strong> <span class="mono">@_fromSales</span> · @L("The queue is filtered to this order.", "Eilė filtruojama pagal šį užsakymą.")</span><button type="button" @onclick="() => _fromSales = null">@L("Show all", "Rodyti visus")</button></div>
                }
                <div class="gamyba-pagehead">
                    <div><div class="gamyba-eyebrow">SHOPFLOOR · G01–G03</div><h1>@L("Ready for production", "Paruošta gamybai")</h1><p class="mono">@QueueItems.Count() @L("rows", "eil.") · @QueueItems.Sum(x => x.Quantity) @L("items", "vnt.") · <strong>@_selected.Count @L("selected", "pasirinkta")</strong></p></div>
                    <div class="gamyba-actions">
                        <label class="gamyba-compact-select"><span>@L("Target GU", "Tikslinė GU")</span><select @bind="_targetGu"><option value="new">@L("New GU", "Nauja GU")</option>@foreach (var task in _tasks){<option value="@task.Number">@task.Number</option>}</select></label>
                        <button type="button" class="gamyba-btn" @onclick="SelectAll">@L("Select all", "Pasirinkti visus") <kbd>A</kbd></button>
                        <label class="gamyba-first">@L("First N", "Pirmi N") <input type="number" min="1" max="999" @bind="_firstN" @onfocus="SelectFocusedInput" /><button type="button" @onclick="PickFirstN">@L("Pick", "Rinkti")</button></label>
                        <button type="button" class="gamyba-btn gamyba-btn--primary" disabled="@(_selected.Count == 0)" @onclick="OpenIssue">@L("Create GU and issue", "Sukurti GU ir išduoti") <kbd>G</kbd></button>
                    </div>
                </div>
                <section class="gamyba-panel">
                    <div class="gamyba-toolbar">
                        <span class="gamyba-toolbar__label">@L("Branch", "Filialas")</span>
                        <div class="gamyba-segment">@foreach (var branch in new[] { "All", "Vilnius", "Kaunas", "Klaipėda" }){<button type="button" class="@(_branch == branch ? "is-active" : "")" @onclick="() => _branch = branch">@branch</button>}</div>
                        <span class="gamyba-toolbar__label">@L("Type", "Tipas")</span>
                        <div class="gamyba-pills">@foreach (var type in new[] { "All", "Rolėtai", "Vertikalios", "Plise", "Romanetės", "Tinkleliai", "Horizontalios", "Apsauginės", "Grotos" }){<button type="button" class="@(_type == type ? "is-active" : "")" @onclick="() => _type = type">@type <span class="mono">@(VisibleItems.Count(x => (type == "All" || x.Type == type) && x.Stage == "patvirtintas"))</span></button>}</div>
                        <span class="gamyba-toolbar__label">@L("Priority", "Prioritetas")</span>
                        <div class="gamyba-pills">@foreach (var priority in new[] { "All", "urgent", "vip", "repair" }){<button type="button" class="@(_priority == priority ? "is-active" : "")" @onclick="() => _priority = priority">@(priority == "All" ? "All" : char.ToUpperInvariant(priority[0]) + priority[1..])</button>}</div>
                        <span class="gamyba-keyhint mono">↑↓ · Space · A · G · Enter</span>
                    </div>
                    <div class="gamyba-tablewrap" tabindex="0" @onkeydown="QueueKey">
                        <table class="gamyba-table">
                            <thead><tr><th class="gamyba-check"><input type="checkbox" checked="@(QueueItems.Any() && QueueItems.All(x => _selected.Contains(x.Id)))" @onclick="SelectAll" /></th><th>@L("Order", "Užsakymas")</th><th>@L("Due · priority", "Terminas · prioritetas") <button type="button" class="gamyba-question" @onclick='() => Go("map")'>?</button></th><th>@L("Type", "Tipas")</th><th>@L("Material", "Medžiaga")</th><th class="is-num">@L("Size", "Matmenys")</th><th class="is-num">@L("Qty", "Kiekis")</th><th>@L("Note", "Pastaba")</th><th>@L("State", "Būsena")</th><th>@L("Barcode", "Kodas")</th><th>@L("Previous GU", "Ankstesnė GU")</th></tr></thead>
                            <tbody>
                                @foreach (var item in QueueItems)
                                {
                                    <tr class="@(_selected.Contains(item.Id) ? "is-selected" : "") @(QueueItems.ElementAtOrDefault(_cursor)?.Id == item.Id ? "is-cursor" : "")" @onclick="() => ToggleSelected(item.Id)" @ondblclick="() => OpenHistory(item)">
                                        <td class="gamyba-check"><input type="checkbox" checked="@_selected.Contains(item.Id)" @onclick:stopPropagation="true" @onchange="() => ToggleSelected(item.Id)" /></td>
                                        <td><button type="button" class="gamyba-link mono" @onclick:stopPropagation="true" @onclick="() => OpenSalesFixture(item.Order)">@item.Order</button><small>@item.Branch</small></td>
                                        <td class="mono">@item.Due @if (item.Priority != "normal"){<span class="chip @PriorityClass(item.Priority)">@item.Priority</span>}</td>
                                        <td>@item.Type</td><td><span class="gamyba-swatch"></span>@item.Fabric @if(item.NoMaterial){<span class="gamyba-nomaterial">@L("NO MATERIAL", "TRŪKSTA")</span>}</td>
                                        <td class="is-num mono">@item.Width × @item.Height</td><td class="is-num mono"><strong>@item.Quantity</strong></td><td class="gamyba-note">@item.Note</td><td><span class="chip @StageClass(item.Stage)">@item.Stage</span></td><td class="mono">@item.Barcode</td><td class="mono">@if(item.PreviousGu is not null){<span class="gamyba-prev">↻ @item.PreviousGu</span>}else{<span class="gamyba-muted">—</span>}</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                        @if (!QueueItems.Any())
                        {
                            <div class="gamyba-empty"><strong>@L("No items in this queue", "Eilėje nėra gaminių")</strong><span>@L("Clear filters or change the fixture simulation.", "Išvalykite filtrus arba pakeiskite pavyzdžio būseną.")</span><button type="button" class="gamyba-btn" @onclick="ClearQueueFilters">@L("Clear filters", "Išvalyti filtrus")</button></div>
                        }
                    </div>
                    <div class="gamyba-panel__foot"><span>@L("Queue source", "Eilės šaltinis") <span class="mono">V_WaitingProductionBlinds</span> · @L("fixture snapshot", "pavyzdiniai duomenys")</span><span class="mono">@L("Double-click a row to open history", "Dukart spustelėkite eilutę istorijai")</span></div>
                </section>
                }
            }

            @if (_screen == "tasks")
            {
                @if (LiveQueueEnabled)
                {
                    <div class="gamyba-pagehead"><div><div class="gamyba-eyebrow">SHOPFLOOR · G04</div><h1>@L("Production tasks", "Gamybos užduotys")</h1><p class="mono">@L("Live GU documents", "Gyvi GU dokumentai") · @L("page", "puslapis") @_liveTaskPage</p></div><div class="gamyba-actions"><span class="chip chip--info">@L("READ ONLY", "TIK PERŽIŪRA")</span><button type="button" class="gamyba-btn" disabled="@_liveTaskLoading" @onclick="() => LoadLiveTasksAsync(_liveTaskPage)">@L("Refresh", "Atnaujinti")</button></div></div>
                    @if (_liveTaskError is not null){<div class="gamyba-alert gamyba-alert--danger" role="alert">@_liveTaskError</div>}
                    <section class="gamyba-panel"><div class="gamyba-tablewrap"><table class="gamyba-table"><thead><tr><th>GU</th><th>@L("Created", "Sukurta")</th><th>@L("Author", "Autorius")</th><th class="is-num">@L("Items", "Gaminiai")</th><th class="is-num">@L("Orders", "Užsakymai")</th></tr></thead><tbody>
                    @foreach (var task in _liveTasks?.Items ?? [])
                    {
                        <tr class="gamyba-clickrow" @onclick="() => OpenLiveTaskAsync(task.Id)"><td class="mono gamyba-accent"><strong>@task.Number ↗</strong></td><td class="mono">@task.Created?.ToString("yyyy-MM-dd HH:mm")</td><td>@task.Author</td><td class="is-num mono"><strong>@task.ItemRows</strong></td><td class="is-num mono">@task.OrderCount</td></tr>
                    }
                    </tbody></table>
                    @if (!_liveTaskLoading && _liveTaskError is null && _liveTasks?.Items.Count == 0){<div class="gamyba-empty"><strong>@L("No accessible tasks", "Nėra prieinamų užduočių")</strong></div>}
                    </div><div class="gamyba-panel__foot"><span>@L("Tasks with hidden items are excluded", "Užduotys su neprieinamais gaminiais nerodomos")</span><span><button type="button" class="gamyba-btn gamyba-btn--xs" disabled="@(_liveTaskLoading || _liveTaskPage <= 1)" @onclick="() => LoadLiveTasksAsync(_liveTaskPage - 1)">← @L("Previous", "Atgal")</button> <span class="mono">@_liveTaskPage</span> <button type="button" class="gamyba-btn gamyba-btn--xs" disabled="@(_liveTaskLoading || _liveTasks?.HasMore != true)" @onclick="() => LoadLiveTasksAsync(_liveTaskPage + 1)">@L("Next", "Toliau") →</button></span></div></section>
                }
                else
                {
                <div class="gamyba-pagehead"><div><div class="gamyba-eyebrow">SHOPFLOOR · G03–G04</div><h1>@L("Production tasks", "Gamybos užduotys")</h1><p>@L("GU documents, portions, composition and print status.", "GU dokumentai, porcijos, sudėtis ir spausdinimo būsena.")</p></div><div class="gamyba-actions"><input class="gamyba-input" @bind="_taskSearch" @bind:event="oninput" placeholder="@L("Search GU", "Ieškoti GU")" /><button type="button" class="gamyba-btn" @onclick="NewEmptyTask">@L("New empty GU", "Nauja tuščia GU")</button></div></div>
                <section class="gamyba-panel"><div class="gamyba-tablewrap"><table class="gamyba-table"><thead><tr><th>GU</th><th>@L("Created", "Sukurta")</th><th>@L("Author", "Autorius")</th><th class="is-num">@L("Portions", "Porcijos")</th><th class="is-num">@L("Items", "Gaminiai")</th><th>@L("Orders", "Užsakymai")</th><th>@L("State", "Būsena")</th><th>@L("Documents", "Dokumentai")</th><th>@L("Labels", "Etiketės")</th></tr></thead><tbody>
                @foreach (var task in _tasks.Where(x => x.Number.Contains(_taskSearch, StringComparison.OrdinalIgnoreCase)))
                {
                    <tr class="gamyba-clickrow" @onclick="() => OpenTask(task.Number)"><td class="mono gamyba-accent"><strong>@task.Number ↗</strong></td><td class="mono">@task.Created</td><td>@task.Author</td><td class="is-num mono">@task.Portions.Count</td><td class="is-num mono"><strong>@TaskItemCount(task)</strong></td><td>@TaskOrders(task)</td><td><span class="chip chip--warn">GAMINAMAS</span></td><td>@task.Pdfs.Count PDF</td><td>@(_jobs.Count(x => x.Task == task.Number)) @L("jobs", "darbai")</td></tr>
                }
                </tbody></table></div></section>
                }
            }

            @if (_screen == "task")
            {
                @if (LiveQueueEnabled)
                {
                    <div class="gamyba-breadcrumb"><button type="button" @onclick='() => Go("tasks")'>@L("Production tasks", "Gamybos užduotys")</button> / <strong class="mono">@(_liveTask?.Task.Number ?? "GU")</strong></div>
                    @if (_liveTaskError is not null){<div class="gamyba-alert gamyba-alert--danger" role="alert">@_liveTaskError</div>}
                    @if (_liveTask is not null)
                    {
                        <div class="gamyba-taskhead"><div><div class="gamyba-eyebrow">@L("TASK", "UŽDUOTIS") GU <span class="chip chip--info">@L("READ ONLY", "TIK PERŽIŪRA")</span></div><h1 class="mono">@_liveTask.Task.Number</h1><p>@_liveTask.Task.Created?.ToString("yyyy-MM-dd HH:mm") · @_liveTask.Task.Author · @_liveTask.Task.ItemRows @L("rows", "eil.") · @_liveTask.Task.OrderCount @L("orders", "užsakymai")</p></div><button type="button" class="gamyba-btn" @onclick="OpenLiveReportsAsync">@L("Production documents", "Gamybos dokumentai")</button></div>
                        <section class="gamyba-panel"><div class="gamyba-panel__head"><strong>@L("Composition", "Sudėtis")</strong><span>@L("Live Access document", "Gyvas Access dokumentas")</span></div><div class="gamyba-tablewrap"><table class="gamyba-table"><thead><tr><th>@L("Barcode", "Kodas")</th><th>@L("Order", "Užsakymas")</th><th>@L("Type", "Tipas")</th><th>@L("Material", "Medžiaga")</th><th class="is-num">@L("Size", "Matmenys")</th><th class="is-num">@L("Qty", "Kiekis")</th><th>@L("State", "Būsena")</th></tr></thead><tbody>
                        @foreach (var item in _liveTask.Items)
                        {
                            <tr><td class="mono">@item.Barcode</td><td class="mono">@item.OrderNumber</td><td>@item.ProductType</td><td>@item.MaterialCode</td><td class="is-num mono">@item.WidthMm × @item.HeightMm</td><td class="is-num mono">@item.Quantity</td><td><span class="chip chip--info">@item.State</span></td></tr>
                        }
                        </tbody></table></div></section>
                    }
                }
                else
                {
                <div class="gamyba-breadcrumb"><button type="button" @onclick='() => Go("tasks")'>@L("Production tasks", "Gamybos užduotys")</button> / <strong class="mono">@CurrentTask.Number</strong></div>
                <div class="gamyba-taskhead"><div><div class="gamyba-eyebrow">@L("TASK", "UŽDUOTIS") GU <span class="chip chip--warn">GAMINAMAS</span> @if(TaskMixed(CurrentTask)){<span class="chip chip--warn">@L("MIXED BRANCHES", "KELI FILIALAI")</span>}</div><h1 class="mono">@CurrentTask.Number</h1><p>@CurrentTask.Created · @CurrentTask.Author · @TaskItemCount(CurrentTask) @L("items", "vnt.") · @CurrentTask.Portions.Count @L("portions", "porcijos") · @TaskOrders(CurrentTask)</p></div><div class="gamyba-actions"><button type="button" class="gamyba-btn gamyba-btn--primary" @onclick="AddPortion">+ @L("Add portion", "Pridėti porciją")</button><button type="button" class="gamyba-btn" @onclick='() => Go("reports")'>@L("Print documents", "Spausdinti dokumentus")</button><button type="button" class="gamyba-btn" @onclick='() => Go("labels")'>@L("Print labels", "Spausdinti etiketes")</button><button type="button" class="gamyba-btn" @onclick='() => Go("scan")'>@L("Scan", "Skenuoti")</button></div></div>
                <div class="gamyba-two-col">
                    <div class="gamyba-stack">
                        <section class="gamyba-panel"><div class="gamyba-panel__head"><strong>@L("Composition", "Sudėtis")</strong><span>@L("Issued rows; another portion can be added", "Išduotos eilutės; galima pridėti dar porciją")</span></div><div class="gamyba-tablewrap"><table class="gamyba-table"><thead><tr><th>@L("Barcode", "Kodas")</th><th>@L("Order", "Užsakymas")</th><th>@L("Type", "Tipas")</th><th>@L("Material", "Medžiaga")</th><th class="is-num">@L("Size", "Matmenys")</th><th>@L("State", "Būsena")</th><th>@L("Action", "Veiksmas")</th></tr></thead><tbody>
                        @foreach(var portion in CurrentTask.Portions)
                        {
                            <tr class="gamyba-group"><td colspan="7">@L("PORTION", "PORCIJA") @portion.Number · @portion.At · @portion.By</td></tr>
                            @foreach(var item in VisibleItems.Where(x => portion.ItemIds.Contains(x.Id)))
                            {
                                <tr><td class="mono">@item.Barcode</td><td class="mono">@item.Order</td><td>@item.Type</td><td>@item.Fabric</td><td class="is-num mono">@item.Width × @item.Height</td><td><span class="chip @StageClass(item.Stage)">@item.Stage</span></td><td><button type="button" class="gamyba-btn gamyba-btn--xs" @onclick="() => OpenHistory(item)">@L("History", "Istorija")</button> <button type="button" class="gamyba-btn gamyba-btn--xs gamyba-btn--danger" @onclick="() => OpenStop(item)">@L("Stop", "Stabdyti")</button></td></tr>
                            }
                        }
                        </tbody></table></div>@if(!CurrentTask.Portions.Any()){<div class="gamyba-empty"><strong>@L("This GU is empty", "Ši GU tuščia")</strong><span>@L("Add a portion from the ready queue.", "Pridėkite porciją iš paruoštų gaminių eilės.")</span></div>}</section>
                        <section class="gamyba-panel"><div class="gamyba-panel__head"><strong>@L("History", "Istorija")</strong></div><div class="gamyba-history-lines">@foreach(var portion in CurrentTask.Portions){<div><span class="mono">@portion.At</span><strong>@L("Portion issued", "Porcija išduota")</strong><span>@portion.ItemIds.Count @L("rows", "eil.") · @portion.By</span></div>}</div></section>
                    </div>
                    <div class="gamyba-stack">
                        <section class="gamyba-panel"><div class="gamyba-panel__head"><strong>@L("Documents", "Dokumentai")</strong><button type="button" class="gamyba-textbutton" @onclick='() => Go("reports")'>@L("Open all", "Atidaryti visus") →</button></div><div class="gamyba-sidebody">@foreach(var pdf in CurrentTask.Pdfs){<div class="gamyba-pdf"><span>PDF</span><strong>@pdf</strong><button type="button" class="gamyba-btn gamyba-btn--xs" @onclick="() => OpenArchivedPdf(pdf)">@L("Open", "Atidaryti")</button></div>}<div class="gamyba-warning">@L("Composition changed after archived PDF? Generate a new version.", "Sudėtis keitėsi po archyvinio PDF? Sukurkite naują versiją.")</div></div></section>
                        <section class="gamyba-panel"><div class="gamyba-panel__head"><strong>@L("Labels", "Etiketės")</strong><button type="button" class="gamyba-textbutton" @onclick='() => Go("labels")'>@L("Queue", "Eilė") →</button></div><div class="gamyba-sidebody"><span class="chip @JobClass(_jobs.FirstOrDefault(x => x.Task == CurrentTask.Number)?.State ?? "Pending")">@(_jobs.FirstOrDefault(x => x.Task == CurrentTask.Number)?.State ?? "Pending")</span><div class="gamyba-progress"><span style="width:@($"{(_jobs.FirstOrDefault(x => x.Task == CurrentTask.Number)?.Sent ?? 0) * 100 / Math.Max(1, _jobs.FirstOrDefault(x => x.Task == CurrentTask.Number)?.PhysicalLabels ?? 1)}%")"></span></div></div></section>
                        <section class="gamyba-panel"><div class="gamyba-panel__head"><strong>@L("Warehouse", "Sandėlis") · G12</strong></div><div class="gamyba-sidebody">@if(CurrentTask.WriteOff is not null){<span class="chip chip--done">@L("WRITTEN OFF", "NURAŠYTA")</span> <span class="mono">@CurrentTask.WriteOff</span>}else{<p>@L("No material movement recorded for this GU.", "Šiai GU medžiagų judėjimas neužfiksuotas.")</p><button type="button" class="gamyba-btn gamyba-btn--xs" @onclick="WriteOffTask">@L("Write off", "Nurašyti")</button>}</div></section>
                    </div>
                </div>
                }
            }
            @if (_screen == "scan")
            {
                <div class="gamyba-pagehead"><div><div class="gamyba-eyebrow">SCANNING · G07</div><h1>@L("Scanning", "Skenavimas")</h1></div><div class="gamyba-actions"><label class="gamyba-compact-select"><span>@L("Document", "Dokumentas")</span><select @bind="_currentDocument">@foreach(var doc in _documents){<option value="@doc.Number">@doc.Number</option>}</select></label><div class="gamyba-segment"><button type="button" class="@(_scanMode == "desktop" ? "is-active" : "")" @onclick='() => _scanMode = "desktop"'>Desktop</button><button type="button" class="@(_scanMode == "mobile" ? "is-active" : "")" @onclick='() => _scanMode = "mobile"'>Mobile</button></div><button type="button" class="gamyba-btn" @onclick='() => _modal = "scan-import"'>@L("Import list", "Importuoti sąrašą")</button><button type="button" class="gamyba-btn" @onclick='() => _modal = "scan-errors"'>@L("Error log", "Klaidų žurnalas") <span class="gamyba-danger mono">@_scanErrors.Count</span></button></div></div>
                @if (_scanMode == "desktop")
                {
                    <div class="gamyba-scan-grid">
                        <div class="gamyba-stack">
                            <section class="gamyba-panel gamyba-scan-pad"><div class="gamyba-scan-label"><span>@L("Scanner input", "Skaitytuvo įvestis")</span><span>@L("Scan or type + Enter · focus returns here", "Skenuokite arba įveskite + Enter · fokusas grįžta čia")</span></div><input id="gamyba-scan-input" class="gamyba-scan-code" inputmode="numeric" autocomplete="off" @bind="_scanValue" @bind:event="oninput" @onkeydown="ScanKey" @onfocus="SelectFocusedInput" placeholder="000000000000" /><div class="gamyba-scan-actions"><button type="button" class="gamyba-btn" @onclick='() => _modal = "scan-manual"'>@L("Pick from list", "Parinkti iš sąrašo")</button><button type="button" class="gamyba-btn gamyba-btn--primary" @onclick="Scan">@L("Confirm · Enter", "Patvirtinti · Enter")</button></div></section>
                            <section class="gamyba-scan-status gamyba-scan-status--@(_scanOutcome == "" ? "idle" : _scanOutcome)"><div><i></i><strong>@(_scanOutcome == "" ? L("WAITING FOR SCAN", "LAUKIAMA SKENO") : _scanOutcome.ToUpperInvariant())</strong><span class="mono">@DateTime.Now.ToString("HH:mm:ss")</span></div><b class="mono">@(_lastScanBarcode == "" ? "— — — —" : _lastScanBarcode)</b><p>@(_scanOutcome == "" ? L("Result of each barcode appears here, large enough to read from the bench.", "Kiekvieno kodo rezultatas rodomas čia, pakankamai didelis matyti nuo darbo stalo.") : _scanReason)</p></section>
                            <div class="gamyba-scan-stats"><div><span>@L("ACCEPTED", "PRIIMTA")</span><strong class="mono">@CurrentDocument.Scans.Count</strong></div><div><span>@L("REPEATED", "PAKARTOTA")</span><strong class="mono">@(_scanOutcome == "repeat" ? 1 : 0)</strong></div><div><span>@L("REJECTED", "ATMESTA")</span><strong class="mono">@_scanErrors.Count</strong></div></div><small class="gamyba-muted">@L("Counters stay with the GT document.", "Skaitikliai lieka su GT dokumentu.")</small>
                        </div>
                        <section class="gamyba-panel"><div class="gamyba-panel__head"><div><strong class="mono">@CurrentDocument.Number</strong><span> · @L("Operation", "Operacija"): @CurrentDocument.Operation · @CurrentDocument.Author · @CurrentDocument.Created</span></div><div class="gamyba-actions"><button type="button" class="gamyba-btn gamyba-btn--xs" disabled="@(!CurrentDocument.Scans.Any())" @onclick="UndoLastScan">↶ @L("Undo last", "Atšaukti paskutinį")</button><button type="button" class="gamyba-btn gamyba-btn--xs" @onclick="() => OpenDocument(CurrentDocument.Number)">@L("Details", "Išsamiau")</button></div></div><div class="gamyba-tablewrap"><table class="gamyba-table"><thead><tr><th>@L("Time", "Laikas")</th><th>@L("Barcode", "Kodas")</th><th>@L("Product", "Gaminys")</th><th>@L("Transition", "Perėjimas")</th><th>@L("Status", "Būsena")</th><th>@L("Reason", "Priežastis")</th></tr></thead><tbody>@foreach(var scan in CurrentDocument.Scans.AsEnumerable().Reverse()){var scannedItem = _items.First(x => x.Id == scan.ItemId);<tr><td class="mono">@scan.At</td><td class="mono"><strong>@scannedItem.Barcode</strong></td><td>@scannedItem.Type</td><td class="mono">@scan.Before → @scan.After</td><td><span class="chip @(scan.Locked ? "chip--slate" : "chip--ok")">@(scan.Locked ? L("LOCKED", "UŽRAKINTA") : L("ACCEPTED", "PRIIMTA"))</span></td><td>@(scan.Locked ? L("Later document", "Vėlesnis dokumentas") : "—")</td></tr>}</tbody></table>@if(!CurrentDocument.Scans.Any()){<div class="gamyba-empty">@L("No scans yet", "Skenų dar nėra")</div>}</div></section>
                    </div>
                }
                else
                {
                    <div class="gamyba-mobile-wrap"><div class="gamyba-phone"><div class="gamyba-phone__head"><span>SCANNING <b>TEST</b></span><strong class="mono">@CurrentDocument.Number</strong><small>@L("Operation", "Operacija"): @CurrentDocument.Operation</small></div><div class="gamyba-phone__body"><input id="gamyba-scan-input" class="gamyba-scan-code" inputmode="numeric" autocomplete="off" @bind="_scanValue" @bind:event="oninput" @onkeydown="ScanKey" @onfocus="SelectFocusedInput" placeholder="000000000000" /><section class="gamyba-scan-status gamyba-scan-status--@(_scanOutcome == "" ? "idle" : _scanOutcome)"><div><i></i><strong>@(_scanOutcome == "" ? L("WAITING FOR SCAN", "LAUKIAMA SKENO") : _scanOutcome.ToUpperInvariant())</strong></div><b class="mono">@(_lastScanBarcode == "" ? "— — — —" : _lastScanBarcode)</b><p>@(_scanOutcome == "" ? L("Result of each barcode appears here, large enough to read from the bench.", "Kiekvieno kodo rezultatas rodomas čia, pakankamai didelis matyti nuo darbo stalo.") : _scanReason)</p></section><div class="gamyba-scan-stats"><div><span>@L("ACCEPTED", "PRIIMTA")</span><strong class="mono">@CurrentDocument.Scans.Count</strong></div><div><span>@L("REPEATED", "PAKARTOTA")</span><strong class="mono">@(_scanOutcome == "repeat" ? 1 : 0)</strong></div><div><span>@L("REJECTED", "ATMESTA")</span><strong class="mono">@_scanErrors.Count</strong></div></div><div class="gamyba-phone__rows">@foreach(var scan in CurrentDocument.Scans.AsEnumerable().Reverse().Take(4)){var scannedItem = _items.First(x => x.Id == scan.ItemId);<div><span class="mono">@scannedItem.Barcode</span><span>@scannedItem.Type</span><small class="mono">@scan.At</small></div>}</div><div class="gamyba-scan-actions"><button type="button" class="gamyba-btn" @onclick='() => _modal = "scan-manual"'>@L("Pick from list", "Parinkti iš sąrašo")</button><button type="button" class="gamyba-btn" disabled="@(!CurrentDocument.Scans.Any())" @onclick="UndoLastScan">↶ @L("Undo last", "Atšaukti paskutinį")</button></div></div></div><div class="gamyba-mobile-note"><strong>@L("Mobile mode", "Mobilus režimas")</strong><p>@L("The same GT document and scan results are used on desktop and mobile.", "Tas pats GT dokumentas ir skenų rezultatai naudojami kompiuteryje bei mobiliajame įrenginyje.")</p></div></div>
                }
            }

            @if (_screen == "gt")
            {
                <div class="gamyba-pagehead"><div><div class="gamyba-eyebrow">SHOPFLOOR · G08</div><h1>@L("GT documents", "GT dokumentai")</h1><p>@L("Production transitions and scan history.", "Gamybos perėjimai ir skenavimo istorija.")</p></div><div class="gamyba-actions"><label class="gamyba-mine-filter"><input type="checkbox" @bind="_mineLastFour" />@L("Mine · last 4 days", "Mano · 4 dienos")</label><button type="button" class="gamyba-btn gamyba-btn--primary" @onclick="NewDocument">+ @L("New GT document", "Naujas GT dokumentas")</button></div></div>
                <section class="gamyba-panel"><div class="gamyba-tablewrap"><table class="gamyba-table"><thead><tr><th>GT</th><th>@L("Date", "Data")</th><th>@L("Author", "Autorius")</th><th>@L("Operation", "Operacija")</th><th class="is-num">@L("Rows", "Eilutės")</th><th>@L("Note", "Pastaba")</th><th class="is-num">@L("Action", "Veiksmas")</th></tr></thead><tbody>
                    @foreach (var doc in ListedDocuments)
                    {
                        <tr><td class="mono gamyba-accent"><strong>@doc.Number</strong></td><td class="mono">@doc.Created</td><td>@doc.Author</td><td><span class="chip @StageClass(doc.Operation)">@doc.Operation</span></td><td class="mono is-num"><strong>@doc.Scans.Count</strong></td><td class="gamyba-muted">@(CanContinueDocument(doc) ? "—" : L("Older or another author", "Senas arba kitas autorius"))</td><td class="is-num"><button type="button" class="gamyba-btn gamyba-btn--xs gamyba-btn--primary" disabled="@(!CanContinueDocument(doc))" @onclick="() => ContinueDocument(doc.Number)">@L("Continue scanning", "Tęsti skenavimą")</button> <button type="button" class="gamyba-btn gamyba-btn--xs" @onclick="() => OpenDocument(doc.Number)">@L("Details", "Detalės")</button></td></tr>
                    }
                </tbody></table></div></section>
            }

            @if (_screen == "gt-detail")
            {
                <div class="gamyba-breadcrumb"><button type="button" @onclick='() => Go("gt")'>@L("GT documents", "GT dokumentai")</button> / <strong class="mono">@CurrentDocument.Number</strong></div>
                <div class="gamyba-taskhead"><div><div class="gamyba-eyebrow">GT · @L("DOCUMENT", "DOKUMENTAS")</div><h1 class="mono">@CurrentDocument.Number</h1><p>@L("Operation", "Operacija"): <strong>@CurrentDocument.Operation</strong> · @CurrentDocument.Author · @CurrentDocument.Created · @CurrentDocument.Scans.Count @L("items", "gaminiai")</p></div><div class="gamyba-actions"><button type="button" class="gamyba-btn gamyba-btn--primary" disabled="@(!CanContinueDocument(CurrentDocument))" @onclick='() => Go("scan")'>@L("Continue scanning", "Tęsti skenavimą")</button><button type="button" class="gamyba-btn" disabled="@(CurrentDocument.Scans.Count == 0 || CurrentDocument.Scans.Last().Locked || !CanContinueDocument(CurrentDocument) || Restricted)" @onclick="UndoLastScan">↶ @L("Undo last scan", "Atšaukti paskutinį skeną")</button></div></div>
                <div class="gamyba-gt-rule"><span class="gamyba-dot"></span><span><strong>@L("Correction rule.", "Taisymo taisyklė.")</strong> @L("Only the last accepted row of your recent document can be removed; a later transition locks it.", "Pašalinti galima tik paskutinę priimtą savo naujausio dokumento eilutę; vėlesnis perėjimas ją užrakina.") <button type="button" class="gamyba-textbutton" @onclick='() => Go("map")'>P08 ?</button></span></div>
                <section class="gamyba-panel"><div class="gamyba-tablewrap"><table class="gamyba-table"><thead><tr><th>#</th><th>@L("Time", "Laikas")</th><th>@L("Barcode", "Kodas")</th><th>@L("Item", "Gaminys")</th><th>@L("Transition", "Perėjimas")</th><th>@L("Rights", "Teisės")</th><th class="is-num">@L("Correction", "Taisymas")</th></tr></thead><tbody>
                    @foreach (var scan in CurrentDocument.Scans)
                    {
                        var item = _items.First(x => x.Id == scan.ItemId);
                        var last = scan == CurrentDocument.Scans.Last();
                        <tr><td class="mono gamyba-muted">@(CurrentDocument.Scans.IndexOf(scan) + 1)</td><td class="mono gamyba-muted">@scan.At</td><td class="mono"><strong>@item.Barcode</strong></td><td>@item.Type · @item.Width×@item.Height · @item.Order</td><td class="mono">@scan.Before → @scan.After</td><td>@(Restricted && item.Branch != "Kaunas" ? L("Other branch", "Kitas filialas") : L("Allowed", "Leidžiama"))</td><td class="is-num">@if (last && !scan.Locked){<button type="button" class="gamyba-btn gamyba-btn--xs" disabled="@(!CanContinueDocument(CurrentDocument) || Restricted)" @onclick="UndoLastScan">↶ @L("Delete scan", "Pašalinti skeną")</button>}else if(scan.Locked){<span class="gamyba-muted">@L("Locked", "Užrakinta")</span>}</td></tr>
                    }
                </tbody></table></div></section>
            }

            @if (_screen == "stops")
            {
                <div class="gamyba-pagehead">
                    <div><div class="gamyba-eyebrow">SHOPFLOOR · G09–G10</div><h1>@L("Production stops · Repairs", "Gamybos stabdymai · Remontai")</h1></div>
                    <div class="gamyba-segment"><button type="button" class="@(_stopTab == "stops" ? "is-active" : "")" @onclick='() => _stopTab = "stops"'>@L("Stops", "Stabdymai")</button><button type="button" class="@(_stopTab == "repairs" ? "is-active" : "")" @onclick="SetRepairTabAsync">@L("Repairs", "Remontai")</button></div>
                </div>
                @if (_stopTab == "stops")
                {
                    <div class="gamyba-stop-warning"><span class="gamyba-dot"></span><span><strong>@L("This is a production stop, not an order cancellation.", "Tai gamybos stabdymas, ne užsakymo atšaukimas.")</strong> @L("The Sales order stays as it is; items get status Sustabdytas and a separate stop document. Cancelling the order is done in Sales.", "Sales užsakymas nesikeičia; gaminiai gauna būseną Sustabdytas ir atskirą stabdymo dokumentą. Užsakymas atšaukiamas Sales modulyje.")</span></div>
                    <div class="gamyba-stops-grid">
                        <section class="gamyba-panel">
                            <div class="gamyba-panel__head"><strong>@L("Stop documents", "Stabdymo dokumentai")</strong><button type="button" class="gamyba-btn gamyba-btn--xs gamyba-btn--danger" @onclick="ResetStopPicker">+ @L("New stop document", "Naujas stabdymo dokumentas")</button></div>
                            <div class="gamyba-tablewrap"><table class="gamyba-table"><thead><tr><th>@L("Document", "Dokumentas")</th><th>@L("Date", "Data")</th><th>@L("Order", "Užsakymas")</th><th class="is-num">@L("Rows", "Eilutės")</th><th>@L("Reason", "Priežastis")</th><th></th></tr></thead><tbody>
                                @foreach (var stop in _stops)
                                {
                                    <tr><td class="mono gamyba-accent"><strong>@stop.Number</strong></td><td class="mono">@StopDate(stop.Number)</td><td class="mono">@stop.Order</td><td class="is-num mono">@stop.ItemIds.Count</td><td>@stop.Reason</td><td class="is-num"><button type="button" class="gamyba-btn gamyba-btn--xs" @onclick="() => PreviewStop(stop.Number)">@L("View · Print", "Žiūrėti · Spausdinti")</button></td></tr>
                                }
                            </tbody></table></div>
                        </section>
                        <section class="gamyba-panel">
                            <div class="gamyba-panel__head"><strong>@L("Choose order / items", "Pasirinkti užsakymą / gaminius")</strong></div>
                            <div class="gamyba-sidebody">
                                <div class="gamyba-stop-order">
                                    <label>@L("Series", "Serija")<select class="gamyba-input mono" @bind="_stopSeries"><option>KVT</option><option>KLP</option></select></label>
                                    <label>@L("Group", "Grupė")<select class="gamyba-input mono" @bind="_stopGroup"><option>2611</option><option>2610</option></select></label>
                                    <label>@L("Number", "Numeris")<input class="gamyba-input mono" @bind="_stopOrder" @bind:event="oninput" @onfocus="SelectFocusedInput" placeholder="012" /></label>
                                </div>
                                <small>@L("Only eligible items from this order can be stopped.", "Stabdyti galima tik tinkamos būsenos šio užsakymo gaminius.")</small>
                                <div class="gamyba-stop-candidates">
                                    @foreach (var item in StopCandidates)
                                    {
                                        <label class="@(item.Stage != "gaminamas" ? "is-disabled" : "")"><input type="checkbox" checked="@_stopSelected.Contains(item.Id)" disabled="@(item.Stage != "gaminamas")" @onchange="() => ToggleStop(item.Id)" /><span class="mono">@item.Barcode</span><strong>@item.Order · @item.Type @item.Width×@item.Height</strong><span class="chip @StageClass(item.Stage)">@item.Stage</span></label>
                                    }
                                </div>
                                <label class="gamyba-fieldlabel">@L("Reason", "Priežastis")</label>
                                <select class="gamyba-input" @bind="_stopReason"><option>Kliento prašymas</option><option>Audinio defektas</option><option>Matavimo klaida</option><option>Medžiagos trūkumas</option></select>
                                <button type="button" class="gamyba-btn gamyba-btn--danger" disabled="@(_stopSelected.Count == 0 || Restricted)" @onclick="StopItems">@L("Create stop document", "Sukurti stabdymo dokumentą")</button>
                                <small>@L("The legacy stop contract is still being checked.", "Legacy stabdymo taisyklės dar tikrinamos.") <button type="button" class="gamyba-textbutton" @onclick='() => Go("map")'>P09 ?</button></small>
                            </div>
                        </section>
                    </div>
                }
                else if (LiveQueueEnabled)
                {
                    <div class="gamyba-repair-filters">
                        @foreach (var filter in new[] { ("all", L("All", "Visi")), ("unfinished", L("Unfinished", "Nebaigti")), ("unknown", L("Missing actual failure", "Nenurodytas faktinis gedimas")) })
                        {
                            <button type="button" class="@(_repairFilter == filter.Item1 ? "is-active" : "")" @onclick="() => SetLiveRepairFilterAsync(filter.Item1)">@filter.Item2</button>
                        }
                        <span>@L("Legacy repairs · read only", "Legacy remontai · tik peržiūra")</span>
                    </div>
                    @if (_liveRepairLoading)
                    {
                        <div class="gamyba-empty">@L("Loading repairs…", "Įkeliami remontai…")</div>
                    }
                    else if (_liveRepairError is not null)
                    {
                        <div class="gamyba-empty">@_liveRepairError</div>
                    }
                    else if (_liveRepairs is not null)
                    {
                        <div class="gamyba-stops-grid">
