                                <tr class="gamyba-clickrow @(_repairNumber == rep.Number ? "is-selected" : "")" @onclick="() => _repairNumber = rep.Number"><td class="mono gamyba-accent"><strong>@rep.Number</strong></td><td class="mono">@item.Barcode</td><td>@item.Type @item.Width×@item.Height</td><td>@rep.Reason</td><td><span class="chip @(rep.Done ? "chip--done" : "chip--warn")">@(rep.Done ? "DONE" : "OPEN")</span></td><td class="@(string.IsNullOrWhiteSpace(rep.Fact) ? "gamyba-muted" : "")">@(string.IsNullOrWhiteSpace(rep.Fact) ? "—" : rep.Fact)</td></tr>
