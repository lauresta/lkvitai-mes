@page "/gamyba"
@layout GamybaLayout

<PageTitle>Cikada.MES · @L["Gamyba.PageTitle"]</PageTitle>

<div class="gamyba" @onkeydown="PageKey">
    <div class="gamyba-shell" style="width:@(_viewport == "fit" ? "100%" : _viewport + "px")">
        <nav class="gamyba-tabs" aria-label="Gamyba">
            @foreach (var tab in Tabs)
            {
                <button type="button" class="@(_screen == tab.Key || (_screen == "task" && tab.Key == "tasks") || (_screen == "gt-detail" && tab.Key == "gt") ? "is-active" : "")" @onclick="() => GoLiveAwareAsync(tab.Key)">@L[tab.TitleKey].Value @if(tab.Key == "queue" && !LiveQueueEnabled){<span class="gamyba-tabcount mono">@QueueItems.Count()</span>} @if(tab.Key == "tasks" && !LiveQueueEnabled){<span class="gamyba-tabcount mono">@_tasks.Count</span>} @if(tab.Key == "labels" && !LiveQueueEnabled){<span class="gamyba-tabcount gamyba-tabcount--danger mono">@_jobs.Count(x => x.State != "Sent")</span>}</button>
            }
            <button type="button" class="@(_screen == "map" ? "is-active" : "")" @onclick='() => Go("map")'>@L["Gamyba.MapQuestions"].Value</button>
        </nav>
        <div class="gamyba-quickfind">
            <label class="gamyba-global-search">
                <span aria-hidden="true">⌕</span>
                <input id="gamyba-global-search" @bind="_globalSearch" @bind:event="oninput" placeholder="@L["Gamyba.BarcodeGUGTOrOrderEnter"].Value" @onkeydown="GlobalSearchKey" />
                <kbd>F2</kbd>
            </label>
        </div>

        <main class="gamyba-main @(PrototypeControls ? "gamyba-main--demo" : "")">
            @if (LiveQueueEnabled && _screen is not ("queue" or "tasks" or "task" or "history" or "reports" or "gt" or "gt-detail")
                && !(_screen == "stops" && _stopTab == "repairs"))
            {
                <div class="gamyba-alert gamyba-alert--info" role="status">@L["Gamyba.PreviewThisScreenUsesSampleDataAndDoesNot"].Value</div>
            }
            @if (!string.IsNullOrWhiteSpace(_notice))
            {
                <div class="gamyba-alert gamyba-alert--@_noticeKind" role="alert"><span>@_notice</span><button type="button" @onclick='() => _notice = ""'>×</button></div>
            }

            @if (_screen == "queue")
            {
                @if (LiveQueueEnabled)
                {
                    @if (_fromSales is not null)
                    {
                        <div class="gamyba-source"><span class="gamyba-dot"></span><span><strong>@L["Gamyba.FromSalesOrder"].Value</strong> <span class="mono">@_fromSales</span></span><button type="button" @onclick="ClearLiveOrderFilterAsync">@L["Gamyba.ShowAll"].Value</button></div>
                    }
                    <div class="gamyba-pagehead">
                        <div><div class="gamyba-eyebrow">@L["Gamyba.ShopfloorHeading"] · G02</div><h1>@L["Gamyba.ReadyForProduction"].Value</h1><p class="mono">@L["Gamyba.LiveAccessQueue"].Value · @L["Gamyba.Page"].Value @_liveQueuePage · @(_liveQueue?.Items.Count ?? 0) @L["Gamyba.RowsOnThisPage"].Value · <strong>@_liveSelected.Count @L["Gamyba.Selected"].Value</strong> · @LiveSelectedItems.Sum(item => item.Quantity) @L["Gamyba.Items"].Value</p></div>
                        <div class="gamyba-actions">@if (LiveTaskWriteEnabled){<span class="chip chip--info mono">@(_liveIssueTaskId is int target ? $"GU #{target}" : L["Gamyba.NewGU"].Value)</span>@if (_liveIssueTaskId is not null){<button type="button" class="gamyba-btn" @onclick="() => _liveIssueTaskId = null">@L["Gamyba.NewGU"].Value</button>}<button type="button" class="gamyba-btn gamyba-btn--primary" disabled="@(_liveQueueLoading || _liveSelected.Count == 0)" @onclick="OpenLiveIssue">@L["Gamyba.IssueSelected"].Value</button>}else{<span class="chip chip--info">@L["Gamyba.READONLY"].Value</span>}<button type="button" class="gamyba-btn" disabled="@(_liveQueueLoading || _liveQueue?.Items.Count is not > 0)" @onclick="SelectAllLiveOnPage">@L["Gamyba.SelectPage"].Value</button><label class="gamyba-first">@L["Gamyba.FirstNOnPage"].Value <input type="number" min="1" max="100" @bind="_liveFirstN" @onfocus="SelectFocusedInput" /><button type="button" disabled="@(_liveQueueLoading || _liveQueue?.Items.Count is not > 0)" @onclick="SelectFirstLiveOnPage">@L["Gamyba.Pick"].Value</button></label><button type="button" class="gamyba-btn" disabled="@_liveQueueLoading" @onclick="() => LoadLiveQueueAsync(_liveQueuePage)">@L["Gamyba.Refresh"].Value</button></div>
                    </div>
                    @if (_liveQueueError is not null)
                    {
                        <div class="gamyba-alert gamyba-alert--danger" role="alert">@_liveQueueError <button type="button" @onclick="() => LoadLiveQueueAsync(_liveQueuePage)">@L["Gamyba.Retry"].Value</button></div>
                    }
                    @if (_liveFacetError is not null){<div class="gamyba-alert gamyba-alert--warn" role="status">@_liveFacetError</div>}
                    <section class="gamyba-panel">
                        <div class="gamyba-toolbar">
                            <span class="gamyba-toolbar__label">@L["Gamyba.Branch"].Value</span>
                            <div class="gamyba-segment"><button type="button" class="@(_liveDepartmentId is null ? "is-active" : "")" disabled="@_liveQueueLoading" @onclick='() => SetLiveQueueFilterAsync("branch", null)'>@L["Gamyba.All"].Value</button>@foreach (var facet in _liveFacets.Where(x => x.Kind == "branch")){<button type="button" class="@(_liveDepartmentId == facet.Id ? "is-active" : "")" disabled="@_liveQueueLoading" @onclick='() => SetLiveQueueFilterAsync("branch", facet.Id)'>@facet.Name <span class="mono">@facet.Rows</span></button>}</div>
                            <label class="gamyba-compact-select"><span>@L["Gamyba.Series"].Value</span><select value="@(_liveSeriesId?.ToString() ?? "")" disabled="@_liveQueueLoading" @onchange='args => SetLiveSelectAsync("series", args)'><option value="">@L["Gamyba.AllVisos"].Value</option>@foreach (var facet in _liveFacets.Where(x => x.Kind == "series" && (_liveDepartmentId is null || x.ParentId == _liveDepartmentId))){<option value="@facet.Id">@facet.Name · @facet.Rows</option>}</select></label>
                            <span class="gamyba-toolbar__label">@L["Gamyba.Type"].Value</span>
                            <div class="gamyba-pills"><button type="button" class="@(_liveCategoryId is null ? "is-active" : "")" disabled="@_liveQueueLoading" @onclick='() => SetLiveQueueFilterAsync("category", null)'>@L["Gamyba.All"].Value</button>@foreach (var facet in _liveFacets.Where(x => x.Kind == "category")){<button type="button" class="@(_liveCategoryId == facet.Id ? "is-active" : "")" disabled="@_liveQueueLoading" @onclick='() => SetLiveQueueFilterAsync("category", facet.Id)'>@facet.Name <span class="mono">@facet.Rows</span></button>}</div>
                            <label class="gamyba-compact-select"><span>@L["Gamyba.Subtype"].Value</span><select value="@(_liveTypeId?.ToString() ?? "")" disabled="@_liveQueueLoading" @onchange='args => SetLiveSelectAsync("type", args)'><option value="">@L["Gamyba.All"].Value</option>@foreach (var facet in _liveFacets.Where(x => x.Kind == "type" && (_liveCategoryId is null || x.ParentId == _liveCategoryId))){<option value="@facet.Id">@facet.Name · @facet.Rows</option>}</select></label>
                            <span class="gamyba-toolbar__label">@L["Gamyba.Priority"].Value</span>
                            <div class="gamyba-pills"><button type="button" class="@(_livePriorityId is null ? "is-active" : "")" disabled="@_liveQueueLoading" @onclick='() => SetLiveQueueFilterAsync("priority", null)'>@L["Gamyba.All"].Value</button>@foreach (var facet in _liveFacets.Where(x => x.Kind == "priority")){<button type="button" class="@(_livePriorityId == facet.Id ? "is-active" : "")" disabled="@_liveQueueLoading" @onclick='() => SetLiveQueueFilterAsync("priority", facet.Id)'>@facet.Name <span class="mono">@facet.Rows</span></button>}</div>
                        </div>
                        <div class="gamyba-tablewrap"><table class="gamyba-table">
                            <thead><tr><th class="gamyba-check"><input type="checkbox" aria-label="@L["Gamyba.SelectPage"].Value" checked="@(_liveQueue?.Items.Count is > 0 && _liveQueue.Items.All(item => _liveSelected.Contains(item.ProductId)))" @onchange="SelectAllLiveOnPage" /></th><th>@L["Gamyba.Order"].Value</th><th>@L["Gamyba.Due"].Value</th><th>@L["Gamyba.Type"].Value</th><th>@L["Gamyba.Material"].Value</th><th class="is-num">@L["Gamyba.Size"].Value</th><th class="is-num">@L["Gamyba.Qty"].Value</th><th>@L["Gamyba.Note"].Value</th><th>@L["Gamyba.State"].Value</th><th>@L["Gamyba.Barcode"].Value</th></tr></thead>
                            <tbody>
                            @foreach (var item in _liveQueue?.Items ?? [])
                            {
                                <tr class="@(_liveSelected.Contains(item.ProductId) ? "is-selected" : "")" @onclick="() => ToggleLiveSelected(item.ProductId)"><td class="gamyba-check"><input type="checkbox" aria-label="@($"{item.OrderNumber} · {item.Barcode}")" checked="@_liveSelected.Contains(item.ProductId)" @onclick:stopPropagation="true" @onchange="() => ToggleLiveSelected(item.ProductId)" /></td><td><a class="gamyba-link mono" href="@($"/sales/entry/{item.OrderId}")" target="_blank" rel="noopener" @onclick:stopPropagation="true">@item.OrderNumber ↗</a><small>@item.Department</small></td><td class="mono">@item.DueDate?.ToString("yyyy-MM-dd") @if (!string.IsNullOrWhiteSpace(item.Priority)){<span class="chip chip--slate">@item.Priority</span>}</td><td>@item.ProductType</td><td><span class="gamyba-swatch"></span>@item.Colour</td><td class="is-num mono">@item.WidthMm × @item.HeightMm</td><td class="is-num mono"><strong>@item.Quantity</strong></td><td class="gamyba-note">@item.Notes</td><td><span class="chip chip--info">@item.State</span></td><td class="mono">@if (!string.IsNullOrWhiteSpace(item.Barcode)){<button type="button" class="gamyba-link mono" @onclick:stopPropagation="true" @onclick="() => OpenLiveQueueHistoryAsync(item.Barcode)">@item.Barcode</button>}</td></tr>
                            }
                            </tbody>
                        </table>
                        @if (!_liveQueueLoading && _liveQueueError is null && _liveQueue?.Items.Count == 0)
                        {<div class="gamyba-empty"><strong>@L["Gamyba.NoItemsInThisQueue"].Value</strong></div>}
                        </div>
                        <div class="gamyba-panel__foot"><span>@L["Gamyba.QueueSource"].Value <span class="mono">SP_fsubProduction · Loc_leidimas</span></span><span><button type="button" class="gamyba-btn gamyba-btn--xs" disabled="@(_liveQueueLoading || _liveQueuePage <= 1)" @onclick="() => LoadLiveQueueAsync(_liveQueuePage - 1)">← @L["Gamyba.Previous"].Value</button> <span class="mono">@_liveQueuePage</span> <button type="button" class="gamyba-btn gamyba-btn--xs" disabled="@(_liveQueueLoading || _liveQueue?.HasMore != true)" @onclick="() => LoadLiveQueueAsync(_liveQueuePage + 1)">@L["Gamyba.Next"].Value →</button></span></div>
                    </section>
                }
                else
                {
                @if (_fromSales is not null)
                {
                    <div class="gamyba-source"><span class="gamyba-dot"></span><span><strong>@L["Gamyba.FromSalesOrder"].Value</strong> <span class="mono">@_fromSales</span> · @L["Gamyba.TheQueueIsFilteredToThisOrder"].Value</span><button type="button" @onclick="() => _fromSales = null">@L["Gamyba.ShowAll"].Value</button></div>
                }
                <div class="gamyba-pagehead">
                    <div><div class="gamyba-eyebrow">@L["Gamyba.ShopfloorHeading"] · G01–G03</div><h1>@L["Gamyba.ReadyForProduction"].Value</h1><p class="mono">@QueueItems.Count() @L["Gamyba.Rows"].Value · @QueueItems.Sum(x => x.Quantity) @L["Gamyba.Items"].Value · <strong>@_selected.Count @L["Gamyba.Selected"].Value</strong></p></div>
                    <div class="gamyba-actions">
                        <label class="gamyba-compact-select"><span>@L["Gamyba.TargetGU"].Value</span><select @bind="_targetGu"><option value="new">@L["Gamyba.NewGU"].Value</option>@foreach (var task in _tasks){<option value="@task.Number">@task.Number</option>}</select></label>
                        <button type="button" class="gamyba-btn" @onclick="SelectAll">@L["Gamyba.SelectAll"].Value <kbd>A</kbd></button>
                        <label class="gamyba-first">@L["Gamyba.FirstN"].Value <input type="number" min="1" max="999" @bind="_firstN" @onfocus="SelectFocusedInput" /><button type="button" @onclick="PickFirstN">@L["Gamyba.Pick"].Value</button></label>
                        <button type="button" class="gamyba-btn gamyba-btn--primary" disabled="@(_selected.Count == 0)" @onclick="OpenIssue">@L["Gamyba.CreateGUAndIssue"].Value <kbd>G</kbd></button>
                    </div>
                </div>
                <section class="gamyba-panel">
                    <div class="gamyba-toolbar">
                        <span class="gamyba-toolbar__label">@L["Gamyba.Branch"].Value</span>
                        <div class="gamyba-segment">@foreach (var branch in new[] { "All", "Vilnius", "Kaunas", "Klaipėda" }){<button type="button" class="@(_branch == branch ? "is-active" : "")" @onclick="() => _branch = branch">@branch</button>}</div>
                        <span class="gamyba-toolbar__label">@L["Gamyba.Type"].Value</span>
                        <div class="gamyba-pills">@foreach (var type in new[] { "All", "Rolėtai", "Vertikalios", "Plise", "Romanetės", "Tinkleliai", "Horizontalios", "Apsauginės", "Grotos" }){<button type="button" class="@(_type == type ? "is-active" : "")" @onclick="() => _type = type">@type <span class="mono">@(VisibleItems.Count(x => (type == "All" || x.Type == type) && x.Stage == "patvirtintas"))</span></button>}</div>
                        <span class="gamyba-toolbar__label">@L["Gamyba.Priority"].Value</span>
                        <div class="gamyba-pills">@foreach (var priority in new[] { "All", "urgent", "vip", "repair" }){<button type="button" class="@(_priority == priority ? "is-active" : "")" @onclick="() => _priority = priority">@(priority == "All" ? "All" : char.ToUpperInvariant(priority[0]) + priority[1..])</button>}</div>
                        <span class="gamyba-keyhint mono">↑↓ · Space · A · G · Enter</span>
                    </div>
                    <div class="gamyba-tablewrap" tabindex="0" @onkeydown="QueueKey">
                        <table class="gamyba-table">
                            <thead><tr><th class="gamyba-check"><input type="checkbox" checked="@(QueueItems.Any() && QueueItems.All(x => _selected.Contains(x.Id)))" @onclick="SelectAll" /></th><th>@L["Gamyba.Order"].Value</th><th>@L["Gamyba.DuePriority"].Value <button type="button" class="gamyba-question" @onclick='() => Go("map")'>?</button></th><th>@L["Gamyba.Type"].Value</th><th>@L["Gamyba.Material"].Value</th><th class="is-num">@L["Gamyba.Size"].Value</th><th class="is-num">@L["Gamyba.Qty"].Value</th><th>@L["Gamyba.Note"].Value</th><th>@L["Gamyba.State"].Value</th><th>@L["Gamyba.Barcode"].Value</th><th>@L["Gamyba.PreviousGU"].Value</th></tr></thead>
                            <tbody>
                                @foreach (var item in QueueItems)
                                {
                                    <tr class="@(_selected.Contains(item.Id) ? "is-selected" : "") @(QueueItems.ElementAtOrDefault(_cursor)?.Id == item.Id ? "is-cursor" : "")" @onclick="() => ToggleSelected(item.Id)" @ondblclick="() => OpenHistory(item)">
                                        <td class="gamyba-check"><input type="checkbox" checked="@_selected.Contains(item.Id)" @onclick:stopPropagation="true" @onchange="() => ToggleSelected(item.Id)" /></td>
                                        <td><button type="button" class="gamyba-link mono" @onclick:stopPropagation="true" @onclick="() => OpenSalesFixture(item.Order)">@item.Order</button><small>@item.Branch</small></td>
                                        <td class="mono">@item.Due @if (item.Priority != "normal"){<span class="chip @PriorityClass(item.Priority)">@item.Priority</span>}</td>
                                        <td>@item.Type</td><td><span class="gamyba-swatch"></span>@item.Fabric @if(item.NoMaterial){<span class="gamyba-nomaterial">@L["Gamyba.NoMaterialUpper"].Value</span>}</td>
                                        <td class="is-num mono">@item.Width × @item.Height</td><td class="is-num mono"><strong>@item.Quantity</strong></td><td class="gamyba-note">@item.Note</td><td><span class="chip @StageClass(item.Stage)">@item.Stage</span></td><td class="mono">@item.Barcode</td><td class="mono">@if(item.PreviousGu is not null){<span class="gamyba-prev">↻ @item.PreviousGu</span>}else{<span class="gamyba-muted">—</span>}</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                        @if (!QueueItems.Any())
                        {
                            <div class="gamyba-empty"><strong>@L["Gamyba.NoItemsInThisQueue"].Value</strong><span>@L["Gamyba.ClearFiltersOrChangeTheFixtureSimulation"].Value</span><button type="button" class="gamyba-btn" @onclick="ClearQueueFilters">@L["Gamyba.ClearFilters"].Value</button></div>
                        }
                    </div>
                    <div class="gamyba-panel__foot"><span>@L["Gamyba.QueueSource"].Value <span class="mono">V_WaitingProductionBlinds</span> · @L["Gamyba.FixtureSnapshot"].Value</span><span class="mono">@L["Gamyba.DoubleClickARowToOpenHistory"].Value</span></div>
                </section>
                }
            }

            @if (_screen == "tasks")
            {
                @if (LiveQueueEnabled)
                {
                    <div class="gamyba-pagehead"><div><div class="gamyba-eyebrow">@L["Gamyba.ShopfloorHeading"] · G04</div><h1>@L["Gamyba.ProductionTasks"].Value</h1><p class="mono">@L["Gamyba.LiveGUDocuments"].Value · @L["Gamyba.Page"].Value @_liveTaskPage</p></div><div class="gamyba-actions"><span class="chip chip--info">@L["Gamyba.READONLY"].Value</span><button type="button" class="gamyba-btn" disabled="@_liveTaskLoading" @onclick="() => LoadLiveTasksAsync(_liveTaskPage)">@L["Gamyba.Refresh"].Value</button></div></div>
                    @if (_liveTaskError is not null){<div class="gamyba-alert gamyba-alert--danger" role="alert">@_liveTaskError</div>}
                    <section class="gamyba-panel"><div class="gamyba-tablewrap"><table class="gamyba-table"><thead><tr><th>GU</th><th>@L["Gamyba.Created"].Value</th><th>@L["Gamyba.Author"].Value</th><th class="is-num">@L["Gamyba.ItemsGaminiai"].Value</th><th class="is-num">@L["Gamyba.Orders"].Value</th></tr></thead><tbody>
                    @foreach (var task in _liveTasks?.Items ?? [])
                    {
                        <tr class="gamyba-clickrow" @onclick="() => OpenLiveTaskAsync(task.Id)"><td class="mono gamyba-accent"><strong>@task.Number ↗</strong></td><td class="mono">@task.Created?.ToString("yyyy-MM-dd HH:mm")</td><td>@task.Author</td><td class="is-num mono"><strong>@task.ItemRows</strong></td><td class="is-num mono">@task.OrderCount</td></tr>
                    }
                    </tbody></table>
                    @if (!_liveTaskLoading && _liveTaskError is null && _liveTasks?.Items.Count == 0){<div class="gamyba-empty"><strong>@L["Gamyba.NoAccessibleTasks"].Value</strong></div>}
                    </div><div class="gamyba-panel__foot"><span>@L["Gamyba.TasksWithHiddenItemsAreExcluded"].Value</span><span><button type="button" class="gamyba-btn gamyba-btn--xs" disabled="@(_liveTaskLoading || _liveTaskPage <= 1)" @onclick="() => LoadLiveTasksAsync(_liveTaskPage - 1)">← @L["Gamyba.Previous"].Value</button> <span class="mono">@_liveTaskPage</span> <button type="button" class="gamyba-btn gamyba-btn--xs" disabled="@(_liveTaskLoading || _liveTasks?.HasMore != true)" @onclick="() => LoadLiveTasksAsync(_liveTaskPage + 1)">@L["Gamyba.Next"].Value →</button></span></div></section>
                }
                else
                {
                <div class="gamyba-pagehead"><div><div class="gamyba-eyebrow">@L["Gamyba.ShopfloorHeading"] · G03–G04</div><h1>@L["Gamyba.ProductionTasks"].Value</h1><p>@L["Gamyba.GUDocumentsPortionsCompositionAndPrintStatus"].Value</p></div><div class="gamyba-actions"><input class="gamyba-input" @bind="_taskSearch" @bind:event="oninput" placeholder="@L["Gamyba.SearchGU"].Value" /><button type="button" class="gamyba-btn" @onclick="NewEmptyTask">@L["Gamyba.NewEmptyGU"].Value</button></div></div>
                <section class="gamyba-panel"><div class="gamyba-tablewrap"><table class="gamyba-table"><thead><tr><th>GU</th><th>@L["Gamyba.Created"].Value</th><th>@L["Gamyba.Author"].Value</th><th class="is-num">@L["Gamyba.Portions"].Value</th><th class="is-num">@L["Gamyba.ItemsGaminiai"].Value</th><th>@L["Gamyba.Orders"].Value</th><th>@L["Gamyba.State"].Value</th><th>@L["Gamyba.Documents"].Value</th><th>@L["Gamyba.Labels"].Value</th></tr></thead><tbody>
                @foreach (var task in _tasks.Where(x => x.Number.Contains(_taskSearch, StringComparison.OrdinalIgnoreCase)))
                {
                    <tr class="gamyba-clickrow" @onclick="() => OpenTask(task.Number)"><td class="mono gamyba-accent"><strong>@task.Number ↗</strong></td><td class="mono">@task.Created</td><td>@task.Author</td><td class="is-num mono">@task.Portions.Count</td><td class="is-num mono"><strong>@TaskItemCount(task)</strong></td><td>@TaskOrders(task)</td><td><span class="chip chip--warn">GAMINAMAS</span></td><td>@task.Pdfs.Count PDF</td><td>@(_jobs.Count(x => x.Task == task.Number)) @L["Gamyba.Jobs"].Value</td></tr>
                }
                </tbody></table></div></section>
                }
            }

            @if (_screen == "task")
            {
                @if (LiveQueueEnabled)
                {
                    <div class="gamyba-breadcrumb"><button type="button" @onclick='() => Go("tasks")'>@L["Gamyba.ProductionTasks"].Value</button> / <strong class="mono">@(_liveTask?.Task.Number ?? "GU")</strong></div>
                    @if (_liveTaskError is not null){<div class="gamyba-alert gamyba-alert--danger" role="alert">@_liveTaskError</div>}
                    @if (_liveTask is not null)
                    {
                        <div class="gamyba-taskhead"><div><div class="gamyba-eyebrow">@L["Gamyba.TASK"].Value GU @if (!LiveTaskWriteEnabled){<span class="chip chip--info">@L["Gamyba.READONLY"].Value</span>}</div><h1 class="mono">@_liveTask.Task.Number</h1><p>@_liveTask.Task.Created?.ToString("yyyy-MM-dd HH:mm") · @_liveTask.Task.Author · @_liveTask.Task.ItemRows @L["Gamyba.Rows"].Value · @_liveTask.Task.OrderCount @L["Gamyba.OrdersUSakymai"].Value</p></div><div class="gamyba-actions">@if (LiveTaskWriteEnabled){<button type="button" class="gamyba-btn gamyba-btn--primary" @onclick="AddLivePortion">+ @L["Gamyba.AddPortion"].Value</button>}<button type="button" class="gamyba-btn" @onclick="OpenLiveReportsAsync">@L["Gamyba.ProductionDocuments"].Value</button></div></div>
                        <section class="gamyba-panel"><div class="gamyba-panel__head"><strong>@L["Gamyba.Composition"].Value</strong><span>@L["Gamyba.LiveAccessDocument"].Value</span></div><div class="gamyba-tablewrap"><table class="gamyba-table"><thead><tr><th>@L["Gamyba.Barcode"].Value</th><th>@L["Gamyba.Order"].Value</th><th>@L["Gamyba.Type"].Value</th><th>@L["Gamyba.Material"].Value</th><th class="is-num">@L["Gamyba.Size"].Value</th><th class="is-num">@L["Gamyba.Qty"].Value</th><th>@L["Gamyba.State"].Value</th></tr></thead><tbody>
                        @foreach (var item in _liveTask.Items)
                        {
                            <tr><td class="mono">@item.Barcode</td><td class="mono">@item.OrderNumber</td><td>@item.ProductType</td><td>@item.MaterialCode</td><td class="is-num mono">@item.WidthMm × @item.HeightMm</td><td class="is-num mono">@item.Quantity</td><td><span class="chip chip--info">@item.State</span></td></tr>
                        }
                        </tbody></table></div></section>
                    }
                }
                else
                {
                <div class="gamyba-breadcrumb"><button type="button" @onclick='() => Go("tasks")'>@L["Gamyba.ProductionTasks"].Value</button> / <strong class="mono">@CurrentTask.Number</strong></div>
