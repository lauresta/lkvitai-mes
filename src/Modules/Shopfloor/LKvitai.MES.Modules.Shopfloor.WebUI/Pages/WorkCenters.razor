@page "/ref/work-centers"
@inject ShopfloorApiClient Api
@inject ISnackbar Snackbar

<PageTitle>Cikada.MES · @L["Shopfloor.WorkCenters"]</PageTitle>

<main class="shopfloor-page">
    <section class="sf-head">
        <div>
            <div class="eyebrow mono">@L["Shopfloor.ShopfloorReferenceData"]</div>
            <h1>@L["Shopfloor.WorkCenters"]</h1>
            <p>@L["Shopfloor.ProductionWorkCentersGroupingOneOrMoreWorkStations"]</p>
        </div>
        <div class="sf-head__actions">
            <MudButton Variant="Variant.Filled" Class="lk-btn lk-btn--primary" OnClick="StartCreate">@L["Shopfloor.NewWorkCenter"]</MudButton>
        </div>
    </section>

    <div class="sf-grid sf-grid--editor">
        <MudPaper Outlined="true" Elevation="0" Class="panel">
            <div class="panel__head">
                <div>
                    <h2>@L["Shopfloor.WorkCenters"]</h2>
                    <span>@(_centers?.Count ?? 0) total</span>
                </div>
            </div>

            @if (_centers is null)
            {
                <div class="db-lines"><span class="skeleton"></span><span class="skeleton"></span></div>
            }
            else if (_centers.Count == 0)
            {
                <p class="sf-empty">@L["Shopfloor.NoWorkCentersYet"]</p>
            }
            else
            {
                <div class="table-wrap">
                    <table class="sf-table">
                        <thead>
                            <tr><th>@L["Shopfloor.Code"]</th><th>@L["Shopfloor.Name"]</th><th class="sf-col-actions">@L["Shopfloor.Actions"]</th></tr>
                        </thead>
                        <tbody>
                            @foreach (var c in _centers)
                            {
                                <tr class="@(_editingId == c.Id ? "is-selected" : null)">
                                    <td class="mono">@c.Code</td>
                                    <td>@c.Name</td>
                                    <td class="sf-col-actions">
                                        <MudButton Size="Size.Small" Variant="Variant.Outlined" Class="lk-btn" OnClick="@(() => StartEdit(c))">@L["Shopfloor.Edit"]</MudButton>
                                        <MudButton Size="Size.Small" Variant="Variant.Outlined" Class="lk-btn" OnClick="@(() => Delete(c))">@L["Shopfloor.Delete"]</MudButton>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </MudPaper>

        @if (_formOpen)
        {
            <MudPaper Outlined="true" Elevation="0" Class="panel">
                <div class="panel__head">
                    <div>
                        <h2>@(_editingId is null ? L["Shopfloor.NewWorkCenter"].Value : L["Shopfloor.EditWorkCenter"].Value)</h2>
                        <span>@L["Shopfloor.CodeAndNameAreRequired"]</span>
                    </div>
                </div>
                <div class="sf-form">
                    <MudTextField @bind-Value="_code" Label="@L["Shopfloor.Code"]" Variant="Variant.Outlined" Margin="Margin.Dense" />
                    <MudTextField @bind-Value="_name" Label="@L["Shopfloor.Name"]" Variant="Variant.Outlined" Margin="Margin.Dense" />
                    <div class="sf-form__actions">
                        <MudButton Variant="Variant.Outlined" Class="lk-btn" OnClick="CancelForm">@L["Shopfloor.Cancel"]</MudButton>
                        <MudButton Variant="Variant.Filled" Class="lk-btn lk-btn--primary" Disabled="_saving" OnClick="Save">@L["Shopfloor.Save"]</MudButton>
                    </div>
                </div>
            </MudPaper>
        }
    </div>
</main>

@code {
    private IReadOnlyList<WorkCenterDto>? _centers;
    private bool _formOpen;
    private bool _saving;
    private Guid? _editingId;
    private string _code = "";
    private string _name = "";

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        _centers = await Api.GetWorkCentersAsync(CancellationToken.None);
        if (_centers is null)
        {
            Snackbar.Add(L["Shopfloor.ApiUnreachable"].Value, Severity.Error);
        }
    }

    private void StartCreate()
    {
        _editingId = null;
        _code = "";
        _name = "";
        _formOpen = true;
    }

    private void StartEdit(WorkCenterDto c)
    {
        _editingId = c.Id;
        _code = c.Code;
        _name = c.Name;
        _formOpen = true;
    }

    private void CancelForm() => _formOpen = false;

    private async Task Save()
    {
        _saving = true;
        try
        {
            if (_editingId is { } id)
            {
                var result = await Api.UpdateWorkCenterAsync(id, new UpdateWorkCenterRequest(_code, _name), CancellationToken.None);
                if (!Handle(result.Success, result.Error, L["Shopfloor.WorkCenterUpdated"].Value)) return;
            }
            else
            {
                var result = await Api.CreateWorkCenterAsync(new CreateWorkCenterRequest(_code, _name), CancellationToken.None);
                if (!Handle(result.Success, result.Error, L["Shopfloor.WorkCenterCreated"].Value)) return;
            }

            _formOpen = false;
            await LoadAsync();
        }
        finally
        {
            _saving = false;
        }
    }

    private async Task Delete(WorkCenterDto c)
    {
        var result = await Api.DeleteWorkCenterAsync(c.Id, CancellationToken.None);
        if (Handle(result.Success, result.Error, L["Shopfloor.WorkCenterDeleted"].Value))
        {
            await LoadAsync();
        }
    }

    private bool Handle(bool success, string? error, string okMessage)
    {
        if (success)
        {
            Snackbar.Add(okMessage, Severity.Success);
            return true;
        }

        Snackbar.Add(error ?? L["Shopfloor.OperationFailed"].Value, Severity.Error);
        return false;
    }
}
