@page "/map/product-types"
@inject ShopfloorApiClient Api
@inject ISnackbar Snackbar

<PageTitle>Cikada.MES · @L["Shopfloor.LegacyTypesCoverage"]</PageTitle>

<main class="shopfloor-page">
    <section class="sf-head">
        <div>
            <div class="eyebrow mono">@L["Shopfloor.ShopfloorMappings"]</div>
            <h1>@L["Shopfloor.LegacyTypesCoverage"]</h1>
            <p>@L["Shopfloor.MapLegacyProductTypesToProductionFamilies"]</p>
        </div>
        <div class="sf-head__actions">
            <MudButton Variant="Variant.Outlined" Class="lk-btn" Disabled="_syncing" OnClick="Sync">@(_syncing ? L["Shopfloor.Syncing"].Value : L["Shopfloor.SyncLegacy"].Value)</MudButton>
        </div>
    </section>

    <section class="sf-kpis" aria-label="@L["Shopfloor.Coverage"]">
        <MudPaper Outlined="true" Elevation="0" Class="panel kpi">
            <span class="kpi__label mono">@L["Shopfloor.MappedTotal"]</span>
            <strong class="mono">@(_coverage?.MappedLegacyTypes.ToString() ?? "—") / @(_coverage?.TotalLegacyTypes.ToString() ?? "—")</strong>
            <span class="chip chip--info">@L["Shopfloor.Coverage"]</span>
        </MudPaper>
        <MudPaper Outlined="true" Elevation="0" Class="panel kpi">
            <span class="kpi__label mono">@L["Shopfloor.Unmapped"]</span>
            <strong class="mono">@(_coverage?.UnmappedLegacyTypes.ToString() ?? "—")</strong>
            <span class="chip @((_coverage?.UnmappedLegacyTypes ?? 0) > 0 ? "chip--warn" : "chip--ok")">@((_coverage?.UnmappedLegacyTypes ?? 0) > 0 ? L["Shopfloor.Attention"].Value : L["Shopfloor.Complete"].Value)</span>
        </MudPaper>
        <MudPaper Outlined="true" Elevation="0" Class="panel kpi">
            <span class="kpi__label mono">@L["Shopfloor.Families"]</span>
            <strong class="mono">@(_coverage?.FamilyCount.ToString() ?? "—")</strong>
            <span class="chip chip--slate">@L["Shopfloor.Mapped"]</span>
        </MudPaper>
    </section>

    <MudPaper Outlined="true" Elevation="0" Class="panel">
        <div class="panel__head">
            <div>
                <h2>@L["Shopfloor.LegacyProductTypes"]</h2>
                <span>@L["Shopfloor.ShownOf", _rows?.Count ?? 0, _total]</span>
            </div>
        </div>

        <div class="sf-toolbar">
            <MudTextField @bind-Value="_search" Label="@L["Shopfloor.Search"]" Variant="Variant.Outlined" Margin="Margin.Dense" Immediate="false" OnKeyUp="OnSearchKey" />
            <MudSelect T="string" @bind-Value="_mappedFilter" Label="@L["Shopfloor.Mapping"]" Variant="Variant.Outlined" Margin="Margin.Dense">
                <MudSelectItem T="string" Value="@("all")">@L["Shopfloor.All"]</MudSelectItem>
                <MudSelectItem T="string" Value="@("mapped")">@L["Shopfloor.Mapped"]</MudSelectItem>
                <MudSelectItem T="string" Value="@("unmapped")">@L["Shopfloor.Unmapped"]</MudSelectItem>
            </MudSelect>
            <MudButton Variant="Variant.Outlined" Class="lk-btn" OnClick="Reload">@L["Shopfloor.Apply"]</MudButton>
        </div>

        <div class="sf-bulkbar">
            <span class="mono">@L["Shopfloor.SelectedCount", _selected.Count]</span>
            <MudSelect T="Guid" @bind-Value="_assignTarget" Label="@L["Shopfloor.AssignToFamily"]" Variant="Variant.Outlined" Margin="Margin.Dense" Disabled="@(_selected.Count == 0)">
                @foreach (var f in _families ?? Array.Empty<WorkflowTemplateSummaryDto>())
                {
                    <MudSelectItem T="Guid" Value="f.Id">@f.Code — @f.Name</MudSelectItem>
                }
            </MudSelect>
            <MudButton Variant="Variant.Filled" Class="lk-btn lk-btn--primary" Disabled="@(_selected.Count == 0 || _assignTarget == Guid.Empty)" OnClick="BulkAssign">@L["Shopfloor.Assign"]</MudButton>
        </div>

        @if (_rows is null)
        {
            <div class="db-lines"><span class="skeleton"></span><span class="skeleton"></span></div>
        }
        else if (_rows.Count == 0)
        {
            <p class="sf-empty">@L["Shopfloor.NoLegacyProductTypesMatchTheCurrentFilters"]</p>
        }
        else
        {
            <div class="table-wrap">
                <table class="sf-table">
                    <thead>
                        <tr>
                            <th class="sf-col-check"><input type="checkbox" @onchange="ToggleAll" checked="@AllSelected" /></th>
                            <th>@L["Shopfloor.Code"]</th><th>@L["Shopfloor.Kind"]</th><th>@L["Shopfloor.Name"]</th><th>@L["Shopfloor.MappedFamily"]</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var r in _rows)
                        {
                            <tr class="@(_selected.Contains(r.Code) ? "is-selected" : null)">
                                <td class="sf-col-check"><input type="checkbox" checked="@_selected.Contains(r.Code)" @onchange="@(e => ToggleRow(r.Code, e))" /></td>
                                <td class="mono">@r.Code</td>
                                <td>@r.KindName</td>
                                <td>@r.Name</td>
                                <td>
                                    @if (r.MappedWorkflowTemplateId is not null)
                                    {
                                        <span class="chip chip--ok mono">@r.MappedWorkflowCode</span>
                                    }
                                    else
                                    {
                                        <span class="chip chip--slate">@L["Shopfloor.Unmapped"]</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </MudPaper>
</main>

@code {
    private IReadOnlyList<LegacyProductTypeDto>? _rows;
    private IReadOnlyList<WorkflowTemplateSummaryDto>? _families;
    private CoverageSummaryDto? _coverage;
    private readonly HashSet<string> _selected = new(StringComparer.Ordinal);

    private string _search = "";
    private string _mappedFilter = "all";
    private Guid _assignTarget;
    private int _total;
    private bool _syncing;

    private bool AllSelected => _rows is { Count: > 0 } && _rows.All(r => _selected.Contains(r.Code));

    protected override async Task OnInitializedAsync()
    {
        _families = await Api.GetWorkflowsAsync(CancellationToken.None);
        await Reload();
    }

    private async Task Reload()
    {
        await LoadCoverageAsync();
        await LoadRowsAsync();
    }

    private async Task LoadCoverageAsync()
        => _coverage = await Api.GetCoverageAsync(CancellationToken.None);

    private async Task LoadRowsAsync()
    {
        bool? mapped = _mappedFilter switch
        {
            "mapped" => true,
            "unmapped" => false,
            _ => null,
        };

        var page = await Api.GetLegacyProductTypesAsync(_search, mapped, false, 1, 200, CancellationToken.None);
        if (page is null)
        {
            Snackbar.Add(L["Shopfloor.ApiUnreachable"].Value, Severity.Error);
            _rows = Array.Empty<LegacyProductTypeDto>();
            _total = 0;
            return;
        }

        _rows = page.Items;
        _total = page.Total;
        _selected.RemoveWhere(code => _rows.All(r => r.Code != code));
    }

    private void OnSearchKey(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            _ = Reload();
        }
    }

    private void ToggleRow(string code, ChangeEventArgs e)
    {
        if (e.Value is true)
        {
            _selected.Add(code);
        }
        else
        {
            _selected.Remove(code);
        }
    }

    private void ToggleAll(ChangeEventArgs e)
    {
        if (_rows is null) return;

        if (e.Value is true)
        {
            foreach (var r in _rows) _selected.Add(r.Code);
        }
        else
        {
            _selected.Clear();
        }
    }

    private async Task BulkAssign()
    {
        if (_selected.Count == 0 || _assignTarget == Guid.Empty) return;

        var request = new BulkAssignMappingRequest(_selected.ToList(), _assignTarget);
        var result = await Api.BulkAssignAsync(request, CancellationToken.None);
        if (result.Success)
        {
            Snackbar.Add(L["Shopfloor.AssignedTypes", _selected.Count].Value, Severity.Success);
            _selected.Clear();
            await Reload();
        }
        else
        {
            Snackbar.Add(result.Error ?? L["Shopfloor.AssignFailed"].Value, Severity.Error);
        }
    }

    private async Task Sync()
    {
        _syncing = true;
        try
        {
            var result = await Api.SyncLegacyProductTypesAsync(CancellationToken.None);
            if (result.Success)
            {
                Snackbar.Add(L["Shopfloor.LegacyTypesSynced"].Value, Severity.Success);
                await Reload();
            }
            else
            {
                Snackbar.Add(result.Error ?? L["Shopfloor.SyncFailed"].Value, Severity.Error);
            }
        }
        finally
        {
            _syncing = false;
        }
    }
}
