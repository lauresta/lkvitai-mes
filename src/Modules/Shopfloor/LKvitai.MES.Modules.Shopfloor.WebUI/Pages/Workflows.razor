@page "/workflows"
@inject ShopfloorApiClient Api
@inject ISnackbar Snackbar
@inject NavigationManager Navigation

<PageTitle>Cikada.MES · @L["Shopfloor.ProductionFamilies"]</PageTitle>

<main class="shopfloor-page">
    <section class="sf-head">
        <div>
            <div class="eyebrow mono">@L["Shopfloor.ShopfloorWorkflows"]</div>
            <h1>@L["Shopfloor.ProductionFamilies"]</h1>
            <p>@L["Shopfloor.WorkflowTemplatesAuthoredInTheEditorAndMappedToLegacyProductTypes"]</p>
        </div>
        <div class="sf-head__actions">
            <MudButton Variant="Variant.Filled" Class="lk-btn lk-btn--primary" OnClick="StartCreate">@L["Shopfloor.NewFamily"]</MudButton>
        </div>
    </section>

    <div class="sf-grid sf-grid--editor">
        <MudPaper Outlined="true" Elevation="0" Class="panel">
            <div class="panel__head">
                <div>
                    <h2>@L["Shopfloor.Families"]</h2>
                    <span>@L["Shopfloor.Total", _families?.Count ?? 0]</span>
                </div>
            </div>

            @if (_families is null)
            {
                <div class="db-lines"><span class="skeleton"></span><span class="skeleton"></span></div>
            }
            else if (_families.Count == 0)
            {
                <p class="sf-empty">@L["Shopfloor.NoProductionFamiliesYet"]</p>
            }
            else
            {
                <div class="table-wrap">
                    <table class="sf-table">
                        <thead>
                            <tr>
                                <th>@L["Shopfloor.Code"]</th><th>@L["Shopfloor.Name"]</th><th>@L["Shopfloor.Status"]</th><th>@L["Shopfloor.Mapped"]</th><th>@L["Shopfloor.Tasks"]</th><th>@L["Shopfloor.Updated"]</th>
                                <th class="sf-col-actions">@L["Shopfloor.Actions"]</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var f in _families)
                            {
                                <tr>
                                    <td class="mono">@f.Code</td>
                                    <td>@f.Name</td>
                                    <td><span class="chip @StatusChip(f.Status)">@f.Status</span></td>
                                    <td class="mono">@f.MappedLegacyCount</td>
                                    <td class="mono">@f.TaskCount</td>
                                    <td class="mono">@((f.UpdatedAt ?? f.CreatedAt).ToString("yyyy-MM-dd HH:mm"))</td>
                                    <td class="sf-col-actions">
                                        <MudButton Size="Size.Small" Variant="Variant.Filled" Class="lk-btn lk-btn--primary" OnClick="@(() => OpenEditor(f))">@L["Shopfloor.Editor"]</MudButton>
                                        <MudButton Size="Size.Small" Variant="Variant.Outlined" Class="lk-btn" OnClick="@(() => Preview(f))">@L["Shopfloor.Preview"]</MudButton>
                                        <MudButton Size="Size.Small" Variant="Variant.Outlined" Class="lk-btn" OnClick="@(() => Publish(f))">@L["Shopfloor.Publish"]</MudButton>
                                        <MudButton Size="Size.Small" Variant="Variant.Outlined" Class="lk-btn" OnClick="@(() => StartClone(f))">@L["Shopfloor.Clone"]</MudButton>
                                        <MudButton Size="Size.Small" Variant="Variant.Outlined" Class="lk-btn" OnClick="@(() => Delete(f))">@L["Shopfloor.Delete"]</MudButton>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </MudPaper>

        @if (_formOpen)
        {
            <MudPaper Outlined="true" Elevation="0" Class="panel">
                <div class="panel__head">
                    <div>
                        <h2>@(_cloneSourceId is null ? L["Shopfloor.NewFamily"].Value : L["Shopfloor.CloneFamily"].Value)</h2>
                        <span>@L["Shopfloor.CodeAndNameAreRequired"]</span>
                    </div>
                </div>
                <div class="sf-form">
                    <MudTextField @bind-Value="_code" Label="@L["Shopfloor.Code"]" Variant="Variant.Outlined" Margin="Margin.Dense" />
                    <MudTextField @bind-Value="_name" Label="@L["Shopfloor.Name"]" Variant="Variant.Outlined" Margin="Margin.Dense" />
                    <MudTextField @bind-Value="_description" Label="@L["Shopfloor.DescriptionOptional"]" Variant="Variant.Outlined" Margin="Margin.Dense" Lines="2" />
                    <div class="sf-form__actions">
                        <MudButton Variant="Variant.Outlined" Class="lk-btn" OnClick="CancelForm">@L["Shopfloor.Cancel"]</MudButton>
                        <MudButton Variant="Variant.Filled" Class="lk-btn lk-btn--primary" Disabled="_saving" OnClick="Save">@L["Shopfloor.Save"]</MudButton>
                    </div>
                </div>
            </MudPaper>
        }
        else if (_preview is not null)
        {
            <MudPaper Outlined="true" Elevation="0" Class="panel">
                <div class="panel__head">
                    <div>
                        <h2>Preview · @_preview.FamilyName</h2>
                        <span>@L["Shopfloor.ClientSideDryRunTopologicallyOrderedTaskPlan"]</span>
                    </div>
                    <MudButton Size="Size.Small" Variant="Variant.Outlined" Class="lk-btn" OnClick="@(() => _preview = null)">@L["Shopfloor.Close"]</MudButton>
                </div>

                @if (_preview.Errors.Count > 0)
                {
                    <ul class="sf-errors">
                        @foreach (var e in _preview.Errors)
                        {
                            <li><span class="chip chip--danger">@L["Shopfloor.Invalid"]</span> @e</li>
                        }
                    </ul>
                }
                else
                {
                    <div class="table-wrap">
                        <table class="sf-table">
                            <thead>
                                <tr><th>@L["Shopfloor.Step"]</th><th>@L["Shopfloor.Task"]</th><th>@L["Shopfloor.Description"]</th><th>@L["Shopfloor.Station"]</th><th>@L["Shopfloor.Duration"]</th></tr>
                            </thead>
                            <tbody>
                                @{ var step = 1; }
                                @foreach (var t in _preview.Steps)
                                {
                                    <tr>
                                        <td class="mono">@step</td>
                                        <td>@t.Name</td>
                                        <td>@(string.IsNullOrWhiteSpace(t.Description) ? "—" : t.Description)</td>
                                        <td>@t.Station</td>
                                        <td class="mono">@t.Duration</td>
                                    </tr>
                                    step++;
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </MudPaper>
        }
    </div>
</main>

@code {
    private IReadOnlyList<WorkflowTemplateSummaryDto>? _families;
    private IReadOnlyList<WorkStationDto>? _stations;

    private bool _formOpen;
    private bool _saving;
    private Guid? _cloneSourceId;
    private string _code = "";
    private string _name = "";
    private string? _description;

    private PreviewModel? _preview;

    private sealed record PreviewStep(string Name, string? Description, string Station, string Duration);
    private sealed record PreviewModel(string FamilyName, IReadOnlyList<PreviewStep> Steps, IReadOnlyList<string> Errors);

    protected override async Task OnInitializedAsync()
    {
        _stations = await Api.GetWorkStationsAsync(false, CancellationToken.None);
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _families = await Api.GetWorkflowsAsync(CancellationToken.None);
        if (_families is null)
        {
            Snackbar.Add(L["Shopfloor.ApiUnreachable"].Value, Severity.Error);
        }
    }

    private void OpenEditor(WorkflowTemplateSummaryDto f)
        => Navigation.NavigateTo($"workflow-editor?id={f.Id}");

    private void StartCreate()
    {
        _preview = null;
        _cloneSourceId = null;
        _code = "";
        _name = "";
        _description = null;
        _formOpen = true;
    }

    private void StartClone(WorkflowTemplateSummaryDto f)
    {
        _preview = null;
        _cloneSourceId = f.Id;
        _code = f.Code + "-COPY";
        _name = f.Name + " (copy)";
        _description = f.Description;
        _formOpen = true;
    }

    private void CancelForm() => _formOpen = false;

    private async Task Save()
    {
        _saving = true;
        try
        {
            if (_cloneSourceId is { } sourceId)
            {
                var result = await Api.CloneWorkflowAsync(sourceId, new CloneWorkflowTemplateRequest(_code, _name, _description), CancellationToken.None);
                if (!Handle(result.Success, result.Error, L["Shopfloor.FamilyCloned"].Value)) return;
            }
            else
            {
                var result = await Api.CreateWorkflowAsync(new CreateWorkflowTemplateRequest(_code, _name, _description), CancellationToken.None);
                if (!Handle(result.Success, result.Error, L["Shopfloor.FamilyCreated"].Value)) return;
            }

            _formOpen = false;
            await LoadAsync();
        }
        finally
        {
            _saving = false;
        }
    }

    private async Task Publish(WorkflowTemplateSummaryDto f)
    {
        var result = await Api.PublishWorkflowAsync(f.Id, CancellationToken.None);
        if (Handle(result.Success, result.Error, L["Shopfloor.FamilyPublished", f.Code].Value))
        {
            await LoadAsync();
        }
    }

    private async Task Delete(WorkflowTemplateSummaryDto f)
    {
        var result = await Api.DeleteWorkflowAsync(f.Id, CancellationToken.None);
        if (Handle(result.Success, result.Error, L["Shopfloor.FamilyDeleted", f.Code].Value))
        {
            await LoadAsync();
        }
    }

    private async Task Preview(WorkflowTemplateSummaryDto f)
    {
        _formOpen = false;
        var detail = await Api.GetWorkflowAsync(f.Id, CancellationToken.None);
        if (detail is null)
        {
            Snackbar.Add(L["Shopfloor.CouldNotLoadWorkflowGraph"].Value, Severity.Error);
            return;
        }

        _preview = BuildPreview(detail);
    }

    private PreviewModel BuildPreview(WorkflowTemplateDto wf)
    {
        var graph = wf.Graph;
        var errors = new List<string>();

        var nodes = graph.Nodes.ToDictionary(n => n.Id, n => n);
        var starts = graph.Nodes.Where(n => n.Kind == WorkflowNodeKinds.Start).ToList();
        var finishes = graph.Nodes.Where(n => n.Kind == WorkflowNodeKinds.Finish).ToList();

        if (starts.Count != 1) errors.Add(L["Shopfloor.GraphMustHaveOneStart"].Value);
        if (finishes.Count != 1) errors.Add(L["Shopfloor.GraphMustHaveOneFinish"].Value);

        foreach (var t in graph.Nodes.Where(n => n.Kind == WorkflowNodeKinds.Task))
        {
            if (t.WorkStationId is null) errors.Add(L["Shopfloor.TaskNoStation", t.Name].Value);
            if (t.DurationSec is null or <= 0) errors.Add(L["Shopfloor.TaskNoDuration", t.Name].Value);
        }

        var order = TopologicalOrder(graph, nodes, errors);

        if (errors.Count > 0)
        {
            return new PreviewModel(wf.Name, Array.Empty<PreviewStep>(), errors);
        }

        var stationNames = (_stations ?? Array.Empty<WorkStationDto>())
            .ToDictionary(s => s.Id, s => $"{s.Code} — {s.Name}");

        var steps = order
            .Where(id => nodes[id].Kind == WorkflowNodeKinds.Task)
            .Select(id => nodes[id])
            .Select(n => new PreviewStep(
                n.Name,
                n.Description,
                n.WorkStationId is { } sid && stationNames.TryGetValue(sid, out var name) ? name : "—",
                n.DurationSec is { } d ? $"{d}s" : "—"))
            .ToList();

        return new PreviewModel(wf.Name, steps, errors);
    }

    private List<string> TopologicalOrder(
        WorkflowGraphDto graph,
        IReadOnlyDictionary<string, WorkflowNodeDto> nodes,
        List<string> errors)
    {
        var inDegree = nodes.Keys.ToDictionary(id => id, _ => 0);
        var adjacency = nodes.Keys.ToDictionary(id => id, _ => new List<string>());

        foreach (var e in graph.Edges)
        {
            if (!nodes.ContainsKey(e.From) || !nodes.ContainsKey(e.To))
            {
                errors.Add(L["Shopfloor.EdgeMissingNode", e.From, e.To].Value);
                continue;
            }

            adjacency[e.From].Add(e.To);
            inDegree[e.To]++;
        }

        var queue = new Queue<string>(inDegree.Where(kv => kv.Value == 0).Select(kv => kv.Key));
        var order = new List<string>();
        while (queue.Count > 0)
        {
            var current = queue.Dequeue();
            order.Add(current);
            foreach (var next in adjacency[current])
            {
                if (--inDegree[next] == 0)
                {
                    queue.Enqueue(next);
                }
            }
        }

        if (order.Count != nodes.Count)
        {
            errors.Add(L["Shopfloor.GraphContainsCycle"].Value);
        }

        return order;
    }

    private static string StatusChip(WorkflowStatus status) => status switch
    {
        WorkflowStatus.Published => "chip--ok",
        WorkflowStatus.Archived => "chip--slate",
        _ => "chip--info",
    };

    private bool Handle(bool success, string? error, string okMessage)
    {
        if (success)
        {
            Snackbar.Add(okMessage, Severity.Success);
            return true;
        }

        Snackbar.Add(error ?? L["Shopfloor.OperationFailed"].Value, Severity.Error);
        return false;
    }
}
