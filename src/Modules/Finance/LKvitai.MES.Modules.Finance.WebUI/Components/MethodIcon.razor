@* Payment method icons (Lucide geometry, stroke 1.9, coloured by the surrounding text): landmark = bank transfer,
   credit card = EKA, receipt = PPK, banknote = cash desk. <MethodIcon Defs="true" /> renders the <symbol>s once per page;
   <MethodIcon Code="BANK" /> uses one. Methods are always shown with their name too, never by colour alone. *@
@if (Defs)
{
    <svg class="inc-ico-defs" width="0" height="0" aria-hidden="true" focusable="false">
        <symbol id="inc-ico-BANK" viewBox="0 0 24 24"><path d="M3 21h18" /><path d="M5 21v-9M10 21v-9M14 21v-9M19 21v-9" /><path d="M2 9l10-6 10 6z" /></symbol>
        <symbol id="inc-ico-EKA" viewBox="0 0 24 24"><rect x="2.5" y="5" width="19" height="14" rx="2" /><path d="M2.5 10h19M6 15h4" /></symbol>
        <symbol id="inc-ico-PPK" viewBox="0 0 24 24"><path d="M5 2.5h14v19l-2.5-1.5-2.3 1.5-2.2-1.5-2.2 1.5-2.3-1.5L5 21.5z" /><path d="M9 8h6M9 12h6M9 16h3" /></symbol>
        <symbol id="inc-ico-KASA" viewBox="0 0 24 24"><rect x="2" y="6" width="20" height="12" rx="2" /><circle cx="12" cy="12" r="2.6" /><path d="M6 12h.01M18 12h.01" /></symbol>
    </svg>
}
else
{
    <svg class="inc-ico" width="@Size" height="@Size" aria-hidden="true" focusable="false"><use href="#inc-ico-@Code" /></svg>
}

@code {
    [Parameter] public string Code { get; set; } = "";
    [Parameter] public int Size { get; set; } = 12;
    [Parameter] public bool Defs { get; set; }
}
