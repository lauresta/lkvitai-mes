@using Microsoft.AspNetCore.Components.Web
@namespace LKvitai.MES.Modules.Finance.WebUI.Pages
@using Microsoft.Extensions.Localization
@using LKvitai.MES.Modules.Finance.WebUI.Resources
@inject IStringLocalizer<FinanceResources> L
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

<!DOCTYPE html>
<html lang="@System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="~/" />
    <link href="_content/MudBlazor/MudBlazor.min.css" rel="stylesheet" asp-append-version="true" />
    <link href="_content/LKvitai.MES.BuildingBlocks.WebUI/css/fonts.css" rel="stylesheet" asp-append-version="true" />
    <link href="_content/LKvitai.MES.BuildingBlocks.WebUI/css/portal-tokens.css" rel="stylesheet" asp-append-version="true" />
    <link href="_content/LKvitai.MES.BuildingBlocks.WebUI/css/portal-shell.css" rel="stylesheet" asp-append-version="true" />
    <link href="css/finance.css" rel="stylesheet" asp-append-version="true" />
    <link rel="icon" type="image/png" sizes="32x32" href="_content/LKvitai.MES.BuildingBlocks.WebUI/brand/favicon-32.png" asp-append-version="true" />
    <link rel="icon" type="image/png" sizes="16x16" href="_content/LKvitai.MES.BuildingBlocks.WebUI/brand/favicon-16.png" asp-append-version="true" />
    <meta name="theme-color" content="#2f8f8b" />
    <title>@L["Shell.PageTitle"]</title>
    <component type="typeof(HeadOutlet)" render-mode="ServerPrerendered" />
</head>
<body>
    @RenderBody()
    <div id="blazor-error-ui">
        @L["Shell.UnhandledError"]
        <a href="" class="reload">@L["Shell.Reload"]</a>
        <a class="dismiss" aria-label="@L["Shell.Dismiss"]">×</a>
    </div>
    <persist-component-state />
    <script src="_framework/blazor.server.js" asp-append-version="true"></script>
    <script src="_content/MudBlazor/MudBlazor.min.js" asp-append-version="true"></script>
    <script src="js/finance-paste.js" asp-append-version="true"></script>
</body>
</html>
