{
  "folderUID": "dg5oiob1o191cd",
  "group": "cikada-logs",
  "interval": 300,
  "rules": [
    {
      "title": "Cikada prod: klaidos loguose",
      "ruleGroup": "cikada-logs",
      "folderUID": "dg5oiob1o191cd",
      "orgID": 1,
      "condition": "C",
      "for": "0s",
      "noDataState": "OK",
      "execErrState": "Error",
      "isPaused": false,
      "annotations": {
        "summary": "Per pastaruosius 10 min Cikada prod loguose daugiau nei 20 error/fatal įrašų",
        "description": "VictoriaLogs: env:prod level:in(error,fatal), > 20 įrašų per 10 min."
      },
      "labels": { "app": "cikada", "env": "prod" },
      "data": [
        {
          "refId": "A",
          "queryType": "",
          "relativeTimeRange": { "from": 600, "to": 0 },
          "datasourceUid": "cf82quh3gjy80a",
          "model": {
            "refId": "A",
            "datasource": { "type": "victoriametrics-logs-datasource", "uid": "cf82quh3gjy80a" },
            "queryType": "stats",
            "expr": "env:prod level:in(error,fatal) | stats count() as errors",
            "intervalMs": 1000,
            "maxDataPoints": 43200
          }
        },
        {
          "refId": "B",
          "queryType": "",
          "relativeTimeRange": { "from": 0, "to": 0 },
          "datasourceUid": "__expr__",
          "model": { "refId": "B", "type": "reduce", "expression": "A", "reducer": "last", "datasource": { "type": "__expr__", "uid": "__expr__" } }
        },
        {
          "refId": "C",
          "queryType": "",
          "relativeTimeRange": { "from": 0, "to": 0 },
          "datasourceUid": "__expr__",
          "model": {
            "refId": "C", "type": "threshold", "expression": "B",
            "conditions": [ { "evaluator": { "type": "gt", "params": [20] } } ],
            "datasource": { "type": "__expr__", "uid": "__expr__" }
          }
        }
      ]
    },
    {
      "title": "Nėra logų iš serverio",
      "ruleGroup": "cikada-logs",
      "folderUID": "dg5oiob1o191cd",
      "orgID": 1,
      "condition": "C",
      "for": "0s",
      "noDataState": "Alerting",
      "execErrState": "Error",
      "isPaused": false,
      "annotations": {
        "summary": "Per pastarąsias 2 val. syslog siunčia mažiau nei 14 skirtingų hostname",
        "description": "Tikėtinas hostname sąrašas (14): lauresta-bin, lauresta-contabo-vps, lauresta-pbs, lauresta-pbs-remote, klp-bazdc1-proxm-rck-admin-01, lkvitai-apps, lkvitai-aux, lkvitai-db, lkvitai-edge, lkvitai-infra, lkvitai-mon, lkvitai-mssql, lkvitai-test, TERMINAL. Palyginkite su dashboard „Bendras vaizdas“ lentele „Paskutinis įrašas pagal hostname“."
      },
      "labels": { "app": "cikada", "kind": "log-collection" },
      "data": [
        {
          "refId": "A",
          "queryType": "",
          "relativeTimeRange": { "from": 7200, "to": 0 },
          "datasourceUid": "cf82quh3gjy80a",
          "model": {
            "refId": "A",
            "datasource": { "type": "victoriametrics-logs-datasource", "uid": "cf82quh3gjy80a" },
            "queryType": "stats",
            "expr": "hostname:* | stats count_uniq(hostname) as hosts",
            "intervalMs": 1000,
            "maxDataPoints": 43200
          }
        },
        {
          "refId": "B",
          "queryType": "",
          "relativeTimeRange": { "from": 0, "to": 0 },
          "datasourceUid": "__expr__",
          "model": { "refId": "B", "type": "reduce", "expression": "A", "reducer": "last", "datasource": { "type": "__expr__", "uid": "__expr__" } }
        },
        {
          "refId": "C",
          "queryType": "",
          "relativeTimeRange": { "from": 0, "to": 0 },
          "datasourceUid": "__expr__",
          "model": {
            "refId": "C", "type": "threshold", "expression": "B",
            "conditions": [ { "evaluator": { "type": "lt", "params": [14] } } ],
            "datasource": { "type": "__expr__", "uid": "__expr__" }
          }
        }
      ]
    }
  ]
}
